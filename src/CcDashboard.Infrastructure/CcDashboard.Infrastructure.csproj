  <!-- BL-V4-STALE-VALUES-LOOK-LIVE-01: the relay's connection notice must be testable. The
       HubConnection it listens to is built inside this service and has no interface, so a test
       cannot make a real link drop without changing how the service is wired - that would be
       structure, not design. Opening the fan-out itself to the test project gives a real test of
       the part that is ours (every subscriber is told; one that throws does not silence the rest)
       without touching the wiring. Agreed with the coordinator 2026-10-22. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CcDashboard.Tests.Unit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

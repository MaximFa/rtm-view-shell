{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ApplyService": {
    "Port": 5099,
    "Token": "REPLACE_AT_DEPLOY"
  },
  "CatalogueOwner": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=rtmviewdb;Username=catalogue_owner;Password=REPLACE_AT_DEPLOY;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Audit": {
    "ConnectionString": "Host=127.0.0.1;Port=5432;Database=rtmviewdb;Username=catalogue_owner;Password=REPLACE_AT_DEPLOY;SSL Mode=Require;Trust Server Certificate=true"
  },
  "PackageMigrationsDir": "C:\\Program Files\\CcDashboard\\migrations",
  "ManifestPath": "C:\\Program Files\\CcDashboard\\manifest.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/applyservice-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
@inherits LayoutComponentBase

<div class="page">
    <nav class="sidebar">
        <div class="sidebar-header px-3 py-2">
            <span class="fw-bold">RTM View Shell</span>
        </div>
        <NavMenu />
    </nav>
    <main>
        <div class="top-row px-4 d-flex justify-content-end align-items-center">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3 text-muted small">@context.User.Identity?.Name</span>
                    <form method="post" action="/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Sign Out</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

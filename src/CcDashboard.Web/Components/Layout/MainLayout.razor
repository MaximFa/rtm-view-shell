@inherits LayoutComponentBase

<div class="shell-layout">
    <nav class="sidebar">
        <div class="sidebar-brand">@L["Layout_AppName"]</div>
        <NavMenu />
    </nav>

    <div class="main-area">
        <header class="topbar">
            <AuthorizeView>
                <Authorized>
                    <span class="user-info">@context.User.Identity?.Name</span>
                    <a href="/logout" class="btn btn-sm btn-outline-secondary">@L["Layout_SignOut"]</a>
                </Authorized>
            </AuthorizeView>
        </header>

        <div class="content-area">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui">
    @L["Layout_UnhandledError"]
    <a href="" class="reload">@L["Layout_Reload"]</a>
    <span class="dismiss">&#x2715;</span>
</div>

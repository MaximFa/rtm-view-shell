@inherits LayoutComponentBase

<div class="shell-layout">
    <nav class="sidebar">
        <div class="sidebar-brand">RTM View Shell</div>
        <NavMenu />
    </nav>

    <div class="main-area">
        <header class="topbar">
            <AuthorizeView>
                <Authorized>
                    <span class="user-info">@context.User.Identity?.Name</span>
                    <a href="/logout" class="btn btn-sm btn-outline-secondary">Sign out</a>
                </Authorized>
            </AuthorizeView>
        </header>

        <div class="content-area">
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">&#x2715;</span>
</div>

@page "/login/2fa"
@using CcDashboard.Application.Interfaces
@inject IIdentityAuthService AuthService
@inject NavigationManager Nav

<PageTitle>@L["TwoFactor_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height:100vh;background:#f0f2f5">
    <div class="card shadow-sm" style="width:420px">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <span class="badge bg-primary mb-2">@L["TwoFactor_Step"]</span>
                <h5 class="fw-bold mb-1">@L["TwoFactor_VerificationRequired"]</h5>
                <p class="text-muted small mb-0">@L["TwoFactor_Instruction"]</p>
            </div>

            @if (ErrorMessage is not null)
            {
                <div class="alert alert-danger py-2 small">@ErrorMessage</div>
            }
            @if (ResendSuccess)
            {
                <div class="alert alert-success py-2 small">@L["TwoFactor_NewCodeSent"]</div>
            }

            <form method="post" @formname="twofactor">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label for="code" class="form-label">@L["TwoFactor_Code"]</label>
                    <input id="code" name="Model.Code" type="text" class="form-control form-control-lg text-center fw-bold"
                           maxlength="6" pattern="[0-9]{6}" placeholder="000000"
                           inputmode="numeric" autocomplete="one-time-code" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 mb-3">@L["TwoFactor_Confirm"]</button>
            </form>

            <form method="post" @formname="twofactor_resend">
                <AntiforgeryToken />
                <div class="text-center">
                    <button type="submit" class="btn btn-link btn-sm p-0 text-muted">@L["TwoFactor_Resend"]</button>
                </div>
            </form>
        </div>
        <div class="card-footer text-muted small text-center py-2">
            @L["TwoFactor_Footer"]
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "twofactor")]
    public TwoFactorFormModel? Model { get; set; }

    [SupplyParameterFromForm(FormName = "twofactor_resend")]
    public ResendFormModel? ResendModel { get; set; }

    private string? ErrorMessage;
    private bool ResendSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null) return;

        if (ResendModel is not null)
        {
            var result = await AuthService.ResendTwoFactorCodeAsync();
            if (result.Succeeded)
                ResendSuccess = true;
            else
                ErrorMessage = L["TwoFactor_ResendWait"];
            return;
        }

        if (Model?.Code is null) return;

        try
        {
            var result = await AuthService.CompleteTwoFactorAsync(Model.Code);
            switch (result.Status)
            {
                case IdentitySignInStatus.Success:
                    HttpContext.Response.Redirect(result.RequiresPasswordChange ? "/change-password" : "/screens");
                    return;
                case IdentitySignInStatus.LockedOut:
                    ErrorMessage = L["TwoFactor_TooManyAttempts"];
                    break;
                default:
                    ErrorMessage = L["Login_InvalidCredentials"];
                    break;
            }
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            ErrorMessage = L["TwoFactor_Failed"];
        }
    }

    public class TwoFactorFormModel
    {
        public string Code { get; set; } = string.Empty;
    }

    public class ResendFormModel { }
}

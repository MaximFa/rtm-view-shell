@page "/two-factor"
@layout AuthLayout
@inject NavigationManager Nav

<PageTitle>2FA Verification — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Two-step verification</h2>
            <span class="badge bg-primary">2FA · step 2 of 2</span>
        </div>

        @if (ErrorMessage is not null)
        {
            <div class="alert alert-danger py-2">@ErrorMessage</div>
        }

        <p class="text-muted small">
            A 6-digit code was sent to your email address.
            Valid 10 minutes · 3 attempts · HMAC-SHA256 + salt [2FA-02..03]
        </p>

        <form method="post" @formname="twofactor">
            <AntiforgeryToken />
            <input type="hidden" name="Model.UserId" value="@UserId" />
            <div class="mb-3">
                <label for="code" class="form-label">Verification code</label>
                <input id="code" name="Model.Code" type="text" class="form-control text-center"
                       maxlength="6" pattern="[0-9]{6}" placeholder="000000"
                       inputmode="numeric" autocomplete="one-time-code" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Confirm →</button>
        </form>

        <div class="mt-2 text-center">
            <a href="/two-factor/resend?userId=@UserId" class="small text-muted">Resend code</a>
        </div>

        <div class="mt-3 text-muted" style="font-size:0.7rem;">
            5 failed login attempts → 15 min lockout [BFP-01] · 3 OTP attempts → cancellation [2FA-04]
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery]
    public Guid? UserId { get; set; }

    [SupplyParameterFromForm(FormName = "twofactor")]
    public TwoFactorFormModel? Model { get; set; }

    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null || Model?.Code is null) return;

        try
        {
            // TODO: verify code via TwoFactorService and sign in
            ErrorMessage = "2FA verification not yet fully wired.";
        }
        catch (Exception ex) when (ex is not Microsoft.AspNetCore.Components.NavigationException)
        {
            ErrorMessage = "Verification failed. Please try again.";
        }
    }

    public class TwoFactorFormModel
    {
        public Guid UserId { get; set; }
        public string Code { get; set; } = string.Empty;
    }
}

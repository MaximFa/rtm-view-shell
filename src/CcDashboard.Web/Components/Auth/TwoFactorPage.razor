@page "/login/2fa"
@using CcDashboard.Application.Interfaces
@inject IIdentityAuthService AuthService
@inject NavigationManager Nav

<PageTitle>Two-Factor Verification — RTM View Shell</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height:100vh;background:#f0f2f5">
    <div class="card shadow-sm" style="width:420px">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <span class="badge bg-primary mb-2">2FA &middot; step 2 of 2</span>
                <h5 class="fw-bold mb-1">Verification required</h5>
                <p class="text-muted small mb-0">Enter the 6-digit code sent to your email.</p>
            </div>

            @if (ErrorMessage is not null)
            {
                <div class="alert alert-danger py-2 small">@ErrorMessage</div>
            }
            @if (ResendSuccess)
            {
                <div class="alert alert-success py-2 small">A new code has been sent.</div>
            }

            <form method="post" @formname="twofactor">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label class="form-label">Verification code</label>
                    <input name="Model.Code" type="text" class="form-control form-control-lg text-center fw-bold"
                           maxlength="6" pattern="[0-9]{6}" placeholder="000000"
                           inputmode="numeric" autocomplete="one-time-code" required />
                </div>
                <button type="submit" class="btn btn-primary w-100 mb-3">Confirm -></button>
            </form>

            <form method="post" @formname="twofactor_resend">
                <AntiforgeryToken />
                <div class="text-center">
                    <button type="submit" class="btn btn-link btn-sm p-0 text-muted">Resend code</button>
                </div>
            </form>
        </div>
        <div class="card-footer text-muted small text-center py-2">
            Valid 10 min &middot; 3 attempts &middot; HMAC-SHA256 + salt [2FA-02..03]
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "twofactor")]
    public TwoFactorFormModel? Model { get; set; }

    [SupplyParameterFromForm(FormName = "twofactor_resend")]
    public ResendFormModel? ResendModel { get; set; }

    private string? ErrorMessage;
    private bool ResendSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null) return;

        if (ResendModel is not null)
        {
            var result = await AuthService.ResendTwoFactorCodeAsync();
            if (result.Succeeded)
                ResendSuccess = true;
            else
                ErrorMessage = "Please wait before requesting another code.";
            return;
        }

        if (Model?.Code is null) return;

        try
        {
            var result = await AuthService.CompleteTwoFactorAsync(Model.Code);
            switch (result.Status)
            {
                case IdentitySignInStatus.Success:
                    HttpContext.Response.Redirect(result.RequiresPasswordChange ? "/change-password" : "/screens");
                    return;
                case IdentitySignInStatus.LockedOut:
                    ErrorMessage = "Too many attempts. Please request a new code.";
                    break;
                default:
                    ErrorMessage = "Invalid username or password.";
                    break;
            }
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            ErrorMessage = "Verification failed. Please try again.";
        }
    }

    public class TwoFactorFormModel
    {
        public string Code { get; set; } = string.Empty;
    }

    public class ResendFormModel { }
}

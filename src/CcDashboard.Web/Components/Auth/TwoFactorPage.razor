@page "/login/2fa"
@layout AuthLayout
@using CcDashboard.Application.Interfaces
@inject IIdentityAuthService AuthService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@L["TwoFactor_Title"] — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="text-center mb-4">
            <span class="badge bg-primary mb-2">@L["TwoFactor_Step"]</span>
            <h5 class="fw-bold mb-1">@L["TwoFactor_VerificationRequired"]</h5>
            <p class="text-muted small mb-0">@L["TwoFactor_Instruction"]</p>
        </div>

        @if (ErrorMessage is not null)
        {
            <div class="alert alert-danger py-2 small" role="alert">@ErrorMessage</div>
        }
        @if (ResendSuccess)
        {
            <div class="alert alert-success py-2 small">@L["TwoFactor_NewCodeSent"]</div>
        }

        <form method="post" @formname="twofactor">
            <AntiforgeryToken />
            <!-- Hidden field to collect the 6-digit code -->
            <input type="hidden" name="Model.Code" value="@CombinedCode" />

            <div class="mb-4">
                <label class="form-label d-block text-center">@L["TwoFactor_Code"]</label>
                <!-- 6-box OTP input [UX-02] -->
                <div class="d-flex justify-content-center gap-2" role="group" aria-label="@L["TwoFactor_Code"]">
                    @for (int i = 0; i < 6; i++)
                    {
                        var idx = i;
                        <input type="text"
                               inputmode="numeric"
                               maxlength="1"
                               pattern="[0-9]"
                               class="form-control text-center fw-bold fs-4 otp-box"
                               style="width:48px;height:56px;"
                               autocomplete="off"
                               @ref="OtpRefs[idx]"
                               value="@OtpDigits[idx]"
                               @oninput="e => OnOtpInput(idx, e)"
                               @onkeydown="e => OnOtpKeyDown(idx, e)"
                               @onpaste="OnOtpPaste"
                               aria-label="@($"Digit {idx + 1}")" />
                    }
                </div>
                <div class="text-muted text-center small mt-2">@L["TwoFactor_ValidFor"]</div>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-3" disabled="@(!IsCodeComplete)">
                @L["TwoFactor_Confirm"]
            </button>
        </form>

        <form method="post" @formname="twofactor_resend">
            <AntiforgeryToken />
            <div class="text-center">
                <button type="submit" class="btn btn-link btn-sm p-0 text-muted">@L["TwoFactor_Resend"]</button>
            </div>
        </form>
    </div>
    <div class="card-footer text-muted small text-center py-2">
        @L["TwoFactor_Footer"]
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "twofactor")]
    public TwoFactorFormModel? Model { get; set; }

    [SupplyParameterFromForm(FormName = "twofactor_resend")]
    public ResendFormModel? ResendModel { get; set; }

    private string? ErrorMessage;
    private bool ResendSuccess;

    // 6-box OTP state
    private readonly string[] OtpDigits = new string[6] { "", "", "", "", "", "" };
    private readonly ElementReference[] OtpRefs = new ElementReference[6];
    private string CombinedCode => string.Join("", OtpDigits);
    private bool IsCodeComplete => OtpDigits.All(d => !string.IsNullOrEmpty(d));

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null) return;

        if (ResendModel is not null)
        {
            var result = await AuthService.ResendTwoFactorCodeAsync();
            if (result.Succeeded)
                ResendSuccess = true;
            else
                ErrorMessage = L["TwoFactor_ResendWait"];
            return;
        }

        if (Model?.Code is null || Model.Code.Length != 6) return;

        try
        {
            var result = await AuthService.CompleteTwoFactorAsync(Model.Code);
            switch (result.Status)
            {
                case IdentitySignInStatus.Success:
                    HttpContext.Response.Redirect(result.RequiresPasswordChange ? "/change-password" : "/screens");
                    return;
                case IdentitySignInStatus.LockedOut:
                    ErrorMessage = L["TwoFactor_TooManyAttempts"];
                    break;
                default:
                    ErrorMessage = L["Login_InvalidCredentials"];
                    break;
            }
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            ErrorMessage = L["TwoFactor_Failed"];
        }
    }

    private async Task OnOtpInput(int index, ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";

        // Only accept digits
        if (!string.IsNullOrEmpty(value) && !char.IsDigit(value[0]))
        {
            OtpDigits[index] = "";
            return;
        }

        OtpDigits[index] = value.Length > 0 ? value[0].ToString() : "";

        // Auto-advance to next field
        if (!string.IsNullOrEmpty(OtpDigits[index]) && index < 5)
        {
            await FocusOtpBox(index + 1);
        }
    }

    private async Task OnOtpKeyDown(int index, KeyboardEventArgs e)
    {
        // Backspace on empty field - go to previous
        if (e.Key == "Backspace" && string.IsNullOrEmpty(OtpDigits[index]) && index > 0)
        {
            await FocusOtpBox(index - 1);
        }
        // Arrow keys navigation
        else if (e.Key == "ArrowLeft" && index > 0)
        {
            await FocusOtpBox(index - 1);
        }
        else if (e.Key == "ArrowRight" && index < 5)
        {
            await FocusOtpBox(index + 1);
        }
    }

    private void OnOtpPaste(ClipboardEventArgs e)
    {
        // Note: ClipboardEventArgs doesn't contain data in Blazor Server SSR
        // Paste handling requires JS interop for full functionality
        // This is a limitation of SSR forms
    }

    private async Task FocusOtpBox(int index)
    {
        try
        {
            await JS.InvokeVoidAsync("focusElement", OtpRefs[index]);
        }
        catch { /* ignore if JS not available */ }
    }

    public class TwoFactorFormModel
    {
        public string Code { get; set; } = string.Empty;
    }

    public class ResendFormModel { }
}

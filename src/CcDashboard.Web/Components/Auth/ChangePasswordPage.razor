@page "/change-password"
@layout AuthLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject IIdentityAuthService AuthService
@inject ICurrentUserAccessor CurrentUser
@using CcDashboard.Application.Interfaces
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization

<PageTitle>@L["Password_ChangeTitle"] — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-center mb-3 gap-2">
            <span class="badge bg-warning text-dark">@L["Password_ChangeRequired"]</span>
        </div>
        <p class="text-muted small mb-4">@L["Password_ChangeSubtitle"]</p>

        @if (Error is not null)
        {
            <div class="alert alert-danger py-2">@Error</div>
        }

        <form method="post" @formname="change-password">
            <AntiforgeryToken />
            <div class="mb-3">
                <label for="current" class="form-label">@L["Password_Current"]</label>
                <input id="current" name="Model.CurrentPassword" type="password"
                       class="form-control" autocomplete="current-password" required />
            </div>
            <div class="mb-3">
                <label for="new-password" class="form-label">@L["Password_New"]</label>
                <input id="new-password" name="Model.NewPassword" type="password"
                       class="form-control" autocomplete="new-password" required />
            </div>
            <div class="mb-3">
                <label for="confirm" class="form-label">@L["Password_Confirm"]</label>
                <input id="confirm" name="Model.ConfirmPassword" type="password"
                       class="form-control" autocomplete="new-password" required />
            </div>

            <ul class="list-unstyled small mb-3 text-muted">
                <li>- @L["Password_Rule_MinLength"]</li>
                <li>- @L["Password_Rule_Uppercase"]</li>
                <li>- @L["Password_Rule_Lowercase"]</li>
                <li>- @L["Password_Rule_Digit"]</li>
                <li>- @L["Password_Rule_Special"]</li>
                <li>- @L["Password_Rule_History"]</li>
            </ul>

            <button type="submit" class="btn btn-primary w-100">@L["Password_ChangeButton"]</button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "change-password")]
    public ChangePasswordFormModel? Model { get; set; }

    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null || Model?.CurrentPassword is null) return;

        if (Model.NewPassword != Model.ConfirmPassword)
        {
            Error = L["Password_Mismatch"];
            return;
        }

        if (CurrentUser.UserId is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        var result = await AuthService.ChangePasswordAsync(
            CurrentUser.UserId.Value,
            Model.CurrentPassword ?? string.Empty,
            Model.NewPassword ?? string.Empty);

        if (result.Succeeded)
            Nav.NavigateTo("/screens", forceLoad: true);
        else
            Error = result.Error ?? L["Password_ChangeFailed"];
    }

    public class ChangePasswordFormModel
    {
        public string? CurrentPassword { get; set; }
        public string? NewPassword { get; set; }
        public string? ConfirmPassword { get; set; }
    }
}

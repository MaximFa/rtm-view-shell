@page "/change-password"
@rendermode InteractiveServer
@layout AuthLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject IIdentityAuthService AuthService
@inject ICurrentUserAccessor CurrentUser
@using CcDashboard.Application.Interfaces
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization

<PageTitle>@L["Password_ChangeTitle"] — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-center mb-3 gap-2">
            <span class="badge bg-warning text-dark">@L["Password_ChangeRequired"]</span>
        </div>
        <p class="text-muted small mb-4">@L["Password_ChangeSubtitle"]</p>

        @if (Error is not null)
        {
            <div class="alert alert-danger py-2">@Error</div>
        }

        <div class="mb-3">
            <label class="form-label">@L["Password_New"]</label>
            <input type="password" class="form-control" @bind="NewPassword" autocomplete="new-password" />
        </div>
        <div class="mb-3">
            <label class="form-label">@L["Password_Confirm"]</label>
            <input type="password" class="form-control" @bind="ConfirmPassword" autocomplete="new-password" />
        </div>

        <ul class="list-unstyled small mb-3 text-muted">
            <li>- @L["Password_Rule_MinLength"]</li>
            <li>- @L["Password_Rule_Uppercase"]</li>
            <li>- @L["Password_Rule_Lowercase"]</li>
            <li>- @L["Password_Rule_Digit"]</li>
            <li>- @L["Password_Rule_Special"]</li>
            <li>- @L["Password_Rule_History"]</li>
        </ul>

        <button class="btn btn-primary w-100" @onclick="Submit" disabled="@Saving">
            @if (Saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            @L["Password_ChangeButton"]
        </button>
    </div>
</div>

@code {
    private string NewPassword = "";
    private string ConfirmPassword = "";
    private string? Error;
    private bool Saving;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (!CurrentUser.IsAuthenticated)
            Nav.NavigateTo("/login", forceLoad: true);
    }

    private async Task Submit()
    {
        Error = null;

        if (string.IsNullOrWhiteSpace(NewPassword) || string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            Error = L["Password_AllFieldsRequired"];
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            Error = L["Password_Mismatch"];
            return;
        }

        if (CurrentUser.UserId is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        Saving = true;
        try
        {
            var result = await AuthService.ForceSetPasswordAsync(CurrentUser.UserId.Value, NewPassword);

            if (result.Succeeded)
                Nav.NavigateTo("/screens", forceLoad: true);
            else
                Error = result.Error ?? L["Password_ChangeFailed"];
        }
        finally
        {
            Saving = false;
        }
    }
}

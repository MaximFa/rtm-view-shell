@page "/change-password"
@rendermode InteractiveServer
@layout AuthLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject IIdentityAuthService AuthService
@inject ICurrentUserAccessor CurrentUser
@using CcDashboard.Application.Interfaces
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

<PageTitle>@L["Password_ChangeTitle"] — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-center mb-3 gap-2">
            <span class="badge bg-warning text-dark">@L["Password_ChangeRequired"]</span>
        </div>
        <p class="text-muted small mb-4">@L["Password_ChangeSubtitle"]</p>

        @if (Error is not null)
        {
            <div class="alert alert-danger py-2">@Error</div>
        }

        <div class="mb-3">
            <label for="newPassword" class="form-label">@L["Password_New"]</label>
            <input id="newPassword" type="password" class="form-control"
                   @bind="NewPassword" @bind:event="oninput" autocomplete="new-password" />
        </div>
        <div class="mb-3">
            <label for="confirmPassword" class="form-label">@L["Password_Confirm"]</label>
            <input id="confirmPassword" type="password" class="form-control"
                   @bind="ConfirmPassword" @bind:event="oninput" autocomplete="new-password" />
        </div>

        <!-- Live password validation [UX-03] -->
        <ul class="list-unstyled small mb-3">
            <li class="d-flex align-items-center gap-2 mb-1">
                @if (HasMinLength) { <i class="bi bi-check-circle-fill text-success"></i> }
                else { <i class="bi bi-x-circle text-danger"></i> }
                <span class="@(HasMinLength ? "text-success" : "text-muted")">@L["Password_Rule_MinLength"]</span>
            </li>
            <li class="d-flex align-items-center gap-2 mb-1">
                @if (HasUppercase) { <i class="bi bi-check-circle-fill text-success"></i> }
                else { <i class="bi bi-x-circle text-danger"></i> }
                <span class="@(HasUppercase ? "text-success" : "text-muted")">@L["Password_Rule_Uppercase"]</span>
            </li>
            <li class="d-flex align-items-center gap-2 mb-1">
                @if (HasLowercase) { <i class="bi bi-check-circle-fill text-success"></i> }
                else { <i class="bi bi-x-circle text-danger"></i> }
                <span class="@(HasLowercase ? "text-success" : "text-muted")">@L["Password_Rule_Lowercase"]</span>
            </li>
            <li class="d-flex align-items-center gap-2 mb-1">
                @if (HasDigit) { <i class="bi bi-check-circle-fill text-success"></i> }
                else { <i class="bi bi-x-circle text-danger"></i> }
                <span class="@(HasDigit ? "text-success" : "text-muted")">@L["Password_Rule_Digit"]</span>
            </li>
            <li class="d-flex align-items-center gap-2 mb-1">
                @if (HasSpecial) { <i class="bi bi-check-circle-fill text-success"></i> }
                else { <i class="bi bi-x-circle text-danger"></i> }
                <span class="@(HasSpecial ? "text-success" : "text-muted")">@L["Password_Rule_Special"]</span>
            </li>
            <li class="d-flex align-items-center gap-2 mb-1">
                @if (PasswordsMatch) { <i class="bi bi-check-circle-fill text-success"></i> }
                else { <i class="bi bi-x-circle text-danger"></i> }
                <span class="@(PasswordsMatch ? "text-success" : "text-muted")">@L["Password_Rule_Match"]</span>
            </li>
            <li class="d-flex align-items-center gap-2">
                <i class="bi bi-info-circle text-muted"></i>
                <span class="text-muted">@L["Password_Rule_History"]</span>
            </li>
        </ul>

        <button class="btn btn-primary w-100" @onclick="Submit" disabled="@(Saving || !AllRulesPass)">
            @if (Saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            @L["Password_ChangeButton"]
        </button>
    </div>
</div>

@code {
    private string NewPassword = "";
    private string ConfirmPassword = "";
    private string? Error;
    private bool Saving;

    // Live validation computed properties [UX-03]
    private bool HasMinLength => NewPassword.Length >= 12;
    private bool HasUppercase => NewPassword.Any(char.IsUpper);
    private bool HasLowercase => NewPassword.Any(char.IsLower);
    private bool HasDigit => NewPassword.Any(char.IsDigit);
    private bool HasSpecial => NewPassword.Any(c => !char.IsLetterOrDigit(c));
    private bool PasswordsMatch => !string.IsNullOrEmpty(ConfirmPassword) && NewPassword == ConfirmPassword;
    private bool AllRulesPass => HasMinLength && HasUppercase && HasLowercase && HasDigit && HasSpecial && PasswordsMatch;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (!CurrentUser.IsAuthenticated)
            Nav.NavigateTo("/login", forceLoad: true);
    }

    private async Task Submit()
    {
        Error = null;

        if (string.IsNullOrWhiteSpace(NewPassword) || string.IsNullOrWhiteSpace(ConfirmPassword))
        {
            Error = L["Password_AllFieldsRequired"];
            return;
        }

        if (NewPassword != ConfirmPassword)
        {
            Error = L["Password_Mismatch"];
            return;
        }

        if (CurrentUser.UserId is null)
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        Saving = true;
        try
        {
            var result = await AuthService.ForceSetPasswordAsync(CurrentUser.UserId.Value, NewPassword);

            if (result.Succeeded)
                Nav.NavigateTo("/screens", forceLoad: true);
            else
                Error = result.Error ?? L["Password_ChangeFailed"];
        }
        finally
        {
            Saving = false;
        }
    }

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

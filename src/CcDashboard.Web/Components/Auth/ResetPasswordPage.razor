@page "/reset-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using CcDashboard.Application.Interfaces
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IUserManagementService UserService
@inject ITenantContext TenantContext

<PageTitle>New Password — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h2 class="card-title h5 mb-1">Set a new password</h2>

        @if (ErrorMessage is not null)
        {
            <div class="alert alert-danger py-2 small">@ErrorMessage</div>
        }
        @if (Succeeded)
        {
            <div class="alert alert-success py-2">Password changed. <a href="/login">Sign in</a></div>
        }
        else if (string.IsNullOrEmpty(Token) || string.IsNullOrEmpty(Email))
        {
            <div class="alert alert-warning py-2">Invalid or expired reset link. Please <a href="/forgot-password">request a new one</a>.</div>
        }
        else
        {
            <p class="text-muted small mb-3">Min. 12 chars &middot; A-Z &middot; a-z &middot; 0-9 &middot; special char</p>
            <form method="post" @formname="resetpassword">
                <AntiforgeryToken />
                <input type="hidden" name="Model.Email" value="@Email" />
                <input type="hidden" name="Model.Token" value="@Token" />
                <div class="mb-3">
                    <label class="form-label">New password</label>
                    <input name="Model.NewPassword" type="password" class="form-control"
                           autocomplete="new-password" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm password</label>
                    <input name="Model.ConfirmPassword" type="password" class="form-control"
                           autocomplete="new-password" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Set password -></button>
            </form>
        }

        <div class="mt-3 text-center">
            <a href="/login" class="small">&larr; Back to sign in</a>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    [SupplyParameterFromForm(FormName = "resetpassword")]
    public ResetPasswordModel? Model { get; set; }

    private string? ErrorMessage;
    private bool Succeeded;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null || Model?.Email is null || Model?.Token is null) return;

        if (Model.NewPassword != Model.ConfirmPassword)
        {
            ErrorMessage = "Passwords do not match.";
            return;
        }

        var tenantId = TenantContext.TenantId;
        var result = await UserService.ResetPasswordWithTokenAsync(
            tenantId, Model.Email, Model.Token, Model.NewPassword);

        if (result.Succeeded)
            Succeeded = true;
        else
            ErrorMessage = result.Error ?? "Password reset failed. The link may have expired.";
    }

    public class ResetPasswordModel
    {
        public string Email { get; set; } = string.Empty;
        public string Token { get; set; } = string.Empty;
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}

@page "/forgot-password"
@attribute [AllowAnonymous]
@layout AuthLayout
@using CcDashboard.Application.Interfaces
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@inject IUserManagementService UserService
@inject ITenantContext TenantContext
@inject NavigationManager Nav

<PageTitle>Reset Password — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h2 class="card-title h5 mb-1">Reset your password</h2>
        <p class="text-muted small mb-4">Enter your email address and we will send you a reset link.</p>

        @if (Submitted)
        {
            <div class="alert alert-info py-2">
                If an account with that email exists, a reset link has been sent.
            </div>
            <div class="text-center mt-3">
                <a href="/login" class="small">&larr; Back to sign in</a>
            </div>
        }
        else
        {
            <form method="post" @formname="forgotpassword">
                <AntiforgeryToken />
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input id="email" name="Model.Email" type="email"
                           class="form-control" value="@Model?.Email"
                           autocomplete="email" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Send link -></button>
            </form>

            <div class="mt-3 text-center">
                <a href="/login" class="small">&larr; Back to sign in</a>
            </div>
            <div class="mt-3 text-muted" style="font-size:0.7rem;text-align:center">
                UI response is uniform regardless of address existence [BFP-03]
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "forgotpassword")]
    public ForgotPasswordModel? Model { get; set; }

    private bool Submitted;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null || Model?.Email is null) return;

        var tenantId = TenantContext.TenantId;
        var baseUrl = $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}/reset-password";

        // Always show same response regardless of outcome [BFP-03]
        await UserService.RequestPasswordResetAsync(tenantId, Model.Email, baseUrl);
        Submitted = true;
    }

    public class ForgotPasswordModel
    {
        public string Email { get; set; } = string.Empty;
    }
}

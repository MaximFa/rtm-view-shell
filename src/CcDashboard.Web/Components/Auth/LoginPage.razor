@page "/login"
@layout AuthLayout
@inject IUserService UserService
@inject ITwoFactorService TwoFactorService
@inject ISsoService SsoService
@inject NavigationManager Nav

<PageTitle>Sign In — RTM View</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h2 class="card-title h5 mb-4">Sign in to your account</h2>

        @if (SetupDone)
        {
            <div class="alert alert-success py-2">Account created. You can sign in now.</div>
        }

        @if (ErrorMessage is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@ErrorMessage</div>
        }

        <form method="post" @formname="login">
            <AntiforgeryToken />

            <div class="mb-3">
                <label for="email" class="form-label">Email address</label>
                <input id="email" name="Model.Email" type="email" class="form-control"
                       value="@Model?.Email" autocomplete="username" required />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="Model.Password" type="password" class="form-control"
                       autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Sign In</button>
        </form>

        <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1" />
            <span class="px-2 text-muted small">or</span>
            <hr class="flex-grow-1" />
        </div>

        <form method="post" @formname="sso">
            <AntiforgeryToken />
            <input type="hidden" name="SsoRequest.Trigger" value="1" />
            <button type="submit" class="btn btn-outline-secondary w-100">
                Sign in with SSO
            </button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "login")]
    public LoginFormModel? Model { get; set; }

    [SupplyParameterFromForm(FormName = "sso")]
    public SsoTriggerModel? SsoRequest { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "setup")]
    public string? SetupParam { get; set; }

    private bool SetupDone => SetupParam == "1";
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null)
            return;

        if (SsoRequest?.Trigger == "1")
        {
            HandleSso();
            return;
        }

        if (Model?.Email is null)
            return;

        try
        {
            var result = await UserService.LoginAsync(
                new LoginRequest(Model.Email, Model.Password));

            if (result.RequiresTwoFactor)
            {
                await TwoFactorService.SendCodeAsync(result.UserId, result.Email);
                Nav.NavigateTo($"/two-factor?userId={result.UserId}", forceLoad: true);
                return;
            }

            var claims = new List<Claim>
            {
                new(ClaimTypes.NameIdentifier, result.UserId.ToString()),
                new(ClaimTypes.Email, result.Email),
                new(ClaimTypes.Name, result.DisplayName),
            };
            var principal = new ClaimsPrincipal(
                new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme));

            await HttpContext.SignInAsync(
                CookieAuthenticationDefaults.AuthenticationScheme, principal);

            var destination = string.IsNullOrWhiteSpace(ReturnUrl) ? "/dashboard" : ReturnUrl;
            Nav.NavigateTo(destination, forceLoad: true);
        }
        catch (ForbiddenException ex)
        {
            ErrorMessage = ex.Message;
        }
        catch (Exception ex) when (ex is not Microsoft.AspNetCore.Components.NavigationException)
        {
            ErrorMessage = "An unexpected error occurred. Please try again.";
        }
    }

    private void HandleSso()
    {
        try
        {
            var redirectUrl = SsoService.InitiateLogin();
            Nav.NavigateTo(redirectUrl, forceLoad: true);
        }
        catch (NotImplementedException)
        {
            ErrorMessage = "SSO is not configured yet. Contact your administrator.";
        }
        catch (Exception ex) when (ex is not Microsoft.AspNetCore.Components.NavigationException)
        {
            ErrorMessage = "SSO is unavailable. Try again later.";
        }
    }

    public class SsoTriggerModel
    {
        public string Trigger { get; set; } = string.Empty;
    }
}

@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject IIdentityAuthService AuthService
@inject ITenantContext TenantContext
@using CcDashboard.Application.Interfaces
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization

<PageTitle>Sign In — RTM View Shell</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h2 class="card-title h5 mb-4">Sign in to your account</h2>

        @if (ErrorMessage is not null)
        {
            <div class="alert alert-danger py-2" role="alert">@ErrorMessage</div>
        }
        @if (Info is not null)
        {
            <div class="alert alert-info py-2">@Info</div>
        }

        <form method="post" @formname="login">
            <AntiforgeryToken />
            <div class="mb-3">
                <label for="username" class="form-label">Username or email</label>
                <input id="username" name="Model.UserName" type="text"
                       class="form-control" value="@Model?.UserName"
                       autocomplete="username" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input id="password" name="Model.Password" type="password"
                       class="form-control" autocomplete="current-password" required />
                <div class="form-text text-muted small">Min. 12 chars · A-Z · a-z · 0-9 · special char</div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign in →</button>
            <div class="mt-2 text-end">
                <a href="/forgot-password" class="small">Forgot password?</a>
            </div>
        </form>

        <div class="d-flex align-items-center my-3">
            <hr class="flex-grow-1" />
            <span class="px-2 text-muted small">or</span>
            <hr class="flex-grow-1" />
        </div>

        <a href="/login/sso" class="btn btn-outline-secondary w-100">Sign in with SSO / Single Sign-On</a>
    </div>
</div>

<div class="text-center mt-3 text-muted" style="font-size: 0.7rem;">
    HTTPS · TLS 1.3 · cookie HttpOnly SameSite=Strict · session audit [AUTH-WEB-01]
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "login")]
    public LoginFormModel? Model { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "info")]
    public string? Info { get; set; }

    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Only process on POST (form submitted)
        if (HttpContext is null || Model?.UserName is null || Model.Password is null)
            return;

        var ipAddress = HttpContext.Connection.RemoteIpAddress?.ToString()
                        ?? HttpContext.Request.Headers["X-Forwarded-For"].FirstOrDefault()
                        ?? "unknown";
        var userAgent = HttpContext.Request.Headers.UserAgent.ToString();

        var result = await AuthService.PasswordSignInAsync(
            TenantContext.IsResolved ? TenantContext.TenantId : Guid.Empty,
            Model.UserName.Trim(),
            Model.Password,
            ipAddress,
            userAgent);

        switch (result.Status)
        {
            case IdentitySignInStatus.Success:
                var destination = result.RequiresPasswordChange
                    ? "/change-password"
                    : (string.IsNullOrEmpty(ReturnUrl) ? "/screens" : ReturnUrl);
                Nav.NavigateTo(destination, forceLoad: true);
                break;

            case IdentitySignInStatus.RequiresTwoFactor:
                Nav.NavigateTo("/login/2fa", forceLoad: true);
                break;

            case IdentitySignInStatus.LockedOut:
            case IdentitySignInStatus.InvalidCredentials:
            case IdentitySignInStatus.TenantMismatch:
            case IdentitySignInStatus.AccountInactive:
            case IdentitySignInStatus.TenantSuspended:
            default:
                // [BFP-03] — never reveal WHY login failed
                ErrorMessage = "Invalid username or password.";
                break;
        }
    }

    public class LoginFormModel
    {
        public string? UserName { get; set; }
        public string? Password { get; set; }
    }
}

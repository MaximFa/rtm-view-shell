@using Microsoft.Extensions.Localization
@using ReportColumns = CcDashboard.Application.HistoricalReports.ReportColumns
@using ReportColumnKind = CcDashboard.Application.HistoricalReports.ReportColumnKind
@using ReportColumn = CcDashboard.Application.HistoricalReports.ReportColumn
@* The draft this window hands back lives with the filter state it feeds (ReportWidgets). The
   build found this missing on 2026-11-07: the type was moved there and this file, sitting in
   Shared, kept using it unqualified - the very place I had named as the first one to watch. *@
@using CcDashboard.Web.Components.ReportWidgets
@inject IStringLocalizer<SharedResources> L

@* The one filter window of the product: an operator, a value, and - for a text column - the
   column's own values as checkboxes. Applied on purpose by the tick or by Enter.

   It holds a DRAFT: what is typed or ticked is not what the report is filtered by until Apply.
   That is what removed both the flicker (a request per letter) and the stuck spinner (work
   scheduled off the render path) - while the person types, nothing happens at all.

   The inputs follow the column's KIND, from the one rule both sides share: a duration is typed
   the way the cell shows it (h:mm:ss) and converted to the column's own unit before it is sent;
   a count or a percentage is a plain number; a date or an instant is a date field. The window
   never guesses a kind from a column's name. *@

<div class="column-filter-popup rounded shadow-lg p-2" @onclick:stopPropagation="true">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="small opacity-75">@ColumnLabel</span>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-link btn-sm p-0 text-success" title="@L["Common_Apply"]" @onclick="ApplyAsync">
                <i class="bi bi-check-lg"></i>
            </button>
            <button type="button" class="btn btn-link btn-sm p-0 text-danger" title="@L["Common_Clear"]" @onclick="ClearAsync">
                <i class="bi bi-trash"></i>
            </button>
            <button type="button" class="btn btn-link btn-sm p-0" title="@L["Common_Close"]" @onclick="CloseAsync">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div class="mb-1">
        <select class="form-select form-select-sm mb-1" value="@_op"
                @onchange="e => _op = e.Value?.ToString() ?? DefaultOp">
            @if (IsText)
            {
                <option value="contains">@L["Widgets_MatchType_Contains"]</option>
                <option value="equal">@L["Widgets_MatchType_Equal"]</option>
                <option value="startsWith">@L["Widgets_MatchType_StartsWith"]</option>
                <option value="endsWith">@L["Widgets_MatchType_EndsWith"]</option>
            }
            else
            {
                <option value="greater">@L["Widgets_MatchType_GreaterThan"]</option>
                <option value="less">@L["Widgets_MatchType_LessThan"]</option>
                <option value="between">@L["Report_Between"]</option>
            }
        </select>

        @if (IsText)
        {
            @* maxlength, not a validator: over 100 characters the server answers that the settings
               cannot be used, and that must never be the answer to typing. *@
            <input type="text" class="form-control form-control-sm" maxlength="100"
                   value="@_text"
                   @onchange="e => _text = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnKeyDown"
                   placeholder="@L["Widgets_Filter_ValuePlaceholder"]" />
        }
        else if (IsTime && DateFormat is not null)
        {
            @* FEAT-REPORT-QUEUE-DATE-FORMAT-01: a report that writes its dates in its own format asks for them in it too.
               The browser's date field shows the date as the browser's locale decides, and code cannot change that. *@
            <input type="text" class="form-control form-control-sm mb-1" inputmode="numeric" maxlength="10"
                   value="@_timeText" placeholder="@DatePlaceholder"
                   @onchange="e => _timeText = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnKeyDown" />
            @if (_op == "between")
            {
                <input type="text" class="form-control form-control-sm" inputmode="numeric" maxlength="10"
                       value="@_timeToText" placeholder="@DatePlaceholder"
                       @onchange="e => _timeToText = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="OnKeyDown" />
            }
        }
        else if (IsTime)
        {
            <input type="date" class="form-control form-control-sm mb-1"
                   value="@_timeText"
                   @onchange="e => _timeText = e.Value?.ToString() ?? string.Empty" />
            @if (_op == "between")
            {
                <input type="date" class="form-control form-control-sm"
                       value="@_timeToText"
                       @onchange="e => _timeToText = e.Value?.ToString() ?? string.Empty" />
            }
        }
        else
        {
            <input type="text" class="form-control form-control-sm mb-1"
                   value="@_numberText"
                   @onchange="e => _numberText = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnKeyDown"
                   placeholder="@NumberPlaceholder" />
            @if (_op == "between")
            {
                <input type="text" class="form-control form-control-sm"
                       value="@_numberToText"
                       @onchange="e => _numberToText = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="OnKeyDown"
                       placeholder="@NumberPlaceholder" />
            }
            @if (IsDuration)
            {
                <div class="small text-muted mt-1">@L["Report_DurationHint"]</div>
            }
        }

        @if (_problem is not null)
        {
            @* Said here rather than sent: a value the column cannot hold would come back as
               "the settings cannot be used", which reads as a broken report, not as a typo. *@
            <div class="alert alert-warning py-1 px-2 small mt-1 mb-0">
                <i class="bi bi-exclamation-triangle me-1"></i>@_problem
            </div>
        }
    </div>

    @if (IsText && Values.Count > 0)
    {
        <div class="border-top pt-2 mt-2">
            <div class="small mb-1 opacity-75">@L["Widgets_Filter_List"]</div>
            @if (Truncated)
            {
                <div class="alert alert-warning py-1 px-2 small mb-1">
                    <i class="bi bi-exclamation-triangle me-1"></i>@string.Format(L["ReportWidget_AgentsTruncated"].Value, Values.Count, TotalCount)
                </div>
            }
            @if (Values.Count > 8)
            {
                <input type="text" class="form-control form-control-sm mb-1"
                       value="@_listSearch"
                       @onchange="e => _listSearch = e.Value?.ToString() ?? string.Empty"
                       placeholder="@L["Common_Search"]" />
            }
            <div class="column-filter-values">
                @foreach (var value in FilteredValues)
                {
                    var isChecked = _values.Contains(value);
                    <div class="d-flex align-items-center gap-2 px-1 py-1" @key="value">
                        <input type="checkbox" class="form-check-input m-0"
                               checked="@isChecked"
                               @onchange="() => ToggleValue(value)" />
                        <span class="small">@value</span>
                    </div>
                }
                @if (!FilteredValues.Any())
                {
                    <div class="small text-muted px-1 py-1"><em>@L["Common_NoResults"]</em></div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string ColumnLabel { get; set; } = string.Empty;

    /// <summary>What the column holds - it decides which inputs the window offers.</summary>
    [Parameter, EditorRequired] public ReportColumnKind Kind { get; set; }

    /// <summary>
    /// FEAT-REPORT-QUEUE-DATE-FORMAT-01: a .NET date format (e.g. dd'/'MM'/'yyyy) in which this report asks for dates -
    /// a text field read with exactly that format. Null: the browser's date field, as for every other report.
    /// </summary>
    [Parameter] public string? DateFormat { get; set; }

    /// <summary>The filter in force, so reopening the window shows what is applied.</summary>
    [Parameter] public string? Op { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public IReadOnlyList<string>? SelectedValues { get; set; }
    [Parameter] public double? Number { get; set; }
    [Parameter] public double? NumberTo { get; set; }
    [Parameter] public DateTime? Time { get; set; }
    [Parameter] public DateTime? TimeTo { get; set; }

    [Parameter] public IReadOnlyList<string> Values { get; set; } = Array.Empty<string>();
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Truncated { get; set; }

    [Parameter] public EventCallback<ColumnFilterDraft> OnApply { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _op = "contains";
    private string _text = string.Empty;
    private readonly HashSet<string> _values = new(StringComparer.Ordinal);
    private string _numberText = string.Empty;
    private string _numberToText = string.Empty;
    private string _timeText = string.Empty;
    private string _timeToText = string.Empty;
    private string _listSearch = string.Empty;
    private string? _problem;
    private bool _loaded;

    private bool IsText => Kind is ReportColumnKind.Text or ReportColumnKind.Id;
    private bool IsTime => Kind is ReportColumnKind.DateTime or ReportColumnKind.Date;
    private bool IsDuration => Kind is ReportColumnKind.DurationMs or ReportColumnKind.DurationSec;
    private string DefaultOp => IsText ? "contains" : "greater";
    private string NumberPlaceholder => IsDuration ? "0:00:00" : L["Widgets_Filter_ValuePlaceholder"].Value;

    protected override void OnParametersSet()
    {
        // Loaded once, when the window opens: re-reading on every render would throw away what the
        // person is typing the moment anything else on the page redraws.
        if (_loaded) return;
        _loaded = true;
        _op = string.IsNullOrWhiteSpace(Op) ? DefaultOp : Op!;
        _text = Text ?? string.Empty;
        _numberText = Shown(Number);
        _numberToText = Shown(NumberTo);
        _timeText = ShownDate(Time);
        _timeToText = ShownDate(TimeTo);
        _values.Clear();
        foreach (var v in SelectedValues ?? Array.Empty<string>())
            _values.Add(v);
    }

    /// <summary>A stored value shown the way it was typed: a duration back in h:mm:ss, in the column's unit.</summary>
    private string Shown(double? stored)
    {
        if (stored is null) return string.Empty;
        if (!IsDuration) return stored.Value.ToString("0.##");
        var seconds = Kind == ReportColumnKind.DurationMs ? stored.Value / 1000.0 : stored.Value;
        return TimeSpan.FromSeconds(seconds).ToString(@"h\:mm\:ss");
    }

    private IEnumerable<string> FilteredValues =>
        string.IsNullOrWhiteSpace(_listSearch)
            ? Values
            : Values.Where(v => v.Contains(_listSearch, StringComparison.OrdinalIgnoreCase));

    private void ToggleValue(string value)
    {
        if (!_values.Remove(value)) _values.Add(value);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await ApplyAsync();
    }

    private async Task ApplyAsync()
    {
        _problem = null;
        double? number = null, numberTo = null;
        DateTime? time = null, timeTo = null;

        if (!IsText && !IsTime)
        {
            number = ParseTyped(_numberText);
            numberTo = _op == "between" ? ParseTyped(_numberToText) : null;
            if (_problem is not null) return;
        }
        else if (IsTime)
        {
            time = ParseDate(_timeText);
            timeTo = _op == "between" ? ParseDate(_timeToText) : null;
            if (_problem is not null) return;
        }

        await OnApply.InvokeAsync(new ColumnFilterDraft(_op, _text, _values.ToList(), number, numberTo, time, timeTo));
    }

    private double? ParseTyped(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var value = IsDuration ? ReportFilterState.ParseDuration(text) : ReportFilterState.ParseNumber(text);
        if (value is null) _problem = L["Report_FilterValueNotUnderstood"].Value;
        return value;
    }

    private DateTime? ParseDate(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return null;
        var parsed = ColumnFilterDates.Parse(text, DateFormat);
        if (parsed is null) _problem = L["Report_FilterValueNotUnderstood"].Value;
        return parsed;
    }

    private string ShownDate(DateTime? value) => ColumnFilterDates.Show(value, DateFormat);

    private string DatePlaceholder => (DateFormat ?? string.Empty).Replace("'", string.Empty);

    private async Task ClearAsync()
    {
        _op = DefaultOp;
        _text = string.Empty;
        _values.Clear();
        _numberText = _numberToText = _timeText = _timeToText = _listSearch = string.Empty;
        _problem = null;
        await OnClear.InvokeAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}

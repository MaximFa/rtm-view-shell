@using MediatR
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using CcDashboard.Application.HistoricalReports.Queries
@inject IMediator Mediator
@inject IStringLocalizer<SharedResources> L
@inject ILogger<QueueIntervalReport> Logger

<ReportFilterBar 
    ShowWorkgroupFilter="true"
    TotalCount="@_totalCount"
    OnFilterApply="HandleFilter" />

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
else if (_rows is null || _rows.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>@L["Report_NoData"]
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover report-table">
            <thead class="table-light">
                <tr>
                    <th>@L["Report_Interval"]</th>
                    <th>@L["Report_Workgroup"]</th>
                    <th class="text-end">@L["Report_Offered"]</th>
                    <th class="text-end">@L["Report_Answered"]</th>
                    <th class="text-end">@L["Report_Abandoned"]</th>
                    <th class="text-end">@L["Report_AbandonPct"]</th>
                    <th class="text-end">@L["Report_AnsweredInSL"]</th>
                    <th class="text-end">@L["Report_SLPct"]</th>
                    <th class="text-end">@L["Report_ASA"]</th>
                    <th class="text-end">@L["Report_AHT"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@row.IntervalStart.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@row.Workgroup</td>
                        <td class="text-end">@row.Offered</td>
                        <td class="text-end">@row.Answered</td>
                        <td class="text-end">@row.Abandoned</td>
                        <td class="text-end">@FormatPct(row.AbandonPct)</td>
                        <td class="text-end">@row.AnsweredInSl</td>
                        <td class="text-end">@FormatPct(row.SlPct)</td>
                        <td class="text-end">@FormatDuration(row.Asa)</td>
                        <td class="text-end">@FormatDuration(row.QueueAht)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool _loading;
    private IReadOnlyList<QueueIntervalRow>? _rows;
    private int _totalCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadData(DateTime.UtcNow.Date.AddDays(-7), DateTime.UtcNow.Date, 50, 1, null);
    }

    private async Task HandleFilter(ReportFilterBar.ReportFilterArgs args)
    {
        await LoadData(args.From, args.To, args.PageSize, args.Page, args.Workgroups);
    }

    private async Task LoadData(DateTime from, DateTime to, int pageSize, int page, IReadOnlyList<string>? workgroups)
    {
        // Normalize date bounds to UTC (Npgsql 8 throws on Kind=Local to timestamptz)
        from = DateTime.SpecifyKind(from, DateTimeKind.Utc);
        to = DateTime.SpecifyKind(to, DateTimeKind.Utc);

        _loading = true;
        StateHasChanged();

        try
        {
            var result = await Mediator.Send(new GetQueueIntervalReportQuery(from, to, workgroups, pageSize, page));
            _rows = result.Rows;
            _totalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report load failed ({Report})", nameof(QueueIntervalReport));
            _rows = null;
            _totalCount = 0;
        }
        finally
        {
            _loading = false;
        }
    }

    private string FormatPct(double? val) => val.HasValue ? $"{val.Value:F1}%" : "-";

    private string FormatDuration(double? seconds)
    {
        if (!seconds.HasValue) return "-";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return ts.TotalHours >= 1 
            ? $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
@page "/reports"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@using MediatR
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using CcDashboard.Application.HistoricalReports.Queries
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["Report_Title"]</PageTitle>

<div class="container-fluid py-4">
    <h1 class="mb-4">@L["Report_Title"]</h1>

    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "queue-interval" ? "active" : "")" 
                    @onclick="@(() => SetTab("queue-interval"))">
                <i class="bi bi-clock-history me-2"></i>@L["Report_QueueInterval"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "queue-waittime" ? "active" : "")"
                    @onclick="@(() => SetTab("queue-waittime"))">
                <i class="bi bi-hourglass-split me-2"></i>@L["Report_QueueWaitTime"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "agent-monthly" ? "active" : "")"
                    @onclick="@(() => SetTab("agent-monthly"))">
                <i class="bi bi-calendar-month me-2"></i>@L["Report_AgentMonthly"]
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(ActiveTab == "agent-shift" ? "active" : "")"
                    @onclick="@(() => SetTab("agent-shift"))">
                <i class="bi bi-person-badge me-2"></i>@L["Report_AgentShiftDetail"]
            </button>
        </li>
    </ul>

    <div class="tab-content">
        @switch (ActiveTab)
        {
            case "queue-interval":
                <QueueIntervalReport />
                break;
            case "queue-waittime":
                <QueueWaitTimeReport />
                break;
            case "agent-monthly":
                <AgentMonthlyReport />
                break;
            case "agent-shift":
                <AgentShiftDetailReport />
                break;
        }
    </div>
</div>

@code {
    private string ActiveTab { get; set; } = "queue-interval";

    private void SetTab(string tab) => ActiveTab = tab;
}
@page "/reports/{Id:guid}"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Nav
@using MediatR
@using CcDashboard.Application.Reports.Queries
@using CcDashboard.Application.Reports.DTOs
@using CcDashboard.Domain.Domain.Reports
@using CcDashboard.Web.Components.ReportWidgets
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json

<PageTitle>@(_report?.Name ?? L["Reports_Title"]) — RTM View Shell</PageTitle>

<div class="report-view-page @(_darkMode ? "dark-mode" : "")">
    @if (_loading)
    {
        <div class="text-center py-5" aria-busy="true">
            <span class="spinner-border text-primary"></span>
        </div>
    }
    else if (_denied)
    {
        <div class="alert alert-warning m-4">
            <i class="bi bi-shield-exclamation me-2"></i>@L["Report_AccessDenied"]
        </div>
    }
    else if (_report is null)
    {
        <div class="alert alert-warning m-4">@L["Reports_NotFound"]</div>
    }
    else
    {
        <div class="report-view-header d-flex justify-content-between align-items-center mb-3">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="BackToList" title="@L["Screens_Back"]">
                    <i class="bi bi-arrow-left"></i>
                </button>
                <h1 class="h4 mb-0">@_report.Name</h1>
                @StatusBadge(_report.Status)
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary")"
                        @onclick="ToggleDarkMode" title="@(_darkMode ? L["WidgetCfg_LightMode"] : L["WidgetCfg_DarkMode"])">
                    <i class="bi @(_darkMode ? "bi-sun" : "bi-moon")"></i>
                </button>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle" disabled title="@L["Reports_ExportStub"]">
                        <i class="bi bi-download me-1"></i>@L["Reports_Export"]
                    </button>
                </div>
                <button class="btn btn-sm btn-outline-secondary" disabled title="@L["Reports_ScheduleStub"]">
                    <i class="bi bi-calendar-event me-1"></i>@L["Reports_Schedule"]
                </button>
                @if ((_report.AccessLevel & 2) != 0)
                {
                    <a href="/reports/@Id/edit" class="btn btn-sm btn-primary">
                        <i class="bi bi-pencil me-1"></i>@L["Common_Edit"]
                    </a>
                }
            </div>
        </div>

        <div class="report-date-bar bg-light border rounded p-3 mb-3">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label small mb-1">@L["Report_From"]</label>
                    <input type="date" class="form-control form-control-sm" @bind="_from" />
                </div>
                <div class="col-auto">
                    <label class="form-label small mb-1">@L["Report_To"]</label>
                    <input type="date" class="form-control form-control-sm" @bind="_to" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-primary" @onclick="ApplyDateRange">
                        <i class="bi bi-check2 me-1"></i>@L["Report_Apply"]
                    </button>
                </div>
            </div>
        </div>

        @if (_report.Widgets.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-grid-3x3-gap fs-1 mb-3 opacity-50"></i>
                <p>@L["Reports_NoWidgets"]</p>
            </div>
        }
        else
        {
            <div class="report-canvas" style="position: relative; min-height: 600px;">
                @foreach (var widget in _report.Widgets)
                {
                    var pos = ParsePosition(widget.PositionJson);
                    var widgetStyle = $"position: absolute; left: {pos.X}px; top: {pos.Y}px; width: {pos.Width}px; height: {pos.Height}px;";

                    <div class="report-widget-container" style="@widgetStyle" @key="widget.Id">
                        <div class="widget-header d-flex align-items-center justify-content-between">
                            <span class="text-truncate small fw-medium">@GetWidgetTitle(widget)</span>
                        </div>
                        <div class="widget-content">
                            <RenderReportWidget
                                WidgetType="widget.WidgetType"
                                ConfigJson="@widget.ConfigJson"
                                From="_rangeFrom"
                                To="_rangeTo"
                                DarkMode="_darkMode" />
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading;
    private bool _denied;
    private ReportScreenDetailDto? _report;
    private bool _darkMode;

    private DateTime _from = DateTime.UtcNow.Date.AddDays(-7);
    private DateTime _to = DateTime.UtcNow.Date;
    private DateTime _rangeFrom;
    private DateTime _rangeTo;

    protected override async Task OnInitializedAsync()
    {
        _rangeFrom = _from;
        _rangeTo = _to;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _denied = false;
        StateHasChanged();

        try
        {
            _report = await Mediator.Send(new GetReportScreenQuery(Id));
            _darkMode = _report.IsDarkMode;
        }
        catch (CcDashboard.Domain.Exceptions.ForbiddenException)
        {
            _denied = true;
            _report = null;
        }
        catch (CcDashboard.Domain.Exceptions.NotFoundException)
        {
            _report = null;
        }
        catch
        {
            _report = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyDateRange()
    {
        _rangeFrom = _from;
        _rangeTo = _to;
        StateHasChanged();
    }

    private void BackToList() => Nav.NavigateTo("/reports");

    private void ToggleDarkMode() => _darkMode = !_darkMode;

    private static WidgetPosition ParsePosition(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new WidgetPosition(0, 0, 400, 300);

        try
        {
            var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            return new WidgetPosition(
                root.TryGetProperty("x", out var x) ? x.GetInt32() : 0,
                root.TryGetProperty("y", out var y) ? y.GetInt32() : 0,
                root.TryGetProperty("width", out var w) ? w.GetInt32() : 400,
                root.TryGetProperty("height", out var h) ? h.GetInt32() : 300
            );
        }
        catch
        {
            return new WidgetPosition(0, 0, 400, 300);
        }
    }

    private string GetWidgetTitle(ReportWidgetDto widget)
    {
        if (!string.IsNullOrEmpty(widget.ConfigJson))
        {
            try
            {
                var doc = JsonDocument.Parse(widget.ConfigJson);
                if (doc.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String)
                {
                    var t = title.GetString();
                    if (!string.IsNullOrEmpty(t)) return t;
                }
            }
            catch { }
        }
        return widget.WidgetType.ToString();
    }

    private RenderFragment StatusBadge(ReportScreenStatus status) => status switch
    {
        ReportScreenStatus.Draft => @<span class="badge bg-warning text-dark ms-2">@L["Screens_Draft"]</span>,
        ReportScreenStatus.Published => @<span class="badge bg-success ms-2">@L["Screens_Published"]</span>,
        _ => @<span class="badge bg-secondary ms-2">@status</span>
    };

    private record WidgetPosition(int X, int Y, int Width, int Height);
}

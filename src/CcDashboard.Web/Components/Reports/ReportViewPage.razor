@page "/reports/{Id:guid}/fullscreen"
@page "/reports/{Id:guid}/view"
@page "/reports/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<ReportViewPage> Logger
@using MediatR
@using CcDashboard.Application.Reports.Queries
@using CcDashboard.Application.Reports.DTOs
@using CcDashboard.Domain.Domain.Reports
@using CcDashboard.Web.Components.ReportWidgets
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using CcDashboard.Application.Reports.Export
@implements IDisposable

<PageTitle>@(_report?.Name ?? L["Reports_Title"]) — Fullscreen</PageTitle>

<div class="fullscreen-dashboard @(_darkMode ? "dark-mode" : "")">
    @if (_loading)
    {
        <div class="text-center py-5" aria-busy="true">
            <span class="spinner-border text-primary"></span>
        </div>
    }
    else if (_denied)
    {
        <div class="alert alert-warning m-4">
            <i class="bi bi-shield-exclamation me-2"></i>@L["Report_AccessDenied"]
        </div>
    }
    else if (_report is null)
    {
        <div class="alert alert-warning m-4">@L["Reports_NotFound"]</div>
    }
    else
    {
        <div class="fullscreen-header">
            <h1 class="fullscreen-title mb-0">@_report.Name</h1>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <div class="report-header-datebar d-flex gap-2 align-items-center">
                    <label class="small mb-0">@L["Report_From"]</label>
                    <input type="date" class="form-control form-control-sm" style="width: auto;" @bind="_from" />
                    <label class="small mb-0">@L["Report_To"]</label>
                    <input type="date" class="form-control form-control-sm" style="width: auto;" @bind="_to" />
                    <button class="btn btn-sm btn-primary" @onclick="ApplyDateRange">
                        <i class="bi bi-check2 me-1"></i>@L["Report_Apply"]
                    </button>
                </div>
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary")"
                        @onclick="ToggleDarkMode" title="@(_darkMode ? L["WidgetCfg_LightMode"] : L["WidgetCfg_DarkMode"])">
                    <i class="bi @(_darkMode ? "bi-sun" : "bi-moon")"></i>
                </button>
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary")"
                        disabled="@_exporting" @onclick="ExportReport" title="@L["Reports_Export"]">
                    @if (_exporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-download me-1"></i>
                    }
                    @L["Reports_Export"]
                </button>
                @if (!string.IsNullOrEmpty(_exportError))
                {
                    <span class="text-danger small ms-2">@_exportError</span>
                }
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary")" disabled title="@L["Reports_ScheduleStub"]">
                    <i class="bi bi-calendar-event me-1"></i>@L["Reports_Schedule"]
                </button>
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary") fullscreen-close" @onclick="ExitToList" title="@L["Screens_Back"]">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="fullscreen-canvas" style="@(_positionsApplied ? "" : "visibility: hidden;")">
            @if (_report.Widgets.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-grid-3x3-gap fs-1 mb-3 opacity-50"></i>
                    <p>@L["Reports_NoWidgets"]</p>
                </div>
            }
            else
            {
                <div class="fullscreen-scale-wrap">
                    <div class="fullscreen-design-layer" @ref="_designLayerRef"
                         style="width: @(_designWidth)px; height: @(_designHeight)px; position: relative;">
                        @foreach (var widget in _report.Widgets)
                        {
                            var pos = ParsePosition(widget.PositionJson);
                            var widgetStyle = $"position: absolute; left: {pos.X}px; top: {pos.Y}px; width: {pos.Width}px; height: {pos.Height}px;";

                            <div class="dashboard-widget" data-widget-id="@widget.Id" style="@widgetStyle" @key="widget.Id">
                                <div class="widget-header d-flex align-items-center justify-content-between">
                                    <span class="text-truncate">@GetWidgetTitle(widget)</span>
                                </div>
                                <div class="widget-content">
                                    <RenderReportWidget
                                        WidgetType="widget.WidgetType"
                                        ConfigJson="@widget.ConfigJson"
                                        From="_rangeFrom"
                                        To="_rangeTo"
                                        DarkMode="_darkMode"
                                        TenantId="_report?.TenantId" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _denied;
    private ReportScreenDetailDto? _report;
    private bool _darkMode;
    private bool _positionsApplied;
    private bool _scaleApplied;
    private ElementReference _designLayerRef;
    private int _designWidth = 1920;
    private int _designHeight = 1080;

    private DateTime _from = DateTime.UtcNow.Date.AddDays(-7);
    private DateTime _to = DateTime.UtcNow.Date;
    private DateTime _rangeFrom;
    private DateTime _rangeTo;

    private readonly CancellationTokenSource _cts = new();
    private bool _exporting;
    private string? _exportError;

    protected override async Task OnInitializedAsync()
    {
        _rangeFrom = _from;
        _rangeTo = _to;
        _loading = true;

        try
        {
            _report = await Mediator.Send(new GetReportScreenQuery(Id), _cts.Token);
            _darkMode = _report.IsDarkMode;

            if (_report.Widgets.Count > 0)
            {
                var maxX = 0;
                var maxY = 0;
                foreach (var w in _report.Widgets)
                {
                    var pos = ParsePosition(w.PositionJson);
                    if (pos.X + pos.Width > maxX) maxX = pos.X + pos.Width;
                    if (pos.Y + pos.Height > maxY) maxY = pos.Y + pos.Height;
                }
                _designWidth = maxX + 32;
                _designHeight = maxY + 32;
            }
            else
            {
                // For 0-widget reports, set _positionsApplied so empty-state is visible
                _positionsApplied = true;
            }
        }
        catch (CcDashboard.Domain.Exceptions.ForbiddenException)
        {
            _denied = true;
            _report = null;
        }
        catch (CcDashboard.Domain.Exceptions.NotFoundException)
        {
            _report = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report view load failed for {Id}", Id);
            _report = null;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_positionsApplied && _report?.Widgets.Count > 0 && !_loading)
        {
            var positions = _report.Widgets.Select(w =>
            {
                var pos = ParsePosition(w.PositionJson);
                return new
                {
                    id = w.Id.ToString(),
                    x = pos.X,
                    y = pos.Y,
                    width = pos.Width,
                    height = pos.Height
                };
            }).ToArray();

            await JS.InvokeVoidAsync("widgetResize.applyAllWidgetPositions", (object)positions);
            _positionsApplied = true;
            StateHasChanged();
        }

        if (_positionsApplied && !_scaleApplied && _report?.Widgets.Count > 0)
        {
            await JS.InvokeVoidAsync("viewerScale.init", _designLayerRef, _designWidth, _designHeight);
            _scaleApplied = true;
        }
    }

    private void ApplyDateRange()
    {
        _rangeFrom = _from;
        _rangeTo = _to;
        StateHasChanged();
    }

    private void ExitToList() => Nav.NavigateTo("/reports");

    private void ToggleDarkMode() => _darkMode = !_darkMode;

    private static WidgetPosition ParsePosition(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new WidgetPosition(0, 0, 400, 300);

        try
        {
            var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            return new WidgetPosition(
                root.TryGetProperty("x", out var x) ? x.GetInt32() : 0,
                root.TryGetProperty("y", out var y) ? y.GetInt32() : 0,
                root.TryGetProperty("width", out var w) ? w.GetInt32() : 400,
                root.TryGetProperty("height", out var h) ? h.GetInt32() : 300
            );
        }
        catch
        {
            return new WidgetPosition(0, 0, 400, 300);
        }
    }

    private string GetWidgetTitle(ReportWidgetDto widget)
    {
        if (!string.IsNullOrEmpty(widget.ConfigJson))
        {
            try
            {
                var doc = JsonDocument.Parse(widget.ConfigJson);
                if (doc.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String)
                {
                    var t = title.GetString();
                    if (!string.IsNullOrEmpty(t)) return t;
                }
            }
            catch { }
        }
        return widget.WidgetType.ToString();
    }

    private async Task ExportReport()
    {
        if (_report is null || _exporting) return;
        _exporting = true;
        _exportError = null;
        StateHasChanged();

        try
        {
            var res = await Mediator.Send(
                new ExportReportCommand(_report.Id, _rangeFrom, _rangeTo, _report.TenantId),
                _cts.Token);
            var base64 = Convert.ToBase64String(res.Content);
            await JS.InvokeVoidAsync("ccApp.downloadFile", base64, res.FileName, res.ContentType);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report export failed for {Id}", _report.Id);
            _exportError = L["Reports_ExportFailed"];
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _ = JS.InvokeVoidAsync("viewerScale.dispose");
    }

    private record WidgetPosition(int X, int Y, int Width, int Height);
}

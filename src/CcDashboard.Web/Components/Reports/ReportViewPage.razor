@page "/reports/{Id:guid}/fullscreen"
@page "/reports/{Id:guid}/view"
@page "/reports/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IMediator Mediator
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<ReportViewPage> Logger
@inject CcDashboard.Application.Interfaces.IDisplayTimeZone DisplayZone
@using MediatR
@using CcDashboard.Application.Reports.Queries
@using CcDashboard.Application.Reports.DTOs
@using CcDashboard.Domain.Domain.Reports
@using CcDashboard.Web.Components.ReportWidgets
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using CcDashboard.Application.Reports.Export
@using CcDashboard.Contracts.Common
@implements IDisposable

<PageTitle>@(_report?.Name ?? L["Reports_Title"]) — @L["Common_Fullscreen"]</PageTitle>

<div class="fullscreen-dashboard @(_darkMode ? "dark-mode" : "")">
    @if (_loading)
    {
        <div class="text-center py-5" aria-busy="true">
            <span class="spinner-border text-primary"></span>
        </div>
    }
    else if (_denied)
    {
        <div class="alert alert-warning m-4">
            <i class="bi bi-shield-exclamation me-2"></i>@L["Report_AccessDenied"]
        </div>
    }
    else if (_report is null)
    {
        <div class="alert alert-warning m-4">@L["Reports_NotFound"]</div>
    }
    else
    {
        <div class="fullscreen-header">
            <h1 class="fullscreen-title mb-0">@_report.Name</h1>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <div class="report-header-datebar d-flex gap-2 align-items-center">
                    <label class="small mb-0">@L["Report_From"]</label>
                    <input type="date" class="form-control form-control-sm" style="width: auto;" @bind="_from" />
                    @* Operator, 2026-11-05: one date field when the screen holds only end-of-shift
                       reports, because they take a single date and the second field changed
                       nothing - silently. With any other report on the screen both fields stay,
                       and the end-of-shift widgets take the first one; their own caption says so. *@
                    @if (!_singleDate)
                    {
                        <label class="small mb-0">@L["Report_To"]</label>
                        <input type="date" class="form-control form-control-sm" style="width: auto;" @bind="_to" />
                    }
                    <button class="btn btn-sm btn-primary" @onclick="ApplyDateRange">
                        <i class="bi bi-check2 me-1"></i>@L["Report_Apply"]
                    </button>
                    @if (_rangeError is not null)
                    {
                        <span class="text-danger small">
                            <i class="bi bi-exclamation-triangle me-1"></i>@_rangeError
                        </span>
                    }
                </div>
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary")"
                        @onclick="ToggleDarkMode" title="@(_darkMode ? L["WidgetCfg_LightMode"] : L["WidgetCfg_DarkMode"])">
                    <i class="bi @(_darkMode ? "bi-sun" : "bi-moon")"></i>
                </button>
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary")"
                        disabled="@_exporting" @onclick="ExportReport" title="@L["Reports_Export"]">
                    @if (_exporting)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <i class="bi bi-download me-1"></i>
                    }
                    @L["Reports_Export"]
                </button>
                @if (!string.IsNullOrEmpty(_exportError))
                {
                    <span class="text-danger small ms-2">@_exportError</span>
                }
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary")" disabled title="@L["Reports_ScheduleStub"]">
                    <i class="bi bi-calendar-event me-1"></i>@L["Reports_Schedule"]
                </button>
                <button class="btn btn-sm @(_darkMode ? "btn-outline-light" : "btn-outline-secondary") fullscreen-close" @onclick="ExitToList" title="@L["Screens_Back"]">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        @* A widget the export left out is NAMED here. The handler skips a refused widget and logs
           it, so before this block a person downloaded a file with sheets missing and the screen
           said nothing. A warning, not an error: the file did download. An unrecognised reason
           code still produces a line - the widget's name without an invented reason - because
           hiding it would be the same silent skip one step further downstream. *@
        @if (_skippedLines.Count > 0)
        {
            <div class="alert alert-warning py-1 px-2 small mb-2" role="status">
                <i class="bi bi-exclamation-triangle me-1"></i><strong>@L["Reports_ExportSkipped"]</strong>
                <ul class="mb-0 ps-3">
                    @foreach (var line in _skippedLines)
                    {
                        <li>@line</li>
                    }
                </ul>
            </div>
        }

        <div class="fullscreen-canvas" style="@(_positionsApplied ? "" : "visibility: hidden;")">
            @if (_report.Widgets.Count == 0)
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-grid-3x3-gap fs-1 mb-3 opacity-50"></i>
                    <p>@L["Reports_NoWidgets"]</p>
                </div>
            }
            else
            {
                <div class="fullscreen-scale-wrap">
                    <div class="fullscreen-design-layer" @ref="_designLayerRef"
                         style="width: @(_designWidth)px; height: @(_designHeight)px; position: relative;">
                        @foreach (var widget in _report.Widgets)
                        {
                            var pos = ParsePosition(widget.PositionJson);
                            var widgetStyle = $"position: absolute; left: {pos.X}px; top: {pos.Y}px; width: {pos.Width}px; height: {pos.Height}px;";

                            <div class="dashboard-widget" data-widget-id="@widget.Id" style="@widgetStyle" @key="widget.Id">
                                <div class="widget-header d-flex align-items-center justify-content-between">
                                    <span class="text-truncate">@GetWidgetTitle(widget)</span>
                                </div>
                                <div class="widget-content">
                                    <RenderReportWidget
                                        WidgetType="widget.WidgetType"
                                        ConfigJson="@widget.ConfigJson"
                                        From="_rangeFrom"
                                        To="_rangeTo"
                                        DarkMode="_darkMode"
                                        TenantId="_report?.TenantId"
                                        WidgetId="widget.Id"
                                        FilterChanged="OnWidgetFilterChanged"
                                        StepChanged="OnWidgetStepChanged" />
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool _loading = true;
    private bool _denied;
    private ReportScreenDetailDto? _report;
    private bool _darkMode;
    private bool _positionsApplied;
    private bool _scaleApplied;
    private ElementReference _designLayerRef;
    private int _designWidth = 1920;
    private int _designHeight = 1080;

    // Set in OnInitializedAsync from the site's display zone, not from UtcNow: after local
    // midnight a UTC "today" is still yesterday, and the report would open on the wrong day
    // without anyone touching it.
    private DateTime _from;
    private DateTime _to;
    private DateTime _rangeFrom;
    private DateTime _rangeTo;

    private readonly CancellationTokenSource _cts = new();
    private bool _exporting;
    private string? _exportError;
    // Built once, when the export answers - not during render: the unknown-code branch writes to
    // the log, and a render-time log would repeat on every redraw of the page.
    private List<string> _skippedLines = new();
    private string? _rangeError;

    /// <summary>
    /// What each widget is filtered by right now. The export is built here, so without this the
    /// file would be made from unfiltered queries while the screen showed filtered rows - and
    /// nobody would be told. Per widget, because two agent reports on one board may be filtered
    /// differently and a single screen-wide filter would match neither.
    /// A widget whose filter is empty is REMOVED rather than stored as empty: "no entry" and "an
    /// entry that filters nothing" would otherwise be two ways of saying the same thing, and the
    /// export would have to understand both.
    /// </summary>
    private readonly Dictionary<Guid, ReportWidgetFilter> _widgetFilters = new();

    private void OnWidgetFilterChanged(ReportWidgetFilter filter)
    {
        if (filter.IsEmpty)
            _widgetFilters.Remove(filter.WidgetId);
        else
            _widgetFilters[filter.WidgetId] = filter;
    }

    /// <summary>
    /// The step each end-of-shift queues widget is drawn with (FEAT-REPORT-EOS-CONFIGURABLE-01).
    /// Kept for the same reason as the filters: the export is built here, and a file grouped by
    /// days next to a screen grouped by months would disagree with it without a word. Every widget
    /// reports its step, Day included - the export must not assume a step it was never told.
    /// </summary>
    private readonly Dictionary<Guid, CcDashboard.Application.HistoricalReports.Queries.ReportStep> _widgetSteps = new();

    private void OnWidgetStepChanged(ReportWidgetStep step) => _widgetSteps[step.WidgetId] = step.Step;

    /// <summary>
    /// True when every widget on this screen is an end-of-shift report: then the second date field
    /// is not drawn, and the single date is sent as both ends of the window.
    /// An empty report is NOT "single": a screen with no widgets says nothing about what it will
    /// hold, and hiding a field on that guess would surprise whoever drops another report on it.
    /// </summary>
    private bool _singleDate;
    private DateTime _siteToday;
    // The day the defaults are anchored on: the site's today until the server names the last day
    // that has data (FEAT-REPORT-DEFAULT-LAST-DATA-DAY-01).
    private DateTime _defaultDay;
    // True once the person has applied dates of their own: after that the defaults never win back.
    private bool _datesChosen;

    private void RecomputeDateFields()
    {
        // The rule itself is in ReportDateFields, where a test can reach it; the page only applies
        // it. Keeping a second copy of "which types take one date" here is how the two would
        // drift apart.
        var wasSingle = _singleDate;
        _singleDate = ReportDateFields.SingleDate(_report?.Widgets.Select(w => w.WidgetType));

        if (_singleDate != wasSingle || !_datesChosen)
        {
            // The number of fields decides what "the default" means: a one-field screen opens on
            // today, because that single date IS the window; a two-field screen opens on the last
            // week. Applied only while the person has not chosen dates themselves - their choice
            // must survive a reload of the widget list.
            (_from, _to) = ReportDateFields.DefaultRange(_defaultDay, _singleDate);
            _rangeFrom = _from;
            _rangeTo = _to;
            _rangeError = null;
        }
        else if (_singleDate)
        {
            // One field means one date on both ends; a leftover "to" would send a window the
            // screen no longer shows.
            _to = _from;
            _rangeTo = _rangeFrom;
            _rangeError = null;
        }
    }

    /// <summary>
    /// The screen opens on the last day that has data (ReportDefaultDay - the one rule, shared with
    /// the editor). A day the person chose themselves always wins.
    /// </summary>
    private async Task ApplyLastDataDayAsync()
    {
        if (_report is null || _datesChosen) return;

        var latest = await ReportDefaultDay.LatestAsync(
            Mediator, _report.Widgets.Select(w => (w.Id, w.WidgetType, w.ConfigJson)), _report.TenantId, Logger, _cts.Token);

        if (latest is null || _datesChosen) return;
        _defaultDay = latest.Value;
        (_from, _to) = ReportDateFields.DefaultRange(_defaultDay, _singleDate);
        _rangeFrom = _from;
        _rangeTo = _to;
        _rangeError = null;
    }

    protected override async Task OnInitializedAsync()
    {
        // The site's today, not the server's UTC one; the dates themselves are set once the
        // report is loaded and the number of date fields is known (RecomputeDateFields).
        _siteToday = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, DisplayZone.Zone).Date;
        _defaultDay = _siteToday;
        (_from, _to) = ReportDateFields.DefaultRange(_siteToday, singleDate: false);
        _rangeFrom = _from;
        _rangeTo = _to;
        _loading = true;

        try
        {
            _report = await Mediator.Send(new GetReportScreenQuery(Id), _cts.Token);
            _darkMode = _report.IsDarkMode;
            RecomputeDateFields();
            await ApplyLastDataDayAsync();

            if (_report.Widgets.Count > 0)
            {
                var maxX = 0;
                var maxY = 0;
                foreach (var w in _report.Widgets)
                {
                    var pos = ParsePosition(w.PositionJson);
                    if (pos.X + pos.Width > maxX) maxX = pos.X + pos.Width;
                    if (pos.Y + pos.Height > maxY) maxY = pos.Y + pos.Height;
                }
                // No extra padding - see ScreenFullscreenPage: it would land on the right and
                // bottom only. Even margins come from centring the layer in its wrapper.
                _designWidth = maxX;
                _designHeight = maxY;
            }
            else
            {
                // For 0-widget reports, set _positionsApplied so empty-state is visible
                _positionsApplied = true;
            }
        }
        catch (CcDashboard.Domain.Exceptions.ForbiddenException)
        {
            _denied = true;
            _report = null;
        }
        catch (CcDashboard.Domain.Exceptions.NotFoundException)
        {
            _report = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report view load failed for {Id}", Id);
            _report = null;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_positionsApplied && _report?.Widgets.Count > 0 && !_loading)
        {
            var positions = _report.Widgets.Select(w =>
            {
                var pos = ParsePosition(w.PositionJson);
                return new
                {
                    id = w.Id.ToString(),
                    x = pos.X,
                    y = pos.Y,
                    width = pos.Width,
                    height = pos.Height
                };
            }).ToArray();

            await JS.InvokeVoidAsync("widgetResize.applyAllWidgetPositions", (object)positions);
            _positionsApplied = true;
            StateHasChanged();
        }

        if (_positionsApplied && !_scaleApplied && _report?.Widgets.Count > 0)
        {
            await JS.InvokeVoidAsync("viewerScale.init", _designLayerRef, _designWidth, _designHeight);
            _scaleApplied = true;
        }
    }

    private void ApplyDateRange()
    {
        // PR234-V4-REPORT-DATE-RANGE-INVERTED-ACCEPTED-01: "from" later than "to" used to be
        // accepted without a word. Every report then asked for a window that cannot contain
        // anything, and the screen showed "no data" - which reads as "there was no traffic",
        // not as "you asked for an impossible range". Refused here, before anything is sent.
        if (_singleDate)
            _to = _from;

        // The order check belongs to the two-field screen only: with one field there is no pair to
        // be out of order, and a message about an end date nobody can see would be nonsense.
        if (!_singleDate && _from.Date > _to.Date)
        {
            _rangeError = L["Report_DateRangeInverted"].Value;
            StateHasChanged();
            return;
        }

        _rangeError = null;
        _datesChosen = true;
        _rangeFrom = _from;
        _rangeTo = _to;
        StateHasChanged();
    }

    private void ExitToList() => Nav.NavigateTo("/reports");

    private void ToggleDarkMode() => _darkMode = !_darkMode;

    private static WidgetPosition ParsePosition(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return new WidgetPosition(0, 0, 400, 300);

        try
        {
            var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            return new WidgetPosition(
                root.TryGetProperty("x", out var x) ? x.GetInt32() : 0,
                root.TryGetProperty("y", out var y) ? y.GetInt32() : 0,
                root.TryGetProperty("width", out var w) ? w.GetInt32() : 400,
                root.TryGetProperty("height", out var h) ? h.GetInt32() : 300
            );
        }
        catch
        {
            return new WidgetPosition(0, 0, 400, 300);
        }
    }

    private string GetWidgetTitle(ReportWidgetDto widget)
    {
        if (!string.IsNullOrEmpty(widget.ConfigJson))
        {
            try
            {
                var doc = JsonDocument.Parse(widget.ConfigJson);
                if (doc.RootElement.TryGetProperty("title", out var title) && title.ValueKind == JsonValueKind.String)
                {
                    var t = title.GetString();
                    if (!string.IsNullOrEmpty(t)) return t;
                }
            }
            catch { }
        }
        // The enum name is not a name: an untitled widget used to show "EndOfShiftAgents" on the
        // board. The localised name is the same one the palette offers, so the header and the
        // place the widget was picked from say the same thing.
        return L[ReportWidgetPalette.NameKey(widget.WidgetType)].Value;
    }

    /// <summary>
    /// One line per widget the export left out. A code this screen does not know is logged with
    /// the server's own reason text and still shown by name: "unknown" must never render as
    /// "nothing to report".
    /// </summary>
    private List<string> BuildSkippedLines(IReadOnlyList<SkippedWidget> skipped)
    {
        var lines = new List<string>(skipped.Count);
        foreach (var item in skipped)
        {
            // A widget with no title would otherwise produce a line with a dash and no subject.
            var title = string.IsNullOrWhiteSpace(item.Title) ? L["UnknownWidget"].Value : item.Title;
            var reasonKey = ExportSkipReason.KeyFor(item.ReasonCode);

            if (reasonKey is null)
            {
                Logger.LogWarning(
                    "Export: widget {WidgetId} was skipped with an unrecognised reason code {ReasonCode} ({Reason})",
                    item.WidgetId, item.ReasonCode, item.Reason);
                lines.Add(string.Format(L[ExportSkipReason.ItemWithoutReasonKey].Value, title));
            }
            else
            {
                lines.Add(string.Format(L[ExportSkipReason.ItemKey].Value, title, L[reasonKey].Value));
            }
        }
        return lines;
    }

    private async Task ExportReport()
    {
        if (_report is null || _exporting) return;
        _exporting = true;
        _exportError = null;
        _skippedLines = new();
        StateHasChanged();

        try
        {
            var res = await Mediator.Send(
                // The file must be the screen. Each widget's own filter goes with it, keyed by the
                // widget, so two agent reports filtered differently still produce two sheets that
                // each match what their widget shows. A widget with no entry exports unfiltered -
                // which is exactly what "no filter" looks like on screen.
                new ExportReportCommand(_report.Id, _rangeFrom, _rangeTo, _report.TenantId,
                    Filters: _widgetFilters
                        .Where(e => e.Value.Filters is { Count: > 0 })
                        .ToDictionary(e => e.Key, e => e.Value.Filters!),
                    Steps: new Dictionary<Guid, CcDashboard.Application.HistoricalReports.Queries.ReportStep>(_widgetSteps)),
                _cts.Token);
            _skippedLines = BuildSkippedLines(res.Skipped);
            var base64 = Convert.ToBase64String(res.Content);
            await JS.InvokeVoidAsync("ccApp.downloadFile", base64, res.FileName, res.ContentType);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Report export failed for {Id}", _report.Id);
            _exportError = L["Reports_ExportFailed"];
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _ = JS.InvokeVoidAsync("viewerScale.dispose");
    }

    private record WidgetPosition(int X, int Y, int Width, int Height);
}

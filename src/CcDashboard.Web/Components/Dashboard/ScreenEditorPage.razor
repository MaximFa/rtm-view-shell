    private async Task SaveWidgetConfig()
    {
        if (ConfiguringWidget is null || Dashboard is null) return;

        int? preassignedGridId = null;
        int? columnsSetId = null;
        int? rtsUserGridId = null;

        // For AgentGrid widgets, save to RTS tables first
        if (IsAgentGridWidget(ConfiguringWidget))
        {
            try
            {
                // Get the existing RTS IDs from config (if editing)
                var existingRtsUserGridId = ConfiguringWidget.Config?.RtsUserGridId ?? 0;
                var existingColumnsSetId = ConfiguringWidget.Config?.ColumnsSetId;

                // Build rows filter string from table filters
                var validFilters = ConfigTableFilters.Where(f => !string.IsNullOrEmpty(f.MetricId)).ToList();
                var rowsFilter = BuildRowsFilter(validFilters);

                // Build column inputs for RTS command
                var columnInputs = ConfigAgentColumnDefs.Select((col, idx) => new RtsColumnInput(
                    col.DbColumnId,  // null for new columns
                    col.Name,        // Column display name
                    col.MetricId,
                    idx  // columnsOrder
                )).ToList();

                // Save to RTS tables (use RtsUserGridId from config, not DashboardWidget.GridId)
                var rtsResult = await Mediator.Send(new SaveAgentGridRtsCommand(
                    existingRtsUserGridId,     // 0 for new widget, or existing RTS GridId
                    existingColumnsSetId,      // null for new widget
                    ConfigDisplayName ?? ConfiguringWidget.Name,
                    string.IsNullOrEmpty(ConfigBusinessUnit) ? null : int.TryParse(ConfigBusinessUnit, out var buId) ? buId : null,
                    rowsFilter,
                    columnInputs
                ), _cts.Token);

                // Store RTS GridId for ConfigJson
                rtsUserGridId = rtsResult.GridId;
                columnsSetId = rtsResult.ColumnsSetId;

                // Update column DbColumnIds from RTS result
                foreach (var (title, dbColumnId) in rtsResult.SavedColumns)
                {
                    var colDef = ConfigAgentColumnDefs.FirstOrDefault(c => c.Name == title);
                    if (colDef != null)
                    {
                        colDef.DbColumnId = dbColumnId;
                    }
                }
            }
            catch (Exception ex)
            {
                Error = $"RTS save failed: {ex.Message}";
                return;
            }
        }

        // For QueueGrid widgets, save to RTS tables (RTSGrid_*)
        int? queueGridId = null;
        int? headerRowId = null;
        Dictionary<string, int?>? savedHeaderCellIds = null;
        if (IsQueueGridWidget(ConfiguringWidget))
        {
            try
            {
                var existingGridId = ConfiguringWidget.Config?.GridId;
                var existingHeaderRowId = ConfiguringWidget.Config?.HeaderRowId;
                var existingHeaderCellIds = ConfiguringWidget.Config?.HeaderCellIds ?? new Dictionary<string, int?>();

                // Build column inputs (1-based ColumnNumber)
                var columnInputs = ConfigQueueGridColumnDefs.Select((col, idx) => new QueueGridColumnInput(
                    col.Id,
                    col.ColumnId,
                    col.Name,
                    col.MetricId,
                    idx + 1
                )).ToList();

                // Build row inputs (2-based RowNumber, 1 is header)
                var rowInputs = ConfigQueueGridRows.Select((row, idx) => new QueueGridRowInput(
                    row.Id,
                    row.RowId,
                    row.BusinessUnitId,
                    idx + 2,
                    row.CellIds
                )).ToList();

                var rtsResult = await Mediator.Send(new SaveQueueGridRtsCommand(
                    existingGridId,
                    existingHeaderRowId,
                    ConfigDisplayName ?? ConfiguringWidget.Name,
                    columnInputs,
                    rowInputs,
                    existingHeaderCellIds
                ), _cts.Token);

                queueGridId = rtsResult.GridId;
                headerRowId = rtsResult.HeaderRowId;
                savedHeaderCellIds = rtsResult.HeaderCellIds.ToDictionary(kvp => kvp.Key, kvp => (int?)kvp.Value);

                // Update column ColumnIds from result
                foreach (var (localId, dbColumnId) in rtsResult.SavedColumnIds)
                {
                    var colDef = ConfigQueueGridColumnDefs.FirstOrDefault(c => c.Id == localId);
                    if (colDef != null)
                    {
                        colDef.ColumnId = dbColumnId;
                    }
                }

                // Update row RowIds and CellIds from result
                foreach (var (localId, dbRowId) in rtsResult.SavedRowIds)
                {
                    var rowDef = ConfigQueueGridRows.FirstOrDefault(r => r.Id == localId);
                    if (rowDef != null)
                    {
                        rowDef.RowId = dbRowId;
                        if (rtsResult.SavedCellIds.TryGetValue(localId, out var cellIds))
                        {
                            rowDef.CellIds = cellIds.ToDictionary(kvp => kvp.Key, kvp => (int?)kvp.Value);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Error = $"Queue Grid RTS save failed: {ex.Message}";
                return;
            }
        }

        // For DataSlot widgets, save to RTS tables (RTSGrid_* - same as Queue Grid)
        if (IsDataSlotWidget(ConfiguringWidget) && !string.IsNullOrEmpty(ConfigDataSlotMetricId))
        {
            try
            {
                var rtsResult = await Mediator.Send(new SaveDataSlotRtsCommand(
                    _dataSlotGridId,
                    _dataSlotColumnId,
                    _dataSlotRowId,
                    _dataSlotCellId,
                    ConfigDataSlotTitle ?? ConfiguringWidget.Name,
                    ConfigDataSlotMetricId,
                    ConfigDataSlotBusinessUnitId
                ), _cts.Token);

                _dataSlotGridId = rtsResult.GridId;
                _dataSlotColumnId = rtsResult.ColumnId;
                _dataSlotRowId = rtsResult.RowId;
                _dataSlotCellId = rtsResult.CellId;
            }
            catch (Exception ex)
            {
                Error = $"Data Slot RTS save failed: {ex.Message}";
                return;
            }
        }

        var newConfig = new WidgetConfig
        {
            DisplayName = ConfigDisplayName,
            BusinessUnit = ConfigBusinessUnit,
            Metric = ConfigMetric,
            FontSize = ConfigFontSize,
            BackgroundColor = ConfigBackgroundColor,
            FontColor = ConfigFontColor,
            TableBackgroundColor = ConfigTableBackgroundColor,
            // Dark mode colors
            DarkBackgroundColor = ConfigDarkBackgroundColor,
            DarkFontColor = ConfigDarkFontColor,
            DarkTableBackgroundColor = ConfigDarkTableBackgroundColor,
            // Header colors
            HeaderBackgroundColor = ConfigHeaderBackgroundColor,
            HeaderFontColor = ConfigHeaderFontColor,
            DarkHeaderBackgroundColor = ConfigDarkHeaderBackgroundColor,
            DarkHeaderFontColor = ConfigDarkHeaderFontColor,
            Thresholds = ConfigThresholds.Select(t => new ThresholdRule
            {
                From = t.From,
                To = t.To,
                BackgroundColor = t.BackgroundColor,
                FontColor = t.FontColor
            }).ToList(),
            // Agent Grid specific
            AgentGridTeams = ConfigAgentTeams.Count > 0 ? ConfigAgentTeams.ToList() : null,
            AgentGridStates = ConfigAgentStates.Count > 0 ? ConfigAgentStates.ToList() : null,
            AgentGridColumns = ConfigAgentColumns.ToList(),
            AgentGridShowAlerts = ConfigAgentShowAlerts,
            AgentGridColumnNames = ConfigAgentColumnNames.Count > 0 ? ConfigAgentColumnNames : null,
            AgentGridColumnDefs = ConfigAgentColumnDefs.Count > 0 ? ConfigAgentColumnDefs : null,
            // RTS references (Agent Grid)
            RtsUserGridId = rtsUserGridId,
            ColumnsSetId = columnsSetId,
            // Column thresholds
            ColumnThresholds = ConfigColumnThresholds.Count > 0
                ? ConfigColumnThresholds.Where(kvp => kvp.Value.Count > 0)
                    .ToDictionary(kvp => kvp.Key, kvp => kvp.Value)
                : null,
            // Table filters (only include rules with non-empty MetricId)
            TableFilters = ConfigTableFilters.Where(f => !string.IsNullOrEmpty(f.MetricId)).ToList() is { Count: > 0 } filters
                ? filters
                : null,
            // Avatar and Score settings
            ShowAvatar = ConfigShowAvatar,
            AvatarBgColor = ConfigAvatarBgColor,
            AvatarFontColor = ConfigAvatarFontColor,
            ShowScore = ConfigShowScore,
            ShowPagination = ConfigShowPagination,
            ScoreStarColor = ConfigScoreStarColor,
            ScoreFormula = ConfigScoreFormula.Where(r => !string.IsNullOrEmpty(r.MetricId)).ToList() is { Count: > 0 } scoreRules
                ? scoreRules
                : null,
            // Queue Grid specific
            QueueGridRows = ConfigQueueGridRows.Count > 0 ? ConfigQueueGridRows : null,
            QueueGridColumnDefs = ConfigQueueGridColumnDefs.Count > 0 ? ConfigQueueGridColumnDefs : null,
            // Queue Grid RTS IDs
            GridId = queueGridId,
            HeaderRowId = headerRowId,
            HeaderCellIds = savedHeaderCellIds ?? new Dictionary<string, int?>(),
            // Data Slot specific
            DataSlotTitle = !string.IsNullOrEmpty(ConfigDataSlotTitle) ? ConfigDataSlotTitle : null,
            DataSlotMetricId = ConfigDataSlotMetricId,
            DataSlotBusinessUnitId = ConfigDataSlotBusinessUnitId,
            DataSlotTarget = ConfigDataSlotTarget,
            DataSlotTargetText = !string.IsNullOrEmpty(_dataSlotTargetText) ? _dataSlotTargetText : null,
            DataSlotTargetMode = ConfigDataSlotTargetMode,
            DataSlotTargetLabel = !string.IsNullOrEmpty(ConfigDataSlotTargetLabel) ? ConfigDataSlotTargetLabel : null,
            DataSlotBold = ConfigDataSlotBold,
            DataSlotAlign = ConfigDataSlotAlign,
            DataSlotShowTargetLabel = ConfigDataSlotShowTargetLabel,
            DataSlotShowArrow = ConfigDataSlotShowArrow,
            HideHeader = ConfigHideHeader,
            // Data Slot RTS IDs
            DataSlotGridId = _dataSlotGridId,
            DataSlotColumnId = _dataSlotColumnId,
            DataSlotRowId = _dataSlotRowId,
            DataSlotCellId = _dataSlotCellId
        };

        ConfiguringWidget.Config = newConfig;

        // Update widget display name
        if (!string.IsNullOrWhiteSpace(ConfigDisplayName))
        {
            ConfiguringWidget.Name = ConfigDisplayName;
        }

        // Save widget to database
        try
        {
            var widgetDto = new DashboardWidgetDto(
                ConfiguringWidget.Id,
                ConfiguringWidget.GridId,
                Dashboard.Id,
                ConfiguringWidget.CatalogItemId,
                System.Text.Json.JsonSerializer.Serialize(new { ConfiguringWidget.Width, ConfiguringWidget.Height, ConfiguringWidget.X, ConfiguringWidget.Y }, _jsonOptions),
                System.Text.Json.JsonSerializer.Serialize(newConfig, _jsonOptions)
            );

            var gridId = await Mediator.Send(new SaveDashboardWidgetCommand(Dashboard.Id, widgetDto, preassignedGridId), _cts.Token);
            ConfiguringWidget.GridId = gridId;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        CloseWidgetConfig();
        StateHasChanged();
    }


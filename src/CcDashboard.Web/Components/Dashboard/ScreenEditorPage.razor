                ConfiguringWidget.CatalogItemId,
                System.Text.Json.JsonSerializer.Serialize(new { ConfiguringWidget.Width, ConfiguringWidget.Height, ConfiguringWidget.X, ConfiguringWidget.Y }, _jsonOptions),

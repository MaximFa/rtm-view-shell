@page "/screens/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Superadmin,Administrator,Editor")]
@inject IMediator Mediator
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L
@using MediatR
@using Microsoft.Extensions.Localization
@using CcDashboard.Application.Commands.Dashboards
@using CcDashboard.Application.Queries.Dashboards
@using CcDashboard.Application.Queries.Widgets
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Contracts.DTOs.Dashboards
@using CcDashboard.Contracts.DTOs.Widgets
@using CcDashboard.Contracts.DTOs.Configuration
@using CcDashboard.Domain.Enums
@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Application.Queries.WidgetTemplates
@using CcDashboard.Application.Queries.AgentStates
@using CcDashboard.Application.Commands.WidgetTemplates
@using CcDashboard.Application.Queries.InfoSlots
@using CcDashboard.Contracts.DTOs.InfoSlots
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

<PageTitle>@L["Screens_Edit"] — @(Dashboard?.Name ?? "...") — RTM View Shell</PageTitle>

<div class="editor-fullscreen @(_darkMode ? "dark-mode" : "")">
    @if (Loading)
    {
        <div class="text-center py-5" aria-busy="true">
            <span class="spinner-border text-primary"></span>
            <p class="mt-2 text-muted">@L["Loading"]</p>
        </div>
    }
    else if (Dashboard is null)
    {
        <div class="alert alert-warning m-4">@L["Screens_NotFound"]</div>
        <a href="/screens" class="btn btn-outline-primary ms-4">@L["Screens_Back"]</a>
    }
    else
    {
        <!-- Fullscreen Editor Header -->
        <div class="editor-header">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-light" @onclick="TogglePalette" title="@L["Widgets_Palette"]">
                    <i class="bi bi-layout-sidebar-inset"></i>
                </button>
                <a href="/screens" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-x-lg"></i>
                </a>
                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary fw-bold" style="width:250px"
                       @bind="EditName" @bind:event="oninput" maxlength="200" />
                <span class="badge @(Dashboard.Status == DashboardStatus.Published ? "bg-success" : "bg-warning text-dark")">
                    @Dashboard.Status
                </span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" @onclick="ToggleDarkMode" title="@(_darkMode ? "Light mode" : "Dark mode")">
                    <i class="bi @(_darkMode ? "bi-sun" : "bi-moon")"></i>
                </button>
                @if (ConfiguringWidget is not null)
                {
                    <span class="badge bg-info me-2">Modal: @ConfiguringWidget.Name</span>
                }
                @if (Error is not null)
                {
                    <span class="text-danger small me-2">@Error</span>
                }
                @if (Dashboard.Status == DashboardStatus.Draft)
                {
                    <button class="btn btn-warning btn-sm" @onclick="PublishDashboard" disabled="@Saving">
                        <i class="bi bi-send"></i> @L["Screens_Publish"]
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-warning btn-sm" @onclick="UnpublishDashboard" disabled="@Saving">
                        <i class="bi bi-archive"></i> @L["Screens_Unpublish"]
                    </button>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="CloneScreen" disabled="@(Saving || Cloning)" title="@L["Screens_Clone"]">
                    @if (Cloning)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-copy"></i> @L["Screens_Clone"]
                </button>
                <button class="btn btn-success btn-sm" @onclick="SaveLayout" disabled="@Saving">
                    @if (Saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-check-lg"></i> @L["Common_Save"]
                </button>
            </div>
        </div>

        <div class="editor-body">
        <!-- Slide-out Widget Palette -->
        <div class="editor-palette @(PaletteOpen ? "open" : "")">
            <div class="palette-header">
                <h6 class="mb-0">@L["Widgets_Palette"]</h6>
                <button class="btn btn-sm btn-link text-muted p-0" @onclick="TogglePalette">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="palette-content">
                @if (WidgetCatalog.Count == 0)
                {
                    <p class="text-muted small">@L["Widgets_NoWidgets"]</p>
                }
                else
                {
                    @foreach (var category in WidgetCatalog.GroupBy(w => w.Category))
                    {
                        <div class="mb-3" @key="category.Key">
                            <div class="small text-muted text-uppercase mb-2">@category.Key</div>
                            @foreach (var widget in category)
                            {
                                <div class="widget-palette-item"
                                     draggable="true"
                                     @key="widget.Id"
                                     @ondragstart="() => OnDragStart(widget)"
                                     @ondragend="OnDragEnd">
                                    <div class="widget-palette-icon">
                                        <i class="bi @GetWidgetIcon(widget.Name)"></i>
                                    </div>
                                    <div class="widget-palette-info">
                                        <div class="widget-palette-name">@widget.Name</div>
                                        <div class="widget-palette-desc">@widget.Description</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                <!-- Templates Section -->
                @if (WidgetTemplates.Count > 0)
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="small text-muted text-uppercase mb-2">
                            <i class="bi bi-bookmark me-1"></i>@L["WidgetCfg_Templates"]
                        </div>
                        @foreach (var template in WidgetTemplates)
                        {
                            <div class="widget-palette-item template-item"
                                 draggable="true"
                                 @key="template.Id"
                                 @ondragstart="() => OnTemplateDragStart(template)"
                                 @ondragend="OnDragEnd">
                                <div class="widget-palette-icon">
                                    <i class="bi @GetWidgetIcon(template.WidgetName ?? "")"></i>
                                </div>
                                <div class="widget-palette-info flex-grow-1">
                                    <div class="widget-palette-name">@template.Name</div>
                                    <div class="widget-palette-desc">@template.WidgetName</div>
                                </div>
                                <button class="btn btn-link btn-sm p-0 text-danger ms-1"
                                        @onclick="() => ConfirmDeleteTemplate(template)"
                                        @onclick:stopPropagation
                                        title="Delete template">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Dashboard Canvas (fullscreen) -->
        <div class="editor-canvas @(IsDragging ? "drag-over" : "")"
             @ondragover="OnDragOver"
             @ondragover:preventDefault="true"
             @ondrop="OnDropAtPosition"
             @ondrop:preventDefault="true">
            @if (PlacedWidgets.Count == 0)
            {
                <div class="text-center py-5 text-muted" style="pointer-events: none;">
                    <i class="bi bi-grid-3x3-gap fs-1 mb-3 opacity-50"></i>
                    <p>@L["Widgets_DragHere"]</p>
                </div>
            }
            <div class="dashboard-canvas-grid"
                 style="position: relative; min-height: calc(100vh - 60px); @(_positionsApplied || PlacedWidgets.Count == 0 ? "" : "visibility: hidden;")">
                @foreach (var widget in PlacedWidgets)
                {
                    <div class="dashboard-widget @(SelectedWidgetId == widget.Id ? "selected" : "") @(widget.Config?.HideHeader == true ? "header-hidden" : "")"
                         data-widget-id="@widget.Id"
                         style="@GetWidgetStyle(widget)"
                         @key="widget.Id"
                         @onclick="() => SelectWidget(widget.Id)"
                         @onmousedown="e => { if (widget.Config?.HideHeader == true) StartMove(widget.Id, e); }"
                         @onmousedown:stopPropagation="@(widget.Config?.HideHeader == true)">
                        <div class="widget-toolbar">
                            <button class="widget-toolbar-btn" title="Save as template"
                                    @onclick="() => OpenSaveAsTemplate(widget)" @onclick:stopPropagation="true">
                                <i class="bi bi-bookmark-plus"></i>
                            </button>
                            <button class="widget-toolbar-btn" title="@L["Widgets_Configure"]"
                                    @onclick="async () => await OpenWidgetConfig(widget)" @onclick:stopPropagation="true">
                                <i class="bi bi-gear"></i>
                            </button>
                            <button class="widget-toolbar-btn danger" title="@L["Delete"]"
                                    @onclick="() => RemoveWidget(widget.Id)" @onclick:stopPropagation="true">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        @if (widget.Config?.HideHeader != true)
                        {
                            <div class="widget-header widget-drag-handle d-flex align-items-center"
                                 @onmousedown="e => StartMove(widget.Id, e)"
                                 @onmousedown:stopPropagation="true">
                                <i class="bi bi-grip-horizontal me-1"></i>
                                <span>@widget.Name</span>
                                @if (_widgetFilterCounts.GetValueOrDefault(widget.Id) > 0)
                                {
                                    <span class="badge rounded-pill bg-primary ms-1" style="font-size: 10px; padding: 2px 6px;">
                                        @_widgetFilterCounts[widget.Id]
                                    </span>
                                }
                            </div>
                        }
                        <div class="widget-content">
                            <RenderWidget Widget="widget" DarkMode="_darkMode" ActiveFilterCountChanged="count => { _widgetFilterCounts[widget.Id] = count; InvokeAsync(StateHasChanged); }" />
                        </div>
                        @* Resize handles *@
                        <div class="resize-handle resize-e"  @onmousedown="e => StartResizeE(widget.Id, e)"  @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-s"  @onmousedown="e => StartResizeS(widget.Id, e)"  @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-se" @onmousedown="e => StartResizeSE(widget.Id, e)" @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-n"  @onmousedown="e => StartResizeN(widget.Id, e)"  @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-w"  @onmousedown="e => StartResizeW(widget.Id, e)"  @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-nw" @onmousedown="e => StartResizeNW(widget.Id, e)" @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-ne" @onmousedown="e => StartResizeNE(widget.Id, e)" @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-sw" @onmousedown="e => StartResizeSW(widget.Id, e)" @onmousedown:stopPropagation="true"></div>
                    </div>
                }
            </div>
        </div>
        </div>
    }
</div>

<!-- Widget Configuration Modal -->
@if (ConfiguringWidget is not null)
{
    <div class="editor-modal @(_darkMode ? "dark-mode" : "")" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="widget-config-title" data-modal-id="widget-config">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header modal-drag-header">
                    <i class="bi bi-grip-vertical me-2 text-muted" style="font-size: 1rem; flex-shrink: 0;"></i>
                    <h5 class="modal-title" id="widget-config-title">
                        @L["Widgets_Configure"]: @ConfiguringWidget.Name
                    </h5>
                    <button type="button" class="btn-close ms-auto" @onclick="CloseWidgetConfig"></button>
                </div>
                <!-- Resize Handle (bottom-right corner) -->
                <div class="modal-resize-handle"></div>
                <div class="modal-body" style="height: 700px; overflow-y: auto; overflow-x: hidden;">
                    <!-- Tabs Navigation -->
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(ConfigActiveTab == "general" ? "active" : "")" @onclick='() => ConfigActiveTab = "general"'>@L["WidgetCfg_General"]</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(ConfigActiveTab == "appearance" ? "active" : "")" @onclick='() => ConfigActiveTab = "appearance"'>@L["WidgetCfg_Appearance"]</button>
                        </li>
                        @if (IsQueueGridWidget(ConfiguringWidget) || IsAgentGridWidget(ConfiguringWidget))
                        {
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "thresholds" ? "active" : "")" @onclick='() => ConfigActiveTab = "thresholds"'>@L["WidgetCfg_Thresholds"]</button>
                            </li>
                        }
                        @if (IsAgentGridWidget(ConfiguringWidget))
                        {
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "filters" ? "active" : "")" @onclick='() => ConfigActiveTab = "filters"'>@L["WidgetCfg_Filters"]</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "columns" ? "active" : "")" @onclick='() => ConfigActiveTab = "columns"'>@L["WidgetCfg_Columns"]</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "score" ? "active" : "")" @onclick='() => ConfigActiveTab = "score"'>@L["WidgetCfg_Score"]</button>
                            </li>
                        }
                        @if (IsQueueGridWidget(ConfiguringWidget))
                        {
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "rows" ? "active" : "")" @onclick='() => ConfigActiveTab = "rows"'>@L["WidgetCfg_Rows"]</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "queuecolumns" ? "active" : "")" @onclick='() => ConfigActiveTab = "queuecolumns"'>@L["WidgetCfg_Columns"]</button>
                            </li>
                        }
                        @if (IsDayTrendWidget(ConfiguringWidget))
                        {
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "callmetrics" ? "active" : "")" @onclick='() => ConfigActiveTab = "callmetrics"'>@L["WidgetCfg_CallMetrics"]</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "agentmetrics" ? "active" : "")" @onclick='() => ConfigActiveTab = "agentmetrics"'>@L["WidgetCfg_AgentMetrics"]</button>
                            </li>
                        }
                    </ul>

                    <!-- Tab: General -->
                    @if (ConfigActiveTab == "general")
                    {
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label small text-muted">@L["WidgetCfg_WidgetId"]</label>
                                <input type="text" class="form-control form-control-sm font-monospace" value="@ConfiguringWidget?.Id" readonly />
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted">@L["WidgetCfg_GridId"]</label>
                                <input type="text" class="form-control form-control-sm font-monospace" value="@ConfiguringWidget?.GridId" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["Widgets_Name"]</label>
                            <input type="text" class="form-control" @bind="ConfigDisplayName" />
                        </div>

                        @if (!IsQueueGridWidget(ConfiguringWidget) && !IsDayTrendWidget(ConfiguringWidget) && !IsInfoSlotWidget(ConfiguringWidget))
                        {
                            <div class="mb-3">
                                <label class="form-label">@L["Widgets_BusinessUnit"]</label>
                                <div class="searchable-select">
                                    <input type="text" class="form-control" placeholder="@L["Common_Search"]..."
                                           value="@BuSearchText"
                                           @oninput="OnBuSearchInput"
                                           @onfocus="() => { BuSearchText = string.Empty; BuDropdownOpen = true; }"
                                           @onblur="OnBuSearchBlur" />
                                    @if (BuDropdownOpen)
                                    {
                                        <div class="searchable-dropdown">
                                            <div class="dropdown-item @(string.IsNullOrEmpty(ConfigBusinessUnit) ? "active" : "")"
                                                 @onmousedown="() => SelectBusinessUnit(null)"
                                                 @onmousedown:preventDefault="true">
                                                <em>@L["Common_All"]</em>
                                            </div>
                                            @foreach (var bu in FilteredBusinessUnits)
                                            {
                                                <div class="dropdown-item @(ConfigBusinessUnit == bu.BusinessUnitId.ToString() ? "active" : "")"
                                                     @onmousedown="() => SelectBusinessUnit(bu)"
                                                     @onmousedown:preventDefault="true">
                                                    @bu.BusinessUnitName
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (IsInfoSlotWidget(ConfiguringWidget))
                        {
                            <!-- Info Slot: Select Info Slot -->
                            <div class="mb-3">
                                <label class="form-label">@L["InfoSlots_Name"]</label>
                                <select class="form-select" @bind="ConfigInfoSlotId">
                                    <option value="">— @L["Common_Select"] —</option>
                                    @foreach (var slot in AvailableInfoSlots)
                                    {
                                        <option value="@slot.Id">@slot.Name (@slot.DisplayMode)</option>
                                    }
                                </select>
                            </div>
                        }

                        @if (IsDataSlotWidget(ConfiguringWidget))
                        {
                            <!-- Data Slot: Title -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DataSlotTitle"]</label>
                                <input type="text" class="form-control" @bind="ConfigDataSlotTitle"
                                       placeholder="@L["Common_Optional"]" />
                                <small class="text-muted">@L["Widget_DataSlotTitleHint"]</small>
                            </div>

                            <!-- Data Slot: Metric -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DataSlotMetric"]</label>
                                <button type="button"
                                        class="form-control text-start"
                                        @onclick="OpenDataSlotMetricWizard">
                                    @if (!string.IsNullOrEmpty(ConfigDataSlotMetricId))
                                    {
                                        @GetMetricDisplayName(ConfigDataSlotMetricId)
                                    }
                                    else
                                    {
                                        <span class="text-muted">@L["Common_SelectMetric"]</span>
                                    }
                                </button>
                            </div>

                            <!-- Data Slot: Target -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label class="form-label">@L["Widget_DataSlotTarget"]</label>
                                    <input type="text" class="form-control @(_dataSlotTargetError != null ? "is-invalid" : "")"
                                           value="@_dataSlotTargetText"
                                           @oninput="OnDataSlotTargetInput"
                                           placeholder="0.00" />
                                    @if (_dataSlotTargetError != null)
                                    {
                                        <div class="invalid-feedback">@_dataSlotTargetError</div>
                                    }
                                </div>
                                <div class="col-6">
                                    <label class="form-label">@L["Widget_DataSlotTargetMode"]</label>
                                    <select class="form-select" @bind="ConfigDataSlotTargetMode">
                                        <option value="less">@L["Widget_DataSlotTargetLess"]</option>
                                        <option value="greater">@L["Widget_DataSlotTargetGreater"]</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Data Slot: Target Label -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DataSlotTargetLabel"]</label>
                                <input type="text" class="form-control" @bind="ConfigDataSlotTargetLabel"
                                       placeholder="Goal < 5%" />
                                <small class="text-muted">@L["Widget_DataSlotTargetLabelHint"]</small>
                            </div>

                        }

                        @if (IsDayTrendWidget(ConfiguringWidget))
                        {
                            <!-- DayTrend: Business Unit -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widgets_BusinessUnit"]</label>
                                <div class="searchable-select">
                                    <input type="text" class="form-control" placeholder="@L["Common_Search"]..."
                                           value="@DayTrendBuSearchText"
                                           @oninput="e => DayTrendBuSearchText = e.Value?.ToString() ?? string.Empty"
                                           @onfocus="() => { DayTrendBuSearchText = string.Empty; DayTrendBuDropdownOpen = true; }"
                                           @onblur="() => { Task.Delay(150).ContinueWith(_ => InvokeAsync(() => { DayTrendBuDropdownOpen = false; DayTrendBuSearchText = BusinessUnits.FirstOrDefault(b => b.BusinessUnitId == ConfigDayTrendBusinessUnitId)?.BusinessUnitName ?? string.Empty; StateHasChanged(); })); }" />
                                    @if (DayTrendBuDropdownOpen)
                                    {
                                        <div class="searchable-dropdown">
                                            @foreach (var bu in BusinessUnits.Where(b =>
                                                string.IsNullOrEmpty(DayTrendBuSearchText) ||
                                                (b.BusinessUnitName?.Contains(DayTrendBuSearchText, StringComparison.OrdinalIgnoreCase) ?? false)))
                                            {
                                                <div class="dropdown-item @(ConfigDayTrendBusinessUnitId == bu.BusinessUnitId ? "active" : "")"
                                                     @onmousedown="() => { ConfigDayTrendBusinessUnitId = bu.BusinessUnitId; DayTrendBuSearchText = bu.BusinessUnitName ?? string.Empty; DayTrendBuDropdownOpen = false; }"
                                                     @onmousedown:preventDefault="true">
                                                    @(bu.BusinessUnitName ?? $"BU #{bu.BusinessUnitId}")
                                                </div>
                                            }
                                            @if (!BusinessUnits.Any())
                                            {
                                                <div class="dropdown-item text-muted">No Business Units available</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- DayTrend: Interval -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DayTrend_Interval"]</label>
                                <div class="btn-group w-100" role="group">
                                    <input type="radio" class="btn-check" name="dayTrendInterval" id="interval15" value="15"
                                           checked="@(ConfigDayTrendIntervalMinutes == 15)"
                                           @onchange="() => ConfigDayTrendIntervalMinutes = 15" />
                                    <label class="btn btn-outline-primary" for="interval15">15 min</label>

                                    <input type="radio" class="btn-check" name="dayTrendInterval" id="interval30" value="30"
                                           checked="@(ConfigDayTrendIntervalMinutes == 30)"
                                           @onchange="() => ConfigDayTrendIntervalMinutes = 30" />
                                    <label class="btn btn-outline-primary" for="interval30">30 min</label>

                                    <input type="radio" class="btn-check" name="dayTrendInterval" id="interval60" value="60"
                                           checked="@(ConfigDayTrendIntervalMinutes == 60)"
                                           @onchange="() => ConfigDayTrendIntervalMinutes = 60" />
                                    <label class="btn btn-outline-primary" for="interval60">60 min</label>
                                </div>
                            </div>

                            <!-- DayTrend: Auto-refresh -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DayTrend_Refresh"]</label>
                                <select class="form-select" @bind="ConfigDayTrendRefreshIntervalSeconds">
                                    <option value="60">1 min</option>
                                    <option value="300">5 min</option>
                                    <option value="600">10 min</option>
                                    <option value="0">@L["Widget_DayTrend_Manual"]</option>
                                </select>
                            </div>
                        }

                    }

                    <!-- Tab: Appearance -->
                    @if (ConfigActiveTab == "appearance")
                    {
                        @if (IsInfoSlotWidget(ConfiguringWidget))
                        {
                            <!-- Scroll Behaviour Section (InfoSlot only) -->
                            <div class="appearance-section mb-4">
                                <h6 class="section-label">@L["InfoSlot_ScrollBehaviour"]</h6>
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted mb-1">@L["InfoSlot_ScrollDirection"]</label>
                                        <select class="form-select form-select-sm" @bind="ConfigScrollDirection">
                                            <option value="LeftToRight">@L["InfoSlot_LeftToRight"]</option>
                                            <option value="RightToLeft">@L["InfoSlot_RightToLeft"]</option>
                                            <option value="TopToBottom">@L["InfoSlot_TopToBottom"]</option>
                                            <option value="BottomToTop">@L["InfoSlot_BottomToTop"]</option>
                                        </select>
                                    </div>
                                    @if (GetSelectedInfoSlotDisplayMode() == "Ticker")
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label small text-muted mb-1">@L["InfoSlot_ScrollSpeed"]</label>
                                            <select class="form-select form-select-sm" @bind="ConfigScrollSpeed">
                                                <option value="Slow">@L["InfoSlot_SpeedSlow"]</option>
                                                <option value="Medium">@L["InfoSlot_SpeedMedium"]</option>
                                                <option value="Fast">@L["InfoSlot_SpeedFast"]</option>
                                            </select>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Typography Section -->
                        <div class="appearance-section mb-4">

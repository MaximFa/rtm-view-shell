    private async Task SaveWidgetConfig()
    {
        if (ConfiguringWidget is null || Dashboard is null) return;
        if (_configSaving) return;  // Guard against double-click
        _configSaving = true;
        StateHasChanged();
        try
        {

        int? preassignedGridId = null;
        int? columnsSetId = null;
        int? rtsUserGridId = null;

        // For AgentGrid widgets, save to RTS tables first
        if (IsAgentGridWidget(ConfiguringWidget))
        {
            try
            {
                // Get the existing RTS IDs from config (if editing)
                var existingRtsUserGridId = ConfiguringWidget.Config?.RtsUserGridId ?? 0;
                var existingColumnsSetId = ConfiguringWidget.Config?.ColumnsSetId;

                // Build rows filter string from table filters
                var validFilters = ConfigTableFilters.Where(f => !string.IsNullOrEmpty(f.MetricId)).ToList();
                var rowsFilter = BuildRowsFilter(validFilters);

                // Build column inputs for RTS command
                var columnInputs = ConfigAgentColumnDefs.Select((col, idx) => new RtsColumnInput(
                    col.DbColumnId,  // null for new columns
                    col.Name,        // Column display name
                    col.MetricId,
                    idx  // columnsOrder
                )).ToList();

                // Save to RTS tables (use RtsUserGridId from config, not DashboardWidget.GridId)
                var rtsResult = await Mediator.Send(new SaveAgentGridRtsCommand(
                    existingRtsUserGridId,     // 0 for new widget, or existing RTS GridId
                    existingColumnsSetId,      // null for new widget
                    ConfigDisplayName ?? ConfiguringWidget.Name,
                    string.IsNullOrEmpty(ConfigBusinessUnit) ? null : int.TryParse(ConfigBusinessUnit, out var buId) ? buId : null,
                    rowsFilter,
                    columnInputs
                ), _cts.Token);

                // Store RTS GridId for ConfigJson
                rtsUserGridId = rtsResult.GridId;
                columnsSetId = rtsResult.ColumnsSetId;

                // Sync DashboardWidget.GridId with RTSUserGrid_Grid.GridId so that
                // AgentGridWidget's init("u{GridId}") matches the simulator's SQL query.
                preassignedGridId = rtsUserGridId;

                // Update column DbColumnIds from RTS result
                foreach (var (title, dbColumnId) in rtsResult.SavedColumns)
                {
                    var colDef = ConfigAgentColumnDefs.FirstOrDefault(c => c.Name == title);
                    if (colDef != null)
                    {
                        colDef.DbColumnId = dbColumnId;
                    }
                }

                // Notify RTM Service to reload metrics so new columns are included in updateUserGrid
                _ = NotifyRtmLoadDataAsync();
            }
            catch (Exception ex)
            {
                Error = $"RTS save failed: {ex.Message}";
                return;
            }
        }

        // For QueueGrid widgets, save to RTS tables (RTSGrid_*)
        int? queueGridId = null;
        int? headerRowId = null;
        Dictionary<string, int?>? savedHeaderCellIds = null;
        if (IsQueueGridWidget(ConfiguringWidget))
        {
            try
            {
                var existingGridId = ConfiguringWidget.Config?.GridId;
                var existingHeaderRowId = ConfiguringWidget.Config?.HeaderRowId;
                var existingHeaderCellIds = ConfiguringWidget.Config?.HeaderCellIds ?? new Dictionary<string, int?>();

                // Build column inputs (1-based ColumnNumber)
                var columnInputs = ConfigQueueGridColumnDefs.Select((col, idx) => new QueueGridColumnInput(
                    col.Id,
                    col.ColumnId,
                    col.Name,
                    col.MetricId,
                    idx + 1
                )).ToList();

                // Build row inputs (2-based RowNumber, 1 is header)
                var rowInputs = ConfigQueueGridRows.Select((row, idx) => new QueueGridRowInput(
                    row.Id,
                    row.RowId,
                    row.BusinessUnitId,
                    idx + 2,
                    row.CellIds
                )).ToList();

                var rtsResult = await Mediator.Send(new SaveQueueGridRtsCommand(
                    existingGridId,
                    existingHeaderRowId,
                    ConfigDisplayName ?? ConfiguringWidget.Name,
                    columnInputs,
                    rowInputs,
                    existingHeaderCellIds
                ), _cts.Token);

                queueGridId = rtsResult.GridId;
                preassignedGridId = queueGridId;  // Sync dashboard_widgets.GridId with RTSGrid_Grid.GridId
                headerRowId = rtsResult.HeaderRowId;
                savedHeaderCellIds = rtsResult.HeaderCellIds.ToDictionary(kvp => kvp.Key, kvp => (int?)kvp.Value);

                // Update column ColumnIds from result
                foreach (var (localId, dbColumnId) in rtsResult.SavedColumnIds)
                {
                    var colDef = ConfigQueueGridColumnDefs.FirstOrDefault(c => c.Id == localId);
                    if (colDef != null)
                    {
                        colDef.ColumnId = dbColumnId;
                    }
                }

                // Update row RowIds and CellIds from result
                foreach (var (localId, dbRowId) in rtsResult.SavedRowIds)
                {
                    var rowDef = ConfigQueueGridRows.FirstOrDefault(r => r.Id == localId);
                    if (rowDef != null)
                    {

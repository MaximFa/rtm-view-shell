            await LoadAsdGroupsAndStatesAsync();

            // Initialize By Group segment colors from saved config or fallbacks
            EditingGroupSegmentColors = widget.Config.SegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
            EditingDarkGroupSegmentColors = widget.Config.DarkSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();

            // Merge legacy individual color fields into group dictionaries (backward compat)
            MergeLegacyAsdColorsToGroupDict(widget.Config);

            // Ensure all active groups have a color entry
            foreach (var group in _asdGroups.Where(g => g.IsActive))
            {
                if (!EditingGroupSegmentColors.ContainsKey(group.GroupName))
                    EditingGroupSegmentColors[group.GroupName] = AsdGroupFallbackColors.GetValueOrDefault(group.GroupName, "#64748b");
                if (!EditingDarkGroupSegmentColors.ContainsKey(group.GroupName))
                    EditingDarkGroupSegmentColors[group.GroupName] = AsdDarkGroupFallbackColors.GetValueOrDefault(group.GroupName, "#64748b");
            }

            // Initialize By State segment colors from saved config or fallbacks
            EditingStateSegmentColors = widget.Config.StateSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
            EditingDarkStateSegmentColors = widget.Config.DarkStateSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();

            // Ensure all active states have a color entry (cycle palette for unknowns)
            var stateIndex = 0;
            foreach (var state in _asdStates.Where(s => s.IsActive))
            {
                if (!EditingStateSegmentColors.ContainsKey(state.AgentStateName))
                    EditingStateSegmentColors[state.AgentStateName] = StateColorPalette[stateIndex % StateColorPalette.Length];
                if (!EditingDarkStateSegmentColors.ContainsKey(state.AgentStateName))
                    EditingDarkStateSegmentColors[state.AgentStateName] = StateDarkColorPalette[stateIndex % StateDarkColorPalette.Length];
                stateIndex++;
            }

            // Legacy support — also populate EditingSegmentColors for backward compat UI
            await LoadAsdDefinitionsAsync();
            EditingSegmentColors = widget.Config.SegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
            EditingDarkSegmentColors = widget.Config.DarkSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
            MergeLegacyAsdColors(widget.Config);
            foreach (var def in _asdDefinitions)
            {
                if (!EditingSegmentColors.ContainsKey(def.AgentState))
                    EditingSegmentColors[def.AgentState] = AsdFallbackColors.GetValueOrDefault(def.AgentState, "#64748b");
                if (!EditingDarkSegmentColors.ContainsKey(def.AgentState))
                    EditingDarkSegmentColors[def.AgentState] = AsdDarkFallbackColors.GetValueOrDefault(def.AgentState, "#64748b");
            }
            if (!EditingSegmentColors.ContainsKey("Other"))
                EditingSegmentColors["Other"] = AsdFallbackColors["Other"];
            if (!EditingDarkSegmentColors.ContainsKey("Other"))
                EditingDarkSegmentColors["Other"] = AsdDarkFallbackColors["Other"];
        }

        // Initialize search fields with selected values
        BuSearchText = GetBusinessUnitName(ConfigBusinessUnit);
        MetricSearchText = ConfigMetric ?? "";
        BuDropdownOpen = false;
        MetricDropdownOpen = false;
    }

    private List<QueueGridColumnDef> GetDefaultQueueGridColumnDefs()
    {
        // Return default columns for Queue Grid - select first few QM metrics
        var qmMetrics = QueueGridMetrics.Take(5).ToList();
        if (qmMetrics.Count == 0)
        {
            return new List<QueueGridColumnDef>
            {
                new() { Name = "Queue", MetricId = "QueueName", ValueType = "String" },
                new() { Name = "Waiting", MetricId = "QMCallsWaiting", ValueType = "Number" },
                new() { Name = "Available", MetricId = "QMAgentsAvailable", ValueType = "Number" },
                new() { Name = "SLA", MetricId = "QMServiceLevel", ValueType = "Number" }
            };
        }
        return qmMetrics.Select(m => new QueueGridColumnDef
        {
            Name = m.Description ?? m.MetricId,
            MetricId = m.MetricId,
            ValueType = m.ValueType
        }).ToList();
    }


    private async Task SaveWidgetConfig()
    {
        if (ConfiguringWidget is null || Dashboard is null) return;

        int? preassignedGridId = null;
        int? columnsSetId = null;

        // For AgentGrid widgets, save to RTS tables first
        if (IsAgentGridWidget(ConfiguringWidget))
        {
            try
            {
                // Get the existing ColumnsSetId from config (if editing)
                var existingColumnsSetId = ConfiguringWidget.Config?.ColumnsSetId;

                // Build rows filter string from table filters
                var validFilters = ConfigTableFilters.Where(f => !string.IsNullOrEmpty(f.MetricId)).ToList();
                var rowsFilter = BuildRowsFilter(validFilters);

                // Build column inputs for RTS command
                var columnInputs = ConfigAgentColumnDefs.Select((col, idx) => new RtsColumnInput(
                    col.DbColumnId,  // null for new columns
                    col.Name,        // Column display name
                    col.MetricId,
                    idx  // columnsOrder
                )).ToList();

                // Save to RTS tables
                var rtsResult = await Mediator.Send(new SaveAgentGridRtsCommand(
                    ConfiguringWidget.GridId,  // 0 for new widget
                    existingColumnsSetId,      // null for new widget
                    ConfigDisplayName ?? ConfiguringWidget.Name,
                    string.IsNullOrEmpty(ConfigBusinessUnit) ? null : int.TryParse(ConfigBusinessUnit, out var buId) ? buId : null,
                    rowsFilter,
                    columnInputs
                ), _cts.Token);

                // Use GridId from RTS for new widgets
                if (ConfiguringWidget.GridId == 0)
                {
                    preassignedGridId = rtsResult.GridId;
                    ConfiguringWidget.GridId = rtsResult.GridId;
                }

                columnsSetId = rtsResult.ColumnsSetId;

                // Update column DbColumnIds from RTS result
                foreach (var (title, dbColumnId) in rtsResult.SavedColumns)
                {
                    var colDef = ConfigAgentColumnDefs.FirstOrDefault(c => c.Name == title);
                    if (colDef != null)
                    {
                        colDef.DbColumnId = dbColumnId;
                    }
                }
            }
            catch (Exception ex)
            {
                Error = $"RTS save failed: {ex.Message}";
                return;
            }
        }

        var newConfig = new WidgetConfig
        {
            DisplayName = ConfigDisplayName,
            BusinessUnit = ConfigBusinessUnit,
            Metric = ConfigMetric,
            FontSize = ConfigFontSize,
            BackgroundColor = ConfigBackgroundColor,
            FontColor = ConfigFontColor,
            TableBackgroundColor = ConfigTableBackgroundColor,
            Thresholds = ConfigThresholds.Select(t => new ThresholdRule
            {
                From = t.From,
                To = t.To,
                BackgroundColor = t.BackgroundColor,
                FontColor = t.FontColor
            }).ToList(),
            // Agent Grid specific
            AgentGridTeams = ConfigAgentTeams.Count > 0 ? ConfigAgentTeams.ToList() : null,
            AgentGridStates = ConfigAgentStates.Count > 0 ? ConfigAgentStates.ToList() : null,
            AgentGridColumns = ConfigAgentColumns.ToList(),
            AgentGridShowAlerts = ConfigAgentShowAlerts,
            AgentGridColumnNames = ConfigAgentColumnNames.Count > 0 ? ConfigAgentColumnNames : null,
            AgentGridColumnDefs = ConfigAgentColumnDefs.Count > 0 ? ConfigAgentColumnDefs : null,
            // RTS references
            ColumnsSetId = columnsSetId,
            // Column thresholds
            ColumnThresholds = ConfigColumnThresholds.Count > 0
                ? ConfigColumnThresholds.Where(kvp => kvp.Value.Count > 0)
                    .ToDictionary(kvp => kvp.Key, kvp => kvp.Value)
                : null,
            // Table filters (only include rules with non-empty MetricId)
            TableFilters = ConfigTableFilters.Where(f => !string.IsNullOrEmpty(f.MetricId)).ToList() is { Count: > 0 } filters
                ? filters
                : null
        };

        ConfiguringWidget.Config = newConfig;

        // Update widget display name
        if (!string.IsNullOrWhiteSpace(ConfigDisplayName))
        {
            ConfiguringWidget.Name = ConfigDisplayName;
        }

        // Save widget to database
        try
        {
            var widgetDto = new DashboardWidgetDto(
                ConfiguringWidget.Id,
                ConfiguringWidget.GridId,
                Dashboard.Id,
                ConfiguringWidget.CatalogItemId,
                System.Text.Json.JsonSerializer.Serialize(new { ConfiguringWidget.Width, ConfiguringWidget.Height, ConfiguringWidget.X, ConfiguringWidget.Y }, _jsonOptions),
                System.Text.Json.JsonSerializer.Serialize(newConfig, _jsonOptions)
            );

            var gridId = await Mediator.Send(new SaveDashboardWidgetCommand(Dashboard.Id, widgetDto, preassignedGridId), _cts.Token);
            ConfiguringWidget.GridId = gridId;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        CloseWidgetConfig();
        StateHasChanged();
    }


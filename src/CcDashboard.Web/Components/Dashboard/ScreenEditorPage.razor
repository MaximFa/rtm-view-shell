                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio"
                                                   name="asdChartType" id="asdChart_@val"
                                                   checked="@(ConfigAsdChartType == val)"
                                                   @onchange="@(() => ConfigAsdChartType = val)" />

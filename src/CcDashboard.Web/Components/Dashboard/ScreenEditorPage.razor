            DarkColorPaperwork = IsAgentStateDistributionWidget(ConfiguringWidget) ? ConfigAsdDarkColorPaperwork : null,
            DarkColorTraining = IsAgentStateDistributionWidget(ConfiguringWidget) ? ConfigAsdDarkColorTraining : null,

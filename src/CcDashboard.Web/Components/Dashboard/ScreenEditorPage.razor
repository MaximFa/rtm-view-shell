    // Column threshold management
    private List<ColumnThreshold> GetColumnThresholds(string column)
    {
        if (!ConfigColumnThresholds.TryGetValue(column, out var thresholds))
        {
            thresholds = new List<ColumnThreshold>();
            ConfigColumnThresholds[column] = thresholds;
        }
        return thresholds;
    }

    private void AddColThreshold(string column)
    {
        var thresholds = GetColumnThresholds(column);
        var isNumeric = NumericColumns.Contains(column);
        thresholds.Add(new ColumnThreshold
        {
            MatchType = isNumeric ? "numeric" : "text",
            From = isNumeric ? 0 : null,
            To = isNumeric ? 100 : null,
            TextMatch = isNumeric ? null : "",
            BackgroundColor = "#DFFBE6",
            FontColor = "#0A5D1E"
        });
    }

    private void RemoveColThreshold(string column, int index)
    {
        if (ConfigColumnThresholds.TryGetValue(column, out var thresholds) && index >= 0 && index < thresholds.Count)
            thresholds.RemoveAt(index);
    }


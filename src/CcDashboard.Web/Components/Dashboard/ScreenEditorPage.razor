                                        <input type="checkbox" class="form-check-input" id="dayTrendShowLabels" @bind="ConfigDayTrendShowDataLabels" />
                                        <label class="form-check-label" for="dayTrendShowLabels">@L["Widget_DayTrend_ShowDataLabels"]</label>

    private void OpenWidgetConfig(PlacedWidget widget)
    {
        Console.WriteLine($"[DEBUG] OpenWidgetConfig called for widget: {widget.Name}");
        ConfiguringWidget = widget;
        ConfigDisplayName = widget.Config.DisplayName ?? widget.Name;
        ConfigBusinessUnit = widget.Config.BusinessUnit;
        ConfigMetric = widget.Config.Metric;
        ConfigFontSize = widget.Config.FontSize ?? "normal";
        ConfigBackgroundColor = widget.Config.BackgroundColor ?? "#FFFFFF";
        ConfigFontColor = widget.Config.FontColor ?? "#202124";
        ConfigTableBackgroundColor = widget.Config.TableBackgroundColor ?? "transparent";
        ConfigThresholds = widget.Config.Thresholds?.Select(t => new ThresholdRule
        {
            From = t.From,
            To = t.To,
            BackgroundColor = t.BackgroundColor,
            FontColor = t.FontColor
        }).ToList() ?? [];

        // Agent Grid specific
        ConfigAgentTeams = widget.Config.AgentGridTeams?.ToHashSet() ?? new HashSet<string>();
        ConfigAgentStates = widget.Config.AgentGridStates?.ToHashSet() ?? new HashSet<string>();
        ConfigAgentColumns = widget.Config.AgentGridColumns?.ToHashSet() ?? new HashSet<string> { "agent", "state", "duration", "occupancy", "adherence" };
        ConfigAgentShowAlerts = widget.Config.AgentGridShowAlerts;

        // Column thresholds
        Console.WriteLine($"[DEBUG] OpenWidgetConfig: widget.Config.ColumnThresholds = {(widget.Config.ColumnThresholds == null ? "null" : widget.Config.ColumnThresholds.Count.ToString())}");
        if (widget.Config.ColumnThresholds != null)
        {
            foreach (var kvp in widget.Config.ColumnThresholds)
            {
                Console.WriteLine($"[DEBUG]   Column '{kvp.Key}': {kvp.Value.Count} rules");
            }
        }
        ConfigColumnThresholds = widget.Config.ColumnThresholds != null
            ? widget.Config.ColumnThresholds.ToDictionary(
                kvp => kvp.Key,
                kvp => kvp.Value.Select(t => new ColumnThreshold
                {
                    MatchType = t.MatchType,
                    From = t.From,
                    To = t.To,
                    TextMatch = t.TextMatch,
                    TextTo = t.TextTo,
                    TextMatchType = t.TextMatchType,
                    BackgroundColor = t.BackgroundColor,
                    FontColor = t.FontColor
                }).ToList())
            : new Dictionary<string, List<ColumnThreshold>>();
        Console.WriteLine($"[DEBUG] OpenWidgetConfig: ConfigColumnThresholds = {ConfigColumnThresholds.Count}");
        SelectedThresholdColumn = "";

        // Initialize search fields with selected values
        BuSearchText = GetBusinessUnitName(ConfigBusinessUnit);
        MetricSearchText = ConfigMetric ?? "";
        BuDropdownOpen = false;
        MetricDropdownOpen = false;
    }


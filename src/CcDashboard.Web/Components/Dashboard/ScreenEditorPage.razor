    private void SelectTableBackgroundColor(string color)
    {
        ConfigTableBackgroundColor = color;
        _openColorPalette = null;
    }

    private static string GetColorName(string colorValue, (string Name, string Value)[] colors)
    {
        var color = colors.FirstOrDefault(c => c.Value == colorValue);
        return color.Name ?? colorValue;
    }

    private static string GetWidgetIcon(string widgetName)
    {
        var n = widgetName.ToLower();
        if (n.Contains("queue")) return "bi-people-fill";
        if (n.Contains("agent")) return "bi-person-badge";
        if (n.Contains("kpi") || n.Contains("scorecard")) return "bi-speedometer2";
        if (n.Contains("chart") || n.Contains("trend")) return "bi-graph-up";
        if (n.Contains("call")) return "bi-telephone";
        if (n.Contains("sla")) return "bi-bullseye";
        return "bi-grid-3x3";
    }

    private static (int Width, int Height, int X, int Y) ParseWidgetDimensions(string? positionJson)
    {
        if (string.IsNullOrEmpty(positionJson)) return (280, 200, 0, 0);
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var pos = System.Text.Json.JsonSerializer.Deserialize<PositionData>(positionJson, options);
            return (pos?.Width ?? 280, pos?.Height ?? 200, pos?.X ?? 0, pos?.Y ?? 0);
        }
        catch { }
        return (280, 200, 0, 0);
    }

    private class PositionData
    {
        public int Width { get; set; } = 280;
        public int Height { get; set; } = 200;
        public int X { get; set; }
        public int Y { get; set; }
    }

    private static readonly System.Text.Json.JsonSerializerOptions _jsonOptions = new()
    {
        PropertyNameCaseInsensitive = true,
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };

    private static WidgetConfig ParseWidgetConfig(string? configJson)
    {
        if (string.IsNullOrEmpty(configJson)) return new WidgetConfig();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<WidgetConfig>(configJson, _jsonOptions) ?? new WidgetConfig();
        }
        catch { return new WidgetConfig(); }
    }

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _dotNetRef?.Dispose();
        _ = JS.InvokeVoidAsync("widgetResize.dispose");
    }

    // Inner classes
    public class PlacedWidget
    {
        public Guid Id { get; set; }
        public int GridId { get; set; }  // Auto-incremented DB field for SignalR communication
        public Guid CatalogItemId { get; set; }
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public int Width { get; set; } = 280;
        public int Height { get; set; } = 200;
        public int X { get; set; } = 0;
        public int Y { get; set; } = 0;
        public WidgetConfig Config { get; set; } = new();
    }

    public class WidgetConfig
    {
        public string? DisplayName { get; set; }
        public string? BusinessUnit { get; set; }
        public string? Metric { get; set; }
        public string? FontSize { get; set; }
        public string? BackgroundColor { get; set; }
        public string? FontColor { get; set; }
        public string? TableBackgroundColor { get; set; }  // Background for the data table
        public List<ThresholdRule>? Thresholds { get; set; }

        // Agent Grid specific
        public List<string>? AgentGridTeams { get; set; }
        public List<string>? AgentGridStates { get; set; }
        public List<string>? AgentGridColumns { get; set; }  // Legacy - kept for backward compatibility
        public bool AgentGridShowAlerts { get; set; } = true;
        public Dictionary<string, string>? AgentGridColumnNames { get; set; }  // Legacy - kept for backward compatibility
        public List<AgentGridColumnDef>? AgentGridColumnDefs { get; set; }  // New column definitions

        // Per-column thresholds: key = column name, value = list of rules
        public Dictionary<string, List<ColumnThreshold>>? ColumnThresholds { get; set; }

        // Saved row filters applied before display
        public List<TableFilterRule>? TableFilters { get; set; }

        // RTS table IDs (persisted after first save)
        public int? ColumnsSetId { get; set; }
    }

    public class AgentGridColumnDef
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();  // Unique ID for reordering
        public string Name { get; set; } = "";  // Display name
        public string MetricId { get; set; } = "";  // Reference to RtsGridMetric.MetricId
        public int? DbColumnId { get; set; }  // RTSUserGrid_Column.ColumnId, null if not yet inserted
    }

    public class ThresholdRule
    {
        [System.Text.Json.Serialization.JsonConverter(typeof(StringOrNumberConverter))]
        public string? From { get; set; }
        [System.Text.Json.Serialization.JsonConverter(typeof(StringOrNumberConverter))]
        public string? To { get; set; }
        public string? BackgroundColor { get; set; }
        public string? FontColor { get; set; }
    }

    public class ColumnThreshold
    {
        public string MatchType { get; set; } = "numeric"; // "numeric" or "text"
        [System.Text.Json.Serialization.JsonConverter(typeof(StringOrNumberConverter))]
        public string? From { get; set; }
        [System.Text.Json.Serialization.JsonConverter(typeof(StringOrNumberConverter))]
        public string? To { get; set; }
        public string? TextMatch { get; set; }  // Text "From" value
        public string? TextTo { get; set; }     // Text "To" value (optional)
        public string TextMatchType { get; set; } = "equal"; // "equal", "contains", "startswith", "endswith"
        public string? BackgroundColor { get; set; }       // Badge background
        public string? FontColor { get; set; }             // Badge font color
    }

    public class TableFilterRule
    {
        public string MetricId { get; set; } = "";  // References AgentGridColumnDef.MetricId
        public string Operator { get; set; } = "contains";  // MatchType strings: contains, equal, greater, etc.
        public string Value { get; set; } = "";  // Filter value as text
        public string Connector { get; set; } = "AND";  // "AND" or "OR" — logical connector before this rule
    }

    public class StringOrNumberConverter : System.Text.Json.Serialization.JsonConverter<string?>
    {
        public override string? Read(ref System.Text.Json.Utf8JsonReader reader, Type typeToConvert, System.Text.Json.JsonSerializerOptions options)
        {
            return reader.TokenType switch
            {
                System.Text.Json.JsonTokenType.String => reader.GetString(),
                System.Text.Json.JsonTokenType.Number => reader.TryGetInt64(out var l) ? l.ToString() : reader.GetDecimal().ToString(),
                System.Text.Json.JsonTokenType.Null => null,
                _ => null
            };
        }

        public override void Write(System.Text.Json.Utf8JsonWriter writer, string? value, System.Text.Json.JsonSerializerOptions options)
        {
            if (value == null)
                writer.WriteNullValue();
            else
                writer.WriteStringValue(value);
        }
    }

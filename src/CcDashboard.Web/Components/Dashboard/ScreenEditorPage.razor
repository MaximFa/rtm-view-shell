            DayTrendIntervalMinutes = ConfigDayTrendIntervalMinutes,
            DayTrendRefreshIntervalSeconds = ConfigDayTrendRefreshIntervalSeconds,
            DayTrendChartType = ConfigDayTrendChartType,
            DayTrendShowDataLabels = ConfigDayTrendShowDataLabels,
            DayTrendShowLegend = ConfigDayTrendShowLegend,
            DayTrendMetrics = ConfigDayTrendMetrics.Count > 0 ? ConfigDayTrendMetrics : null,
            DayTrendAgentMetrics = ConfigDayTrendAgentMetrics.Count > 0 ? ConfigDayTrendAgentMetrics : null,
            // Agent State Distribution specific
            ChartType = IsAgentStateDistributionWidget(ConfiguringWidget) ? ConfigAsdChartType : null,
            ValueDisplay = IsAgentStateDistributionWidget(ConfiguringWidget) ? ConfigAsdValueDisplay : null,
            ShowLegend = ConfigAsdShowLegend,
            ShowValueLabels = ConfigAsdShowValueLabels,
            // CC-009: Dual-mode
            DistributionMode = IsAgentStateDistributionWidget(ConfiguringWidget) ? ConfigAsdDistributionMode : null,
            GroupGridId = IsAgentStateDistributionWidget(ConfiguringWidget) ? _asdGroupGridId : null,
            StateGridId = IsAgentStateDistributionWidget(ConfiguringWidget) ? _asdStateGridId : null,
            GroupColumnMetricIds = IsAgentStateDistributionWidget(ConfiguringWidget) && _asdGroupColumnMetricIds.Count > 0

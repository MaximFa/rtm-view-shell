    // Column threshold management
    private bool IsNumericMetric(string metricId)
    {
        // Check ValueType from the metric definition in database
        var metric = Metrics.FirstOrDefault(m => m.MetricId == metricId);
        if (metric != null && !string.IsNullOrEmpty(metric.ValueType))
        {
            return metric.ValueType == "Number" || metric.ValueType == "Time";
        }
        // Fallback to pattern matching if metric not found
        if (string.IsNullOrEmpty(metricId)) return false;
        var id = metricId.ToLowerInvariant();
        return id.Contains("duration") || id.Contains("occupancy") || id.Contains("adherence") ||
               id.Contains("calls") || id.Contains("aht") || id.Contains("time") || id.Contains("percent") ||
               id.Contains("pct") || id.Contains("total") || id.Contains("avg") || id.Contains("count");
    }

    private List<ColumnThreshold> GetColumnThresholds(string column)
    {
        if (!ConfigColumnThresholds.TryGetValue(column, out var thresholds))
        {

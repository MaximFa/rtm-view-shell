    private void ConfirmDeleteWidget()
    {
        if (WidgetToDelete is null) return;

        // Mark widget for RTS deletion (will be deleted on Save)
        if ((IsAgentGridWidget(WidgetToDelete) && WidgetToDelete.Config?.RtsUserGridId > 0) ||
            (IsQueueGridWidget(WidgetToDelete) && WidgetToDelete.Config?.GridId > 0) ||
            (IsDataSlotWidget(WidgetToDelete) && WidgetToDelete.Config?.DataSlotGridId > 0) ||
            (IsAgentStateDistributionWidget(WidgetToDelete) && (WidgetToDelete.Config?.GroupGridId > 0 || WidgetToDelete.Config?.StateGridId > 0 || WidgetToDelete.Config?.GridId > 0)))
        {
            WidgetsPendingRtsDeletion.Add(WidgetToDelete);
        }

        // Remove from UI immediately
        PlacedWidgets.RemoveAll(w => w.Id == WidgetToDelete.Id);
        if (SelectedWidgetId == WidgetToDelete.Id) SelectedWidgetId = null;

        WidgetToDelete = null;
    }


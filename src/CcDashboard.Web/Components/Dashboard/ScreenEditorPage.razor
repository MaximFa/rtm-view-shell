        {
            ("Gold (Default)", "#ffc107"),
            ("Green", "#28a745"),
            ("Blue", "#007bff"),
            ("Orange", "#fd7e14"),
            ("Red", "#dc3545"),
            ("Purple", "#6f42c1")

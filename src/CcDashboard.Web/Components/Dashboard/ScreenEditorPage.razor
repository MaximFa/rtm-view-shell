    private void RemoveColumnDef(string id)
    {
        // Get the MetricId before removing
        var col = ConfigAgentColumnDefs.FirstOrDefault(c => c.Id == id);
        var metricId = col?.MetricId;

        // Remove the column
        ConfigAgentColumnDefs.RemoveAll(c => c.Id == id);

        // Cleanup related data if MetricId was set
        if (!string.IsNullOrEmpty(metricId))
        {
            // Remove thresholds for this column
            ConfigColumnThresholds.Remove(metricId);

            // Remove score formula rules referencing this column
            ConfigScoreFormula.RemoveAll(r => r.MetricId == metricId);

            // Remove table filters referencing this column
            ConfigTableFilters.RemoveAll(f => f.MetricId == metricId);
        }
    }

    private void MoveColumnDef(string id, int direction)
    {
        var index = ConfigAgentColumnDefs.FindIndex(c => c.Id == id);
        if (index < 0) return;

        var newIndex = index + direction;
        if (newIndex < 0 || newIndex >= ConfigAgentColumnDefs.Count) return;

        var item = ConfigAgentColumnDefs[index];
        ConfigAgentColumnDefs.RemoveAt(index);
        ConfigAgentColumnDefs.Insert(newIndex, item);
    }


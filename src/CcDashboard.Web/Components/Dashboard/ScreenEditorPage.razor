                                               name="asdValueDisplay" id="asdValNum"
                                               checked="@(ConfigAsdValueDisplay == "numbers")"
                                               @onchange="@(() => ConfigAsdValueDisplay = "numbers")" />
                                        <label class="form-check-label" for="asdValNum">@L["Widget_ASD_ValueDisplay_Numbers"]</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Show Legend + Show Value Labels checkboxes -->
                            <div class="mb-3 d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           id="asdShowLegend" @bind="ConfigAsdShowLegend" />
                                    <label class="form-check-label" for="asdShowLegend">@L["Widget_ASD_ShowLegend"]</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           id="asdShowValueLabels" @bind="ConfigAsdShowValueLabels" />
                                    <label class="form-check-label" for="asdShowValueLabels">@L["Widget_ASD_ShowValueLabels"]</label>
                                </div>

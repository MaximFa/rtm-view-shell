                                        <i class="bi bi-graph-up"></i> @L["Widget_DayTrend_Line"]
                                    </label>

                                    <input type="radio" class="btn-check" name="chartType" id="chartBar"
                                           checked="@(ConfigDayTrendChartType == "bar")"
                                           @onchange="@(() => SetDayTrendChartType("bar"))" />
                                    <label class="btn btn-outline-primary" for="chartBar">
                                        <i class="bi bi-bar-chart"></i> @L["Widget_DayTrend_Bar"]
                                    </label>

                                    <input type="radio" class="btn-check" name="chartType" id="chartArea"
                                           checked="@(ConfigDayTrendChartType == "area")"
                                           @onchange="@(() => SetDayTrendChartType("area"))" />
                                    <label class="btn btn-outline-primary" for="chartArea">
                                        <i class="bi bi-graph-down"></i> @L["Widget_DayTrend_Area"]
                                    </label>

                                    <input type="radio" class="btn-check" name="chartType" id="chartStep"
                                           checked="@(ConfigDayTrendChartType == "step")"
                                           @onchange="@(() => SetDayTrendChartType("step"))" />

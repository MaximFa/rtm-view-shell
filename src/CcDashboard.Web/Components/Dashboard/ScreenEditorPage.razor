    private bool IsNumericMetricForFilter(string metricId)
    {
        if (string.IsNullOrEmpty(metricId)) return false;
        // Check ValueType from database
        var metric = Metrics.FirstOrDefault(m => m.MetricId == metricId);
        if (metric != null && !string.IsNullOrEmpty(metric.ValueType))
        {
            return metric.ValueType == "Number" || metric.ValueType == "Time";
        }
        // Fallback to pattern matching if metric not found in database
        if (metricId.Contains("Name", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Extension", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("State", StringComparison.OrdinalIgnoreCase) &&
            !metricId.Contains("Duration", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Duration", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Time", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Pct", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Num", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private IEnumerable<(string Value, string Label)> GetOperatorsForMetric(string metricId)
    {
        if (IsNumericMetricForFilter(metricId))
        {
            return new[]
            {
                ("greater", "> Greater than"),
                ("greaterequal", ">= Greater or equal"),
                ("less", "< Less than"),
                ("lessequal", "<= Less or equal"),
                ("equal", "= Equal"),
                ("notequal", "!= Not equal"),
                ("empty", "Is empty"),
                ("notempty", "Is not empty")
            };
        }
        else
        {
            return new[]
            {
                ("contains", "Contains"),
                ("notcontains", "Does not contain"),
                ("equal", "Equals"),
                ("notequal", "Not equals"),
                ("startswith", "Starts with"),
                ("endswith", "Ends with"),
                ("empty", "Is empty"),
                ("notempty", "Is not empty")
            };
        }
    }

    private string? BuildRowsFilter(List<TableFilterRule> filters)
    {
        if (filters.Count == 0) return null;

        var parts = new List<string>();
        for (int i = 0; i < filters.Count; i++)
        {
            var f = filters[i];
            if (string.IsNullOrEmpty(f.MetricId)) continue;

            // Build filter expression: [MetricId] == "Value" or [MetricId] > 123
            var expr = BuildFilterExpression(f.MetricId, f.Operator, f.Value ?? string.Empty);
            if (!string.IsNullOrEmpty(expr))
            {
                parts.Add(expr);

                // Add connector if not the last filter
                if (i < filters.Count - 1 && !string.IsNullOrEmpty(f.Connector))
                {
                    parts.Add(f.Connector.ToUpperInvariant() == "OR" ? "||" : "&&");
                }
            }
        }

        return parts.Count > 0 ? string.Join(string.Empty, parts) : null;
    }

    private string? BuildFilterExpression(string metricId, string op, string value)
    {
        var isNumeric = IsNumericMetricForFilter(metricId);
        var fieldRef = $"[{metricId}]";

        // Format value: quoted for text, unquoted for numeric
        string formattedValue = isNumeric ? value : $"\"{value}\"";

        return op switch
        {
            "equal" => $"{fieldRef} == {formattedValue}",
            "notequal" => $"{fieldRef} != {formattedValue}",
            "greater" => $"{fieldRef} > {value}",
            "greaterequal" => $"{fieldRef} >= {value}",
            "less" => $"{fieldRef} < {value}",
            "lessequal" => $"{fieldRef} <= {value}",
            "contains" => $"{fieldRef}.Contains(\"{value}\")",
            "notcontains" => $"!{fieldRef}.Contains(\"{value}\")",
            "startswith" => $"{fieldRef}.StartsWith(\"{value}\")",
            "endswith" => $"{fieldRef}.EndsWith(\"{value}\")",
            "empty" => $"string.IsNullOrEmpty({fieldRef})",
            "notempty" => $"!string.IsNullOrEmpty({fieldRef})",
            _ => null
        };
    }

    private async Task SaveLayout()
    {
        if (Dashboard is null) return;
        Saving = true;
        Error = null;

        try
        {
            // Save dashboard settings (name, dark mode, etc.)
            var name = string.IsNullOrWhiteSpace(EditName) ? Dashboard.Name : EditName.Trim();
            await Mediator.Send(new UpdateDashboardCommand(
                new UpdateDashboardRequest(Dashboard.Id, name, Dashboard.Description,
                    Dashboard.CategoryId, Dashboard.Status, Dashboard.IsPublic, _darkMode, Dashboard.RowVersion)), _cts.Token);

            // Save widgets
            var widgetDtos = PlacedWidgets.Select(w => new DashboardWidgetDto(
                w.Id,
                w.GridId,  // Auto-incremented by DB for new widgets (GridId = 0)
                Dashboard.Id,
                w.CatalogItemId,
                System.Text.Json.JsonSerializer.Serialize(new { w.Width, w.Height, w.X, w.Y }, _jsonOptions),
                System.Text.Json.JsonSerializer.Serialize(w.Config, _jsonOptions)
            )).ToList();

            await Mediator.Send(new UpdateDashboardWidgetsCommand(Dashboard.Id, widgetDtos), _cts.Token);

            // Delete RTS data for widgets that were removed
            foreach (var widget in WidgetsPendingRtsDeletion)
            {
                if (IsAgentGridWidget(widget) && widget.Config?.RtsUserGridId > 0)
                {
                    await Mediator.Send(new DeleteAgentGridRtsCommand(widget.Config.RtsUserGridId.Value), _cts.Token);
                }
                else if (IsQueueGridWidget(widget) && widget.Config?.GridId > 0)
                {
                    await Mediator.Send(new DeleteQueueGridRtsCommand(widget.Config.GridId.Value), _cts.Token);
                }
                else if (IsDataSlotWidget(widget) && widget.Config?.DataSlotGridId > 0)
                {
                    // Data Slot uses same RTSGrid_* tables as Queue Grid
                    await Mediator.Send(new DeleteQueueGridRtsCommand(widget.Config.DataSlotGridId.Value), _cts.Token);
                }
                else if (IsAgentStateDistributionWidget(widget))
                {
                    // ASD dual-mode (CC-009): delete both GroupGridId and StateGridId
                    if (widget.Config?.GroupGridId > 0)
                        await Mediator.Send(new DeleteQueueGridRtsCommand(widget.Config.GroupGridId.Value), _cts.Token);
                    if (widget.Config?.StateGridId > 0)
                        await Mediator.Send(new DeleteQueueGridRtsCommand(widget.Config.StateGridId.Value), _cts.Token);
                    // Backward compat: legacy single GridId (CC-008)
                    if (widget.Config?.GridId > 0 && widget.Config?.GroupGridId is null && widget.Config?.StateGridId is null)
                        await Mediator.Send(new DeleteQueueGridRtsCommand(widget.Config.GridId.Value), _cts.Token);
                }
            }
            WidgetsPendingRtsDeletion.Clear();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task NotifyRtmLoadDataAsync()
    {
        try
        {
            if (Dashboard?.TenantId == null) return;

            var settings = await Mediator.Send(new GetTenantSettingsQuery(Dashboard.TenantId), _cts.Token);
            if (string.IsNullOrEmpty(settings?.SignalRConnectionUrl)) return;

            // Build base URL from SignalR URL (strip /signalr suffix if present)
            var baseUrl = settings.SignalRConnectionUrl.TrimEnd('/');
            if (baseUrl.EndsWith("/signalr", StringComparison.OrdinalIgnoreCase))
                baseUrl = baseUrl[..^8];

            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(5) };
            await http.GetAsync($"{baseUrl}/LoadData");
        }
        catch
        {
            // RTM reload failed - non-critical, widget will show data after RTM restart
        }
    }

    private async Task CloneScreen()
    {
        if (Dashboard is null) return;
        Cloning = true;
        Error = null;

        try
        {
            // First save current changes
            await SaveLayout();

            // Clone the dashboard
            var newDashboardId = await Mediator.Send(
                new CloneDashboardCommand(Dashboard.Id, $"Copy of {Dashboard.Name}"), _cts.Token);

            // Navigate to the cloned dashboard
            Nav.NavigateTo($"/screens/{newDashboardId}/edit");
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Cloning = false;
        }
    }


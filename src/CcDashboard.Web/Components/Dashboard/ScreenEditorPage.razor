            var gridId = await Mediator.Send(new SaveDashboardWidgetCommand(Dashboard.Id, widgetDto, preassignedGridId), _cts.Token);
            ConfiguringWidget.GridId = gridId;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }

        CloseWidgetConfig();
        StateHasChanged();
        }
        finally
        {
            _configSaving = false;
            StateHasChanged();
        }
    }


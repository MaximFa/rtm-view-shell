    private void OnDataSlotTargetInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString()?.Trim() ?? "";
        _dataSlotTargetText = text;

        if (string.IsNullOrWhiteSpace(text))
        {
            ConfigDataSlotTarget = null;
            _dataSlotTargetError = null;
            return;
        }

        // Try parse as time format HH:MM:SS or MM:SS
        if (TryParseTimeFormat(text, out var seconds))
        {
            ConfigDataSlotTarget = seconds;
            _dataSlotTargetError = null;
            return;
        }

        // Replace comma with dot for decimal parsing
        var normalized = text.Replace(",", ".");
        if (decimal.TryParse(normalized, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var value))
        {
            ConfigDataSlotTarget = value;
            _dataSlotTargetError = null;
        }
        else
        {
            ConfigDataSlotTarget = null;
            _dataSlotTargetError = L["Widget_InvalidFormat"];
        }
    }

    private static bool TryParseTimeFormat(string text, out decimal seconds)
    {
        seconds = 0;
        var parts = text.Split(':');

        if (parts.Length == 2)
        {
            // MM:SS format
            if (int.TryParse(parts[0], out var minutes) && int.TryParse(parts[1], out var secs)
                && minutes >= 0 && secs >= 0 && secs < 60)
            {
                seconds = minutes * 60 + secs;
                return true;
            }
        }
        else if (parts.Length == 3)
        {
            // HH:MM:SS format
            if (int.TryParse(parts[0], out var hours) && int.TryParse(parts[1], out var minutes) && int.TryParse(parts[2], out var secs)
                && hours >= 0 && minutes >= 0 && minutes < 60 && secs >= 0 && secs < 60)
            {
                seconds = hours * 3600 + minutes * 60 + secs;
                return true;
            }
        }

        return false;
    }


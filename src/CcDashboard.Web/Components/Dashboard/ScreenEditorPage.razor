    private static bool IsNumericMetricForFilter(string metricId)
    {
        if (string.IsNullOrEmpty(metricId)) return false;
        // Pattern-based detection (same logic as AgentGridWidget)
        if (metricId.Contains("Name", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Extension", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("State", StringComparison.OrdinalIgnoreCase) &&
            !metricId.Contains("Duration", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Queue", StringComparison.OrdinalIgnoreCase) &&
            !metricId.Contains("Duration", StringComparison.OrdinalIgnoreCase)) return false;

        if (metricId.Contains("Duration", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Time", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Occupancy", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Adherence", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Calls", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("AHT", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Pct", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Avg", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Number", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Num", StringComparison.OrdinalIgnoreCase)) return true;

        return false;
    }

    private static IEnumerable<(string Value, string Label)> GetOperatorsForMetric(string metricId)
    {
        if (IsNumericMetricForFilter(metricId))
        {
            return new[]
            {
                ("greater", "> Greater than"),
                ("greaterequal", ">= Greater or equal"),
                ("less", "< Less than"),
                ("lessequal", "<= Less or equal"),
                ("equal", "= Equal"),
                ("notequal", "!= Not equal"),
                ("empty", "Is empty"),
                ("notempty", "Is not empty")
            };
        }
        else
        {
            return new[]
            {
                ("contains", "Contains"),
                ("notcontains", "Does not contain"),
                ("equal", "Equals"),
                ("notequal", "Not equals"),
                ("startswith", "Starts with"),
                ("endswith", "Ends with"),
                ("empty", "Is empty"),
                ("notempty", "Is not empty")
            };
        }
    }

    private string? BuildRowsFilter(List<TableFilterRule> filters)
    {
        if (filters.Count == 0) return null;

        var parts = new List<string>();
        for (int i = 0; i < filters.Count; i++)
        {
            var f = filters[i];
            if (string.IsNullOrEmpty(f.MetricId)) continue;

            // Build filter expression: [MetricId] == "Value" or [MetricId] > 123
            var expr = BuildFilterExpression(f.MetricId, f.Operator, f.Value ?? string.Empty);
            if (!string.IsNullOrEmpty(expr))
            {
                parts.Add(expr);

                // Add connector if not the last filter
                if (i < filters.Count - 1 && !string.IsNullOrEmpty(f.Connector))
                {
                    parts.Add(f.Connector.ToUpperInvariant() == "OR" ? "||" : "&&");
                }
            }
        }

        return parts.Count > 0 ? string.Join(string.Empty, parts) : null;
    }

    private string? BuildFilterExpression(string metricId, string op, string value)
    {
        var isNumeric = IsNumericMetricForFilter(metricId);
        var fieldRef = $"[{metricId}]";

        // Format value: quoted for text, unquoted for numeric
        string formattedValue = isNumeric ? value : $"\"{value}\"";

        return op switch
        {
            "equal" => $"{fieldRef} == {formattedValue}",
            "notequal" => $"{fieldRef} != {formattedValue}",
            "greater" => $"{fieldRef} > {value}",
            "greaterequal" => $"{fieldRef} >= {value}",
            "less" => $"{fieldRef} < {value}",
            "lessequal" => $"{fieldRef} <= {value}",
            "contains" => $"{fieldRef}.Contains(\"{value}\")",
            "notcontains" => $"!{fieldRef}.Contains(\"{value}\")",
            "startswith" => $"{fieldRef}.StartsWith(\"{value}\")",
            "endswith" => $"{fieldRef}.EndsWith(\"{value}\")",
            "empty" => $"string.IsNullOrEmpty({fieldRef})",
            "notempty" => $"!string.IsNullOrEmpty({fieldRef})",
            _ => null
        };
    }

    private async Task SaveLayout()
    {
        if (Dashboard is null) return;
        Saving = true;
        Error = null;

        try
        {
            // Save dashboard settings (name, dark mode, etc.)
            var name = string.IsNullOrWhiteSpace(EditName) ? Dashboard.Name : EditName.Trim();
            await Mediator.Send(new UpdateDashboardCommand(
                new UpdateDashboardRequest(Dashboard.Id, name, Dashboard.Description,
                    Dashboard.CategoryId, Dashboard.Status, Dashboard.IsPublic, _darkMode, Dashboard.RowVersion)), _cts.Token);

            // Save widgets
            var widgetDtos = PlacedWidgets.Select(w => new DashboardWidgetDto(
                w.Id,
                w.GridId,  // Auto-incremented by DB for new widgets (GridId = 0)
                Dashboard.Id,
                w.CatalogItemId,
                System.Text.Json.JsonSerializer.Serialize(new { w.Width, w.Height, w.X, w.Y }, _jsonOptions),
                System.Text.Json.JsonSerializer.Serialize(w.Config, _jsonOptions)
            )).ToList();

            await Mediator.Send(new UpdateDashboardWidgetsCommand(Dashboard.Id, widgetDtos), _cts.Token);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private void PreviewDashboard()
    {
        Nav.NavigateTo($"/screens/{Id}");
    }

    private async Task PublishDashboard()
    {
        if (Dashboard is null) return;
        Saving = true;
        Error = null;
        try
        {
            await Mediator.Send(new UpdateDashboardCommand(
                new UpdateDashboardRequest(Dashboard.Id, Dashboard.Name, Dashboard.Description,
                    Dashboard.CategoryId, DashboardStatus.Published, Dashboard.IsPublic, _darkMode, Dashboard.RowVersion)), _cts.Token);
            Dashboard = await Mediator.Send(new GetDashboardByIdQuery(Id), _cts.Token);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private async Task UnpublishDashboard()
    {
        if (Dashboard is null) return;
        Saving = true;
        Error = null;
        try
        {
            await Mediator.Send(new UpdateDashboardCommand(
                new UpdateDashboardRequest(Dashboard.Id, Dashboard.Name, Dashboard.Description,
                    Dashboard.CategoryId, DashboardStatus.Draft, Dashboard.IsPublic, _darkMode, Dashboard.RowVersion)), _cts.Token);
            Dashboard = await Mediator.Send(new GetDashboardByIdQuery(Id), _cts.Token);
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Saving = false;
        }
    }

    private static string GetColorStyle(string colorValue)
    {
        return $"background: {colorValue} !important; background-color: {colorValue} !important;";
    }

    private void ToggleBgColorPalette() => _openColorPalette = _openColorPalette == "bg" ? null : "bg";
    private void ToggleFontColorPalette() => _openColorPalette = _openColorPalette == "font" ? null : "font";
    private void ToggleTableColorPalette() => _openColorPalette = _openColorPalette == "table" ? null : "table";
    private void CloseColorPalette() => _openColorPalette = null;


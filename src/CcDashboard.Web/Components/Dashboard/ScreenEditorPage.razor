                                    @foreach (var (val, key) in new[] {
                                        ("doughnut","Widget_ASD_ChartType_Donut"),
                                        ("pie","Widget_ASD_ChartType_Pie"),
                                        ("bar","Widget_ASD_ChartType_Bar"),
                                        ("horizontalbar","Widget_ASD_ChartType_HorizontalBar") })

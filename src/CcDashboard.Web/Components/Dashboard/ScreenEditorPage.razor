                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="asdValueDisplay" id="asdValPct"
                                               checked="@(ConfigAsdValueDisplay == "percentages")"
                                               @onchange="@(() => ConfigAsdValueDisplay = "percentages")" />
                                        <label class="form-check-label" for="asdValPct">@L["Widget_ASD_ValueDisplay_Percentages"]</label>
                                    </div>
                                    <div class="form-check">

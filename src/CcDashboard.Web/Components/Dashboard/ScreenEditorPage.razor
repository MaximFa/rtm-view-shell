    private static string GetWidgetIcon(string widgetName)
    {
        var n = widgetName.ToLower();
        if (n.Contains("queue")) return "bi-people-fill";
        if (n.Contains("agent")) return "bi-person-badge";
        if (n.Contains("kpi") || n.Contains("scorecard")) return "bi-speedometer2";
        if (n.Contains("chart") || n.Contains("trend")) return "bi-graph-up";
        if (n.Contains("call")) return "bi-telephone";
        if (n.Contains("sla")) return "bi-bullseye";
        return "bi-grid-3x3";
    }

    private static (int Width, int Height, int X, int Y) ParseWidgetDimensions(string? positionJson)
    {
        if (string.IsNullOrEmpty(positionJson)) return (280, 200, 0, 0);
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var pos = System.Text.Json.JsonSerializer.Deserialize<PositionData>(positionJson, options);
            return (pos?.Width ?? 280, pos?.Height ?? 200, pos?.X ?? 0, pos?.Y ?? 0);
        }
        catch { }
        return (280, 200, 0, 0);
    }


                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="asdDistMode" id="asdDist_group"
                                               checked="@(ConfigAsdDistributionMode == "group")"
                                               @onchange="@(() => ConfigAsdDistributionMode = "group")" />
                                        <label class="form-check-label" for="asdDist_group">@L["Widget_ByGroup"]</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio"
                                               name="asdDistMode" id="asdDist_state"
                                               checked="@(ConfigAsdDistributionMode == "state")"
                                               @onchange="@(() => ConfigAsdDistributionMode = "state")" />
                                        <label class="form-check-label" for="asdDist_state">@L["Widget_ByState"]</label>
                                    </div>

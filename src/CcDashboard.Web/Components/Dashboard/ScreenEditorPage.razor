    private void MoveQueueGridRow(string rowId, int direction)
    {
        var idx = ConfigQueueGridRows.FindIndex(r => r.Id == rowId);
        if (idx < 0) return;
        var newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= ConfigQueueGridRows.Count) return;
        var item = ConfigQueueGridRows[idx];
        ConfigQueueGridRows.RemoveAt(idx);
        ConfigQueueGridRows.Insert(newIdx, item);
    }


    private static string GetColorStyle(string colorValue)
    {
        return $"background: {colorValue} !important; background-color: {colorValue} !important;";
    }

    private static string GetWidgetIcon(string widgetName)
    {
        var n = widgetName.ToLower();
        if (n.Contains("queue")) return "bi-people-fill";
        if (n.Contains("agent")) return "bi-person-badge";
        if (n.Contains("kpi") || n.Contains("scorecard")) return "bi-speedometer2";
        if (n.Contains("chart") || n.Contains("trend")) return "bi-graph-up";
        if (n.Contains("call")) return "bi-telephone";
        if (n.Contains("sla")) return "bi-bullseye";
        return "bi-grid-3x3";
    }

    private static (int Width, int Height, int X, int Y) ParseWidgetDimensions(string? positionJson)
    {
        if (string.IsNullOrEmpty(positionJson)) return (280, 200, 0, 0);
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var pos = System.Text.Json.JsonSerializer.Deserialize<PositionData>(positionJson, options);
            return (pos?.Width ?? 280, pos?.Height ?? 200, pos?.X ?? 0, pos?.Y ?? 0);
        }
        catch { }
        return (280, 200, 0, 0);
    }

    private class PositionData
    {
        public int Width { get; set; } = 280;
        public int Height { get; set; } = 200;
        public int X { get; set; }
        public int Y { get; set; }
    }

    private static WidgetConfig ParseWidgetConfig(string? configJson)
    {
        if (string.IsNullOrEmpty(configJson)) return new WidgetConfig();
        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<WidgetConfig>(configJson) ?? new WidgetConfig();
        }
        catch { return new WidgetConfig(); }
    }

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _dotNetRef?.Dispose();
        _ = JS.InvokeVoidAsync("widgetResize.dispose");
    }

    // Inner classes
    public class PlacedWidget
    {
        public Guid Id { get; set; }
        public Guid CatalogItemId { get; set; }
        public string Name { get; set; } = "";
        public string Category { get; set; } = "";
        public int Width { get; set; } = 280;
        public int Height { get; set; } = 200;
        public int X { get; set; } = 0;
        public int Y { get; set; } = 0;
        public WidgetConfig Config { get; set; } = new();
    }

    public class WidgetConfig
    {
        public string? DisplayName { get; set; }
        public string? BusinessUnit { get; set; }
        public string? Metric { get; set; }
        public string? FontSize { get; set; }
        public string? BackgroundColor { get; set; }
        public string? FontColor { get; set; }
        public List<ThresholdRule>? Thresholds { get; set; }
    }

    public class ThresholdRule
    {
        public int? From { get; set; }
        public int? To { get; set; }
        public string? BackgroundColor { get; set; }
        public string? FontColor { get; set; }
    }

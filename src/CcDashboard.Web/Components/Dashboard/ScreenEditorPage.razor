@page "/screens/{Id:guid}/edit"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Superadmin,Administrator,Editor")]
@inject IMediator Mediator
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L
@using MediatR
@using Microsoft.Extensions.Localization
@using CcDashboard.Application.Commands.Dashboards
@using CcDashboard.Application.Queries.Dashboards
@using CcDashboard.Application.Queries.Widgets
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Contracts.DTOs.Dashboards
@using CcDashboard.Contracts.DTOs.Widgets
@using CcDashboard.Contracts.DTOs.Configuration
@using CcDashboard.Domain.Enums
@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Application.Queries.WidgetTemplates
@using CcDashboard.Application.Commands.WidgetTemplates
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

<PageTitle>@L["Screens_Edit"] — @(Dashboard?.Name ?? "...") — RTM View Shell</PageTitle>

<div class="editor-fullscreen @(_darkMode ? "dark-mode" : "")">
    @if (Loading)
    {
        <div class="text-center py-5" aria-busy="true">
            <span class="spinner-border text-primary"></span>
            <p class="mt-2 text-muted">@L["Loading"]</p>
        </div>
    }
    else if (Dashboard is null)
    {
        <div class="alert alert-warning m-4">@L["Screens_NotFound"]</div>
        <a href="/screens" class="btn btn-outline-primary ms-4">@L["Screens_Back"]</a>
    }
    else
    {
        <!-- Fullscreen Editor Header -->
        <div class="editor-header">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm btn-outline-light" @onclick="TogglePalette" title="@L["Widgets_Palette"]">
                    <i class="bi bi-layout-sidebar-inset"></i>
                </button>
                <a href="/screens" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-x-lg"></i>
                </a>
                <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary fw-bold" style="width:250px"
                       @bind="EditName" @bind:event="oninput" maxlength="200" />
                <span class="badge @(Dashboard.Status == DashboardStatus.Published ? "bg-success" : "bg-warning text-dark")">
                    @Dashboard.Status
                </span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-light" @onclick="ToggleDarkMode" title="@(_darkMode ? "Light mode" : "Dark mode")">
                    <i class="bi @(_darkMode ? "bi-sun" : "bi-moon")"></i>
                </button>
                @if (ConfiguringWidget is not null)
                {
                    <span class="badge bg-info me-2">Modal: @ConfiguringWidget.Name</span>
                }
                @if (Error is not null)
                {
                    <span class="text-danger small me-2">@Error</span>
                }
                @if (Dashboard.Status == DashboardStatus.Draft)
                {
                    <button class="btn btn-warning btn-sm" @onclick="PublishDashboard" disabled="@Saving">
                        <i class="bi bi-send"></i> @L["Screens_Publish"]
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-warning btn-sm" @onclick="UnpublishDashboard" disabled="@Saving">
                        <i class="bi bi-archive"></i> @L["Screens_Unpublish"]
                    </button>
                }
                <button class="btn btn-outline-secondary btn-sm" @onclick="CloneScreen" disabled="@(Saving || Cloning)" title="@L["Screens_Clone"]">
                    @if (Cloning)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-copy"></i> @L["Screens_Clone"]
                </button>
                <button class="btn btn-success btn-sm" @onclick="SaveLayout" disabled="@Saving">
                    @if (Saving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <i class="bi bi-check-lg"></i> @L["Common_Save"]
                </button>
            </div>
        </div>

        <!-- Slide-out Widget Palette -->
        <div class="editor-palette @(PaletteOpen ? "open" : "")">
            <div class="palette-header">
                <h6 class="mb-0">@L["Widgets_Palette"]</h6>
                <button class="btn btn-sm btn-link text-muted p-0" @onclick="TogglePalette">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="palette-content">
                @if (WidgetCatalog.Count == 0)
                {
                    <p class="text-muted small">@L["Widgets_NoWidgets"]</p>
                }
                else
                {
                    @foreach (var category in WidgetCatalog.GroupBy(w => w.Category))
                    {
                        <div class="mb-3" @key="category.Key">
                            <div class="small text-muted text-uppercase mb-2">@category.Key</div>
                            @foreach (var widget in category)
                            {
                                <div class="widget-palette-item"
                                     draggable="true"
                                     @key="widget.Id"
                                     @ondragstart="() => OnDragStart(widget)"
                                     @ondragend="OnDragEnd">
                                    <div class="widget-palette-icon">
                                        <i class="bi @GetWidgetIcon(widget.Name)"></i>
                                    </div>
                                    <div class="widget-palette-info">
                                        <div class="widget-palette-name">@widget.Name</div>
                                        <div class="widget-palette-desc">@widget.Description</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }

                <!-- Templates Section -->
                @if (WidgetTemplates.Count > 0)
                {
                    <div class="mt-4 pt-3 border-top">
                        <div class="small text-muted text-uppercase mb-2">
                            <i class="bi bi-bookmark me-1"></i>Templates
                        </div>
                        @foreach (var template in WidgetTemplates)
                        {
                            <div class="widget-palette-item template-item"
                                 draggable="true"
                                 @key="template.Id"
                                 @ondragstart="() => OnTemplateDragStart(template)"
                                 @ondragend="OnDragEnd">
                                <div class="widget-palette-icon">
                                    <i class="bi @GetWidgetIcon(template.WidgetName ?? "")"></i>
                                </div>
                                <div class="widget-palette-info flex-grow-1">
                                    <div class="widget-palette-name">@template.Name</div>
                                    <div class="widget-palette-desc">@template.WidgetName</div>
                                </div>
                                <button class="btn btn-link btn-sm p-0 text-danger ms-1"
                                        @onclick="() => ConfirmDeleteTemplate(template)"
                                        @onclick:stopPropagation
                                        title="Delete template">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Dashboard Canvas (fullscreen) -->
        <div class="editor-canvas @(IsDragging ? "drag-over" : "")"
             @ondragover="OnDragOver"
             @ondragover:preventDefault="true"
             @ondrop="OnDropAtPosition"
             @ondrop:preventDefault="true">
            @if (PlacedWidgets.Count == 0)
            {
                <div class="text-center py-5 text-muted" style="pointer-events: none;">
                    <i class="bi bi-grid-3x3-gap fs-1 mb-3 opacity-50"></i>
                    <p>@L["Widgets_DragHere"]</p>
                </div>
            }
            <div class="dashboard-canvas-grid"
                 style="position: relative; min-height: calc(100vh - 60px); @(_positionsApplied || PlacedWidgets.Count == 0 ? "" : "visibility: hidden;")">
                @foreach (var widget in PlacedWidgets)
                {
                    <div class="dashboard-widget @(SelectedWidgetId == widget.Id ? "selected" : "") @(widget.Config?.HideHeader == true ? "header-hidden" : "")"
                         data-widget-id="@widget.Id"
                         style="@GetWidgetStyle(widget)"
                         @key="widget.Id"
                         @onclick="() => SelectWidget(widget.Id)"
                         @onmousedown="e => { if (widget.Config?.HideHeader == true) StartMove(widget.Id, e); }"
                         @onmousedown:stopPropagation="@(widget.Config?.HideHeader == true)">
                        <div class="widget-toolbar">
                            <button class="widget-toolbar-btn" title="Save as template"
                                    @onclick="() => OpenSaveAsTemplate(widget)" @onclick:stopPropagation="true">
                                <i class="bi bi-bookmark-plus"></i>
                            </button>
                            <button class="widget-toolbar-btn" title="@L["Widgets_Configure"]"
                                    @onclick="() => OpenWidgetConfig(widget)" @onclick:stopPropagation="true">
                                <i class="bi bi-gear"></i>
                            </button>
                            <button class="widget-toolbar-btn danger" title="@L["Delete"]"
                                    @onclick="() => RemoveWidget(widget.Id)" @onclick:stopPropagation="true">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        @if (widget.Config?.HideHeader != true)
                        {
                            <div class="widget-header widget-drag-handle"
                                 @onmousedown="e => StartMove(widget.Id, e)"
                                 @onmousedown:stopPropagation="true">
                                <i class="bi bi-grip-horizontal me-1"></i>@widget.Name
                            </div>
                        }
                        <div class="widget-content">
                            <RenderWidget Widget="widget" DarkMode="_darkMode" />
                        </div>
                        @* Resize handles *@
                        <div class="resize-handle resize-e" @onmousedown="e => StartResizeE(widget.Id, e)" @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-s" @onmousedown="e => StartResizeS(widget.Id, e)" @onmousedown:stopPropagation="true"></div>
                        <div class="resize-handle resize-se" @onmousedown="e => StartResizeSE(widget.Id, e)" @onmousedown:stopPropagation="true"></div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Widget Configuration Modal -->
@if (ConfiguringWidget is not null)
{
    <div class="editor-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="widget-config-title" data-modal-id="widget-config">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="modal-drag-handle" title="@L["Common_DragToMove"]">
                        <i class="bi bi-grip-vertical"></i>
                    </div>
                    <h5 class="modal-title" id="widget-config-title">
                        @L["Widgets_Configure"]: @ConfiguringWidget.Name
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseWidgetConfig"></button>
                </div>
                <!-- Resize Handle (bottom-right corner) -->
                <div class="modal-resize-handle"></div>
                <div class="modal-body" style="height: 700px; overflow-y: auto; overflow-x: hidden;" @onscroll="CloseMetricDropdown">
                    <!-- Tabs Navigation -->
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(ConfigActiveTab == "general" ? "active" : "")" @onclick='() => ConfigActiveTab = "general"'>General</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(ConfigActiveTab == "appearance" ? "active" : "")" @onclick='() => ConfigActiveTab = "appearance"'>Appearance</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(ConfigActiveTab == "thresholds" ? "active" : "")" @onclick='() => ConfigActiveTab = "thresholds"'>Thresholds</button>
                        </li>
                        @if (IsAgentGridWidget(ConfiguringWidget))
                        {
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "filters" ? "active" : "")" @onclick='() => ConfigActiveTab = "filters"'>Filters</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "columns" ? "active" : "")" @onclick='() => ConfigActiveTab = "columns"'>Columns</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "score" ? "active" : "")" @onclick='() => ConfigActiveTab = "score"'>Score</button>
                            </li>
                        }
                        @if (IsQueueGridWidget(ConfiguringWidget))
                        {
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "rows" ? "active" : "")" @onclick='() => ConfigActiveTab = "rows"'>Rows</button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(ConfigActiveTab == "queuecolumns" ? "active" : "")" @onclick='() => ConfigActiveTab = "queuecolumns"'>Columns</button>
                            </li>
                        }
                    </ul>

                    <!-- Tab: General -->
                    @if (ConfigActiveTab == "general")
                    {
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label small text-muted">Widget ID</label>
                                <input type="text" class="form-control form-control-sm font-monospace" value="@ConfiguringWidget?.Id" readonly />
                            </div>
                            <div class="col-6">
                                <label class="form-label small text-muted">Grid ID</label>
                                <input type="text" class="form-control form-control-sm font-monospace" value="@ConfiguringWidget?.GridId" readonly />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@L["Widgets_Name"]</label>
                            <input type="text" class="form-control" @bind="ConfigDisplayName" />
                        </div>

                        @if (!IsQueueGridWidget(ConfiguringWidget))
                        {
                            <div class="mb-3">
                                <label class="form-label">@L["Widgets_BusinessUnit"]</label>
                                <div class="searchable-select">
                                    <input type="text" class="form-control" placeholder="@L["Common_Search"]..."
                                           value="@BuSearchText"
                                           @oninput="OnBuSearchInput"
                                           @onfocus="() => BuDropdownOpen = true"
                                           @onblur="OnBuSearchBlur" />
                                    @if (BuDropdownOpen)
                                    {
                                        <div class="searchable-dropdown">
                                            <div class="dropdown-item @(string.IsNullOrEmpty(ConfigBusinessUnit) ? "active" : "")"
                                                 @onmousedown="() => SelectBusinessUnit(null)"
                                                 @onmousedown:preventDefault="true">
                                                <em>@L["Common_All"]</em>
                                            </div>
                                            @foreach (var bu in FilteredBusinessUnits)
                                            {
                                                <div class="dropdown-item @(ConfigBusinessUnit == bu.BusinessUnitId.ToString() ? "active" : "")"
                                                     @onmousedown="() => SelectBusinessUnit(bu)"
                                                     @onmousedown:preventDefault="true">
                                                    @bu.BusinessUnitName
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (IsDataSlotWidget(ConfiguringWidget))
                        {
                            <!-- Data Slot: Title -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DataSlotTitle"]</label>
                                <input type="text" class="form-control" @bind="ConfigDataSlotTitle"
                                       placeholder="@L["Common_Optional"]" />
                                <small class="text-muted">@L["Widget_DataSlotTitleHint"]</small>
                            </div>

                            <!-- Data Slot: Metric -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DataSlotMetric"]</label>
                                <div class="searchable-select">
                                    <input type="text" class="form-control" placeholder="@L["Common_Search"]..."
                                           value="@DataSlotMetricSearchText"
                                           @oninput="e => DataSlotMetricSearchText = e.Value?.ToString() ?? string.Empty"
                                           @onfocus="() => DataSlotMetricDropdownOpen = true"
                                           @onblur="() => { Task.Delay(150).ContinueWith(_ => InvokeAsync(() => { DataSlotMetricDropdownOpen = false; StateHasChanged(); })); }" />
                                    @if (DataSlotMetricDropdownOpen)
                                    {
                                        <div class="searchable-dropdown">
                                            @foreach (var metric in Metrics.Where(m =>
                                                string.IsNullOrEmpty(DataSlotMetricSearchText) ||
                                                (m.Description?.Contains(DataSlotMetricSearchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                                                m.MetricId.Contains(DataSlotMetricSearchText, StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <div class="dropdown-item @(ConfigDataSlotMetricId == metric.MetricId ? "active" : "")"
                                                     @onmousedown="() => { ConfigDataSlotMetricId = metric.MetricId; DataSlotMetricSearchText = metric.Description ?? metric.MetricId; DataSlotMetricDropdownOpen = false; }"
                                                     @onmousedown:preventDefault="true">
                                                    @(metric.Description ?? metric.MetricId)
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Data Slot: Target -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <label class="form-label">@L["Widget_DataSlotTarget"]</label>
                                    <input type="text" class="form-control @(_dataSlotTargetError != null ? "is-invalid" : "")"
                                           value="@_dataSlotTargetText"
                                           @oninput="OnDataSlotTargetInput"
                                           placeholder="0.00" />
                                    @if (_dataSlotTargetError != null)
                                    {
                                        <div class="invalid-feedback">@_dataSlotTargetError</div>
                                    }
                                </div>
                                <div class="col-6">
                                    <label class="form-label">@L["Widget_DataSlotTargetMode"]</label>
                                    <select class="form-select" @bind="ConfigDataSlotTargetMode">
                                        <option value="less">@L["Widget_DataSlotTargetLess"]</option>
                                        <option value="greater">@L["Widget_DataSlotTargetGreater"]</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Data Slot: Target Label -->
                            <div class="mb-3">
                                <label class="form-label">@L["Widget_DataSlotTargetLabel"]</label>
                                <input type="text" class="form-control" @bind="ConfigDataSlotTargetLabel"
                                       placeholder="Goal < 5%" />
                                <small class="text-muted">@L["Widget_DataSlotTargetLabelHint"]</small>
                            </div>

                        }

                    }

                    <!-- Tab: Appearance -->
                    @if (ConfigActiveTab == "appearance")
                    {
                        <!-- Typography Section -->
                        <div class="appearance-section mb-4">
                            <h6 class="section-label">Typography</h6>
                            <div class="row align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1">Font Size</label>
                                    <select class="form-select form-select-sm" @bind="ConfigFontSize">
                                        <option value="small">@L["Widgets_FontSize_Small"] (12px)</option>
                                        <option value="normal">@L["Widgets_FontSize_Normal"] (14px)</option>
                                        <option value="large">@L["Widgets_FontSize_Large"] (18px)</option>
                                        <option value="xlarge">@L["Widgets_FontSize_XLarge"] (24px)</option>
                                        <option value="xxlarge">@L["Widgets_FontSize_XXLarge"] (32px)</option>
                                    </select>
                                </div>
                                @if (IsDataSlotWidget(ConfiguringWidget))
                                {
                                    <div class="col-md-6">
                                        <div class="form-check mb-2">
                                            <input type="checkbox" class="form-check-input" id="dataSlotBoldTypo" @bind="ConfigDataSlotBold" />
                                            <label class="form-check-label" for="dataSlotBoldTypo">@L["Widgets_Bold"]</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (IsDataSlotWidget(ConfiguringWidget))
                        {
                            <!-- Data Slot Display Options -->
                            <div class="appearance-section mb-4">
                                <h6 class="section-label">@L["Widgets_DisplayOptions"]</h6>
                                <div class="row mb-2">
                                    <div class="col-md-6">
                                        <label class="form-label small text-muted mb-1">@L["Widgets_Alignment"]</label>
                                        <select class="form-select form-select-sm" @bind="ConfigDataSlotAlign">
                                            <option value="left">@L["Common_Left"]</option>
                                            <option value="center">@L["Common_Center"]</option>
                                            <option value="right">@L["Common_Right"]</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-4 mt-3">
                                    <div class="form-check form-switch">
                                        <input type="checkbox" class="form-check-input" id="dataSlotShowTarget" @bind="ConfigDataSlotShowTargetLabel" />
                                        <label class="form-check-label" for="dataSlotShowTarget">@L["Widgets_ShowTargetLabel"]</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input type="checkbox" class="form-check-input" id="dataSlotShowArrow" @bind="ConfigDataSlotShowArrow" />
                                        <label class="form-check-label" for="dataSlotShowArrow">@L["Widgets_ShowDeltaArrow"]</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input type="checkbox" class="form-check-input" id="dataSlotHideHeader" @bind="ConfigHideHeader" />
                                        <label class="form-check-label" for="dataSlotHideHeader">@L["Widgets_HideHeader"]</label>
                                    </div>
                                </div>
                                <small class="text-muted d-block mt-2">@L["Widgets_HideHeaderHint"]</small>
                            </div>
                        }

                        <!-- Colors Section -->
                        <div class="appearance-section">
                            <h6 class="section-label">Colors</h6>
                            <div class="color-settings-dual">
                                <!-- Header row -->
                                <div class="color-dual-header">
                                    <span class="color-setting-label"></span>
                                    <span class="color-mode-label">Light Mode</span>
                                    <span class="color-mode-label">Dark Mode</span>
                                </div>

                                <!-- Widget Background -->
                                <div class="color-setting-row-dual">
                                    <span class="color-setting-label">Widget Background</span>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(ConfigBackgroundColor, BackgroundColors)"
                                              style="@GetColorStyle(ConfigBackgroundColor); cursor: pointer;"
                                              @onclick="ToggleBgColorPalette"
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "bg")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in BackgroundColors)
                                                {
                                                    <span class="clr-swatch @(ConfigBackgroundColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => SelectBackgroundColor(color.Value)"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(ConfigDarkBackgroundColor, BackgroundColors)"
                                              style="@GetColorStyle(ConfigDarkBackgroundColor); cursor: pointer;"
                                              @onclick="ToggleDarkBgColorPalette"
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "darkBg")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in BackgroundColors)
                                                {
                                                    <span class="clr-swatch @(ConfigDarkBackgroundColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => SelectDarkBackgroundColor(color.Value)"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Text Color -->
                                <div class="color-setting-row-dual">
                                    <span class="color-setting-label">Text Color</span>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(ConfigFontColor, FontColors)"
                                              style="@GetColorStyle(ConfigFontColor); cursor: pointer;"
                                              @onclick="ToggleFontColorPalette"
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "font")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in FontColors)
                                                {
                                                    <span class="clr-swatch @(ConfigFontColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => SelectFontColor(color.Value)"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(ConfigDarkFontColor, FontColors)"
                                              style="@GetColorStyle(ConfigDarkFontColor); cursor: pointer;"
                                              @onclick="ToggleDarkFontColorPalette"
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "darkFont")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in FontColors)
                                                {
                                                    <span class="clr-swatch @(ConfigDarkFontColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => SelectDarkFontColor(color.Value)"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Header Text Color -->
                                <div class="color-setting-row-dual">
                                    <span class="color-setting-label">Header Text</span>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(ConfigHeaderFontColor, HeaderFontColors)"
                                              style="@GetColorStyle(ConfigHeaderFontColor); cursor: pointer;"
                                              @onclick="ToggleHeaderFontColorPalette"
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "headerFont")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in HeaderFontColors)
                                                {
                                                    <span class="clr-swatch @(ConfigHeaderFontColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { ConfigHeaderFontColor = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(ConfigDarkHeaderFontColor, HeaderFontColors)"
                                              style="@GetColorStyle(ConfigDarkHeaderFontColor); cursor: pointer;"
                                              @onclick="ToggleDarkHeaderFontColorPalette"
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "darkHeaderFont")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in HeaderFontColors)
                                                {
                                                    <span class="clr-swatch @(ConfigDarkHeaderFontColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { ConfigDarkHeaderFontColor = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                @if (IsAgentGridWidget(ConfiguringWidget) || IsQueueGridWidget(ConfiguringWidget))
                                {
                                    <!-- Table Background -->
                                    <div class="color-setting-row-dual">
                                        <span class="color-setting-label">Table Background</span>
                                        <div class="position-relative">
                                            <span class="clr-swatch clr-swatch-lg"
                                                  title="@GetColorName(ConfigTableBackgroundColor, TableBackgroundColors)"
                                                  style="@GetColorStyle(ConfigTableBackgroundColor); cursor: pointer;"
                                                  @onclick="ToggleTableColorPalette"
                                                  @onclick:stopPropagation></span>
                                            @if (_openColorPalette == "table")
                                            {
                                                <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                     @onclick="CloseColorPalette"></div>
                                                <div class="color-palette-dropdown">
                                                    @foreach (var color in TableBackgroundColors)
                                                    {
                                                        <span class="clr-swatch @(ConfigTableBackgroundColor == color.Value ? "selected" : "")"
                                                              title="@color.Name"
                                                              style="@GetColorStyle(color.Value)"
                                                              @onclick="() => SelectTableBackgroundColor(color.Value)"
                                                              @onclick:stopPropagation></span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="position-relative">
                                            <span class="clr-swatch clr-swatch-lg"
                                                  title="@GetColorName(ConfigDarkTableBackgroundColor, TableBackgroundColors)"
                                                  style="@GetColorStyle(ConfigDarkTableBackgroundColor); cursor: pointer;"
                                                  @onclick="ToggleDarkTableColorPalette"
                                                  @onclick:stopPropagation></span>
                                            @if (_openColorPalette == "darkTable")
                                            {
                                                <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                     @onclick="CloseColorPalette"></div>
                                                <div class="color-palette-dropdown">
                                                    @foreach (var color in TableBackgroundColors)
                                                    {
                                                        <span class="clr-swatch @(ConfigDarkTableBackgroundColor == color.Value ? "selected" : "")"
                                                              title="@color.Name"
                                                              style="@GetColorStyle(color.Value)"
                                                              @onclick="() => SelectDarkTableBackgroundColor(color.Value)"
                                                              @onclick:stopPropagation></span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (IsAgentGridWidget(ConfiguringWidget) || IsQueueGridWidget(ConfiguringWidget))
                        {
                            <!-- Display Options Section -->
                            <div class="appearance-section mt-4">
                                <h6 class="section-label">Display Options</h6>

                                @if (IsAgentGridWidget(ConfiguringWidget))
                                {
                                    <!-- Show Avatar -->
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox" id="showAvatarAppearance" @bind="ConfigShowAvatar" />
                                            <label class="form-check-label" for="showAvatarAppearance">@L["Widgets_AgentGrid_ShowAvatar"]</label>
                                        </div>
                                        @if (ConfigShowAvatar)
                                        {
                                            <!-- Avatar BG Color -->
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="small text-muted">BG:</span>
                                                <div class="position-relative">
                                                    <span class="clr-swatch"
                                                          title="@GetColorName(ConfigAvatarBgColor, BackgroundColors)"
                                                          style="@GetColorStyle(ConfigAvatarBgColor); cursor: pointer;"
                                                          @onclick="ToggleAvatarBgColorPalette"
                                                          @onclick:stopPropagation></span>
                                                    @if (_openColorPalette == "avatarBg")
                                                    {
                                                        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                             @onclick="CloseColorPalette"></div>
                                                        <div class="color-palette-dropdown">
                                                            @foreach (var color in BackgroundColors.Where(c => c.Value != "transparent"))
                                                            {
                                                                <span class="clr-swatch @(ConfigAvatarBgColor == color.Value ? "selected" : "")"
                                                                      title="@color.Name"
                                                                      style="@GetColorStyle(color.Value)"
                                                                      @onclick="() => SelectAvatarBgColor(color.Value)"
                                                                      @onclick:stopPropagation></span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <!-- Avatar Font Color -->
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="small text-muted">Text:</span>
                                                <div class="position-relative">
                                                    <span class="clr-swatch"
                                                          title="@GetColorName(ConfigAvatarFontColor, FontColors)"
                                                          style="@GetColorStyle(ConfigAvatarFontColor); cursor: pointer;"
                                                          @onclick="ToggleAvatarFontColorPalette"
                                                          @onclick:stopPropagation></span>
                                                    @if (_openColorPalette == "avatarFont")
                                                    {
                                                        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                             @onclick="CloseColorPalette"></div>
                                                        <div class="color-palette-dropdown">
                                                            @foreach (var color in FontColors)
                                                            {
                                                                <span class="clr-swatch @(ConfigAvatarFontColor == color.Value ? "selected" : "")"
                                                                      title="@color.Name"
                                                                      style="@GetColorStyle(color.Value)"
                                                                      @onclick="() => SelectAvatarFontColor(color.Value)"
                                                                      @onclick:stopPropagation></span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Show Pagination -->
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="showPagination" @bind="ConfigShowPagination" />
                                    <label class="form-check-label" for="showPagination">@L["Widgets_ShowPagination"]</label>
                                </div>
                            </div>
                        }
                    }

                    <!-- Tab: Thresholds -->
                    @if (ConfigActiveTab == "thresholds")
                    {
                    @if (IsAgentGridWidget(ConfiguringWidget) || IsQueueGridWidget(ConfiguringWidget))
                    {
                        <!-- Per-column thresholds for Agent Grid / Queue Grid -->
                        <div class="mb-3">
                            <label class="form-label">Column</label>
                            <select class="form-select form-select-sm" @bind="SelectedThresholdColumn">
                                <option value="">-- Select column --</option>
                                @if (IsAgentGridWidget(ConfiguringWidget))
                                {
                                    @foreach (var col in ConfigAgentColumnDefs)
                                    {
                                        <option value="@col.MetricId">@col.Name</option>
                                    }
                                }
                                else
                                {
                                    @foreach (var col in ConfigQueueGridColumnDefs)
                                    {
                                        <option value="@col.MetricId">@col.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        @if (!string.IsNullOrEmpty(SelectedThresholdColumn))
                        {
                            var colThresholds = GetColumnThresholds(SelectedThresholdColumn);
                            var isNumeric = IsNumericMetric(SelectedThresholdColumn);

                            @for (int i = 0; i < colThresholds.Count; i++)
                            {
                                var idx = i;
                                var rule = colThresholds[idx];
                                <div class="threshold-rule mb-2 p-2 border rounded" @key="@($"{SelectedThresholdColumn}_{idx}")">
                                    <div class="row g-2 align-items-end">
                                        @if (isNumeric)
                                        {
                                            <div class="col-2">
                                                <label class="form-label small">@L["Widgets_From"]</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       value="@rule.From"
                                                       @onchange="e => UpdateColThresholdFrom(SelectedThresholdColumn, idx, e)" />
                                            </div>
                                            <div class="col-2">
                                                <label class="form-label small">@L["Widgets_To"]</label>
                                                <input type="text" class="form-control form-control-sm"
                                                       value="@rule.To"
                                                       @onchange="e => UpdateColThresholdTo(SelectedThresholdColumn, idx, e)" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="col-2">
                                                <label class="form-label small">@L["Widgets_MatchType"]</label>
                                                <select class="form-select form-select-sm"
                                                        value="@rule.TextMatchType"
                                                        @onchange="e => UpdateColThresholdMatchType(SelectedThresholdColumn, idx, e)">
                                                    <option value="equal">@L["Widgets_MatchType_Equal"]</option>
                                                    <option value="notequal">@L["Widgets_MatchType_NotEqual"]</option>
                                                    <option value="contains">@L["Widgets_MatchType_Contains"]</option>
                                                    <option value="startswith">@L["Widgets_MatchType_StartsWith"]</option>
                                                    <option value="endswith">@L["Widgets_MatchType_EndsWith"]</option>
                                                    <option value="empty">@L["Widgets_MatchType_Empty"]</option>
                                                    <option value="notempty">@L["Widgets_MatchType_NotEmpty"]</option>
                                                </select>
                                            </div>
                                            @if (rule.TextMatchType != "empty" && rule.TextMatchType != "notempty")
                                            {
                                                <div class="col-2">
                                                    <label class="form-label small">@L["Widgets_Value"]</label>
                                                    <input type="text"
                                                           class="form-control form-control-sm"
                                                           value="@rule.TextMatch"
                                                           @onchange="e => UpdateColThresholdText(SelectedThresholdColumn, idx, e)" />
                                                </div>
                                            }
                                        }
                                        @{
                                            var colBgKey = $"col-{SelectedThresholdColumn}-{idx}-bg";
                                            var colFontKey = $"col-{SelectedThresholdColumn}-{idx}-font";
                                        }
                                        <div class="col-auto">
                                            <label class="form-label small">@L["Widgets_BadgeBg"]</label>
                                            <div class="position-relative">
                                                <span class="clr-swatch"
                                                      title="@GetColorName(rule.BackgroundColor ?? "#198754", ThresholdBackgroundColors)"
                                                      style="@GetColorStyle(rule.BackgroundColor ?? "#198754"); cursor: pointer;"
                                                      @onclick="() => ToggleThresholdPalette(colBgKey)"
                                                      @onclick:stopPropagation></span>
                                                @if (_openThresholdPalette == colBgKey)
                                                {
                                                    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                         @onclick="() => _openThresholdPalette = null"></div>
                                                    <div class="color-palette-dropdown">
                                                        @foreach (var color in ThresholdBackgroundColors)
                                                        {
                                                            <span class="clr-swatch sm @(rule.BackgroundColor == color.Value ? "selected" : "")"
                                                                  title="@color.Name"
                                                                  style="@GetColorStyle(color.Value)"
                                                                  @onclick="() => SelectColThresholdBgColor(SelectedThresholdColumn, idx, color.Value)"
                                                                  @onclick:stopPropagation></span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <label class="form-label small">@L["Widgets_BadgeFont"]</label>
                                            <div class="position-relative">
                                                <span class="clr-swatch"
                                                      title="@GetColorName(rule.FontColor ?? "#ffffff", ThresholdFontColors)"
                                                      style="@GetColorStyle(rule.FontColor ?? "#ffffff"); cursor: pointer;"
                                                      @onclick="() => ToggleThresholdPalette(colFontKey)"
                                                      @onclick:stopPropagation></span>
                                                @if (_openThresholdPalette == colFontKey)
                                                {
                                                    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                         @onclick="() => _openThresholdPalette = null"></div>
                                                    <div class="color-palette-dropdown">
                                                        @foreach (var color in ThresholdFontColors)
                                                        {
                                                            <span class="clr-swatch sm @(rule.FontColor == color.Value ? "selected" : "")"
                                                                  title="@color.Name"
                                                                  style="@GetColorStyle(color.Value)"
                                                                  @onclick="() => SelectColThresholdFontColor(SelectedThresholdColumn, idx, color.Value)"
                                                                  @onclick:stopPropagation></span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-2 text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => RemoveColThreshold(SelectedThresholdColumn, idx)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            <button type="button" class="btn btn-outline-secondary btn-sm mt-2"
                                    @onclick="() => AddColThreshold(SelectedThresholdColumn)">
                                <i class="bi bi-plus"></i> @L["Widgets_AddThreshold"]
                            </button>
                        }
                    }
                    else
                    {
                        <!-- Standard thresholds for other widgets -->
                        <div class="threshold-rules">
                            @for (int i = 0; i < ConfigThresholds.Count; i++)
                            {
                                var idx = i;
                                var rule = ConfigThresholds[idx];
                                <div class="threshold-rule mb-2" @key="idx">
                                    <div class="row g-2 align-items-end">
                                        <div class="col-2">
                                            <label class="form-label small">@L["Widgets_From"]</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   value="@rule.From"
                                                   @onchange="e => UpdateThresholdFrom(idx, e)" />
                                        </div>
                                        <div class="col-2">
                                            <label class="form-label small">@L["Widgets_To"]</label>
                                            <input type="text" class="form-control form-control-sm"
                                                   value="@rule.To"
                                                   @onchange="e => UpdateThresholdTo(idx, e)" />
                                        </div>
                                        @{
                                            var stdBgKey = $"std-{idx}-bg";
                                            var stdFontKey = $"std-{idx}-font";
                                        }
                                        <div class="col-auto">
                                            <label class="form-label small">@L["Widgets_BackgroundColor"]</label>
                                            <div class="position-relative">
                                                <span class="clr-swatch"
                                                      title="@GetColorName(rule.BackgroundColor ?? "#198754", ThresholdBackgroundColors)"
                                                      style="@GetColorStyle(rule.BackgroundColor ?? "#198754"); cursor: pointer;"
                                                      @onclick="() => ToggleThresholdPalette(stdBgKey)"
                                                      @onclick:stopPropagation></span>
                                                @if (_openThresholdPalette == stdBgKey)
                                                {
                                                    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                         @onclick="() => _openThresholdPalette = null"></div>
                                                    <div class="color-palette-dropdown">
                                                        @foreach (var color in ThresholdBackgroundColors)
                                                        {
                                                            <span class="clr-swatch sm @(rule.BackgroundColor == color.Value ? "selected" : "")"
                                                                  title="@color.Name"
                                                                  style="@GetColorStyle(color.Value)"
                                                                  @onclick="() => SelectThresholdBgColor(idx, color.Value)"
                                                                  @onclick:stopPropagation></span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <label class="form-label small">@L["Widgets_FontColor"]</label>
                                            <div class="position-relative">
                                                <span class="clr-swatch"
                                                      title="@GetColorName(rule.FontColor ?? "#ffffff", ThresholdFontColors)"
                                                      style="@GetColorStyle(rule.FontColor ?? "#ffffff"); cursor: pointer;"
                                                      @onclick="() => ToggleThresholdPalette(stdFontKey)"
                                                      @onclick:stopPropagation></span>
                                                @if (_openThresholdPalette == stdFontKey)
                                                {
                                                    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                         @onclick="() => _openThresholdPalette = null"></div>
                                                    <div class="color-palette-dropdown">
                                                        @foreach (var color in ThresholdFontColors)
                                                        {
                                                            <span class="clr-swatch sm @(rule.FontColor == color.Value ? "selected" : "")"
                                                                  title="@color.Name"
                                                                  style="@GetColorStyle(color.Value)"
                                                                  @onclick="() => SelectThresholdFontColor(idx, color.Value)"
                                                                  @onclick:stopPropagation></span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-2 text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm"
                                                    @onclick="() => RemoveThreshold(idx)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            <button type="button" class="btn btn-outline-secondary btn-sm mt-2"
                                    @onclick="AddThreshold">
                                <i class="bi bi-plus"></i> @L["Widgets_AddThreshold"]
                            </button>
                        </div>
                    }
                    }

                    <!-- Tab: Filters (Agent Grid only) -->
                    @if (ConfigActiveTab == "filters" && IsAgentGridWidget(ConfiguringWidget))
                    {
                        <div class="filters-tab">
                            <!-- Header with Add button -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">Row filter — applied before display</span>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddTableFilterRule">
                                    <i class="bi bi-plus"></i> Add condition
                                </button>
                            </div>

                            @if (ConfigTableFilters.Count == 0)
                            {
                                <div class="text-center text-muted py-4">
                                    <i class="bi bi-funnel fs-3 mb-2 d-block opacity-50"></i>
                                    <p class="small mb-0">No filter conditions defined.</p>
                                    <p class="small text-muted">Add conditions to filter rows before display.</p>
                                </div>
                            }
                            else
                            {
                                @for (int i = 0; i < ConfigTableFilters.Count; i++)
                                {
                                    var idx = i;
                                    var rule = ConfigTableFilters[idx];
                                    var isFirst = idx == 0;

                                    @if (!isFirst)
                                    {
                                        <div class="text-center my-2">
                                            <select class="form-select form-select-sm d-inline-block" style="width: 80px;"
                                                    value="@rule.Connector"
                                                    @onchange="e => UpdateTableFilterConnector(idx, e.Value?.ToString() ?? string.Empty)">
                                                <option value="AND">AND</option>
                                                <option value="OR">OR</option>
                                            </select>
                                        </div>
                                    }

                                    <div class="filter-rule d-flex align-items-center gap-2 p-2 border rounded mb-2" @key="@idx">
                                        <!-- Column select -->
                                        <select class="form-select form-select-sm" style="width: 180px;"
                                                value="@rule.MetricId"
                                                @onchange="e => UpdateTableFilterMetricId(idx, e.Value?.ToString() ?? string.Empty)">
                                            <option value="">-- Select column --</option>
                                            @foreach (var col in ConfigAgentColumnDefs)
                                            {
                                                <option value="@col.MetricId">@col.Name</option>
                                            }
                                        </select>

                                        <!-- Operator select -->
                                        <select class="form-select form-select-sm" style="width: 160px;"
                                                value="@rule.Operator"
                                                @onchange="e => UpdateTableFilterOperator(idx, e.Value?.ToString() ?? string.Empty)">
                                            @foreach (var op in GetOperatorsForMetric(rule.MetricId))
                                            {
                                                <option value="@op.Value">@op.Label</option>
                                            }
                                        </select>

                                        <!-- Value input (hidden for empty/notempty operators) -->
                                        @if (rule.Operator != "empty" && rule.Operator != "notempty")
                                        {
                                            <input type="text" class="form-control form-control-sm" style="flex: 1;"
                                                   placeholder="Value..."
                                                   value="@rule.Value"
                                                   @onchange="e => UpdateTableFilterValue(idx, e.Value?.ToString() ?? string.Empty)" />
                                        }
                                        else
                                        {
                                            <div style="flex: 1;"></div>
                                        }

                                        <!-- Remove button -->
                                        <button type="button" class="btn btn-outline-danger btn-sm"
                                                @onclick="() => RemoveTableFilterRule(idx)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                }
                            }
                        </div>
                    }

                    <!-- Tab: Columns (Agent Grid only) -->
                    @if (ConfigActiveTab == "columns" && IsAgentGridWidget(ConfiguringWidget))
                    {
                        <div class="columns-tab">
                            <!-- Header with Add button -->
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">@ConfigAgentColumnDefs.Count columns</span>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddColumnDef">
                                    <i class="bi bi-plus"></i> Add Column
                                </button>
                            </div>

                            @if (ConfigAgentColumnDefs.Count > 0)
                            {
                                <!-- Table header -->
                                <div class="columns-table-header row g-2 mb-1 px-2 py-1 bg-light rounded-top small text-muted fw-medium">
                                    <div class="col-auto" style="width: 40px;"></div>
                                    <div class="col">Name</div>
                                    <div class="col">Metric</div>
                                    <div class="col-auto" style="width: 40px;"></div>
                                </div>

                                <!-- Scrollable list - fixed height for ~20 rows -->
                                <div class="columns-table-body" style="height: 400px; overflow-y: scroll;" @onscroll="CloseMetricDropdown">
                                    @for (int i = 0; i < ConfigAgentColumnDefs.Count; i++)
                                    {
                                        var col = ConfigAgentColumnDefs[i];
                                        var colId = col.Id;
                                        var isFirst = i == 0;
                                        var isLast = i == ConfigAgentColumnDefs.Count - 1;

                                        <div class="column-def-row row g-2 align-items-center py-1 px-2 border-bottom" @key="colId">
                                            <div class="col-auto" style="width: 40px;">
                                                <div class="btn-group-vertical btn-group-sm">
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                                                            disabled="@isFirst"
                                                            @onclick="() => MoveColumnDef(colId, -1)"
                                                            title="Move up">
                                                        <i class="bi bi-chevron-up"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                                                            disabled="@isLast"
                                                            @onclick="() => MoveColumnDef(colId, 1)"
                                                            title="Move down">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col">
                                                <input type="text" class="form-control form-control-sm"
                                                       value="@col.Name"
                                                       @onchange="e => UpdateColumnDefName(colId, e.Value?.ToString())" />
                                            </div>
                                            <div class="col">
                                                <div class="position-relative">
                                                    <input type="text" class="form-control form-control-sm"
                                                           placeholder="Select metric..."
                                                           value="@(_activeMetricDropdown == colId ? _metricSearchText : GetMetricDescription(col.MetricId))"
                                                           @onclick="() => OpenMetricDropdown(colId)"
                                                           @onclick:stopPropagation
                                                           @oninput="e => OnMetricSearch(e.Value?.ToString())" />
                                                    @if (_activeMetricDropdown == colId)
                                                    {
                                                        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                             @onclick="CloseMetricDropdown"></div>
                                                        <div class="dropdown-menu show w-100" style="max-height: 200px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1050;"
                                                             @onclick:stopPropagation>
                                                            @foreach (var metric in GetFilteredMetrics())
                                                            {
                                                                <button type="button" class="dropdown-item small"
                                                                        @onclick="() => SelectMetric(colId, metric.MetricId)">
                                                                    @metric.Description
                                                                </button>
                                                            }
                                                            @if (!GetFilteredMetrics().Any())
                                                            {
                                                                <span class="dropdown-item-text text-muted small">No matches</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-auto" style="width: 40px;">
                                                <button type="button" class="btn btn-link btn-sm p-0 text-danger"
                                                        @onclick="() => RemoveColumnDef(colId)"
                                                        title="Remove column">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="bi bi-columns-gap fs-1 mb-3 d-block opacity-50"></i>
                                    <p class="mb-3">No columns defined yet.</p>
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddColumnDef">
                                        <i class="bi bi-plus"></i> Add first column
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <!-- Tab: Score (Agent Grid only) -->
                    @if (ConfigActiveTab == "score" && IsAgentGridWidget(ConfiguringWidget))
                    {
                        <div class="score-tab">
                            <!-- Score Enable/Disable -->
                            <div class="mb-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="showScore" @bind="ConfigShowScore" />
                                    <label class="form-check-label fw-medium" for="showScore">@L["Widgets_AgentGrid_ShowScore"]</label>
                                </div>
                                <div class="form-text text-muted small">@L["Widgets_AgentGrid_ShowScore_Help"]</div>
                            </div>

                            @if (ConfigShowScore)
                            {
                                <!-- Star Color Selection -->
                                <div class="mb-4">
                                    <label class="form-label small fw-medium">@L["Widgets_AgentGrid_ScoreStarColor"]</label>
                                    <div class="d-flex gap-2 flex-wrap">
                                        @foreach (var color in ScoreStarColors)
                                        {
                                            <span class="clr-swatch clr-swatch-lg @(ConfigScoreStarColor == color.Value ? "selected" : "")"
                                                  title="@color.Name"
                                                  style="background-color: @color.Value; cursor: pointer; @(ConfigScoreStarColor == color.Value ? "box-shadow: 0 0 0 2px #fff, 0 0 0 4px " + color.Value + ";" : "")"
                                                  @onclick="() => ConfigScoreStarColor = color.Value"></span>
                                        }
                                    </div>
                                </div>

                                <!-- Formula Builder -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label small fw-medium mb-0">@L["Widgets_AgentGrid_ScoreFormula"]</label>
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddScoreFormulaRule">
                                            <i class="bi bi-plus"></i> @L["Common_Add"]
                                        </button>
                                    </div>
                                    <p class="text-muted small mb-3">@L["Widgets_AgentGrid_ScoreFormula_Help"]</p>

                                    @if (ConfigScoreFormula.Count > 0)
                                    {
                                        <div class="score-formula-list border rounded p-2" style="max-height: 300px; overflow-y: auto;">
                                            @for (int i = 0; i < ConfigScoreFormula.Count; i++)
                                            {
                                                var rule = ConfigScoreFormula[i];
                                                var ruleId = rule.Id;
                                                var ruleIdx = i;

                                                <div class="score-rule-row d-flex gap-2 align-items-center mb-2 p-2 bg-light rounded" @key="ruleId">
                                                    <!-- Metric Selection (from configured columns) -->
                                                    <div class="flex-grow-1" style="min-width: 200px;">
                                                        <select class="form-select form-select-sm"
                                                                value="@rule.MetricId"
                                                                @onchange="e => UpdateScoreRuleMetric(ruleId, e.Value?.ToString())">
                                                            <option value="">-- @L["Common_SelectColumn"] --</option>
                                                            @foreach (var col in ConfigAgentColumnDefs)
                                                            {
                                                                <option value="@col.MetricId">@col.Name</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <!-- Operator Selection -->
                                                    <div style="width: 80px;">
                                                        <select class="form-select form-select-sm"
                                                                value="@rule.Operator"
                                                                @onchange="e => UpdateScoreRuleOperator(ruleId, e.Value?.ToString())">
                                                            <option value=">=">≥</option>
                                                            <option value="<=">≤</option>
                                                            <option value=">">&gt;</option>
                                                            <option value="<">&lt;</option>
                                                            <option value="==">==</option>
                                                            <option value="!=">≠</option>
                                                        </select>
                                                    </div>

                                                    <!-- Value Input -->
                                                    <div style="width: 100px;">
                                                        <input type="text" class="form-control form-control-sm"
                                                               placeholder="@L["Common_Value"]"
                                                               value="@rule.Value"
                                                               @onchange="e => UpdateScoreRuleValue(ruleId, e.Value?.ToString())" />
                                                    </div>

                                                    <!-- Remove Button -->
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-danger"
                                                            @onclick="() => RemoveScoreFormulaRule(ruleId)"
                                                            title="@L["Common_Remove"]">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>

                                                @if (i < ConfigScoreFormula.Count - 1)
                                                {
                                                    <div class="text-center text-muted small my-1">AND</div>
                                                }
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-center text-muted py-4 border rounded">
                                            <i class="bi bi-calculator fs-2 mb-2 d-block opacity-50"></i>
                                            <p class="mb-2 small">@L["Widgets_AgentGrid_NoScoreRules"]</p>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddScoreFormulaRule">
                                                <i class="bi bi-plus"></i> @L["Widgets_AgentGrid_AddFirstRule"]
                                            </button>
                                        </div>
                                    }
                                </div>

                                <!-- Score Preview -->
                                <div class="score-preview mt-4 p-3 border rounded bg-light">
                                    <label class="form-label small fw-medium">@L["Widgets_AgentGrid_ScorePreview"]</label>
                                    <div class="d-flex gap-1 align-items-center">
                                        @{
                                            var starColor = ConfigScoreStarColor ?? "#ffc107";
                                            var previewScore = ConfigScoreFormula.Count > 0
                                                ? Math.Round((3.0 / ConfigScoreFormula.Count) * 5.0, 1)
                                                : 3.5;
                                        }
                                        <i class="bi bi-star-fill" style="color: @starColor; font-size: 1.25rem;"></i>
                                        <i class="bi bi-star-fill" style="color: @starColor; font-size: 1.25rem;"></i>
                                        <i class="bi bi-star-fill" style="color: @starColor; font-size: 1.25rem;"></i>
                                        <i class="bi bi-star-half" style="color: @starColor; font-size: 1.25rem;"></i>
                                        <i class="bi bi-star" style="color: @starColor; font-size: 1.25rem;"></i>
                                        <span class="ms-2 text-muted small">3.5 / 5 (70%)</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Tab: Rows (Queue Grid only) -->
                    @if (ConfigActiveTab == "rows" && IsQueueGridWidget(ConfiguringWidget))
                    {
                        <div class="rows-tab">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">@ConfigQueueGridRows.Count rows</span>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddQueueGridRow">
                                    <i class="bi bi-plus"></i> @L["Common_Add"]
                                </button>
                            </div>

                            @if (ConfigQueueGridRows.Count > 0)
                            {
                                <div class="row row-header mb-1 small text-muted fw-medium">
                                    <div class="col-auto" style="width: 50px;"></div>
                                    <div class="col">Business Unit</div>
                                    <div class="col">Queue Name</div>
                                    <div class="col-auto" style="width: 120px;">Colors</div>
                                    <div class="col-auto" style="width: 40px;"></div>
                                </div>

                                <div class="rows-list">
                                    @foreach (var row in ConfigQueueGridRows)
                                    {
                                        var rowIdx = ConfigQueueGridRows.IndexOf(row);
                                        var rowId = row.Id;
                                        var isFirst = rowIdx == 0;
                                        var isLast = rowIdx == ConfigQueueGridRows.Count - 1;

                                        <div class="row align-items-center mb-2 row-item @(rowIdx % 2 == 0 ? "bg-light" : "")" @key="row.Id">
                                            <div class="col-auto" style="width: 50px;">
                                                <div class="d-flex flex-column align-items-center gap-1">
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                                                            disabled="@isFirst"
                                                            @onclick="() => MoveQueueGridRow(rowId, -1)"
                                                            title="Move up">
                                                        <i class="bi bi-chevron-up"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                                                            disabled="@isLast"
                                                            @onclick="() => MoveQueueGridRow(rowId, 1)"
                                                            title="Move down">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col">
                                                <div class="position-relative">
                                                    <input type="text" class="form-control form-control-sm"
                                                           placeholder="Select Business Unit..."
                                                           value="@(_queueRowBuDropdownOpenFor == rowIdx ? _queueRowBuSearchText : row.BusinessUnitName ?? "")"
                                                           @onclick="() => OpenQueueRowBuDropdown(rowIdx)"
                                                           @onclick:stopPropagation
                                                           @oninput="e => OnQueueRowBuSearch(e.Value?.ToString())" />
                                                    @if (_queueRowBuDropdownOpenFor == rowIdx)
                                                    {
                                                        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                             @onclick="CloseQueueRowBuDropdown"></div>
                                                        <div class="dropdown-menu show w-100" style="max-height: 200px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1050;"
                                                             @onclick:stopPropagation>
                                                            @foreach (var bu in GetFilteredQueueRowBus())
                                                            {
                                                                <button type="button" class="dropdown-item small"
                                                                        @onclick="() => SelectQueueRowBu(rowId, bu)">
                                                                    @bu.BusinessUnitName
                                                                </button>
                                                            }
                                                            @if (!GetFilteredQueueRowBus().Any())
                                                            {
                                                                <span class="dropdown-item-text text-muted small">No matches</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col">
                                                <input type="text" class="form-control form-control-sm"
                                                       placeholder="(defaults to BU name)"
                                                       value="@row.QueueName"
                                                       @onchange="e => UpdateQueueGridRowName(rowId, e.Value?.ToString())" />
                                            </div>
                                            <div class="col-auto" style="width: 120px;">
                                                <div class="d-flex gap-1 align-items-center">
                                                    <div class="position-relative">
                                                        <span class="clr-swatch clr-swatch-sm"
                                                              title="@(string.IsNullOrEmpty(row.BackgroundColor) ? "Default" : row.BackgroundColor)"
                                                              style="@GetColorStyle(row.BackgroundColor ?? "transparent"); cursor: pointer;"
                                                              @onclick="() => ToggleQueueRowBgPalette(rowIdx)"
                                                              @onclick:stopPropagation></span>
                                                        @if (_queueRowBgPaletteOpenFor == rowIdx)
                                                        {
                                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                                 @onclick="CloseQueueRowPalette"></div>
                                                            <div class="color-palette-dropdown" @onclick:stopPropagation>
                                                                <div class="color-palette-grid">
                                                                    <div class="color-palette-swatch @(string.IsNullOrEmpty(row.BackgroundColor) ? "selected" : "")"
                                                                         style="background: transparent; border: 1px dashed #ccc;"
                                                                         title="Default"
                                                                         @onclick="() => SelectQueueRowBgColor(rowId, null)">
                                                                        <span class="small text-muted">D</span>
                                                                    </div>
                                                                    @foreach (var color in BackgroundColors.Where(c => c.Value != "transparent"))
                                                                    {
                                                                        <div class="color-palette-swatch @(row.BackgroundColor?.Equals(color.Value, StringComparison.OrdinalIgnoreCase) == true ? "selected" : "")"
                                                                             style="background: @color.Value"
                                                                             title="@color.Name"
                                                                             @onclick="() => SelectQueueRowBgColor(rowId, color.Value)"></div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="position-relative">
                                                        <span class="clr-swatch clr-swatch-sm"
                                                              title="@(string.IsNullOrEmpty(row.FontColor) ? "Default" : row.FontColor)"
                                                              style="@GetColorStyle(row.FontColor ?? "#333"); cursor: pointer;"
                                                              @onclick="() => ToggleQueueRowFontPalette(rowIdx)"
                                                              @onclick:stopPropagation></span>
                                                        @if (_queueRowFontPaletteOpenFor == rowIdx)
                                                        {
                                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                                 @onclick="CloseQueueRowPalette"></div>
                                                            <div class="color-palette-dropdown" @onclick:stopPropagation>
                                                                <div class="color-palette-grid">
                                                                    <div class="color-palette-swatch @(string.IsNullOrEmpty(row.FontColor) ? "selected" : "")"
                                                                         style="background: #333; border: 1px dashed #ccc;"
                                                                         title="Default"
                                                                         @onclick="() => SelectQueueRowFontColor(rowId, null)">
                                                                        <span class="small text-white">D</span>
                                                                    </div>
                                                                    @foreach (var color in FontColors)
                                                                    {
                                                                        <div class="color-palette-swatch @(row.FontColor?.Equals(color.Value, StringComparison.OrdinalIgnoreCase) == true ? "selected" : "")"
                                                                             style="background: @color.Value"
                                                                             title="@color.Name"
                                                                             @onclick="() => SelectQueueRowFontColor(rowId, color.Value)"></div>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-auto" style="width: 40px;">
                                                <button type="button" class="btn btn-link btn-sm p-0 text-danger"
                                                        @onclick="() => RemoveQueueGridRow(rowId)"
                                                        title="Remove row">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="bi bi-list-ul fs-1 mb-3 d-block opacity-50"></i>
                                    <p class="mb-3">No rows defined yet.</p>
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddQueueGridRow">
                                        <i class="bi bi-plus"></i> Add first row
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <!-- Tab: Columns (Queue Grid only) -->
                    @if (ConfigActiveTab == "queuecolumns" && IsQueueGridWidget(ConfiguringWidget))
                    {
                        <div class="columns-tab">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">@ConfigQueueGridColumnDefs.Count columns (QM / Agent Group metrics)</span>
                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddQueueGridColumnDef">
                                    <i class="bi bi-plus"></i> @L["Common_Add"]
                                </button>
                            </div>

                            @if (ConfigQueueGridColumnDefs.Count > 0)
                            {
                                <div class="row row-header mb-1 small text-muted fw-medium">
                                    <div class="col-auto" style="width: 50px;"></div>
                                    <div class="col">Name</div>
                                    <div class="col">Metric</div>
                                    <div class="col-auto" style="width: 40px;"></div>
                                </div>

                                <div class="columns-list">
                                    @foreach (var col in ConfigQueueGridColumnDefs)
                                    {
                                        var colIdx = ConfigQueueGridColumnDefs.IndexOf(col);
                                        var colId = col.Id;
                                        var isFirst = colIdx == 0;
                                        var isLast = colIdx == ConfigQueueGridColumnDefs.Count - 1;

                                        <div class="row align-items-center mb-2 column-item @(colIdx % 2 == 0 ? "bg-light" : "")" @key="col.Id">
                                            <div class="col-auto" style="width: 50px;">
                                                <div class="d-flex flex-column align-items-center gap-1">
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                                                            disabled="@isFirst"
                                                            @onclick="() => MoveQueueGridColumnDef(colId, -1)"
                                                            title="Move up">
                                                        <i class="bi bi-chevron-up"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-link btn-sm p-0 text-muted"
                                                            disabled="@isLast"
                                                            @onclick="() => MoveQueueGridColumnDef(colId, 1)"
                                                            title="Move down">
                                                        <i class="bi bi-chevron-down"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col">
                                                <input type="text" class="form-control form-control-sm"
                                                       value="@col.Name"
                                                       @onchange="e => UpdateQueueGridColumnDefName(colId, e.Value?.ToString())" />
                                            </div>
                                            <div class="col">
                                                <div class="position-relative">
                                                    <input type="text" class="form-control form-control-sm"
                                                           placeholder="Select metric..."
                                                           value="@(_activeQueueMetricDropdown == colId ? _queueColumnMetricSearch : GetMetricDescription(col.MetricId))"
                                                           @onclick="() => OpenQueueMetricDropdown(colId)"
                                                           @onclick:stopPropagation
                                                           @oninput="e => OnQueueMetricSearch(e.Value?.ToString())" />
                                                    @if (_activeQueueMetricDropdown == colId)
                                                    {
                                                        <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                             @onclick="CloseQueueMetricDropdown"></div>
                                                        <div class="dropdown-menu show w-100" style="max-height: 200px; overflow-y: auto; position: absolute; top: 100%; left: 0; z-index: 1050;"
                                                             @onclick:stopPropagation>
                                                            @foreach (var metric in FilteredQueueGridMetrics)
                                                            {
                                                                <button type="button" class="dropdown-item small"
                                                                        @onclick="() => SelectQueueMetric(colId, metric.MetricId)">
                                                                    @metric.Description
                                                                </button>
                                                            }
                                                            @if (!FilteredQueueGridMetrics.Any())
                                                            {
                                                                <span class="dropdown-item-text text-muted small">No matches</span>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-auto" style="width: 40px;">
                                                <button type="button" class="btn btn-link btn-sm p-0 text-danger"
                                                        @onclick="() => RemoveQueueGridColumnDef(colId)"
                                                        title="Remove column">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted py-5">
                                    <i class="bi bi-columns-gap fs-1 mb-3 d-block opacity-50"></i>
                                    <p class="mb-3">No columns defined yet.</p>
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddQueueGridColumnDef">
                                        <i class="bi bi-plus"></i> Add first column
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseWidgetConfig">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="async () => await SaveWidgetConfig()">@L["Common_Save"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="editor-modal-backdrop"></div>
}

<!-- Widget Delete Confirmation Modal -->
@if (WidgetToDelete is not null)
{
    <div class="editor-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-widget-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="delete-widget-title">@L["Widget_DeleteConfirm"]</h5>
                    <button type="button" class="btn-close" @onclick="CancelDeleteWidget" aria-label="@L["Common_Close"]"></button>
                </div>
                <div class="modal-body">
                    <p>@L["Widget_DeleteMessage", WidgetToDelete.Name]</p>
                    @if ((IsAgentGridWidget(WidgetToDelete) && WidgetToDelete.Config?.RtsUserGridId > 0) ||
                        (IsQueueGridWidget(WidgetToDelete) && WidgetToDelete.Config?.GridId > 0) ||
                        (IsDataSlotWidget(WidgetToDelete) && WidgetToDelete.Config?.DataSlotGridId > 0))
                    {
                        <p class="text-muted small">@L["Widget_DeleteRtsWarning"]</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDeleteWidget">@L["Common_Cancel"]</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteWidget">@L["Common_Delete"]</button>
                </div>
            </div>
        </div>
    </div>
    <div class="editor-modal-backdrop"></div>
}

<!-- Save As Template Modal -->
@if (WidgetToSaveAsTemplate is not null)
{
    <div class="editor-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="save-template-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="save-template-title">Save as Template</h5>
                    <button type="button" class="btn-close" @onclick="CancelSaveAsTemplate" aria-label="@L["Common_Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Save "<strong>@WidgetToSaveAsTemplate.Name</strong>" as a reusable template with all its configuration.
                    </p>
                    <div class="mb-3">
                        <label class="form-label">Template Name</label>
                        <input type="text" class="form-control" @bind="TemplateName" maxlength="200"
                               placeholder="Enter template name..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CancelSaveAsTemplate">Cancel</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveAsTemplate" disabled="@(SavingTemplate || string.IsNullOrWhiteSpace(TemplateName))">
                        @if (SavingTemplate)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Save Template
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="editor-modal-backdrop"></div>
}

<!-- Delete Template Confirmation Modal -->
@if (TemplateToDelete is not null)
{
    <div class="editor-modal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="delete-template-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="delete-template-title">Delete Template</h5>
                    <button type="button" class="btn-close" @onclick="CancelDeleteTemplate" aria-label="@L["Common_Close"]"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete the template "<strong>@TemplateToDelete.Name</strong>"?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CancelDeleteTemplate">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="DeleteTemplate">Delete</button>
                </div>
            </div>
        </div>
    </div>
    <div class="editor-modal-backdrop"></div>
}


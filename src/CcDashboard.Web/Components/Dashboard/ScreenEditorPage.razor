    private async Task ConfirmDeleteWidget()
    {
        if (WidgetToDelete is null) return;

        DeletingWidget = true;
        try
        {
            // If it's an AgentGrid widget with a valid GridId, delete RTS records
            if (IsAgentGridWidget(WidgetToDelete) && WidgetToDelete.GridId > 0)
            {
                await Mediator.Send(new DeleteAgentGridRtsCommand(WidgetToDelete.GridId), _cts.Token);
            }

            PlacedWidgets.RemoveAll(w => w.Id == WidgetToDelete.Id);
            if (SelectedWidgetId == WidgetToDelete.Id) SelectedWidgetId = null;
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            WidgetToDelete = null;
            DeletingWidget = false;
        }
    }


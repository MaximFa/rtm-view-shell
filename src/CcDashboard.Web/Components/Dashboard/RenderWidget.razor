@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@using CcDashboard.Web.Components.Widgets

@* Widget content renderer - renders placeholder until real widget library is implemented *@

<div class="widget-render">
    @switch ((Widget.OriginalWidgetName ?? Widget.Name).ToLower())
    {
        case var n when n.Contains("agent") && n.Contains("grid"):
            <AgentGridWidget @key="Widget.GridId" Config="Widget.Config" GridId="Widget.GridId" DarkMode="DarkMode" ActiveFilterCountChanged="ActiveFilterCountChanged" />
            break;
        case var n when n.Contains("queue") && n.Contains("grid"):
            <QueueGridWidget @key="Widget.GridId" Config="Widget.Config" GridId="Widget.GridId" DarkMode="DarkMode" ActiveFilterCountChanged="ActiveFilterCountChanged" />
            break;
        case var n when n.Contains("data") && n.Contains("slot"):
            <DataSlotWidget @key="Widget.GridId" Config="Widget.Config" GridId="Widget.GridId" DarkMode="DarkMode" />
            break;
        case var n when n.Contains("day") && n.Contains("trend"):
            <DayTrendWidget @ref="_dayTrendWidget"
                            @key="Widget.Id"
                            Config="Widget.Config"
                            DarkMode="DarkMode"
                            WidgetInstanceId="Widget.Id"
                            IsViewMode="IsViewMode" />
            break;
        case var n when n.Contains("agent") && n.Contains("state") && n.Contains("distribution"):
            <AgentStateDistributionWidget @key="Widget.GridId" Config="Widget.Config" GridId="Widget.GridId" DarkMode="DarkMode" />
            break;
        case var n when n.Contains("info") && n.Contains("slot"):
            <InfoSlotWidget @key="Widget.Id" Config="Widget.Config" DarkMode="DarkMode" />
            break;
        case var n when n.Contains("wfm") || n.Contains("workforce"):
            <WfmWidget @key="Widget.Id" Config="Widget.Config" DarkMode="DarkMode" GridId="Widget.GridId" />
            break;
        default:
            <div class="text-center text-muted small">
                <i class="bi bi-puzzle fs-4 mb-2 d-block opacity-50"></i>
                @Widget.Name
            </div>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public PlacedWidget Widget { get; set; } = null!;
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public bool IsViewMode { get; set; }
    [Parameter] public EventCallback<int> ActiveFilterCountChanged { get; set; }

    private DayTrendWidget? _dayTrendWidget;

    public async Task OpenDayTrendLocalConfigAsync()
    {
        if (_dayTrendWidget is not null)
            await _dayTrendWidget.OpenLocalConfigAsync();
    }
}

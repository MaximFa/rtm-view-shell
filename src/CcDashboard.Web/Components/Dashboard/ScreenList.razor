@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IScreenService ScreenService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>Dashboards — RTM View</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Dashboards</h1>
    <a href="/dashboard/new" class="btn btn-primary">+ New Dashboard</a>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading…</span>
        </div>
    </div>
}
else if (_screens.Count == 0)
{
    <div class="text-center py-5 text-muted">
        <p class="mb-2">No dashboards yet.</p>
        <a href="/dashboard/new" class="btn btn-outline-primary btn-sm">Create your first dashboard</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var screen in _screens)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between">
                            <h5 class="card-title mb-1 text-truncate">@screen.Name</h5>
                            <span class="badge @StatusBadge(screen.Status) ms-2 flex-shrink-0">
                                @screen.Status
                            </span>
                        </div>
                        <p class="text-muted small mb-0">
                            Updated @screen.UpdatedAt.ToString("d MMM yyyy")
                        </p>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a href="/dashboard/edit/@screen.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <button class="btn btn-sm btn-outline-danger ms-auto"
                                @onclick="() => DeleteAsync(screen.Id)">
                            Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@code {
    private List<ScreenDto> _screens = new();
    private bool _loading = true;
    private string? _error;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = Guid.Parse(state.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        try
        {
            _screens = (await ScreenService.GetForUserAsync(_userId)).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await ScreenService.DeleteAsync(id);
            _screens.RemoveAll(s => s.Id == id);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string StatusBadge(ScreenStatus status) => status switch
    {
        ScreenStatus.Active   => "bg-success",
        ScreenStatus.Draft    => "bg-secondary",
        ScreenStatus.Archived => "bg-warning text-dark",
        _                     => "bg-secondary"
    };
}

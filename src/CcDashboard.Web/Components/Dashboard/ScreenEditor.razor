@page "/dashboard/new"
@page "/dashboard/edit/{Id:guid}"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IScreenService ScreenService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Nav

<PageTitle>@(Id is null ? "New Dashboard" : "Edit Dashboard") — RTM View</PageTitle>

<div class="d-flex align-items-center mb-4 gap-3">
    <a href="/dashboard" class="btn btn-sm btn-outline-secondary">&#8592; Back</a>
    <h1 class="h3 mb-0">@(Id is null ? "New Dashboard" : "Edit Dashboard")</h1>
</div>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status" />
    </div>
}
else
{
    <div class="card shadow-sm" style="max-width:520px;">
        <div class="card-body p-4">
            <EditForm Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText class="form-control" @bind-Value="_model.Name" placeholder="Dashboard name" />
                    <ValidationMessage For="() => _model.Name" class="text-danger small" />
                </div>

                @if (Id is not null)
                {
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <InputSelect class="form-select" @bind-Value="_model.Status">
                            @foreach (var s in Enum.GetValues<ScreenStatus>())
                            {
                                <option value="@s">@s</option>
                            }
                        </InputSelect>
                    </div>
                }

                @if (_error is not null)
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@_saving">
                        @(_saving ? "Saving…" : "Save")
                    </button>
                    <a href="/dashboard" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private ScreenEditorModel _model = new();
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private Guid _userId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = Guid.Parse(state.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        if (Id is not null)
        {
            var screen = await ScreenService.GetByIdAsync(Id.Value);
            if (screen is null)
            {
                Nav.NavigateTo("/dashboard");
                return;
            }
            _model = new ScreenEditorModel { Name = screen.Name, Status = screen.Status };
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        try
        {
            if (Id is null)
                await ScreenService.CreateAsync(_userId, new CreateScreenRequest(_model.Name));
            else
                await ScreenService.UpdateAsync(Id.Value, new UpdateScreenRequest(_model.Name, _model.Status));

            Nav.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _saving = false;
        }
    }

    private class ScreenEditorModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MaxLength(256)]
        public string Name { get; set; } = string.Empty;
        public ScreenStatus Status { get; set; } = ScreenStatus.Draft;
    }
}

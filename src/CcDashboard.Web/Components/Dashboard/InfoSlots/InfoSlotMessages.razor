@page "/info-slots"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize]
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@inject IHubContext<CcDashboard.Web.Hubs.InfoSlotHub> HubContext
@using MediatR
@using CcDashboard.Application.Commands.InfoSlots
@using CcDashboard.Application.Queries.InfoSlots
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Contracts.DTOs.InfoSlots
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR
@implements IDisposable

<PageTitle>@L["InfoSlots_ViewerTitle"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["InfoSlots_ViewerTitle"]</h1>
    <AuthorizeView Roles="Superadmin">
        @if (Tenants.Count > 0)
        {
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                <select class="form-select form-select-sm" style="width:auto"
                        value="@SelectedTenantId"
                        @onchange="OnTenantChanged">
                    <option value="">@L["Audit_AllTenants"]</option>
                    @foreach (var t in Tenants)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>
        }
    </AuthorizeView>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @Error <button class="btn-close btn-sm" @onclick="() => Error = null"></button>
    </div>
}

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else if (!InfoSlots.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-broadcast-pin display-4 d-block mb-2"></i>
        <p>@L["InfoSlots_NoSlotsViewer"]</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <AuthorizeView Roles="Superadmin">
                        <th>@L["PG_Tenant"]</th>
                    </AuthorizeView>
                    <th>@L["InfoSlots_Name"]</th>
                    <th>@L["InfoSlots_DisplayMode"]</th>
                    <th class="text-center">@L["InfoSlots_Messages"]</th>
                    <th>@L["InfoSlots_PlacedOn"]</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var slot in PagedInfoSlots)
                {
                    <tr @key="slot.Id">
                        <AuthorizeView Roles="Superadmin">
                            <td class="text-muted small">@GetTenantName(slot.TenantId)</td>
                        </AuthorizeView>
                        <td><strong>@slot.Name</strong></td>
                        <td>
                            <span class="badge @(slot.DisplayMode == "Ticker" ? "bg-info text-dark" : "bg-warning text-dark")">
                                @(slot.DisplayMode == "Ticker" ? L["InfoSlots_ModeTicker"] : L["InfoSlots_ModeSequential"])
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-primary">@slot.ActiveMessageCount</span>
                        </td>
                        <td>
                            @if (slot.DashboardNames.Any())
                            {
                                @foreach (var name in slot.DashboardNames)
                                {
                                    <span class="badge bg-light text-dark me-1">@name</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenMessagesModal(slot)">
                                <i class="bi bi-chat-text me-1"></i>@L["InfoSlots_ManageMessages"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <AppPagination TotalCount="InfoSlots.Count" Page="_page" PageSize="_pageSize"
                   PageChanged="p => { _page = p; StateHasChanged(); }" PageSizeChanged="s => { _pageSize = s; _page = 1; StateHasChanged(); }" />
}

@if (SelectedSlot is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-msgs-title">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-msgs-title">@SelectedSlot.Name — @L["InfoSlots_Messages"]</h5>
                    <button class="btn-close" @onclick="CloseMessagesModal"></button>
                </div>
                <div class="modal-body">
                    @if (ModalError is not null)
                    {
                        <div class="alert alert-danger py-2">@ModalError</div>
                    }

                    @* Display Mode toggle — CC-012 *@
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <span class="me-2">@L["InfoSlot_DisplayMode"]:</span>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button"
                                class="btn @(_currentDisplayMode == "Ticker" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick='() => SetDisplayMode("Ticker")'>
                                @L["InfoSlot_Ticker"]
                            </button>
                            <button type="button"
                                class="btn @(_currentDisplayMode == "Sequential" ? "btn-primary" : "btn-outline-secondary")"
                                @onclick='() => SetDisplayMode("Sequential")'>
                                @L["InfoSlot_Sequential"]
                            </button>
                        </div>
                        @if (_currentDisplayMode == "Sequential")
                        {
                            <span class="ms-3">@L["InfoSlot_SecondsPerMessage"]:</span>
                            <input type="number" min="3" max="3600" @bind="_currentSeconds"
                                   @bind:event="oninput" @bind:after="OnSecondsChangedDebounced"
                                   class="form-control form-control-sm ms-1" style="width:70px" />
                        }
                    </div>

                    <h6 class="mb-3">@L["InfoSlots_ActiveMessages"] <span class="badge bg-primary">@SelectedSlot.ActiveMessages.Count</span></h6>

                    @if (SelectedSlot.ActiveMessages.Any())
                    {
                        <div class="list-group mb-4">
                            @foreach (var msg in SelectedSlot.ActiveMessages)
                            {
                                <div class="list-group-item" @key="msg.Id">
                                    @if (_editingMessageId == msg.Id)
                                    {
                                        @* Inline edit form *@
                                        <div class="mb-2">
                                            <textarea class="form-control form-control-sm" rows="2" @bind="_editContent" maxlength="2000"></textarea>
                                        </div>
                                        <div class="row g-2 mb-2">
                                            <div class="col-auto">
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="editPriority" id="editPrioNormal"
                                                           checked="@(_editPriority == "Normal")"
                                                           @onclick='() => _editPriority = "Normal"' />
                                                    <label class="form-check-label small" for="editPrioNormal">@L["InfoSlots_PriorityNormal"]</label>
                                                </div>
                                                <div class="form-check form-check-inline">
                                                    <input class="form-check-input" type="radio" name="editPriority" id="editPrioHigh"
                                                           checked="@(_editPriority == "High")"
                                                           @onclick='() => _editPriority = "High"' />
                                                    <label class="form-check-label small" for="editPrioHigh">@L["InfoSlots_PriorityHigh"]</label>
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <input type="datetime-local" class="form-control form-control-sm" @bind="_editExpiresAt" disabled="@_editNeverExpires" />
                                            </div>
                                            <div class="col-auto d-flex align-items-center">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" id="editNeverExpires" @bind="_editNeverExpires" />
                                                    <label class="form-check-label small" for="editNeverExpires">@L["InfoSlots_NeverExpires"]</label>
                                                </div>
                                            </div>
                                        </div>
                                        @if (_editError is not null)
                                        {
                                            <div class="alert alert-danger py-1 small mb-2">@_editError</div>
                                        }
                                        <div class="d-flex gap-2">
                                            <button class="btn btn-primary btn-sm" @onclick="SaveEdit" disabled="@_editSaving">
                                                @if (_editSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                                @L["Common_Save"]
                                            </button>
                                            <button class="btn btn-secondary btn-sm" @onclick="CancelEdit" disabled="@_editSaving">@L["Common_Cancel"]</button>
                                        </div>
                                    }
                                    else
                                    {
                                        @* Display mode *@
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <div class="d-flex align-items-center mb-1">
                                                    @if (msg.Priority == "High")
                                                    {
                                                        <span class="badge bg-danger me-2"><i class="bi bi-star-fill me-1"></i>@L["InfoSlots_PriorityHigh"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary me-2">@L["InfoSlots_PriorityNormal"]</span>
                                                    }
                                                    <small class="text-muted">@msg.AuthorName · @msg.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</small>
                                                </div>
                                                <p class="mb-1">@msg.Content</p>
                                                @if (msg.ExpiresAt.HasValue)
                                                {
                                                    <small class="text-muted">@L["InfoSlots_ExpiresAt"]: @msg.ExpiresAt.Value.ToLocalTime().ToString("dd.MM HH:mm")</small>
                                                }
                                            </div>
                                            <div class="d-flex gap-1">
                                                @if (CanEditMessage(msg))
                                                {
                                                    <button class="btn btn-outline-secondary btn-sm" @onclick="() => StartEdit(msg)" title="@L["Common_Edit"]">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                }
                                                @if (IsAdmin)
                                                {
                                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeactivateMessage(msg.Id)"
                                                            disabled="@Deactivating" title="@L["InfoSlots_Deactivate"]">
                                                        <i class="bi bi-x-circle"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mb-4">@L["InfoSlot_NoMessages"]</div>
                    }

                    @if (CanWriteMessages)
                    {
                        <hr />
                        <h6 class="mb-3">@L["InfoSlots_AddMessage"]</h6>
                        <div class="mb-3">
                            <label class="form-label">@L["InfoSlots_MsgContent"] *</label>
                            <textarea class="form-control" rows="3" @bind="NewContent" maxlength="1000"></textarea>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">@L["InfoSlots_Priority"]</label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="priority" id="prioNormal"
                                               checked="@(NewPriority == "Normal")"
                                               @onclick='() => NewPriority = "Normal"' />
                                        <label class="form-check-label" for="prioNormal">@L["InfoSlots_PriorityNormal"]</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="priority" id="prioHigh"
                                               checked="@(NewPriority == "High")"
                                               @onclick='() => NewPriority = "High"' />
                                        <label class="form-check-label" for="prioHigh">@L["InfoSlots_PriorityHigh"]</label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">@L["InfoSlots_ExpiresAt"]</label>
                                <input type="datetime-local" class="form-control" @bind="NewExpiresAt" disabled="@NeverExpires" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="neverExpires" @bind="NeverExpires" />
                                    <label class="form-check-label" for="neverExpires">@L["InfoSlots_NeverExpires"]</label>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseMessagesModal">@L["Common_Close"]</button>
                    @if (CanWriteMessages)
                    {
                        <button class="btn btn-primary btn-sm" @onclick="AddMessage" disabled="@Adding">
                            @if (Adding) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            @L["InfoSlots_AddMessageBtn"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

@code {
    private List<InfoSlotViewerDto> InfoSlots = [];
    private List<TenantDto> Tenants = [];
    private Guid? SelectedTenantId;
    private bool Loading = true;
    private int _page = 1;
    private int _pageSize = 25;
    private IEnumerable<InfoSlotViewerDto> PagedInfoSlots => InfoSlots.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private string? Error;

    private InfoSlotViewerDto? SelectedSlot;
    private string? ModalError;
    private bool Adding;
    private bool Deactivating;

    private string NewContent = "";
    private string NewPriority = "Normal";
    private DateTime? NewExpiresAt;
    private bool NeverExpires = true;

    // Edit message state
    private Guid? _editingMessageId;
    private string _editContent = "";
    private string _editPriority = "Normal";
    private DateTime? _editExpiresAt;
    private bool _editNeverExpires = true;
    private bool _editSaving;
    private string? _editError;

    // Display mode toggle state — CC-012
    private string _currentDisplayMode = "Ticker";
    private int _currentSeconds = 10;
    private CancellationTokenSource? _secondsDebounce;

    // Args record for display mode sync
    private record InfoSlotDisplayModeUpdatedArgs(Guid InfoSlotId, string DisplayMode, int SecondsPerMessage);

    private bool IsSuperadmin => CurrentUser.Role == "Superadmin";
    private bool IsAdmin => CurrentUser.Role == "Administrator" || CurrentUser.Role == "Superadmin";

    private string GetTenantName(Guid tenantId) =>
        Tenants.FirstOrDefault(t => t.Id == tenantId)?.Name ?? tenantId.ToString()[..8];

    private bool CanWriteMessages => IsAdmin || SelectedSlot is not null;

    private bool CanEditMessage(InfoSlotMessageDto msg)
    {
        if (IsSuperadmin || IsAdmin) return true;
        return msg.CreatedByUserId == CurrentUser.UserId;
    }

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (CurrentUser.Role == "Superadmin")
        {
            try { Tenants = (await Mediator.Send(new GetTenantsQuery(), _cts.Token)).ToList(); }
            catch { }
        }
        await LoadSlotsAsync();
    }

    private async Task OnTenantChanged(ChangeEventArgs e)
    {
        SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        Loading = true;
        try { InfoSlots = (await Mediator.Send(new GetInfoSlotsForViewerQuery(SelectedTenantId), _cts.Token)).ToList(); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Error = ex.Message; }
        finally { Loading = false; }
    }

    private void OpenMessagesModal(InfoSlotViewerDto slot)
    {
        SelectedSlot = slot;
        ModalError = null;
        NewContent = "";
        NewPriority = "Normal";
        NewExpiresAt = null;
        NeverExpires = true;
        // Initialize display mode from slot
        _currentDisplayMode = slot.DisplayMode;
        _currentSeconds = slot.SecondsPerMessage;
    }

    private void CloseMessagesModal()
    {
        SelectedSlot = null;
        ModalError = null;
    }

    private async Task AddMessage()
    {
        if (SelectedSlot is null) return;
        if (string.IsNullOrWhiteSpace(NewContent))
        {
            ModalError = L["InfoSlots_MsgContent"] + " is required.";
            return;
        }

        Adding = true;
        ModalError = null;
        try
        {
            var expiresAt = NeverExpires ? null : NewExpiresAt?.ToUniversalTime();
            var result = await Mediator.Send(new CreateInfoSlotMessageCommand(
                SelectedSlot.Id,
                NewContent.Trim(),
                NewPriority,
                expiresAt), _cts.Token);

            if (!result.IsSuccess)
            {
                ModalError = result.Error;
                return;
            }

            var tenantId = CurrentUser.TenantId;
            if (tenantId.HasValue)
            {
                var group = $"t:{tenantId}:is:{SelectedSlot.Id}";
                await HubContext.Clients.Group(group).SendAsync("MessageAdded", result.Value, _cts.Token);
            }

            NewContent = "";
            NewPriority = "Normal";
            NewExpiresAt = null;
            NeverExpires = true;

            await LoadSlotsAsync();
            SelectedSlot = InfoSlots.FirstOrDefault(s => s.Id == SelectedSlot.Id);
        }
        catch (Exception ex) { ModalError = ex.Message; }
        finally { Adding = false; }
    }

    private async Task DeactivateMessage(Guid messageId)
    {
        if (SelectedSlot is null) return;

        Deactivating = true;
        ModalError = null;
        try
        {
            var result = await Mediator.Send(new DeactivateInfoSlotMessageCommand(messageId), _cts.Token);
            if (!result.IsSuccess)
            {
                ModalError = result.Error;
                return;
            }

            var tenantId = CurrentUser.TenantId;
            if (tenantId.HasValue)
            {
                var group = $"t:{tenantId}:is:{SelectedSlot.Id}";
                await HubContext.Clients.Group(group).SendAsync("MessageDeactivated", new { MessageId = messageId }, _cts.Token);
            }

            await LoadSlotsAsync();
            SelectedSlot = InfoSlots.FirstOrDefault(s => s.Id == SelectedSlot.Id);
        }
        catch (Exception ex) { ModalError = ex.Message; }
        finally { Deactivating = false; }
    }

    private void StartEdit(InfoSlotMessageDto msg)
    {
        _editingMessageId = msg.Id;
        _editContent = msg.Content;
        _editPriority = msg.Priority;
        _editExpiresAt = msg.ExpiresAt?.ToLocalTime();
        _editNeverExpires = !msg.ExpiresAt.HasValue;
        _editError = null;
    }

    private void CancelEdit()
    {
        _editingMessageId = null;
        _editContent = "";
        _editPriority = "Normal";
        _editExpiresAt = null;
        _editNeverExpires = true;
        _editError = null;
    }

    private async Task SaveEdit()
    {
        if (_editingMessageId is null || SelectedSlot is null) return;
        if (string.IsNullOrWhiteSpace(_editContent))
        {
            _editError = L["InfoSlots_MsgContent"] + " is required.";
            return;
        }

        _editSaving = true;
        _editError = null;
        try
        {
            var expiresAt = _editNeverExpires ? null : _editExpiresAt?.ToUniversalTime();
            var dto = await Mediator.Send(new UpdateInfoSlotMessageCommand(
                _editingMessageId.Value,
                _editContent.Trim(),
                _editPriority,
                expiresAt), _cts.Token);

            // Push MessageUpdated to SignalR group
            var tenantId = CurrentUser.TenantId;
            if (tenantId.HasValue)
            {
                var group = $"t:{tenantId}:is:{SelectedSlot.Id}";
                await HubContext.Clients.Group(group).SendAsync("MessageUpdated", dto, _cts.Token);
            }

            CancelEdit();
            await LoadSlotsAsync();
            SelectedSlot = InfoSlots.FirstOrDefault(s => s.Id == SelectedSlot.Id);
        }
        catch (Exception ex) { _editError = ex.Message; }
        finally { _editSaving = false; }
    }


    // Display Mode handlers — CC-012
    private async Task SetDisplayMode(string mode)
    {
        if (SelectedSlot is null || mode == _currentDisplayMode) return;
        _currentDisplayMode = mode;
        await SendDisplayModeUpdate();
    }

    private async Task OnSecondsChangedDebounced()
    {
        // Debounce 800ms before sending
        _secondsDebounce?.Cancel();
        _secondsDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(800, _secondsDebounce.Token);
            await SendDisplayModeUpdate();
        }
        catch (OperationCanceledException) { }
    }

    private async Task SendDisplayModeUpdate()
    {
        if (SelectedSlot is null || _currentSeconds < 3) return;
        try
        {
            var result = await Mediator.Send(new UpdateInfoSlotDisplayModeCommand(
                SelectedSlot.Id,
                _currentDisplayMode,
                _currentSeconds), _cts.Token);

            if (result.IsSuccess)
            {
                // Update local list so badge reflects new mode immediately
                HandleDisplayModeChanged(new(SelectedSlot.Id, _currentDisplayMode, _currentSeconds));

                // Push DisplayModeChanged to SignalR group
                var tenantId = CurrentUser.TenantId;
                if (tenantId.HasValue)
                {
                    var group = $"t:{tenantId}:is:{SelectedSlot.Id}";
                    await HubContext.Clients.Group(group).SendAsync(
                        "DisplayModeChanged",
                        new { DisplayMode = _currentDisplayMode, SecondsPerMessage = _currentSeconds },
                        _cts.Token);
                }
            }
            else
            {
                ModalError = result.Error;
            }
        }
        catch (Exception ex) { ModalError = ex.Message; }
    }

    private void HandleDisplayModeChanged(InfoSlotDisplayModeUpdatedArgs args)
    {
        var slot = InfoSlots.FirstOrDefault(s => s.Id == args.InfoSlotId);
        if (slot is null) return;
        var idx = InfoSlots.IndexOf(slot);
        InfoSlots[idx] = slot with
        {
            DisplayMode = args.DisplayMode,
            SecondsPerMessage = args.SecondsPerMessage
        };
        // Also update SelectedSlot if it's the same
        if (SelectedSlot?.Id == args.InfoSlotId)
        {
            SelectedSlot = InfoSlots[idx];
        }
    }

    private readonly CancellationTokenSource _cts = new();
    public void Dispose()
    {
        _secondsDebounce?.Cancel();
        _secondsDebounce?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }
}
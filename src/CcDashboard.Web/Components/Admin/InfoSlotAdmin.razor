@page "/admin/info-slots"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@using MediatR
@using CcDashboard.Application.Commands.InfoSlots
@using CcDashboard.Application.Queries.InfoSlots
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Application.Queries.PermissionGroups
@using CcDashboard.Contracts.DTOs.InfoSlots
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Contracts.DTOs.PermissionGroups
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@using CcDashboard.Web.Components.Shared
@implements IDisposable

<PageTitle>@L["InfoSlots_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["InfoSlots_Title"]</h1>
    <div class="d-flex align-items-center gap-2">
        <AuthorizeView Roles="Superadmin">
            @if (Tenants.Count > 0)
            {
                <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                <select class="form-select form-select-sm" style="width:auto"
                        value="@SelectedTenantId"
                        @onchange="OnTenantChanged">
                    <option value="">@L["Audit_AllTenants"]</option>
                    @foreach (var t in Tenants)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            }
        </AuthorizeView>
        <button class="btn btn-primary btn-sm text-nowrap" @onclick="OpenCreate">
            <i class="bi bi-plus-lg me-1"></i>@L["InfoSlots_NewSlot"]
        </button>
    </div>
</div>

@if (SaveError is not null && !ShowModal)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @SaveError <button class="btn-close btn-sm" @onclick="() => SaveError = null"></button>
    </div>
}

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["InfoSlots_Name"]</th>
                    @if (IsSuperadmin) { <th>@L["PG_Tenant"]</th> }
                    <th>@L["InfoSlots_DisplayMode"]</th>
                    <th class="text-center">@L["InfoSlots_ActiveMessages"]</th>
                    <th class="text-center">@L["InfoSlots_PgCount"]</th>
                    <th>@L["Common_Status"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in InfoSlots)
                {
                    <tr @key="s.Id">
                        <td class="fw-semibold">@s.Name</td>
                        @if (IsSuperadmin)
                        {
                            <td class="small text-muted">@(Tenants.FirstOrDefault(t => t.Id == s.TenantId)?.Name ?? "—")</td>
                        }
                        <td>
                            <span class="badge @(s.DisplayMode == "Ticker" ? "bg-info text-dark" : "bg-warning text-dark")">
                                @(s.DisplayMode == "Ticker" ? L["InfoSlots_ModeTicker"] : L["InfoSlots_ModeSequential"])
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-primary">@s.ActiveMessageCount</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">@s.AssignedPgCount</span>
                        </td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge bg-success">@L["Common_Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@L["Common_Inactive"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenEdit(s)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(s)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
                @if (!InfoSlots.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">@L["InfoSlots_NoSlots"]</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ShowModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-is-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-is-title">@(IsNew ? L["InfoSlots_NewSlot"] : L["InfoSlots_EditSlot"])</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (SaveError is not null)
                    {
                        <div class="alert alert-danger py-2">@SaveError</div>
                    }
                    @if (SaveSuccess)
                    {
                        <div class="alert alert-success py-2">@L["TenantSettings_Saved"]</div>
                    }

                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(ActiveTab == "General" ? "active" : "")"
                                    @onclick='() => ActiveTab = "General"'>@L["InfoSlots_TabGeneral"]</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(ActiveTab == "Access" ? "active" : "")"
                                    @onclick='() => ActiveTab = "Access"'>@L["InfoSlots_TabAccess"]</button>
                        </li>
                    </ul>

                    @if (ActiveTab == "General")
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">@L["InfoSlots_Name"] *</label>
                                <input class="form-control" @bind="EName" maxlength="200" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">@L["InfoSlots_DisplayMode"]</label>
                                <select class="form-select" @bind="EDisplayMode">
                                    <option value="Ticker">@L["InfoSlots_ModeTicker"]</option>
                                    <option value="Sequential">@L["InfoSlots_ModeSequential"]</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">@L["InfoSlots_Description"]</label>
                                <textarea class="form-control" rows="2" @bind="EDescription" maxlength="500"></textarea>
                            </div>
                            @if (EDisplayMode == "Sequential")
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">@L["InfoSlots_SecondsPerMessage"]</label>
                                    <input type="number" class="form-control" @bind="ESecondsPerMessage" min="5" max="120" />
                                    <div class="form-text">@L["InfoSlots_SecondsHelp"]</div>
                                </div>
                            }
                            @if (!IsNew)
                            {
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="isActive" @bind="EIsActive" />
                                        <label class="form-check-label" for="isActive">@L["PG_IsActive"]</label>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (ActiveTab == "Access")
                    {
                        @if (ModalLoading)
                        {
                            <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else
                        {
                            <p class="text-muted small mb-3">@L["InfoSlots_AccessNote"]</p>
                            <DualPaneSelector TKey="Guid"
                                              AllItems="AvailablePGs.Select(x => (x.Id, x.Name)).ToList()"
                                              SelectedIds="SelectedPGIds"
                                              SelectedIdsChanged="ids => { SelectedPGIds = ids; }" />
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseModal">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveSlot" disabled="@(Saving || ModalLoading)">
                        @if (Saving || ModalLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L["Common_Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

@if (DeleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-delete-is-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="modal-delete-is-title">@L["InfoSlots_DeleteSlot"]</h5>
                    <button class="btn-close btn-close-white" @onclick="() => DeleteTarget = null"></button>
                </div>
                <div class="modal-body">
                    @if (DeleteError is not null)
                    {
                        <div class="alert alert-danger py-2">@DeleteError</div>
                    }
                    <p>@L["Screens_AreYouSure"]: <strong>@DeleteTarget.Name</strong></p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => DeleteTarget = null">@L["Common_Cancel"]</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete" disabled="@Deleting">
                        @if (Deleting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L["Delete"]
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

@code {
    private List<InfoSlotListDto> InfoSlots = [];
    private List<TenantDto> Tenants = [];
    private List<PermissionGroupDto> AvailablePGs = [];
    private Guid? SelectedTenantId;
    private bool Loading = true;
    private bool ModalLoading;
    private bool Saving;
    private bool Deleting;
    private string? SaveError;
    private string? DeleteError;
    private bool SaveSuccess;

    private bool IsSuperadmin => CurrentUser.Role == "Superadmin";

    private bool ShowModal;
    private bool IsNew;
    private InfoSlotListDto? EditSlot;
    private InfoSlotListDto? DeleteTarget;
    private string ActiveTab = "General";

    private string? EName, EDescription;
    private string EDisplayMode = "Ticker";
    private int ESecondsPerMessage = 10;
    private bool EIsActive = true;
    private HashSet<Guid> SelectedPGIds = [];

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (CurrentUser.Role == "Superadmin")
        {
            try { Tenants = (await Mediator.Send(new GetTenantsQuery(), _cts.Token)).ToList(); }
            catch { }
        }
        await LoadSlotsAsync();
    }

    private async Task OnTenantChanged(ChangeEventArgs e)
    {
        SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        Loading = true;
        try { InfoSlots = (await Mediator.Send(new GetInfoSlotsQuery(SelectedTenantId), _cts.Token)).ToList(); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Loading = false; }
    }

    private async Task LoadAvailablePGsAsync(Guid tenantId)
    {
        ModalLoading = true;
        try
        {
            var groups = await Mediator.Send(new GetPermissionGroupsQuery(tenantId), _cts.Token);
            AvailablePGs = groups.Where(g => g.IsActive).ToList();
        }
        catch { AvailablePGs = []; }
        finally { ModalLoading = false; }
    }

    private async Task OpenCreate()
    {
        EditSlot = null;
        IsNew = true;
        EName = "";
        EDescription = "";
        EDisplayMode = "Ticker";
        ESecondsPerMessage = 10;
        EIsActive = true;
        SelectedPGIds = [];
        ActiveTab = "General";
        SaveError = null;
        SaveSuccess = false;
        ShowModal = true;

        var tenantId = SelectedTenantId ?? CurrentUser.TenantId ?? Guid.Empty;
        if (tenantId != Guid.Empty)
            await LoadAvailablePGsAsync(tenantId);
    }

    private async Task OpenEdit(InfoSlotListDto s)
    {
        EditSlot = s;
        IsNew = false;
        EName = s.Name;
        EDescription = s.Description;
        EDisplayMode = s.DisplayMode;
        ESecondsPerMessage = s.SecondsPerMessage;
        EIsActive = s.IsActive;
        ActiveTab = "General";
        SaveError = null;
        SaveSuccess = false;
        ShowModal = true;

        var tenantId = SelectedTenantId ?? CurrentUser.TenantId ?? Guid.Empty;
        if (tenantId != Guid.Empty)
            await LoadAvailablePGsAsync(tenantId);

        SelectedPGIds = s.PermissionGroupIds.ToHashSet();
    }

    private void CloseModal()
    {
        ShowModal = false;
        SaveError = null;
        SaveSuccess = false;
    }

    private void ConfirmDelete(InfoSlotListDto s)
    {
        DeleteTarget = s;
        DeleteError = null;
    }

    private async Task SaveSlot()
    {
        if (Saving || ModalLoading) return;
        if (string.IsNullOrWhiteSpace(EName))
        {
            SaveError = L["InfoSlots_Name"] + " is required.";
            return;
        }

        Saving = true;
        SaveError = null;
        SaveSuccess = false;
        try
        {
            if (IsNew)
            {
                var result = await Mediator.Send(new CreateInfoSlotCommand(
                    EName!.Trim(),
                    EDescription?.Trim(),
                    EDisplayMode,
                    ESecondsPerMessage,
                    SelectedPGIds.ToList()), _cts.Token);

                if (!result.IsSuccess)
                {
                    SaveError = result.Error;
                    return;
                }
            }
            else if (EditSlot is not null)
            {
                var result = await Mediator.Send(new UpdateInfoSlotCommand(
                    EditSlot.Id,
                    EName!.Trim(),
                    EDescription?.Trim(),
                    EDisplayMode,
                    ESecondsPerMessage,
                    EIsActive,
                    SelectedPGIds.ToList()), _cts.Token);

                if (!result.IsSuccess)
                {
                    SaveError = result.Error;
                    return;
                }
            }
            CloseModal();
            await LoadSlotsAsync();
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task ExecuteDelete()
    {
        if (DeleteTarget is null) return;
        Deleting = true;
        DeleteError = null;
        try
        {
            var result = await Mediator.Send(new DeleteInfoSlotCommand(DeleteTarget.Id), _cts.Token);
            if (!result.IsSuccess)
            {
                DeleteError = result.Error;
                return;
            }
            DeleteTarget = null;
            await LoadSlotsAsync();
        }
        catch (Exception ex) { DeleteError = ex.Message; }
        finally { Deleting = false; }
    }

    private readonly CancellationTokenSource _cts = new();
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
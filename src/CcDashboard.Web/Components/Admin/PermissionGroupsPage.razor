@page "/admin/permission-groups"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@using MediatR
@using CcDashboard.Application.Commands.PermissionGroups
@using CcDashboard.Application.Queries.PermissionGroups
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Contracts.DTOs.PermissionGroups
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@using CcDashboard.Web.Components.Shared
@using CcDashboard.Application.Queries.InfoSlots
@using CcDashboard.Contracts.DTOs.InfoSlots
@implements IDisposable

<PageTitle>@L["PG_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["PG_Title"]</h1>
    <div class="d-flex align-items-center gap-2">
        <AuthorizeView Roles="Superadmin">
            @if (Tenants.Count > 0)
            {
                <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                <select class="form-select form-select-sm" style="width:auto"
                        value="@SelectedTenantId"
                        @onchange="OnTenantChanged">
                    <option value="">@L["Audit_AllTenants"]</option>
                    @foreach (var t in Tenants)
                    {
                        <option value="@t.Id">@t.Name</option>
                    }
                </select>
            }
        </AuthorizeView>
        <button class="btn btn-primary btn-sm text-nowrap" @onclick="OpenNew">
            <i class="bi bi-plus-lg me-1"></i>@L["PG_NewGroup"]
        </button>
    </div>
</div>

@if (SaveError is not null && !ShowModal)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @SaveError <button class="btn-close btn-sm" @onclick="() => SaveError = null"></button>
    </div>
}

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["PG_GroupName"]</th>
                    <th>@L["PG_Description"]</th>
                    @if (IsSuperadmin) { <th>@L["PG_Tenant"]</th> }
                    <th>@L["Common_Active"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Groups)
                {
                    <tr @key="g.Id">
                        <td class="fw-semibold">@g.Name</td>
                        <td class="text-muted small">@g.Description</td>
                        @if (IsSuperadmin)
                        {
                            <td class="small text-muted">@(Tenants.FirstOrDefault(t => t.Id == g.TenantId)?.Name ?? "—")</td>
                        }
                        <td>
                            @if (g.IsActive)
                            { <span class="badge bg-success">@L["Common_Active"]</span> }
                            else
                            { <span class="badge bg-secondary">@L["Common_Inactive"]</span> }
                        </td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenEdit(g)">@L["Edit"]</button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(g)">@L["Delete"]</button>
                        </td>
                    </tr>
                }
                @if (!Groups.Any())
                {
                    <tr><td colspan="@(IsSuperadmin ? 5 : 4)" class="text-center text-muted py-3">@L["PG_NoGroupSelected"]</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ShowModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-pg-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-pg-title">@(IsNew ? L["PG_NewGroup"] : L["PG_EditGroup"])</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (SaveError is not null)
                    {
                        <div class="alert alert-danger py-2">@SaveError</div>
                    }
                    @if (SaveSuccess)
                    {
                        <div class="alert alert-success py-2">@L["TenantSettings_Saved"]</div>
                    }

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@L["PG_GroupName"] *</label>
                            <input class="form-control" @bind="EName" maxlength="200" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">@L["PG_Description"]</label>
                            <input class="form-control" @bind="EDescription" maxlength="500" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="pgActive" @bind="EIsActive" />
                                <label class="form-check-label" for="pgActive">@L["PG_IsActive"]</label>
                            </div>
                        </div>
                    </div>

                    <ul class="nav nav-tabs mb-3">
                        @foreach (var tab in Tabs)
                        {
                            <li class="nav-item" @key="tab.Key">
                                <button class="nav-link @(ActiveTab == tab.Key ? "active" : "")"
                                        @onclick="() => ActiveTab = tab.Key">@L[tab.LabelKey]</button>
                            </li>
                        }
                    </ul>

                    @if (ActiveTab == "Menu")
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead><tr>
                                    <th>@L["PG_ColMenuItem"]</th>
                                    <th>@L["PG_ColPermissionKey"]</th>
                                    <th>@L["PG_ColAllowedRoles"]</th>
                                    <th>@L["PG_TabMenu"]</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var m in MenuItems)
                                    {
                                        <tr @key="m.Key" class="@(m.Restricted ? "text-muted" : "")">
                                            <td>@m.Label</td>
                                            <td><code class="small">@m.Key</code></td>
                                            <td class="small">@m.AllowedRoles</td>
                                            <td>
                                                <input class="form-check-input" type="checkbox"
                                                       checked="@SelectedMenuKeys.Contains(m.Key)"
                                                       disabled="@m.Restricted"
                                                       @onchange="e => ToggleMenuKey(m.Key, (bool)e.Value!)" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (ActiveTab == "Screens")
                    {
                        <DualPaneSelector TKey="Guid"
                                          AllItems="AvailableDashboards.Select(x => (x.Id, x.Name)).ToList()"
                                          SelectedIds="SelectedDashboardIds"
                                          SelectedIdsChanged="ids => { SelectedDashboardIds = ids; }" />
                    }
                    else if (ActiveTab == "Queues")
                    {
                        <DualPaneSelector TKey="Guid"
                                          AllItems="AvailableQueues.Select(x => (x.Id, x.Name)).ToList()"
                                          SelectedIds="SelectedQueueIds"
                                          SelectedIdsChanged="ids => { SelectedQueueIds = ids; }" />
                    }
                    else if (ActiveTab == "AgentGroups")
                    {
                        <DualPaneSelector TKey="Guid"
                                          AllItems="AvailableAgentGroups.Select(x => (x.Id, x.Name)).ToList()"
                                          SelectedIds="SelectedAgentGroupIds"
                                          SelectedIdsChanged="ids => { SelectedAgentGroupIds = ids; }" />
                    }
                    else if (ActiveTab == "BU")
                    {
                        <DualPaneSelector TKey="int"
                                          AllItems="AvailableBUs.Select(x => (x.Id, x.Name)).ToList()"
                                          SelectedIds="SelectedBusinessUnitIds"
                                          SelectedIdsChanged="ids => { SelectedBusinessUnitIds = ids; }" />
                    }
                    else if (ActiveTab == "SG")
                    {
                        <DualPaneSelector TKey="int"
                                          AllItems="AvailableSGs.Select(x => (x.Id, x.Name)).ToList()"
                                          SelectedIds="SelectedSupergroupIds"
                                          SelectedIdsChanged="ids => { SelectedSupergroupIds = ids; }" />
                    }
                    else if (ActiveTab == "InfoSlots")
                    {
                        <p class="text-muted small mb-3">@L["PG_InfoSlotsNote"]</p>
                        <DualPaneSelector TKey="Guid"
                                          AllItems="AvailableInfoSlots.Select(x => (x.Id, x.Name)).ToList()"
                                          SelectedIds="SelectedInfoSlotIds"
                                          SelectedIdsChanged="ids => { SelectedInfoSlotIds = ids; }" />
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseModal">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveGroup" disabled="@(Saving || ModalLoading)">
                        @if (Saving || ModalLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L["Common_Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (DeleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-delete-pg-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-delete-pg-title">@L["PG_DeleteGroup"]</h5>
                    <button class="btn-close" @onclick="() => DeleteTarget = null"></button>
                </div>
                <div class="modal-body">@L["Screens_AreYouSure"]: <strong>@DeleteTarget.Name</strong></div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => DeleteTarget = null">@L["Common_Cancel"]</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete">@L["Delete"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private record MenuItem(string Label, string Key, string AllowedRoles, bool Restricted = false);
    private record TabDef(string Key, string LabelKey);

    private static readonly MenuItem[] MenuItems =
    [
        new("Dashboards",         "menu.dashboards",        "All"),
        new("User Management",    "menu.users",             "Superadmin, Administrator"),
        new("Permission Groups",  "menu.permissionGroups",  "Superadmin, Administrator"),
        new("Widget Catalogue",   "menu.widgetCatalog",     "Superadmin, Administrator, Editor"),
        new("Audit Log",          "menu.audit",             "Superadmin, Administrator"),
        new("Tenant Settings",    "menu.tenantSettings",    "Superadmin, Administrator"),
        new("Tenant Management",  "menu.tenants",           "Superadmin only", Restricted: true),
        new("Info Slots",         "menu.infoSlots",         "All"),
    ];

    private static readonly TabDef[] Tabs =
    [
        new("Menu",        "PG_TabMenu"),
        new("Screens",     "PG_TabScreens"),
        new("Queues",      "PG_TabQueues"),
        new("AgentGroups", "PG_TabAgentGroups"),
        new("BU",          "PG_TabBu"),
        new("SG",          "PG_TabSg"),
        new("InfoSlots",   "PG_TabInfoSlots"),
    ];

    private List<PermissionGroupDto> Groups = [];
    private List<TenantDto> Tenants = [];
    private Guid? SelectedTenantId;
    private bool Loading = true;
    private string? SaveError;
    private bool SaveSuccess;
    private bool Saving;
    private bool ModalLoading;

    private bool IsSuperadmin => CurrentUser.Role == "Superadmin";

    private bool ShowModal;
    private bool IsNew;
    private PermissionGroupDto? EditGroup;
    private PermissionGroupDto? DeleteTarget;

    private string? EName, EDescription;
    private bool EIsActive = true;
    private HashSet<string> SelectedMenuKeys = [];
    private HashSet<Guid> SelectedDashboardIds = [];
    private HashSet<Guid> SelectedQueueIds = [];
    private HashSet<Guid> SelectedAgentGroupIds = [];
    private HashSet<int> SelectedBusinessUnitIds = [];
    private HashSet<int> SelectedSupergroupIds = [];
    private HashSet<Guid> SelectedInfoSlotIds = [];
    private string ActiveTab = "Menu";

    // Available entities for dual-pane selection
    private List<AvailableEntityDto> AvailableDashboards = [];
    private List<AvailableEntityDto> AvailableQueues = [];
    private List<AvailableEntityDto> AvailableAgentGroups = [];
    private List<AvailableEntityIntDto> AvailableBUs = [];
    private List<AvailableEntityIntDto> AvailableSGs = [];
    private List<InfoSlotListDto> AvailableInfoSlots = [];

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (CurrentUser.Role == "Superadmin")
        {
            try
            {
                Tenants = (await Mediator.Send(new GetTenantsQuery())).ToList();
                SelectedTenantId = null;
            }
            catch { /* non-critical */ }
        }
        await LoadGroupsAsync();
    }

    private async Task OnTenantChanged(ChangeEventArgs e)
    {
        SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        await LoadGroupsAsync();
    }

    private async Task LoadGroupsAsync()
    {
        Loading = true;
        try { Groups = (await Mediator.Send(new GetPermissionGroupsQuery(SelectedTenantId))).ToList(); }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Loading = false; }
    }

    private async Task LoadAvailableEntitiesAsync(Guid tenantId)
    {
        ModalLoading = true;
        try
        {
            var result = await Mediator.Send(new GetAvailableEntitiesQuery(tenantId));
            AvailableDashboards = result.Dashboards.ToList();
            AvailableQueues = result.Queues.ToList();
            AvailableAgentGroups = result.AgentGroups.ToList();
            AvailableBUs = result.BusinessUnits.ToList();
            AvailableSGs = result.Supergroups.ToList();
            AvailableInfoSlots = (await Mediator.Send(new GetInfoSlotsQuery(tenantId))).ToList();
        }
        catch { /* fallback to empty */ }
        finally { ModalLoading = false; }
    }

    private async Task OpenNew()
    {
        EditGroup = null; IsNew = true;
        EName = ""; EDescription = ""; EIsActive = true;
        SelectedMenuKeys        = ["menu.dashboards"];
        SelectedDashboardIds    = [];
        SelectedQueueIds        = [];
        SelectedAgentGroupIds   = [];
        SelectedBusinessUnitIds = [];
        SelectedSupergroupIds   = [];
        SelectedInfoSlotIds     = [];
        ActiveTab = "Menu"; SaveError = null; SaveSuccess = false;
        ShowModal = true;

        var tenantId = SelectedTenantId ?? CurrentUser.TenantId ?? Guid.Empty;
        if (tenantId != Guid.Empty)
            await LoadAvailableEntitiesAsync(tenantId);
    }

    private async Task OpenEdit(PermissionGroupDto g)
    {
        EditGroup = g; IsNew = false;
        EName = g.Name; EDescription = g.Description; EIsActive = g.IsActive;
        SelectedMenuKeys        = g.MenuPermissions.ToHashSet();
        SelectedDashboardIds    = g.AllowedDashboardIds.ToHashSet();
        SelectedQueueIds        = g.AllowedQueueIds.ToHashSet();
        SelectedAgentGroupIds   = g.AllowedAgentGroupIds.ToHashSet();
        SelectedBusinessUnitIds = g.AllowedBusinessUnitIds.ToHashSet();
        SelectedSupergroupIds   = g.AllowedSupergroupIds.ToHashSet();
        ActiveTab = "Menu"; SaveError = null; SaveSuccess = false;
        ShowModal = true;

        await LoadAvailableEntitiesAsync(g.TenantId);
        // Populate SelectedInfoSlotIds from Info Slots that have this PG in their permissions
        SelectedInfoSlotIds = AvailableInfoSlots
            .Where(s => s.PermissionGroupIds.Contains(g.Id))
            .Select(s => s.Id)
            .ToHashSet();
    }

    private void CloseModal() { ShowModal = false; SaveError = null; SaveSuccess = false; }

    private void ConfirmDelete(PermissionGroupDto g) => DeleteTarget = g;

    private void ToggleMenuKey(string key, bool value)
    {
        if (value) SelectedMenuKeys.Add(key);
        else SelectedMenuKeys.Remove(key);
    }

    private async Task SaveGroup()
    {
        if (Saving || ModalLoading) return;
        if (string.IsNullOrWhiteSpace(EName)) { SaveError = L["PG_GroupName"] + " is required."; return; }
        Saving = true; SaveError = null; SaveSuccess = false;
        try
        {
            if (IsNew)
            {
                var result = await Mediator.Send(new CreatePermissionGroupCommand(
                    new CreatePermissionGroupRequest(
                        EName!.Trim(), EDescription?.Trim(),
                        SelectedMenuKeys.ToList(),
                        SelectedQueueIds.ToList(),
                        SelectedAgentGroupIds.ToList(),
                        SelectedBusinessUnitIds.ToList(),
                        SelectedSupergroupIds.ToList(),
                        SelectedDashboardIds.ToList()),
                    SelectedTenantId));
                if (!result.IsSuccess) { SaveError = result.Error; return; }
            }
            else if (EditGroup is not null)
            {
                var result = await Mediator.Send(new UpdatePermissionGroupCommand(
                    new UpdatePermissionGroupRequest(
                        EditGroup.Id, EName!.Trim(), EDescription?.Trim(),
                        EIsActive,
                        SelectedMenuKeys.ToList(),
                        EditGroup.RowVersion,
                        SelectedQueueIds.ToList(),
                        SelectedAgentGroupIds.ToList(),
                        SelectedBusinessUnitIds.ToList(),
                        SelectedSupergroupIds.ToList(),
                        SelectedDashboardIds.ToList())));
                if (!result.IsSuccess) { SaveError = result.Error; return; }
            }
            CloseModal();
            await LoadGroupsAsync();
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task ExecuteDelete()
    {
        if (DeleteTarget is null) return;
        try
        {
            var result = await Mediator.Send(new DeletePermissionGroupCommand(DeleteTarget.Id));
            if (!result.IsSuccess) SaveError = result.Error;
            DeleteTarget = null;
            await LoadGroupsAsync();
        }
        catch (Exception ex) { SaveError = ex.Message; DeleteTarget = null; }
    }

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

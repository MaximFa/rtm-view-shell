@page "/admin/tenant-settings"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@using MediatR
@using CcDashboard.Application.Commands.TenantSettings
@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Contracts.DTOs.TenantSettings
@using Microsoft.AspNetCore.Authorization

<PageTitle>Tenant Settings — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Tenant Settings</h1>
</div>

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    @if (SaveError is not null)
    {
        <div class="alert alert-danger py-2 alert-dismissible">
            @SaveError <button class="btn-close btn-sm" @onclick="() => SaveError = null"></button>
        </div>
    }
    @if (SaveSuccess)
    {
        <div class="alert alert-success py-2">Settings saved.</div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold">Password Policy</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Minimum length</label>
                        <input type="number" class="form-control" min="8" max="128" @bind="PwdMinLength" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Expiry (days)</label>
                        <input type="number" class="form-control" min="1" max="365" @bind="PwdExpireDays" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold">Security</div>
                <div class="card-body">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="require2fa" @bind="Require2fa" />
                        <label class="form-check-label" for="require2fa">
                            Require 2FA for all users (Require2faForAll)
                        </label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Default locale (BCP-47)</label>
                        <input type="text" class="form-control" placeholder="en-US" @bind="DefaultLocale" maxlength="10" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold">Audit &amp; Data Retention</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Audit retention (days)</label>
                        <input type="number" class="form-control" min="30" max="3650" @bind="AuditRetentionDays" />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="softDelete" @bind="SoftDelete" />
                        <label class="form-check-label" for="softDelete">Soft-delete dashboards (SoftDeleteDashboards)</label>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Soft-delete retention (days)</label>
                        <input type="number" class="form-control" min="1" max="365" @bind="SoftDeleteRetentionDays" disabled="@(!SoftDelete)" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@Saving">
            @(Saving ? "Saving..." : "Save settings ->")
        </button>
    </div>
}

@code {
    private bool Loading = true;
    private bool Saving;
    private string? SaveError;
    private bool SaveSuccess;

    private int PwdMinLength = 12;
    private int PwdExpireDays = 90;
    private bool Require2fa;
    private int AuditRetentionDays = 365;
    private string DefaultLocale = "en-US";
    private bool SoftDelete;
    private int SoftDeleteRetentionDays = 90;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var settings = await Mediator.Send(new GetTenantSettingsQuery());
            if (settings is not null)
            {
                PwdMinLength = settings.PasswordMinLength;
                PwdExpireDays = settings.PasswordExpireDays;
                Require2fa = settings.Require2faForAll;
                AuditRetentionDays = settings.AuditRetentionDays;
                DefaultLocale = settings.DefaultLocale;
                SoftDelete = settings.SoftDeleteDashboards;
                SoftDeleteRetentionDays = settings.SoftDeleteRetentionDays;
            }
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Loading = false; }
    }

    private async Task SaveAsync()
    {
        Saving = true; SaveError = null; SaveSuccess = false;
        try
        {
            await Mediator.Send(new UpdateTenantSettingsCommand(
                new UpdateTenantSettingsRequest(
                    PwdMinLength, PwdExpireDays, Require2fa,
                    AuditRetentionDays, DefaultLocale,
                    SoftDelete, SoftDeleteRetentionDays)));
            SaveSuccess = true;
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }
}

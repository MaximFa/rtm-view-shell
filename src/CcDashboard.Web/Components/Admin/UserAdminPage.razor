@page "/admin/users"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@inject IUserManagementService UserMgmt
@inject ICurrentUserAccessor CurrentUser
@inject NavigationManager Nav
@using MediatR
@using CcDashboard.Application.Interfaces
@using CcDashboard.Application.Queries.Users
@using CcDashboard.Application.Queries.PermissionGroups
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Contracts.DTOs.Users
@using CcDashboard.Contracts.DTOs.PermissionGroups
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

<PageTitle>@L["Users_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Users_Title"]</h1>
    <div class="d-flex align-items-center gap-3">
        <AuthorizeView Roles="Superadmin">
            @if (Tenants.Count > 0)
            {
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                    <select class="form-select form-select-sm" style="width:auto"
                            value="@SelectedTenantId"
                            @onchange="OnTenantChanged">
                        <option value="">@L["Audit_AllTenants"]</option>
                        @foreach (var t in Tenants)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </select>
                </div>
            }
        </AuthorizeView>
        <button class="btn btn-primary btn-sm" @onclick="OpenCreate">@L["Users_NewUser"]</button>
    </div>
</div>

<!-- Toolbar -->
<div class="row g-2 mb-3">
    <div class="col-md-3">
        <input class="form-control form-control-sm" placeholder="@L["Users_SearchPlaceholder"]"
               @bind="Search" @bind:event="oninput" @onkeyup="OnSearchKey" />
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="RoleFilter" @bind:after="ResetAndLoad">
            <option value="">@L["Users_AllRoles"]</option>
            @foreach (var r in Roles) { <option value="@r">@r</option> }
        </select>
    </div>
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="PgFilter" @bind:after="ResetAndLoad">
            <option value="">@L["Users_AllGroups"]</option>
            @foreach (var pg in PermissionGroups)
            {
                <option value="@pg.Id">@pg.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="ActiveFilter" @bind:after="ResetAndLoad">
            <option value="">@L["Users_AllStatuses"]</option>
            <option value="true">@L["Common_Active"]</option>
            <option value="false">@L["Common_Inactive"]</option>
        </select>
    </div>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}

@if (Loading)
{
    <div class="text-center py-5"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-hover table-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["Users_ColUser"]</th>
                    <th>@L["Users_Username"]</th>
                    <th>@L["Users_ColRole"]</th>
                    <th>@L["Users_ColGroup"]</th>
                    @if (IsSuperadmin) { <th>@L["PG_Tenant"]</th> }
                    <th>@L["Users_ColStatus"]</th>
                    <th>@L["Users_ColLastLogin"]</th>
                    <th>@L["Users_Col2fa"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Users)
                {
                    <tr @key="u.Id">
                        <td>
                            <div class="d-flex align-items-start gap-2">
                                <div class="user-avatar">
                                    @AvatarInitial(u)
                                </div>
                                <div>
                                    <div class="fw-semibold">@FullName(u)</div>
                                    <div class="text-muted small">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="small text-muted">@u.UserName</td>
                        <td><span class="badge badge-@u.Role.ToLower()">@u.Role</span></td>
                        <td><span class="text-muted small">@(PermissionGroups.FirstOrDefault(pg => pg.Id == u.PermissionGroupId)?.Name ?? "—")</span></td>
                        @if (IsSuperadmin)
                        {
                            <td class="small text-muted">@(Tenants.FirstOrDefault(t => t.Id == u.TenantId)?.Name ?? "—")</td>
                        }
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">@L["Users_Active"]</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@L["Users_Inactive"]</span>
                            }
                        </td>
                        <td class="text-muted small">@(u.LastLoginAt?.ToLocalTime().ToString("dd MMM yy HH:mm") ?? "—")</td>
                        <td>@(u.Is2faEnabled ? "✓" : "")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-primary me-1"
                                    @onclick="() => OpenEdit(u)">@L["Edit"]</button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => OpenDeleteConfirm(u)">@L["Delete"]</button>
                        </td>
                    </tr>
                }
                @if (!Users.Any())
                {
                    <tr><td colspan="@(IsSuperadmin ? 9 : 8)" class="text-center text-muted py-3">@L["Audit_NoRecords"]</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        <span class="pagination-info">@TotalCount @L["Common_Records"]</span>
        <div class="pagination-controls">
            <select class="pagination-size" @bind="PageSize" @bind:after="ResetAndLoad">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="PrevPage">&#8249;</button>
            <span class="pagination-counter">@PageLabel</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="NextPage">&#8250;</button>
        </div>
    </div>
}

<!-- Create Modal -->
@if (ShowCreate)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-create-user-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-create-user-title">@L["Users_CreateModal"]</h5>
                    <button class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    @if (SaveError is not null) { <div class="alert alert-danger py-2">@SaveError</div> }
                    <div class="row g-2 mb-2">
                        <div class="col"><label class="form-label">@L["Users_FirstName"]</label><input class="form-control form-control-sm" @bind="CFirst" /></div>
                        <div class="col"><label class="form-label">@L["Users_LastName"]</label><input class="form-control form-control-sm" @bind="CLast" /></div>
                    </div>
                    <div class="mb-2"><label class="form-label">@L["Users_Email"] <span class="text-danger">*</span></label><input class="form-control form-control-sm" type="email" @bind="CEmail" /></div>
                    <div class="mb-2"><label class="form-label">@L["Users_Username"] <span class="text-danger">*</span></label><input class="form-control form-control-sm" @bind="CUserName" /></div>
                    <div class="mb-2">
                        <label class="form-label">@L["Users_Role"] <span class="text-danger">*</span></label>
                        <select class="form-select form-select-sm" @bind="CRole" @bind:after="StateHasChanged">
                            @foreach (var r in AllowedCreateRoles) { <option value="@r">@r</option> }
                        </select>
                    </div>
                    @if (CRole != "Superadmin")
                    {
                        <div class="mb-2">
                            <label class="form-label">@L["Users_PermissionGroup"]</label>
                            <select class="form-select form-select-sm" @bind="CPgId">
                                <option value="">@L["Users_SelectGroup"]</option>
                                @foreach (var pg in PermissionGroups) { <option value="@pg.Id">@pg.Name</option> }
                            </select>
                        </div>
                    }
                    <div class="form-text">@L["Users_TempPasswordNote"]</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModals">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="SaveCreate" disabled="@Saving">
                        @(Saving ? L["Common_Saving"].Value : L["Users_CreateButton"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- Edit Modal -->
@if (ShowEdit && EditUser is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-edit-user-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-edit-user-title">@L["Users_EditModal"] — @FullName(EditUser)</h5>
                    <button class="btn-close" @onclick="CloseModals"></button>
                </div>
                <div class="modal-body">
                    @if (SaveError is not null) { <div class="alert alert-danger py-2">@SaveError</div> }
                    <div class="row g-2 mb-2">
                        <div class="col"><label class="form-label">@L["Users_FirstName"]</label><input class="form-control form-control-sm" @bind="EFirst" /></div>
                        <div class="col"><label class="form-label">@L["Users_LastName"]</label><input class="form-control form-control-sm" @bind="ELast" /></div>
                    </div>
                    <div class="mb-2"><label class="form-label">@L["Users_Email"]</label><input class="form-control form-control-sm" type="email" @bind="EEmail" /></div>
                    <div class="mb-2">
                        <label class="form-label">@L["Users_Role"]</label>
                        <select class="form-select form-select-sm" @bind="ERole" @bind:after="StateHasChanged"
                                disabled="@(EditUser.Id == CurrentUser.UserId)">
                            @foreach (var r in AllowedCreateRoles) { <option value="@r">@r</option> }
                        </select>
                        @if (EditUser.Id == CurrentUser.UserId) { <div class="form-text">You cannot change your own role [USR-08]</div> }
                    </div>
                    @if (ERole != "Superadmin")
                    {
                        <div class="mb-2">
                            <label class="form-label">@L["Users_PermissionGroup"]</label>
                            <select class="form-select form-select-sm" @bind="EPgId">
                                <option value="">@L["Users_SelectGroup"]</option>
                                @foreach (var pg in PermissionGroups) { <option value="@pg.Id">@pg.Name</option> }
                            </select>
                        </div>
                    }
                    <div class="mb-2">
                        <label class="form-label">@L["Users_Locale"]</label>
                        <select class="form-select form-select-sm" @bind="ELocale">
                            <option value="en-US">English (US)</option>
                            <option value="ru-RU">Russian</option>
                            <option value="ar-AE">Arabic (UAE)</option>
                        </select>
                    </div>
                    <div class="d-flex gap-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isActive" @bind="EIsActive" />
                            <label class="form-check-label" for="isActive">@L["Common_Active"]</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="is2fa" @bind="E2fa" />
                            <label class="form-check-label" for="is2fa">2FA</label>
                        </div>
                    </div>
                    <div class="text-muted small mt-2">
                        Last login: @(EditUser.LastLoginAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? L["Users_Never"].Value)
                        &nbsp;·&nbsp; Created: @EditUser.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                    </div>
                    <hr />
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ResetPassword" disabled="@Saving">@L["Users_ResetPassword"]</button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="ForceLogout" disabled="@Saving">@L["Users_ForceLogout"]</button>
                        <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => ConfirmDelete = true" disabled="@ConfirmDelete">@L["Users_DeleteUser"]</button>
                    </div>
                    @if (ConfirmDelete)
                    {
                        <div class="mt-2 text-danger small">
                            @L["Screens_AreYouSure"]
                            <button class="btn btn-danger btn-sm ms-2" @onclick="DeleteUser">@L["Screens_YesDelete"]</button>
                            <button class="btn btn-secondary btn-sm ms-1" @onclick="() => ConfirmDelete = false">@L["Common_Cancel"]</button>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModals">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="SaveEdit" disabled="@Saving">
                        @(Saving ? L["Common_Saving"].Value : L["Common_Save"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (DeleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-delete-user-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-delete-user-title">@L["Users_DeleteUser"]</h5>
                    <button class="btn-close" @onclick="() => DeleteTarget = null"></button>
                </div>
                <div class="modal-body">
                    @L["Users_DeleteConfirm"]: <strong>@DeleteTarget.UserName</strong>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => DeleteTarget = null">@L["Cancel"]</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete" disabled="@Saving">@L["Delete"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Roles = ["Superadmin", "Administrator", "Editor", "Viewer"];
    private bool IsSuperadmin => CurrentUser.Role == "Superadmin";
    private string[] AllowedCreateRoles => IsSuperadmin ? Roles : ["Administrator", "Editor", "Viewer"];

    private List<UserDto> Users = [];
    private List<PermissionGroupDto> PermissionGroups = [];
    private List<TenantDto> Tenants = [];
    private Guid? SelectedTenantId;
    private bool Loading = true;
    private string? Error;
    private string? SaveError;
    private bool Saving;
    private int TotalCount;
    private int TotalPages => (int)Math.Ceiling((double)TotalCount / PageSize);
    private string PageLabel => $"{CurrentPage} / {TotalPages}";
    private int CurrentPage = 1;
    private int PageSize = 25;
    private string? Search;
    private string? RoleFilter;
    private string? PgFilter;
    private string? ActiveFilter;

    private bool ShowCreate;
    private string? CFirst, CLast, CEmail, CUserName;
    private string CRole = "Editor";
    private string? CPgId;

    private bool ShowEdit;
    private UserDto? EditUser;
    private string? EFirst, ELast, EEmail, ERole, ELocale;
    private string? EPgId;
    private bool EIsActive, E2fa;
    private bool ConfirmDelete;
    private UserDto? DeleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (CurrentUser.Role == "Superadmin")
        {
            try
            {
                Tenants = (await Mediator.Send(new GetTenantsQuery())).ToList();
                SelectedTenantId = null;
            }
            catch { /* non-critical */ }
        }
        await LoadPermissionGroupsAsync();
        await LoadAsync();
    }

    private async Task OnTenantChanged(ChangeEventArgs e)
    {
        SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        PgFilter = null;
        CurrentPage = 1;
        await LoadPermissionGroupsAsync();
        await LoadAsync();
    }

    private async Task LoadPermissionGroupsAsync()
    {
        try { PermissionGroups = (await Mediator.Send(new GetPermissionGroupsQuery(SelectedTenantId))).ToList(); }
        catch { PermissionGroups = []; }
    }

    private async Task LoadAsync()
    {
        Loading = true; Error = null;
        try
        {
            Guid? pgId = Guid.TryParse(PgFilter, out var g) ? g : null;
            bool? active = ActiveFilter == "true" ? true : ActiveFilter == "false" ? false : null;
            var result = await Mediator.Send(new GetUsersQuery(
                new UserListRequest(Search, RoleFilter, pgId, active, CurrentPage, PageSize),
                SelectedTenantId));
            Users = result.Items.ToList();
            TotalCount = result.TotalCount;
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Loading = false; }
    }

    private async Task ResetAndLoad() { CurrentPage = 1; await LoadAsync(); }
    private async Task PrevPage() { CurrentPage--; await LoadAsync(); }
    private async Task NextPage() { CurrentPage++; await LoadAsync(); }
    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await ResetAndLoad(); }

    private void OpenCreate()
    {
        CFirst = CLast = CEmail = CUserName = CPgId = null;
        CRole = "Editor"; SaveError = null; ShowCreate = true; ShowEdit = false;
    }

    private void OpenEdit(UserDto u)
    {
        EditUser = u; EFirst = u.FirstName; ELast = u.LastName; EEmail = u.Email;
        ERole = u.Role; ELocale = u.PreferredLocale; EIsActive = u.IsActive; E2fa = u.Is2faEnabled;
        EPgId = u.PermissionGroupId?.ToString(); ConfirmDelete = false;
        SaveError = null; ShowEdit = true; ShowCreate = false;
    }

    private void CloseModals() { ShowCreate = false; ShowEdit = false; SaveError = null; DeleteTarget = null; }

    private void OpenDeleteConfirm(UserDto u) => DeleteTarget = u;

    private async Task SaveCreate()
    {
        if (string.IsNullOrWhiteSpace(CEmail) || string.IsNullOrWhiteSpace(CUserName))
        { SaveError = L["Users_Email"] + " and " + L["Users_Username"] + " are required."; return; }
        Saving = true; SaveError = null;
        try
        {
            var pgId = Guid.TryParse(CPgId, out var g) ? g : (Guid?)null;
            var tenantId = SelectedTenantId ?? CurrentUser.TenantId!.Value;
            var (ok, err, _) = await UserMgmt.CreateAsync(tenantId,
                new CreateUserRequest(CUserName!, CEmail!, CFirst ?? "", CLast ?? "", CRole, pgId));
            if (ok) { CloseModals(); await LoadAsync(); }
            else SaveError = err;
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task SaveEdit()
    {
        if (EditUser is null) return;
        Saving = true; SaveError = null;
        try
        {
            var pgId = Guid.TryParse(EPgId, out var g) ? g : (Guid?)null;
            var roleToSave = EditUser.Id == CurrentUser.UserId ? EditUser.Role : (ERole ?? EditUser.Role);
            var (ok, err) = await UserMgmt.UpdateAsync(new UpdateUserRequest(
                EditUser.Id, EFirst ?? "", ELast ?? "", EEmail ?? EditUser.Email,
                roleToSave, pgId, EIsActive, E2fa, ELocale ?? "en-US"));
            if (ok) { CloseModals(); await LoadAsync(); }
            else SaveError = err;
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task ResetPassword()
    {
        if (EditUser is null) return;
        Saving = true; SaveError = null;
        try
        {
            var resetUrl = Nav.BaseUri + "reset-password";
            var (ok, err) = await UserMgmt.AdminResetPasswordAsync(EditUser.Id, resetUrl);
            if (ok) SaveError = L["Users_ResetEmailSent"];
            else SaveError = err;
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task ForceLogout()
    {
        if (EditUser is null) return;
        Saving = true;
        try { await UserMgmt.ForceLogoutAsync(EditUser.Id); SaveError = L["Users_LoggedOut"]; }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task DeleteUser()
    {
        if (EditUser is null) return;
        Saving = true;
        try
        {
            var (ok, err) = await UserMgmt.DeleteAsync(EditUser.Id);
            if (ok) { CloseModals(); await LoadAsync(); }
            else SaveError = err;
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task ExecuteDelete()
    {
        if (DeleteTarget is null) return;
        Saving = true;
        try
        {
            var (ok, err) = await UserMgmt.DeleteAsync(DeleteTarget.Id);
            if (ok) { DeleteTarget = null; await LoadAsync(); }
            else Error = err;
        }
        catch (Exception ex) { Error = ex.Message; }
        finally { Saving = false; DeleteTarget = null; }
    }

    private static string AvatarInitial(UserDto u) =>
        (!string.IsNullOrEmpty(u.FirstName) ? u.FirstName[0].ToString() :
         !string.IsNullOrEmpty(u.UserName) ? u.UserName[0].ToString() : "?").ToUpper();

    private static string FullName(UserDto u) =>
        string.IsNullOrWhiteSpace(u.FirstName + u.LastName) ? u.UserName
        : $"{u.FirstName} {u.LastName}".Trim();

    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

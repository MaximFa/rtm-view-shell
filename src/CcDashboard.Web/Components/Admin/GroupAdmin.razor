@page "/admin/groups"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IPermissionService PermissionService

<PageTitle>Permission Groups — RTM View</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Permission Groups</h1>
    <button class="btn btn-primary" @onclick="ShowCreate">+ New Group</button>
</div>

@if (_showForm)
{
    <div class="card shadow-sm mb-4" style="max-width:520px;">
        <div class="card-body p-4">
            <h5 class="card-title">@(_editId is null ? "New Group" : "Edit Group")</h5>

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input class="form-control" @bind="_formName" placeholder="Group name" />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea class="form-control" rows="2" @bind="_formDesc" placeholder="Optional description" />
            </div>
            <div class="mb-3">
                <label class="form-label">
                    Menu Permissions
                    <span class="text-muted small">(one key per line, e.g. dashboard.create)</span>
                </label>
                <textarea class="form-control font-monospace" rows="4"
                          @bind="_formMenuPermissions"
                          placeholder="dashboard.create&#10;admin.users&#10;admin.groups" />
            </div>

            @if (_formError is not null)
            {
                <div class="alert alert-danger py-2">@_formError</div>
            }

            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveGroupAsync" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
                <button class="btn btn-outline-secondary" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status" />
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Menu Permissions</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in _groups)
                    {
                        <tr>
                            <td class="fw-semibold">@group.Name</td>
                            <td class="text-muted small">@group.Description</td>
                            <td>
                                <span class="badge bg-secondary">@group.MenuPermissions.Count keys</span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-secondary me-1"
                                        @onclick="() => ShowEdit(group)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteAsync(group.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                    @if (_groups.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No groups yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@code {
    private List<PermissionGroupDto> _groups = new();
    private bool _loading = true;
    private bool _showForm;
    private bool _saving;
    private string? _error;
    private string? _formError;
    private Guid? _editId;
    private string _formName = string.Empty;
    private string _formDesc = string.Empty;
    private string _formMenuPermissions = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try { _groups = (await PermissionService.GetAllGroupsAsync()).ToList(); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private void ShowCreate()
    {
        _editId = null;
        _formName = _formDesc = _formMenuPermissions = string.Empty;
        _formError = null;
        _showForm = true;
    }

    private void ShowEdit(PermissionGroupDto g)
    {
        _editId = g.Id;
        _formName = g.Name;
        _formDesc = g.Description;
        _formMenuPermissions = string.Join("\n", g.MenuPermissions);
        _formError = null;
        _showForm = true;
    }

    private void CancelForm() => _showForm = false;

    private async Task SaveGroupAsync()
    {
        if (string.IsNullOrWhiteSpace(_formName))
        {
            _formError = "Name is required.";
            return;
        }

        _saving = true;
        _formError = null;

        var perms = _formMenuPermissions
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();

        try
        {
            if (_editId is null)
            {
                var created = await PermissionService.CreateGroupAsync(
                    new CreatePermissionGroupRequest(_formName, _formDesc, perms));
                _groups.Add(created);
            }
            else
            {
                var updated = await PermissionService.UpdateGroupAsync(
                    _editId.Value, new UpdatePermissionGroupRequest(_formName, _formDesc, perms));
                var i = _groups.FindIndex(g => g.Id == _editId.Value);
                if (i >= 0) _groups[i] = updated;
            }
            _showForm = false;
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        try
        {
            await PermissionService.DeleteGroupAsync(id);
            _groups.RemoveAll(g => g.Id == id);
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}

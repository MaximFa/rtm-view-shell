@page "/platform/tenants"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin")]
@inject IMediator Mediator
@using MediatR
@using CcDashboard.Application.Commands.Tenants
@using CcDashboard.Application.Commands.TenantSettings
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Contracts.DTOs.TenantSettings
@using CcDashboard.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

<PageTitle>@L["Tenants_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Tenants_Title"]</h1>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">@L["Tenants_NewTenant"]</button>
</div>

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>@L["Tenants_ColName"]</th>
                    <th>@L["Tenants_ColSlug"]</th>
                    <th>@L["Tenants_ColStatus"]</th>
                    <th>@L["Tenants_ColCreated"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Tenants)
                {
                    <tr @key="t.Id">
                        <td class="fw-semibold">@t.Name</td>
                        <td class="small text-muted"><code>@t.Slug</code></td>
                        <td>@StatusBadge(t.Status)</td>
                        <td class="small">@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenEdit(t)">
                                @L["Edit"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ActionError is not null)
{
    <div class="alert alert-danger py-2 mt-2 alert-dismissible">
        @ActionError <button class="btn-close btn-sm" @onclick="() => ActionError = null"></button>
    </div>
}

<!-- Create modal -->
@if (ShowCreate)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-create-tenant-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-create-tenant-title">@L["Tenants_CreateModal"]</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowCreate = false"></button>
                </div>
                <div class="modal-body">
                    @if (SaveError is not null) { <div class="alert alert-danger py-2">@SaveError</div> }
                    <div class="mb-3">
                        <label class="form-label">@L["Tenants_Name"] <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="NewName" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Tenants_Slug"] <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="NewSlug" maxlength="100" placeholder="acme" />
                        <div class="form-text">@L["Tenants_SlugHelp"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => ShowCreate = false">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="CreateTenant" disabled="@Saving">
                        @(Saving ? L["Common_Saving"].Value : L["Tenants_CreateButton"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

<!-- Edit modal -->
@if (EditTenant is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-edit-tenant-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-edit-tenant-title">@L["Tenants_EditModal"]</h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    @if (EditSaveError is not null)
                    {
                        <div class="alert alert-danger py-2 alert-dismissible">
                            @EditSaveError
                            <button class="btn-close btn-sm" @onclick="() => EditSaveError = null"></button>
                        </div>
                    }
                    @if (EditSaveSuccess)
                    {
                        <div class="alert alert-success py-2">@L["TenantSettings_Saved"]</div>
                    }

                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(EditTab == "general" ? "active" : "")"
                                    @onclick='() => EditTab = "general"'>
                                @L["Tenants_TabGeneral"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(EditTab == "settings" ? "active" : "")"
                                    @onclick='() => EditTab = "settings"'>
                                @L["Tenants_TabSettings"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(EditTab == "appearance" ? "active" : "")"
                                    @onclick='() => EditTab = "appearance"'>
                                @L["Tenants_TabAppearance"]
                            </button>
                        </li>
                    </ul>

                    @if (EditTab == "general")
                    {
                        <div class="mb-3">
                            <label class="form-label">@L["Tenants_Name"] <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="EditName" maxlength="200" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["Tenants_Slug"]</label>
                            <input class="form-control" value="@EditTenant.Slug" disabled />
                            <div class="form-text text-muted">@L["Tenants_SlugReadOnly"]</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">@L["Tenants_ColStatus"]</label>
                            <div>@StatusBadge(EditTenant.Status)</div>
                        </div>
                    }
                    else if (EditTab == "settings")
                    {
                        @if (EditSettingsLoading)
                        {
                            <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_Licensing"]</div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <label class="form-label small">@L["TenantSettings_PurchasedLicences"]</label>
                                                <input type="number" class="form-control form-control-sm" min="0" @bind="EditPurchasedLicences" />
                                                <div class="form-text">@L["TenantSettings_LicencesHelp"]</div>
                                            </div>
                                            <div class="mb-0">
                                                <label class="form-label small">@L["TenantSettings_MaxConcurrentConnections"]</label>
                                                <input type="number" class="form-control form-control-sm" min="0" @bind="EditMaxConcurrentConnections" />
                                                <div class="form-text">@L["TenantSettings_ConnectionsHelp"]</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_PasswordPolicy"]</div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <label class="form-label small">@L["TenantSettings_MinLength"]</label>
                                                <input type="number" class="form-control form-control-sm" min="8" max="128" @bind="EditPwdMinLength" />
                                            </div>
                                            <div class="mb-0">
                                                <label class="form-label small">@L["TenantSettings_ExpireDays"]</label>
                                                <input type="number" class="form-control form-control-sm" min="1" max="365" @bind="EditPwdExpireDays" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_Security"]</div>
                                        <div class="card-body">
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="checkbox" id="editRequire2fa" @bind="EditRequire2fa" />
                                                <label class="form-check-label small" for="editRequire2fa">@L["TenantSettings_Require2fa"]</label>
                                            </div>
                                            <div class="mb-0">
                                                <label class="form-label small">@L["TenantSettings_DefaultLocale"]</label>
                                                <select class="form-select form-select-sm" @bind="EditDefaultLocale">
                                                    <option value="en-US">English</option>
                                                    <option value="he-IL">Hebrew</option>
                                                    <option value="ru-RU">Russian</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_SignalR"]</div>
                                        <div class="card-body">
                                            <label class="form-label small">@L["TenantSettings_SignalRUrl"]</label>
                                            <input type="text" class="form-control form-control-sm" placeholder="http://localhost:5045" @bind="EditSignalRConnectionUrl" />
                                            <div class="form-text">@L["TenantSettings_SignalRUrlHelp"]</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_DataRetention"]</div>
                                        <div class="card-body">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label small">@L["TenantSettings_AuditRetention"]</label>
                                                    <input type="number" class="form-control form-control-sm" min="30" max="3650" @bind="EditAuditRetentionDays" />
                                                </div>
                                                <div class="col-md-4 pb-2">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="editSoftDelete" @bind="EditSoftDelete" />
                                                        <label class="form-check-label small" for="editSoftDelete">@L["TenantSettings_SoftDelete"]</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small">@L["TenantSettings_SoftDeleteRetention"]</label>
                                                    <input type="number" class="form-control form-control-sm" min="1" max="365"
                                                           @bind="EditSoftDeleteRetentionDays" disabled="@(!EditSoftDelete)" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (EditTab == "appearance")
                    {
                        <div class="row g-3">
                            <!-- Background Colors -->
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                        @L["TenantSettings_BackgroundColors"]
                                        <span class="badge bg-secondary">@EditBackgroundColors.Count</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var color in EditBackgroundColors)
                                            {
                                                <div class="color-swatch-wrapper">
                                                    <div class="color-swatch" style="background-color: @color;" title="@color">
                                                        <button class="color-remove-btn" @onclick="() => EditBackgroundColors.Remove(color)">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                    <span class="color-code">@color</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color" @bind="NewBackgroundColor" />
                                            <input type="text" class="form-control form-control-sm" style="width: 100px;" @bind="NewBackgroundColor" maxlength="7" />
                                            <button class="btn btn-sm btn-outline-primary" @onclick="AddBackgroundColor">
                                                <i class="bi bi-plus"></i> @L["Common_Add"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Font Colors -->
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                        @L["TenantSettings_FontColors"]
                                        <span class="badge bg-secondary">@EditFontColors.Count</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var color in EditFontColors)
                                            {
                                                <div class="color-swatch-wrapper">
                                                    <div class="color-swatch" style="background-color: @color;" title="@color">
                                                        <button class="color-remove-btn" @onclick="() => EditFontColors.Remove(color)">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                    <span class="color-code">@color</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color" @bind="NewFontColor" />
                                            <input type="text" class="form-control form-control-sm" style="width: 100px;" @bind="NewFontColor" maxlength="7" />
                                            <button class="btn btn-sm btn-outline-primary" @onclick="AddFontColor">
                                                <i class="bi bi-plus"></i> @L["Common_Add"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Font Sizes -->
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                        @L["TenantSettings_FontSizes"]
                                        <span class="badge bg-secondary">@EditFontSizes.Count</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var size in EditFontSizes)
                                            {
                                                <div class="font-size-badge">
                                                    <span>@size px</span>
                                                    <button class="btn-close btn-close-sm ms-1" @onclick="() => EditFontSizes.Remove(size)"></button>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="number" class="form-control form-control-sm" style="width: 80px;" @bind="NewFontSize" min="8" max="72" />
                                            <span class="text-muted small">px</span>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="AddFontSize">
                                                <i class="bi bi-plus"></i> @L["Common_Add"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Danger Zone (not for platform tenant) -->
                    @if (EditTenant.Status != TenantStatus.Deleted && EditTenant.Slug != "platform")
                    {
                        <div class="mt-4 pt-3 border-top border-danger">
                            <h6 class="text-danger mb-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                @L["Screens_DangerZone"]
                            </h6>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @if (EditTenant.Status == TenantStatus.Active)
                                {
                                    <button class="btn btn-outline-warning btn-sm"
                                            @onclick="() => SetStatusFromModal(TenantStatus.Suspended)">
                                        <i class="bi bi-pause-circle me-1"></i>
                                        @L["Tenants_Suspend"]
                                    </button>
                                }
                                else if (EditTenant.Status == TenantStatus.Suspended)
                                {
                                    <button class="btn btn-outline-success btn-sm"
                                            @onclick="() => SetStatusFromModal(TenantStatus.Active)">
                                        <i class="bi bi-play-circle me-1"></i>
                                        @L["Tenants_Activate"]
                                    </button>
                                }

                                @if (!ConfirmDeleteInModal)
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ConfirmDeleteInModal = true">
                                        <i class="bi bi-trash me-1"></i>
                                        @L["Tenants_Delete"]
                                    </button>
                                }
                                else
                                {
                                    <span class="text-danger small me-2">@L["Tenants_ConfirmDelete"]</span>
                                    <button class="btn btn-danger btn-sm"
                                            @onclick="DeleteFromModal">
                                        @L["Common_Yes"]
                                    </button>
                                    <button class="btn btn-secondary btn-sm"
                                            @onclick="() => ConfirmDeleteInModal = false">
                                        @L["Common_No"]
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEdit">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="SaveEdit" disabled="@(EditSaving || EditSettingsLoading)">
                        @(EditSaving ? L["Common_Saving"].Value : L["Tenants_EditButton"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

@code {
    private List<TenantDto> Tenants = [];
    private bool Loading = true;
    private string? Error;
    private string? ActionError;
    private string? SaveError;
    private bool Saving;
    private bool ShowCreate;
    private string? NewName;
    private string? NewSlug;
    private bool ConfirmDeleteInModal;

    // Edit state
    private TenantDto? EditTenant;
    private string EditTab = "general";
    private string EditName = "";
    private bool EditSettingsLoading;
    private bool EditSaving;
    private string? EditSaveError;
    private bool EditSaveSuccess;

    // Settings fields
    private int EditPwdMinLength = 12;
    private int EditPwdExpireDays = 90;
    private bool EditRequire2fa;
    private int EditAuditRetentionDays = 365;
    private string EditDefaultLocale = "en-US";
    private bool EditSoftDelete;
    private int EditSoftDeleteRetentionDays = 90;
    private int EditPurchasedLicences = 0;
    private int EditMaxConcurrentConnections = 0;
    private string? EditSignalRConnectionUrl;

    // Appearance settings
    private List<string> EditBackgroundColors = new();
    private List<string> EditFontColors = new();
    private List<string> EditFontSizes = new();
    private string NewBackgroundColor = "#FFFFFF";
    private string NewFontColor = "#000000";
    private string NewFontSize = "14";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        try { Tenants = (await Mediator.Send(new GetTenantsQuery(), _cts.Token)).ToList(); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Error = ex.Message; }
        finally { Loading = false; }
    }

    private void OpenCreate()
    {
        NewName = null; NewSlug = null; SaveError = null; ShowCreate = true;
    }

    private async Task CreateTenant()
    {
        if (string.IsNullOrWhiteSpace(NewName) || string.IsNullOrWhiteSpace(NewSlug))
        { SaveError = L["Tenants_Name"] + " and " + L["Tenants_Slug"] + " are required."; return; }
        Saving = true; SaveError = null;
        try
        {
            await Mediator.Send(new CreateTenantCommand(new CreateTenantRequest(NewSlug, NewName)));
            ShowCreate = false; await LoadAsync();
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task SetStatusFromModal(TenantStatus status)
    {
        if (EditTenant is null) return;
        EditSaveError = null;
        try
        {
            await Mediator.Send(new SetTenantStatusCommand(EditTenant.Id, status));
            await LoadAsync();
            EditTenant = Tenants.FirstOrDefault(t => t.Id == EditTenant.Id);
            ConfirmDeleteInModal = false;
        }
        catch (Exception ex) { EditSaveError = ex.Message; }
    }

    private async Task DeleteFromModal()
    {
        if (EditTenant is null) return;
        EditSaveError = null;
        try
        {
            await Mediator.Send(new SetTenantStatusCommand(EditTenant.Id, TenantStatus.Deleted));
            await LoadAsync();
            CloseEdit();
        }
        catch (Exception ex) { EditSaveError = ex.Message; }
    }

    private async Task OpenEdit(TenantDto t)
    {
        EditTenant = t;
        EditName = t.Name;
        EditTab = "general";
        EditSaveError = null;
        EditSaveSuccess = false;
        ConfirmDeleteInModal = false;
        await LoadEditSettings(t.Id);
    }

    private void CloseEdit()
    {
        EditTenant = null;
        EditSaveError = null;
        EditSaveSuccess = false;
    }

    private async Task LoadEditSettings(Guid tenantId)
    {
        EditSettingsLoading = true;
        try
        {
            var s = await Mediator.Send(new GetTenantSettingsQuery(tenantId));
            EditPwdMinLength = s?.PasswordMinLength ?? 12;
            EditPwdExpireDays = s?.PasswordExpireDays ?? 90;
            EditRequire2fa = s?.Require2faForAll ?? false;
            EditAuditRetentionDays = s?.AuditRetentionDays ?? 365;
            EditDefaultLocale = s?.DefaultLocale ?? "en-US";
            EditSoftDelete = s?.SoftDeleteDashboards ?? false;
            EditSoftDeleteRetentionDays = s?.SoftDeleteRetentionDays ?? 90;
            EditPurchasedLicences = s?.PurchasedLicences ?? 0;
            EditMaxConcurrentConnections = s?.MaxConcurrentConnections ?? 0;
            EditSignalRConnectionUrl = s?.SignalRConnectionUrl;
            EditBackgroundColors = s?.BackgroundColorPalette?.ToList() ?? GetDefaultBackgroundColors();
            EditFontColors = s?.FontColorPalette?.ToList() ?? GetDefaultFontColors();
            EditFontSizes = s?.FontSizes?.ToList() ?? GetDefaultFontSizes();
        }
        catch { /* use defaults */ }
        finally { EditSettingsLoading = false; }
    }

    private static List<string> GetDefaultBackgroundColors() => new()
    {
        "#FFFFFF", "#F5F5F5", "#E8F5E9", "#FFF3E0", "#FFEBEE",
        "#E3F2FD", "#F3E5F5", "#FFFDE7", "#E0F7FA", "#FBE9E7"
    };

    private static List<string> GetDefaultFontColors() => new()
    {
        "#000000", "#333333", "#666666", "#1976D2", "#388E3C",
        "#D32F2F", "#7B1FA2", "#F57C00", "#0097A7", "#5D4037"
    };

    private static List<string> GetDefaultFontSizes() => new()
    {
        "10", "11", "12", "13", "14", "16", "18", "20", "24", "28", "32"
    };

    private void AddBackgroundColor()
    {
        var color = NewBackgroundColor?.Trim().ToUpperInvariant();
        if (!string.IsNullOrEmpty(color) && !EditBackgroundColors.Contains(color))
        {
            EditBackgroundColors.Add(color);
            NewBackgroundColor = "#FFFFFF";
        }
    }

    private void AddFontColor()
    {
        var color = NewFontColor?.Trim().ToUpperInvariant();
        if (!string.IsNullOrEmpty(color) && !EditFontColors.Contains(color))
        {
            EditFontColors.Add(color);
            NewFontColor = "#000000";
        }
    }

    private void AddFontSize()
    {
        if (!string.IsNullOrEmpty(NewFontSize) && !EditFontSizes.Contains(NewFontSize))
        {
            EditFontSizes.Add(NewFontSize);
            NewFontSize = "14";
        }
    }

    private async Task SaveEdit()
    {
        if (EditTenant is null) return;
        if (string.IsNullOrWhiteSpace(EditName))
        { EditSaveError = L["Tenants_Name"] + " is required."; return; }

        EditSaving = true; EditSaveError = null; EditSaveSuccess = false;
        try
        {
            await Mediator.Send(new UpdateTenantCommand(EditTenant.Id, EditName));
            await Mediator.Send(new UpdateTenantSettingsCommand(
                new UpdateTenantSettingsRequest(
                    EditPwdMinLength, EditPwdExpireDays, EditRequire2fa,
                    EditAuditRetentionDays, EditDefaultLocale,
                    EditSoftDelete, EditSoftDeleteRetentionDays,
                    EditPurchasedLicences, EditMaxConcurrentConnections,
                    EditSignalRConnectionUrl,
                    EditBackgroundColors, EditFontColors, EditFontSizes),
                EditTenant.Id));
            EditSaveSuccess = true;
            await LoadAsync();
            // Update the displayed tenant name in the modal header
            EditTenant = Tenants.FirstOrDefault(t => t.Id == EditTenant.Id) ?? EditTenant;
        }
        catch (Exception ex) { EditSaveError = ex.Message; }
        finally { EditSaving = false; }
    }

    private RenderFragment StatusBadge(TenantStatus status) => status switch
    {
        TenantStatus.Active => @<span class="badge bg-success">@L["Tenants_Active"]</span>,
        TenantStatus.Suspended => @<span class="badge bg-warning text-dark">@L["Tenants_Suspended"]</span>,
        _ => @<span class="badge bg-secondary">@L["Tenants_Deleted"]</span>
    };

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

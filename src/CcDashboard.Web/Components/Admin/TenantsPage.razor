@page "/platform/tenants"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin")]
@inject IMediator Mediator
@using MediatR
@using CcDashboard.Application.Commands.Tenants
@using CcDashboard.Application.Commands.TenantSettings
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Contracts.DTOs.TenantSettings
@using CcDashboard.Domain.Enums
@using CcDashboard.Application.Queries.AgentStates
@using CcDashboard.Application.Commands.AgentStates
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

<PageTitle>@L["Tenants_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Tenants_Title"]</h1>
    <button class="btn btn-primary btn-sm" @onclick="OpenCreate">@L["Tenants_NewTenant"]</button>
</div>

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else if (Error is not null)
{
    <div class="alert alert-danger py-2">@Error</div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>@L["Tenants_ColName"]</th>
                    <th>@L["Tenants_ColSlug"]</th>
                    <th>@L["Tenants_ColStatus"]</th>
                    <th>@L["Tenants_ColCreated"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in PagedTenants)
                {
                    <tr @key="t.Id">
                        <td class="fw-semibold">@t.Name</td>
                        <td class="small text-muted"><code>@t.Slug</code></td>
                        <td>@StatusBadge(t.Status)</td>
                        <td class="small">@t.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => OpenEdit(t)">
                                @L["Edit"]
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <AppPagination TotalCount="Tenants.Count" Page="_page" PageSize="_pageSize"
                   PageChanged="p => { _page = p; StateHasChanged(); }" PageSizeChanged="s => { _pageSize = s; _page = 1; StateHasChanged(); }" />
}

@if (ActionError is not null)
{
    <div class="alert alert-danger py-2 mt-2 alert-dismissible">
        @ActionError <button class="btn-close btn-sm" @onclick="() => ActionError = null"></button>
    </div>
}

<!-- Create modal -->
@if (ShowCreate)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-create-tenant-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-create-tenant-title">@L["Tenants_CreateModal"]</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowCreate = false"></button>
                </div>
                <div class="modal-body">
                    @if (SaveError is not null) { <div class="alert alert-danger py-2">@SaveError</div> }
                    <div class="mb-3">
                        <label class="form-label">@L["Tenants_Name"] <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="NewName" maxlength="200" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Tenants_Slug"] <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="NewSlug" maxlength="100" placeholder="acme" />
                        <div class="form-text">@L["Tenants_SlugHelp"]</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => ShowCreate = false">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="CreateTenant" disabled="@Saving">
                        @(Saving ? L["Common_Saving"].Value : L["Tenants_CreateButton"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

<!-- Edit modal -->
@if (EditTenant is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-edit-tenant-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-edit-tenant-title">@L["Tenants_EditModal"]</h5>
                    <button type="button" class="btn-close" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    @if (EditSaveError is not null)
                    {
                        <div class="alert alert-danger py-2 alert-dismissible">
                            @EditSaveError
                            <button class="btn-close btn-sm" @onclick="() => EditSaveError = null"></button>
                        </div>
                    }
                    @if (EditSaveSuccess)
                    {
                        <div class="alert alert-success py-2">@L["TenantSettings_Saved"]</div>
                    }

                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(EditTab == "general" ? "active" : "")"
                                    @onclick='() => EditTab = "general"'>
                                @L["Tenants_TabGeneral"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(EditTab == "settings" ? "active" : "")"
                                    @onclick='() => EditTab = "settings"'>
                                @L["Tenants_TabSettings"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(EditTab == "appearance" ? "active" : "")"
                                    @onclick='() => EditTab = "appearance"'>
                                @L["Tenants_TabAppearance"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(EditTab == "agentstates" ? "active" : "")"
                                    @onclick="OpenAgentStatesTab">
                                @L["Tenants_TabAgentStates"]
                            </button>
                        </li>
                    </ul>

                    @if (EditTab == "general")
                    {
                        <div class="mb-3">
                            <label class="form-label">@L["Tenants_Name"] <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="EditName" maxlength="200" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@L["Tenants_Slug"]</label>
                            <input class="form-control" value="@EditTenant.Slug" disabled />
                            <div class="form-text text-muted">@L["Tenants_SlugReadOnly"]</div>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">@L["Tenants_ColStatus"]</label>
                            <div>@StatusBadge(EditTenant.Status)</div>
                        </div>
                    }
                    else if (EditTab == "settings")
                    {
                        @if (EditSettingsLoading)
                        {
                            <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_Licensing"]</div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <label class="form-label small">@L["TenantSettings_PurchasedLicences"]</label>
                                                <input type="number" class="form-control form-control-sm" min="0" @bind="EditPurchasedLicences" />
                                                <div class="form-text">@L["TenantSettings_LicencesHelp"]</div>
                                            </div>
                                            <div class="mb-0">
                                                <label class="form-label small">@L["TenantSettings_MaxConcurrentConnections"]</label>
                                                <input type="number" class="form-control form-control-sm" min="0" @bind="EditMaxConcurrentConnections" />
                                                <div class="form-text">@L["TenantSettings_ConnectionsHelp"]</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_PasswordPolicy"]</div>
                                        <div class="card-body">
                                            <div class="mb-2">
                                                <label class="form-label small">@L["TenantSettings_MinLength"]</label>
                                                <input type="number" class="form-control form-control-sm" min="8" max="128" @bind="EditPwdMinLength" />
                                            </div>
                                            <div class="mb-0">
                                                <label class="form-label small">@L["TenantSettings_ExpireDays"]</label>
                                                <input type="number" class="form-control form-control-sm" min="1" max="365" @bind="EditPwdExpireDays" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_Security"]</div>
                                        <div class="card-body">
                                            <div class="form-check mb-2">
                                                <input class="form-check-input" type="checkbox" id="editRequire2fa" @bind="EditRequire2fa" />
                                                <label class="form-check-label small" for="editRequire2fa">@L["TenantSettings_Require2fa"]</label>
                                            </div>
                                            <div class="mb-0">
                                                <label class="form-label small">@L["TenantSettings_DefaultLocale"]</label>
                                                <select class="form-select form-select-sm" @bind="EditDefaultLocale">
                                                    <option value="en-US">English</option>
                                                    <option value="he-IL">Hebrew</option>
                                                    <option value="ru-RU">Russian</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="card h-100">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_SignalR"]</div>
                                        <div class="card-body">
                                            <label class="form-label small">@L["TenantSettings_SignalRUrl"]</label>
                                            <input type="text" class="form-control form-control-sm" placeholder="http://localhost:5045" @bind="EditSignalRConnectionUrl" />
                                            <div class="form-text">@L["TenantSettings_SignalRUrlHelp"]</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header fw-semibold small">@L["TenantSettings_DataRetention"]</div>
                                        <div class="card-body">
                                            <div class="row g-2 align-items-end">
                                                <div class="col-md-4">
                                                    <label class="form-label small">@L["TenantSettings_AuditRetention"]</label>
                                                    <input type="number" class="form-control form-control-sm" min="30" max="3650" @bind="EditAuditRetentionDays" />
                                                </div>
                                                <div class="col-md-4 pb-2">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="editSoftDelete" @bind="EditSoftDelete" />
                                                        <label class="form-check-label small" for="editSoftDelete">@L["TenantSettings_SoftDelete"]</label>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label small">@L["TenantSettings_SoftDeleteRetention"]</label>
                                                    <input type="number" class="form-control form-control-sm" min="1" max="365"
                                                           @bind="EditSoftDeleteRetentionDays" disabled="@(!EditSoftDelete)" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else if (EditTab == "appearance")
                    {
                        <div class="row g-3">
                            <!-- Background Colors -->
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                        @L["TenantSettings_BackgroundColors"]
                                        <span class="badge bg-secondary">@EditBackgroundColors.Count</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var color in EditBackgroundColors)
                                            {
                                                <div class="color-swatch-wrapper">
                                                    <div class="color-swatch" style="background-color: @color;" title="@color">
                                                        <button class="color-remove-btn" @onclick="() => EditBackgroundColors.Remove(color)">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                    <span class="color-code">@color</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color" @bind="NewBackgroundColor" />
                                            <input type="text" class="form-control form-control-sm" style="width: 100px;" @bind="NewBackgroundColor" maxlength="7" />
                                            <button class="btn btn-sm btn-outline-primary" @onclick="AddBackgroundColor">
                                                <i class="bi bi-plus"></i> @L["Common_Add"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Font Colors -->
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                        @L["TenantSettings_FontColors"]
                                        <span class="badge bg-secondary">@EditFontColors.Count</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var color in EditFontColors)
                                            {
                                                <div class="color-swatch-wrapper">
                                                    <div class="color-swatch" style="background-color: @color;" title="@color">
                                                        <button class="color-remove-btn" @onclick="() => EditFontColors.Remove(color)">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                    <span class="color-code">@color</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="color" class="form-control form-control-color" @bind="NewFontColor" />
                                            <input type="text" class="form-control form-control-sm" style="width: 100px;" @bind="NewFontColor" maxlength="7" />
                                            <button class="btn btn-sm btn-outline-primary" @onclick="AddFontColor">
                                                <i class="bi bi-plus"></i> @L["Common_Add"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Font Sizes -->
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                        @L["TenantSettings_FontSizes"]
                                        <span class="badge bg-secondary">@EditFontSizes.Count</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            @foreach (var size in EditFontSizes)
                                            {
                                                <div class="font-size-badge">
                                                    <span>@size px</span>
                                                    <button class="btn-close btn-close-sm ms-1" @onclick="() => EditFontSizes.Remove(size)"></button>
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="number" class="form-control form-control-sm" style="width: 80px;" @bind="NewFontSize" min="8" max="72" />
                                            <span class="text-muted small">px</span>
                                            <button class="btn btn-sm btn-outline-primary" @onclick="AddFontSize">
                                                <i class="bi bi-plus"></i> @L["Common_Add"]
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else if (EditTab == "agentstates")
                    {
                        @if (AgentStatesLoading)
                        {
                            <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                        }
                        else
                        {
                            <div class="row g-3">
                                <!-- State Groups Section -->
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                            @L["AgentStates_StateGroups"]
                                            <button class="btn btn-sm btn-outline-primary" @onclick="OpenCreateGroupModal">
                                                <i class="bi bi-plus"></i> @L["AgentStates_AddGroup"]
                                            </button>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover table-sm mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>@L["AgentStates_GroupName"]</th>
                                                            <th class="text-center" style="width:80px;">@L["AgentStates_States"]</th>
                                                            <th class="text-center" style="width:80px;">@L["AgentStates_Status"]</th>
                                                            <th style="width:120px;"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var g in AgentStateGroups)
                                                        {
                                                            <tr @key="g.Id">
                                                                <td>@g.GroupName</td>
                                                                <td class="text-center">@g.StateCount</td>
                                                                <td class="text-center">
                                                                    @if (g.IsActive)
                                                                    {
                                                                        <span class="badge bg-success">@L["Common_Active"]</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-secondary">@L["Common_Inactive"]</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (g.IsActive)
                                                                    {
                                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditGroupModal(g)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
                                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeactivateGroupModal(g)">
                                                                            <i class="bi bi-x-circle"></i>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (!AgentStateGroups.Any())
                                                        {
                                                            <tr><td colspan="4" class="text-center text-muted py-3">@L["AgentStates_NoGroups"]</td></tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Agent States Section -->
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-header fw-semibold small d-flex justify-content-between align-items-center">
                                            @L["AgentStates_AgentStates"]
                                            <button class="btn btn-sm btn-outline-primary" @onclick="OpenCreateStateModal"
                                                    disabled="@(!AgentStateGroups.Any(g => g.IsActive))">
                                                <i class="bi bi-plus"></i> @L["AgentStates_AddState"]
                                            </button>
                                        </div>
                                        <div class="card-body p-0">
                                            <div class="table-responsive">
                                                <table class="table table-hover table-sm mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>@L["AgentStates_StateName"]</th>
                                                            <th>@L["AgentStates_MappedGroup"]</th>
                                                            <th class="text-center" style="width:80px;">@L["AgentStates_Status"]</th>
                                                            <th style="width:120px;"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var s in AgentStates)
                                                        {
                                                            <tr @key="s.Id">
                                                                <td><code>@s.AgentStateName</code></td>
                                                                <td>@s.GroupName</td>
                                                                <td class="text-center">
                                                                    @if (s.IsActive)
                                                                    {
                                                                        <span class="badge bg-success">@L["Common_Active"]</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-secondary">@L["Common_Inactive"]</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (s.IsActive)
                                                                    {
                                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEditStateModal(s)">
                                                                            <i class="bi bi-pencil"></i>
                                                                        </button>
                                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeactivateStateModal(s)">
                                                                            <i class="bi bi-x-circle"></i>
                                                                        </button>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                        @if (!AgentStates.Any())
                                                        {
                                                            <tr><td colspan="4" class="text-center text-muted py-3">@L["AgentStates_NoStates"]</td></tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <!-- Danger Zone (not for platform tenant) — shown only on the General tab -->
                    @if (EditTab == "general" && EditTenant.Status != TenantStatus.Deleted && EditTenant.Slug != "platform")
                    {
                        <div class="mt-4 pt-3 border-top border-danger">
                            <h6 class="text-danger mb-3">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                @L["Screens_DangerZone"]
                            </h6>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @if (EditTenant.Status == TenantStatus.Active)
                                {
                                    <button class="btn btn-outline-warning btn-sm"
                                            @onclick="() => SetStatusFromModal(TenantStatus.Suspended)">
                                        <i class="bi bi-pause-circle me-1"></i>
                                        @L["Tenants_Suspend"]
                                    </button>
                                }
                                else if (EditTenant.Status == TenantStatus.Suspended)
                                {
                                    <button class="btn btn-outline-success btn-sm"
                                            @onclick="() => SetStatusFromModal(TenantStatus.Active)">
                                        <i class="bi bi-play-circle me-1"></i>
                                        @L["Tenants_Activate"]
                                    </button>
                                }

                                @if (!ConfirmDeleteInModal)
                                {
                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => ConfirmDeleteInModal = true">
                                        <i class="bi bi-trash me-1"></i>
                                        @L["Tenants_Delete"]
                                    </button>
                                }
                                else
                                {
                                    <span class="text-danger small me-2">@L["Tenants_ConfirmDelete"]</span>
                                    <button class="btn btn-danger btn-sm"
                                            @onclick="DeleteFromModal">
                                        @L["Common_Yes"]
                                    </button>
                                    <button class="btn btn-secondary btn-sm"
                                            @onclick="() => ConfirmDeleteInModal = false">
                                        @L["Common_No"]
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseEdit">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="SaveEdit" disabled="@(EditSaving || EditSettingsLoading)">
                        @(EditSaving ? L["Common_Saving"].Value : L["Tenants_EditButton"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

<!-- Create/Edit Group Modal -->
@if (ShowGroupModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditingGroup is null ? L["AgentStates_CreateGroup"] : L["AgentStates_EditGroup"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseGroupModal"></button>
                </div>
                <div class="modal-body">
                    @if (GroupModalError is not null)
                    {
                        <div class="alert alert-danger py-2">@GroupModalError</div>
                    }
                    <div class="mb-0">
                        <label class="form-label">@L["AgentStates_GroupName"] <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="GroupModalName" maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseGroupModal">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="SaveGroup" disabled="@GroupModalSaving">
                        @(GroupModalSaving ? L["Common_Saving"].Value : L["Common_Save"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

<!-- Deactivate Group Modal -->
@if (DeactivatingGroup is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">@L["AgentStates_DeactivateGroup"]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeactivateGroupModal"></button>
                </div>
                <div class="modal-body">
                    @if (DeactivateGroupError is not null)
                    {
                        <div class="alert alert-danger py-2">@DeactivateGroupError</div>
                    }
                    <p>@L["AgentStates_DeactivateGroupConfirm", DeactivatingGroup.GroupName]</p>
                    @if (DeactivatingGroup.StateCount > 0)
                    {
                        <div class="alert alert-warning py-2">
                            <strong>@L["AgentStates_GroupHasStates", DeactivatingGroup.StateCount]</strong>
                        </div>
                        <div class="mb-3">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" id="actionReassign" name="deactivateAction"
                                       checked="@(DeactivateGroupAction == DeactivateGroupAction.ReassignStates)"
                                       @onchange="() => DeactivateGroupAction = DeactivateGroupAction.ReassignStates" />
                                <label class="form-check-label" for="actionReassign">@L["AgentStates_ReassignStates"]</label>
                            </div>
                            @if (DeactivateGroupAction == DeactivateGroupAction.ReassignStates)
                            {
                                <select class="form-select form-select-sm ms-4 mb-2" style="width:auto;" @bind="ReassignToGroupId">
                                    <option value="">@L["AgentStates_SelectGroup"]</option>
                                    @foreach (var g in AgentStateGroups.Where(x => x.IsActive && x.Id != DeactivatingGroup.Id))
                                    {
                                        <option value="@g.Id">@g.GroupName</option>
                                    }
                                </select>
                            }
                            <div class="form-check">
                                <input class="form-check-input" type="radio" id="actionDeactivate" name="deactivateAction"
                                       checked="@(DeactivateGroupAction == DeactivateGroupAction.DeactivateAllStates)"
                                       @onchange="() => DeactivateGroupAction = DeactivateGroupAction.DeactivateAllStates" />
                                <label class="form-check-label" for="actionDeactivate">@L["AgentStates_DeactivateAllStates"]</label>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDeactivateGroupModal">@L["Common_Cancel"]</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeactivateGroup" disabled="@DeactivateGroupSaving">
                        @(DeactivateGroupSaving ? L["Common_Saving"].Value : L["AgentStates_Deactivate"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

<!-- Create/Edit State Modal -->
@if (ShowStateModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(EditingState is null ? L["AgentStates_CreateState"] : L["AgentStates_EditState"])</h5>
                    <button type="button" class="btn-close" @onclick="CloseStateModal"></button>
                </div>
                <div class="modal-body">
                    @if (StateModalError is not null)
                    {
                        <div class="alert alert-danger py-2">@StateModalError</div>
                    }
                    @if (EditingState is null)
                    {
                        <div class="mb-3">
                            <label class="form-label">@L["AgentStates_StateName"] <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="StateModalName" maxlength="100" placeholder="AVAILABLE" />
                            <div class="form-text">@L["AgentStates_StateNameHelp"]</div>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">@L["AgentStates_StateName"]</label>
                            <input class="form-control" value="@EditingState.AgentStateName" disabled />
                        </div>
                    }
                    <div class="mb-0">
                        <label class="form-label">@L["AgentStates_MappedGroup"] <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="StateModalGroupId">
                            <option value="">@L["AgentStates_SelectGroup"]</option>
                            @foreach (var g in AgentStateGroups.Where(x => x.IsActive))
                            {
                                <option value="@g.Id">@g.GroupName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseStateModal">@L["Common_Cancel"]</button>
                    <button class="btn btn-primary" @onclick="SaveState" disabled="@StateModalSaving">
                        @(StateModalSaving ? L["Common_Saving"].Value : L["Common_Save"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

<!-- Deactivate State Modal -->
@if (DeactivatingState is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">@L["AgentStates_DeactivateState"]</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeactivateStateModal"></button>
                </div>
                <div class="modal-body">
                    @if (DeactivateStateError is not null)
                    {
                        <div class="alert alert-danger py-2">@DeactivateStateError</div>
                    }
                    <p>@L["AgentStates_DeactivateStateConfirm", DeactivatingState.AgentStateName]</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDeactivateStateModal">@L["Common_Cancel"]</button>
                    <button class="btn btn-danger" @onclick="ConfirmDeactivateState" disabled="@DeactivateStateSaving">
                        @(DeactivateStateSaving ? L["Common_Saving"].Value : L["AgentStates_Deactivate"].Value)
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show modal-overlay"></div>
}

@code {
    private List<TenantDto> Tenants = [];
    private bool Loading = true;
    private int _page = 1;
    private int _pageSize = 25;
    private IEnumerable<TenantDto> PagedTenants => Tenants.Skip((_page - 1) * _pageSize).Take(_pageSize);
    private string? Error;
    private string? ActionError;
    private string? SaveError;
    private bool Saving;
    private bool ShowCreate;
    private string? NewName;
    private string? NewSlug;
    private bool ConfirmDeleteInModal;

    // Edit state
    private TenantDto? EditTenant;
    private string EditTab = "general";
    private string EditName = "";
    private bool EditSettingsLoading;
    private bool EditSaving;
    private string? EditSaveError;
    private bool EditSaveSuccess;

    // Settings fields
    private int EditPwdMinLength = 12;
    private int EditPwdExpireDays = 90;
    private bool EditRequire2fa;
    private int EditAuditRetentionDays = 365;
    private string EditDefaultLocale = "en-US";
    private bool EditSoftDelete;
    private int EditSoftDeleteRetentionDays = 90;
    private int EditPurchasedLicences = 0;
    private int EditMaxConcurrentConnections = 0;
    private string? EditSignalRConnectionUrl;

    // Appearance settings
    private List<string> EditBackgroundColors = new();
    private List<string> EditFontColors = new();
    private List<string> EditFontSizes = new();
    private string NewBackgroundColor = "#FFFFFF";
    private string NewFontColor = "#000000";
    private string NewFontSize = "14";

    // Agent States tab
    private bool AgentStatesLoading;
    private List<AgentStateGroupDto> AgentStateGroups = new();
    private List<AgentStateDto> AgentStates = new();

    // Group modal
    private bool ShowGroupModal;
    private AgentStateGroupDto? EditingGroup;
    private string GroupModalName = "";
    private string? GroupModalError;
    private bool GroupModalSaving;

    // Deactivate Group modal
    private AgentStateGroupDto? DeactivatingGroup;
    private DeactivateGroupAction DeactivateGroupAction = DeactivateGroupAction.ReassignStates;
    private Guid? ReassignToGroupId;
    private string? DeactivateGroupError;
    private bool DeactivateGroupSaving;

    // State modal
    private bool ShowStateModal;
    private AgentStateDto? EditingState;
    private string StateModalName = "";
    private Guid? StateModalGroupId;
    private string? StateModalError;
    private bool StateModalSaving;

    // Deactivate State modal
    private AgentStateDto? DeactivatingState;
    private string? DeactivateStateError;
    private bool DeactivateStateSaving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        try { Tenants = (await Mediator.Send(new GetTenantsQuery(), _cts.Token)).ToList(); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Error = ex.Message; }
        finally { Loading = false; }
    }

    private void OpenCreate()
    {
        NewName = null; NewSlug = null; SaveError = null; ShowCreate = true;
    }

    private async Task CreateTenant()
    {
        if (string.IsNullOrWhiteSpace(NewName) || string.IsNullOrWhiteSpace(NewSlug))
        { SaveError = L["Tenants_Name"] + " and " + L["Tenants_Slug"] + " are required."; return; }
        Saving = true; SaveError = null;
        try
        {
            await Mediator.Send(new CreateTenantCommand(new CreateTenantRequest(NewSlug, NewName)));
            ShowCreate = false; await LoadAsync();
        }
        catch (Exception ex) { SaveError = ex.Message; }
        finally { Saving = false; }
    }

    private async Task SetStatusFromModal(TenantStatus status)
    {
        if (EditTenant is null) return;
        EditSaveError = null;
        try
        {
            await Mediator.Send(new SetTenantStatusCommand(EditTenant.Id, status));
            await LoadAsync();
            EditTenant = Tenants.FirstOrDefault(t => t.Id == EditTenant.Id);
            ConfirmDeleteInModal = false;
        }
        catch (Exception ex) { EditSaveError = ex.Message; }
    }

    private async Task DeleteFromModal()
    {
        if (EditTenant is null) return;
        EditSaveError = null;
        try
        {
            await Mediator.Send(new SetTenantStatusCommand(EditTenant.Id, TenantStatus.Deleted));
            await LoadAsync();
            CloseEdit();
        }
        catch (Exception ex) { EditSaveError = ex.Message; }
    }

    private async Task OpenEdit(TenantDto t)
    {
        EditTenant = t;
        EditName = t.Name;
        EditTab = "general";
        EditSaveError = null;
        EditSaveSuccess = false;
        ConfirmDeleteInModal = false;
        // Reset agent states data for new tenant
        AgentStateGroups = new();
        AgentStates = new();
        await LoadEditSettings(t.Id);
    }

    private void CloseEdit()
    {
        EditTenant = null;
        EditSaveError = null;
        EditSaveSuccess = false;
    }

    private async Task LoadEditSettings(Guid tenantId)
    {
        EditSettingsLoading = true;
        try
        {
            var s = await Mediator.Send(new GetTenantSettingsQuery(tenantId));
            EditPwdMinLength = s?.PasswordMinLength ?? 12;
            EditPwdExpireDays = s?.PasswordExpireDays ?? 90;
            EditRequire2fa = s?.Require2faForAll ?? false;
            EditAuditRetentionDays = s?.AuditRetentionDays ?? 365;
            EditDefaultLocale = s?.DefaultLocale ?? "en-US";
            EditSoftDelete = s?.SoftDeleteDashboards ?? false;
            EditSoftDeleteRetentionDays = s?.SoftDeleteRetentionDays ?? 90;
            EditPurchasedLicences = s?.PurchasedLicences ?? 0;
            EditMaxConcurrentConnections = s?.MaxConcurrentConnections ?? 0;
            EditSignalRConnectionUrl = s?.SignalRConnectionUrl;
            EditBackgroundColors = s?.BackgroundColorPalette?.ToList() ?? GetDefaultBackgroundColors();
            EditFontColors = s?.FontColorPalette?.ToList() ?? GetDefaultFontColors();
            EditFontSizes = s?.FontSizes?.ToList() ?? GetDefaultFontSizes();
        }
        catch { /* use defaults */ }
        finally { EditSettingsLoading = false; }
    }

    private static List<string> GetDefaultBackgroundColors() => new()
    {
        "#FFFFFF", "#F5F5F5", "#E8F5E9", "#FFF3E0", "#FFEBEE",
        "#E3F2FD", "#F3E5F5", "#FFFDE7", "#E0F7FA", "#FBE9E7"
    };

    private static List<string> GetDefaultFontColors() => new()
    {
        "#000000", "#333333", "#666666", "#1976D2", "#388E3C",
        "#D32F2F", "#7B1FA2", "#F57C00", "#0097A7", "#5D4037"
    };

    private static List<string> GetDefaultFontSizes() => new()
    {
        "10", "11", "12", "13", "14", "16", "18", "20", "24", "28", "32"
    };

    private void AddBackgroundColor()
    {
        var color = NewBackgroundColor?.Trim().ToUpperInvariant();
        if (!string.IsNullOrEmpty(color) && !EditBackgroundColors.Contains(color))
        {
            EditBackgroundColors.Add(color);
            NewBackgroundColor = "#FFFFFF";
        }
    }

    private void AddFontColor()
    {
        var color = NewFontColor?.Trim().ToUpperInvariant();
        if (!string.IsNullOrEmpty(color) && !EditFontColors.Contains(color))
        {
            EditFontColors.Add(color);
            NewFontColor = "#000000";
        }
    }

    private void AddFontSize()
    {
        if (!string.IsNullOrEmpty(NewFontSize) && !EditFontSizes.Contains(NewFontSize))
        {
            EditFontSizes.Add(NewFontSize);
            NewFontSize = "14";
        }
    }

    private async Task SaveEdit()
    {
        if (EditTenant is null) return;
        if (string.IsNullOrWhiteSpace(EditName))
        { EditSaveError = L["Tenants_Name"] + " is required."; return; }

        EditSaving = true; EditSaveError = null; EditSaveSuccess = false;
        try
        {
            await Mediator.Send(new UpdateTenantCommand(EditTenant.Id, EditName));
            await Mediator.Send(new UpdateTenantSettingsCommand(
                new UpdateTenantSettingsRequest(
                    EditPwdMinLength, EditPwdExpireDays, EditRequire2fa,
                    EditAuditRetentionDays, EditDefaultLocale,
                    EditSoftDelete, EditSoftDeleteRetentionDays,
                    EditPurchasedLicences, EditMaxConcurrentConnections,
                    EditSignalRConnectionUrl,
                    EditBackgroundColors, EditFontColors, EditFontSizes),
                EditTenant.Id));
            EditSaveSuccess = true;
            await LoadAsync();
            // Update the displayed tenant name in the modal header
            EditTenant = Tenants.FirstOrDefault(t => t.Id == EditTenant.Id) ?? EditTenant;
        }
        catch (Exception ex) { EditSaveError = ex.Message; }
        finally { EditSaving = false; }
    }

    private RenderFragment StatusBadge(TenantStatus status) => status switch
    {
        TenantStatus.Active => @<span class="badge bg-success">@L["Tenants_Active"]</span>,
        TenantStatus.Suspended => @<span class="badge bg-warning text-dark">@L["Tenants_Suspended"]</span>,
        _ => @<span class="badge bg-secondary">@L["Tenants_Deleted"]</span>
    };

    // =============== Agent States Tab ===============

    private async Task OpenAgentStatesTab()
    {
        EditTab = "agentstates";
        if (EditTenant is not null && !AgentStateGroups.Any())
        {
            await LoadAgentStatesAsync(EditTenant.Id);
        }
    }

    private async Task LoadAgentStatesAsync(Guid tenantId)
    {
        AgentStatesLoading = true;
        try
        {
            AgentStateGroups = (await Mediator.Send(new GetAgentStateGroupsQuery(tenantId), _cts.Token)).ToList();
            AgentStates = (await Mediator.Send(new GetAgentStatesQuery(tenantId), _cts.Token)).ToList();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { EditSaveError = ex.Message; }
        finally { AgentStatesLoading = false; }
    }

    // =============== Group Modal ===============

    private void OpenCreateGroupModal()
    {
        EditingGroup = null;
        GroupModalName = "";
        GroupModalError = null;
        ShowGroupModal = true;
    }

    private void OpenEditGroupModal(AgentStateGroupDto g)
    {
        EditingGroup = g;
        GroupModalName = g.GroupName;
        GroupModalError = null;
        ShowGroupModal = true;
    }

    private void CloseGroupModal()
    {
        ShowGroupModal = false;
        EditingGroup = null;
        GroupModalError = null;
    }

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(GroupModalName))
        {
            GroupModalError = L["AgentStates_GroupNameRequired"];
            return;
        }
        if (EditTenant is null) return;

        GroupModalSaving = true;
        GroupModalError = null;
        try
        {
            if (EditingGroup is null)
            {
                await Mediator.Send(new CreateAgentStateGroupCommand(GroupModalName.Trim(), EditTenant.Id), _cts.Token);
            }
            else
            {
                await Mediator.Send(new UpdateAgentStateGroupCommand(EditingGroup.Id, GroupModalName.Trim()), _cts.Token);
            }
            CloseGroupModal();
            await LoadAgentStatesAsync(EditTenant.Id);
        }
        catch (Exception ex) { GroupModalError = ex.Message; }
        finally { GroupModalSaving = false; }
    }

    // =============== Deactivate Group Modal ===============

    private void OpenDeactivateGroupModal(AgentStateGroupDto g)
    {
        DeactivatingGroup = g;
        DeactivateGroupAction = DeactivateGroupAction.ReassignStates;
        ReassignToGroupId = null;
        DeactivateGroupError = null;
    }

    private void CloseDeactivateGroupModal()
    {
        DeactivatingGroup = null;
        DeactivateGroupError = null;
    }

    private async Task ConfirmDeactivateGroup()
    {
        if (DeactivatingGroup is null || EditTenant is null) return;

        if (DeactivatingGroup.StateCount > 0 &&
            DeactivateGroupAction == DeactivateGroupAction.ReassignStates &&
            ReassignToGroupId is null)
        {
            DeactivateGroupError = L["AgentStates_SelectTargetGroup"];
            return;
        }

        DeactivateGroupSaving = true;
        DeactivateGroupError = null;
        try
        {
            await Mediator.Send(new DeactivateAgentStateGroupCommand(
                DeactivatingGroup.Id,
                DeactivateGroupAction,
                ReassignToGroupId), _cts.Token);
            CloseDeactivateGroupModal();
            await LoadAgentStatesAsync(EditTenant.Id);
        }
        catch (Exception ex) { DeactivateGroupError = ex.Message; }
        finally { DeactivateGroupSaving = false; }
    }

    // =============== State Modal ===============

    private void OpenCreateStateModal()
    {
        EditingState = null;
        StateModalName = "";
        StateModalGroupId = AgentStateGroups.FirstOrDefault(g => g.IsActive)?.Id;
        StateModalError = null;
        ShowStateModal = true;
    }

    private void OpenEditStateModal(AgentStateDto s)
    {
        EditingState = s;
        StateModalName = s.AgentStateName;
        StateModalGroupId = s.GroupId;
        StateModalError = null;
        ShowStateModal = true;
    }

    private void CloseStateModal()
    {
        ShowStateModal = false;
        EditingState = null;
        StateModalError = null;
    }

    private async Task SaveState()
    {
        if (EditTenant is null) return;

        if (EditingState is null && string.IsNullOrWhiteSpace(StateModalName))
        {
            StateModalError = L["AgentStates_StateNameRequired"];
            return;
        }
        if (StateModalGroupId is null)
        {
            StateModalError = L["AgentStates_GroupRequired"];
            return;
        }

        StateModalSaving = true;
        StateModalError = null;
        try
        {
            if (EditingState is null)
            {
                await Mediator.Send(new CreateAgentStateCommand(StateModalName.Trim(), StateModalGroupId.Value, EditTenant.Id), _cts.Token);
            }
            else
            {
                await Mediator.Send(new UpdateAgentStateCommand(EditingState.Id, StateModalGroupId.Value), _cts.Token);
            }
            CloseStateModal();
            await LoadAgentStatesAsync(EditTenant.Id);
        }
        catch (Exception ex) { StateModalError = ex.Message; }
        finally { StateModalSaving = false; }
    }

    // =============== Deactivate State Modal ===============

    private void OpenDeactivateStateModal(AgentStateDto s)
    {
        DeactivatingState = s;
        DeactivateStateError = null;
    }

    private void CloseDeactivateStateModal()
    {
        DeactivatingState = null;
        DeactivateStateError = null;
    }

    private async Task ConfirmDeactivateState()
    {
        if (DeactivatingState is null || EditTenant is null) return;

        DeactivateStateSaving = true;
        DeactivateStateError = null;
        try
        {
            await Mediator.Send(new DeactivateAgentStateCommand(DeactivatingState.Id), _cts.Token);
            CloseDeactivateStateModal();
            await LoadAgentStatesAsync(EditTenant.Id);
        }
        catch (Exception ex) { DeactivateStateError = ex.Message; }
        finally { DeactivateStateSaving = false; }
    }

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

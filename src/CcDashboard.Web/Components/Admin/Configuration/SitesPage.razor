@page "/admin/configuration/sites"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@using MediatR
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Domain.Interfaces
@using CcDashboard.Application.Commands.Configuration
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Contracts.DTOs.Configuration
@using Microsoft.AspNetCore.Authorization
@using FluentValidation
@implements IDisposable

<PageTitle>@L["Sites_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Sites_Title"]</h1>
    <div class="d-flex align-items-center gap-2">
        <AuthorizeView Roles="Superadmin">
            @if (Tenants.Count > 0)
            {
                <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                <select class="form-select form-select-sm" style="width:auto"
                        value="@SelectedTenantId"
                        @onchange="async e => { SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await LoadAsync(); }">
                    <option value="">@L["Audit_AllTenants"]</option>
                    @foreach (var t in Tenants)
                    {
                        <option @key="t.Id" value="@t.Id">@t.Name</option>
                    }
                </select>
            }
        </AuthorizeView>
        <button class="btn btn-primary btn-sm text-nowrap" @onclick="() => OpenModal(null)">
            <i class="bi bi-plus-lg me-1"></i>@L["Sites_NewSite"]
        </button>
    </div>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @Error <button class="btn-close btn-sm" @onclick="() => Error = null"></button>
    </div>
}

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["Sites_SiteId"]</th>
                    <th>@L["Sites_SiteName"]</th>
                    <th>@L["Sites_TimeZone"]</th>
                    <th>@L["Sites_ClearTime"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Sites)
                {
                    <tr @key="s.SiteId">
                        <td class="fw-mono small">@s.SiteId</td>
                        <td>@s.SiteName</td>
                        <td>@s.TimeZone</td>
                        <td>@s.ClearTime</td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenModal(s)">@L["Edit"]</button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(s)">@L["Delete"]</button>
                        </td>
                    </tr>
                }
                @if (!Sites.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">@L["Sites_Empty"]</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ShowModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-site-title">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-site-title">@(IsNew ? L["Sites_NewSite"] : L["Sites_EditSite"])</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (ModalError is not null)
                    {
                        <div class="alert alert-danger py-2">@ModalError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label">@L["Sites_SiteId"] *</label>
                        <input class="form-control" @bind="EditId" disabled="@(!IsNew)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Sites_SiteName"]</label>
                        <input class="form-control" @bind="EditName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["Sites_Description"]</label>
                        <input class="form-control" @bind="EditDescription" />
                    </div>
                    <div class="row g-3">
                        <div class="col">
                            <label class="form-label">@L["Sites_TimeZone"]</label>
                            <select class="form-select" @bind="EditTimeZone">
                                <option value="">— @L["Sites_SelectTimeZone"] —</option>
                                <option value="-12:00">UTC-12:00</option>
                                <option value="-11:00">UTC-11:00</option>
                                <option value="-10:00">UTC-10:00</option>
                                <option value="-09:30">UTC-09:30</option>
                                <option value="-09:00">UTC-09:00</option>
                                <option value="-08:00">UTC-08:00</option>
                                <option value="-07:00">UTC-07:00</option>
                                <option value="-06:00">UTC-06:00</option>
                                <option value="-05:00">UTC-05:00</option>
                                <option value="-04:00">UTC-04:00</option>
                                <option value="-03:30">UTC-03:30</option>
                                <option value="-03:00">UTC-03:00</option>
                                <option value="-02:00">UTC-02:00</option>
                                <option value="-01:00">UTC-01:00</option>
                                <option value="+00:00">UTC+00:00</option>
                                <option value="+01:00">UTC+01:00</option>
                                <option value="+02:00">UTC+02:00</option>
                                <option value="+03:00">UTC+03:00</option>
                                <option value="+03:30">UTC+03:30</option>
                                <option value="+04:00">UTC+04:00</option>
                                <option value="+04:30">UTC+04:30</option>
                                <option value="+05:00">UTC+05:00</option>
                                <option value="+05:30">UTC+05:30</option>
                                <option value="+05:45">UTC+05:45</option>
                                <option value="+06:00">UTC+06:00</option>
                                <option value="+06:30">UTC+06:30</option>
                                <option value="+07:00">UTC+07:00</option>
                                <option value="+08:00">UTC+08:00</option>
                                <option value="+08:45">UTC+08:45</option>
                                <option value="+09:00">UTC+09:00</option>
                                <option value="+09:30">UTC+09:30</option>
                                <option value="+10:00">UTC+10:00</option>
                                <option value="+10:30">UTC+10:30</option>
                                <option value="+11:00">UTC+11:00</option>
                                <option value="+12:00">UTC+12:00</option>
                                <option value="+12:45">UTC+12:45</option>
                                <option value="+13:00">UTC+13:00</option>
                                <option value="+14:00">UTC+14:00</option>
                            </select>
                        </div>
                        <div class="col">
                            <label class="form-label">@L["Sites_ClearTime"]</label>
                            <input type="time" class="form-control" value="@EditClearTime" @onchange="e => EditClearTime = TrimTime(e.Value?.ToString())" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseModal">@L["Cancel"]</button>
                    <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@Saving">
                        @if (Saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L["Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (DeleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-site-delete-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-site-delete-title">@L["Sites_DeleteConfirm"]</h5>
                    <button class="btn-close" @onclick="() => DeleteTarget = null"></button>
                </div>
                <div class="modal-body">
                    @L["Sites_DeleteWarning"]: <strong>@DeleteTarget.SiteId</strong>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => DeleteTarget = null">@L["Cancel"]</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete">@L["Delete"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<SiteDto> Sites = [];
    private bool Loading = true;
    private string? Error;

    private List<TenantDto> Tenants = [];
    private Guid? SelectedTenantId;

    private bool ShowModal;
    private bool IsNew;
    private bool Saving;
    private string? ModalError;
    private string EditId = "";
    private string? EditName;
    private string? EditDescription;
    private string? EditTimeZone;
    private string? EditClearTime;

    private SiteDto? DeleteTarget;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (CurrentUser.Role == "Superadmin")
            Tenants = (await Mediator.Send(new GetTenantsQuery())).ToList();
        else
            SelectedTenantId = CurrentUser.TenantId!.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        try { Sites = await Mediator.Send(new GetSitesQuery(SelectedTenantId)); }
        catch (Exception ex) { Error = SafeError(ex); }
        finally { Loading = false; }
    }

    private void OpenModal(SiteDto? site)
    {
        IsNew = site is null;
        EditId = site?.SiteId ?? "";
        EditName = site?.SiteName;
        EditDescription = site?.Description;
        EditTimeZone = site?.TimeZone;
        EditClearTime = site?.ClearTime;
        ModalError = null;
        ShowModal = true;
    }

    private void CloseModal() { ShowModal = false; ModalError = null; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(EditId)) { ModalError = L["Sites_SiteIdRequired"]; return; }
        Saving = true;
        try
        {
            var result = await Mediator.Send(new SaveSiteCommand(
                new SaveSiteRequest(EditId, EditName, EditDescription, EditTimeZone, EditClearTime, IsNew)));
            if (!result.IsSuccess) { ModalError = result.Error; return; }
            CloseModal();
            await LoadAsync();
        }
        catch (Exception ex) { ModalError = SafeError(ex); }
        finally { Saving = false; }
    }

    private void ConfirmDelete(SiteDto site) => DeleteTarget = site;

    private async Task ExecuteDelete()
    {
        if (DeleteTarget is null) return;
        try
        {
            var result = await Mediator.Send(new DeleteSiteCommand(DeleteTarget.SiteId));
            if (!result.IsSuccess) { Error = result.Error; }
            DeleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex) { Error = SafeError(ex); DeleteTarget = null; }
    }

    private static string? TrimTime(string? val) =>
        val is { Length: > 5 } ? val[..5] : val;

    private static string SafeError(Exception ex) =>
        ex is ValidationException vex
            ? string.Join(" ", vex.Errors.Select(e => e.ErrorMessage))
            : "An unexpected error occurred. Please try again.";

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

@page "/admin/configuration/business-units"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@using MediatR
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Domain.Interfaces
@using CcDashboard.Application.Commands.Configuration
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Contracts.DTOs.Configuration
@using CcDashboard.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using FluentValidation
@implements IDisposable

<PageTitle>@L["BU_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["BU_Title"]</h1>
    <div class="d-flex align-items-center gap-2">
        <AuthorizeView Roles="Superadmin">
            @if (Tenants.Count > 0)
            {
                <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                <select class="form-select form-select-sm" style="width:auto"
                        value="@SelectedTenantId"
                        @onchange="async e => { SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; await LoadAsync(); }">
                    <option value="">@L["Audit_AllTenants"]</option>
                    @foreach (var t in Tenants)
                    {
                        <option @key="t.Id" value="@t.Id">@t.Name</option>
                    }
                </select>
            }
        </AuthorizeView>
        <button class="btn btn-primary btn-sm text-nowrap" @onclick="() => OpenModal(null)">
            <i class="bi bi-plus-lg me-1"></i>@L["BU_New"]
        </button>
    </div>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @Error <button class="btn-close btn-sm" @onclick="() => Error = null"></button>
    </div>
}

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["BU_Name"]</th>
                    <th>@L["BU_Site"]</th>
                    <th>@L["BU_Queues"]</th>
                    <th>@L["BU_Supergroups"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bu in BusinessUnits)
                {
                    <tr @key="bu.BusinessUnitId">
                        <td>@bu.BusinessUnitName</td>
                        <td>@(bu.SiteName ?? bu.SiteId)</td>
                        <td><span class="badge bg-secondary">@bu.QueueIds.Count</span></td>
                        <td><span class="badge bg-secondary">@bu.SupergroupIds.Count</span></td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenModal(bu)">@L["Edit"]</button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(bu)">@L["Delete"]</button>
                        </td>
                    </tr>
                }
                @if (!BusinessUnits.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">@L["BU_Empty"]</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ShowModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-bu-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-bu-title">@(EditId is null ? L["BU_New"] : L["BU_Edit"])</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (ModalError is not null)
                    {
                        <div class="alert alert-danger py-2">@ModalError</div>
                    }
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@L["BU_Name"] *</label>
                            <input class="form-control" @bind="EditName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["BU_Site"]</label>
                            <select class="form-select" @bind="EditSiteId">
                                <option value="">— @L["BU_NoSite"] —</option>
                                @foreach (var s in Sites)
                                {
                                    <option @key="s.SiteId" value="@s.SiteId">@(s.SiteName ?? s.SiteId)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@L["BU_Description"]</label>
                            <input class="form-control" @bind="EditDescription" />
                        </div>
                    </div>

                    <ul class="nav nav-tabs mb-3" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link @(ActiveTab == "queues" ? "active" : "")"
                                    @onclick='() => ActiveTab = "queues"'>
                                @L["BU_Queues"] <span class="badge bg-secondary ms-1">@SelectedQueueIds.Count</span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(ActiveTab == "supergroups" ? "active" : "")"
                                    @onclick='() => ActiveTab = "supergroups"'>
                                @L["BU_Supergroups"] <span class="badge bg-secondary ms-1">@SelectedSupergroupIds.Count</span>
                            </button>
                        </li>
                    </ul>

                    @if (ActiveTab == "queues")
                    {
                        <DualPaneSelector TKey="string"
                            AllItems="@QueueItems"
                            SelectedIds="@SelectedQueueIds"
                            SelectedIdsChanged="@(ids => SelectedQueueIds = ids)" />
                    }
                    else
                    {
                        <DualPaneSelector TKey="int"
                            AllItems="@SupergroupItems"
                            SelectedIds="@SelectedSupergroupIds"
                            SelectedIdsChanged="@(ids => SelectedSupergroupIds = ids)" />
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseModal">@L["Cancel"]</button>
                    <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@Saving">
                        @if (Saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L["Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (DeleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-bu-delete-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-bu-delete-title">@L["BU_DeleteConfirm"]</h5>
                    <button class="btn-close" @onclick="() => DeleteTarget = null"></button>
                </div>
                <div class="modal-body">@L["BU_DeleteWarning"]: <strong>@DeleteTarget.BusinessUnitName</strong></div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => DeleteTarget = null">@L["Cancel"]</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete">@L["Delete"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<BusinessUnitDto> BusinessUnits = [];
    private IReadOnlyList<SiteDto> Sites = [];
    private IReadOnlyList<QueueDto> AllQueues = [];
    private IReadOnlyList<SupergroupDto> AllSupergroups = [];
    private bool Loading = true;
    private string? Error;

    private List<TenantDto> Tenants = [];
    private Guid? SelectedTenantId;

    private bool ShowModal;
    private bool Saving;
    private string? ModalError;
    private string ActiveTab = "queues";
    private int? EditId;
    private string? EditName;
    private string? EditDescription;
    private string? EditSiteId;
    private HashSet<string> SelectedQueueIds = [];
    private HashSet<int> SelectedSupergroupIds = [];

    private BusinessUnitDto? DeleteTarget;

    private IReadOnlyList<(string Key, string Label)> QueueItems =>
        AllQueues.Select(q => (q.QueueId, q.Name ?? q.QueueId)).ToList();

    private IReadOnlyList<(int Key, string Label)> SupergroupItems =>
        AllSupergroups.Select(s => (s.SupergroupId, s.SupergroupName ?? s.SupergroupId.ToString())).ToList();

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (CurrentUser.Role == "Superadmin")
            Tenants = (await Mediator.Send(new GetTenantsQuery())).ToList();
        else
            SelectedTenantId = CurrentUser.TenantId!.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        try
        {
            var tid = SelectedTenantId;
            var (bus, sites, queues, sgs) = (
                await Mediator.Send(new GetBusinessUnitsQuery(tid)),
                await Mediator.Send(new GetSitesQuery(tid)),
                await Mediator.Send(new GetQueuesQuery(tid)),
                await Mediator.Send(new GetSupergroupsQuery(tid)));
            BusinessUnits = bus; Sites = sites; AllQueues = queues; AllSupergroups = sgs;
        }
        catch (Exception ex) { Error = SafeError(ex); }
        finally { Loading = false; }
    }

    private void OpenModal(BusinessUnitDto? bu)
    {
        EditId = bu?.BusinessUnitId;
        EditName = bu?.BusinessUnitName;
        EditDescription = bu?.Description;
        EditSiteId = bu?.SiteId;
        SelectedQueueIds = bu?.QueueIds.ToHashSet() ?? [];
        SelectedSupergroupIds = bu?.SupergroupIds.ToHashSet() ?? [];
        ActiveTab = "queues";
        ModalError = null;
        ShowModal = true;
    }

    private void CloseModal() { ShowModal = false; ModalError = null; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(EditName)) { ModalError = L["BU_NameRequired"]; return; }
        Saving = true;
        try
        {
            var result = await Mediator.Send(new SaveBusinessUnitCommand(
                new SaveBusinessUnitRequest(
                    EditId, EditName, EditDescription,
                    string.IsNullOrEmpty(EditSiteId) ? null : EditSiteId,
                    SelectedQueueIds.ToList(),
                    SelectedSupergroupIds.ToList())));
            if (!result.IsSuccess) { ModalError = result.Error; return; }
            CloseModal();
            await LoadAsync();
        }
        catch (Exception ex) { ModalError = SafeError(ex); }
        finally { Saving = false; }
    }

    private void ConfirmDelete(BusinessUnitDto bu) => DeleteTarget = bu;

    private async Task ExecuteDelete()
    {
        if (DeleteTarget is null) return;
        try
        {
            var result = await Mediator.Send(new DeleteBusinessUnitCommand(DeleteTarget.BusinessUnitId));
            if (!result.IsSuccess) Error = result.Error;
            DeleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex) { Error = SafeError(ex); DeleteTarget = null; }
    }

    private static string SafeError(Exception ex) =>
        ex is ValidationException vex
            ? string.Join(" ", vex.Errors.Select(e => e.ErrorMessage))
            : "An unexpected error occurred. Please try again.";

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

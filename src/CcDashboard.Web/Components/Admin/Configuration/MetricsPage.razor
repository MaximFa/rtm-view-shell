        ModalError = null;
        ShowModal = true;
    }

    private void CloseModal() { ShowModal = false; ModalError = null; }

    private async Task Save()
    {
        if (!IsNew && string.IsNullOrWhiteSpace(EditMetricId)) { ModalError = L["Metrics_IdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(EditDataType)) { ModalError = L["Metrics_DataTypeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(EditMetricFunction)) { ModalError = L["Metrics_FunctionRequired"]; return; }
        if (string.IsNullOrWhiteSpace(EditMetricParameter)) { ModalError = L["Metrics_ParameterRequired"]; return; }
        Saving = true;
        try
        {
            var result = await Mediator.Send(new SaveRtsGridMetricCommand(new SaveRtsGridMetricRequest(EditMetricId, EditDescription, EditDataType, EditMetricFunction, EditMetricParameter, EditMetricFormat, EditDefaultValue, EditValueType, EditMetricType, EditDisplayName, EditShortDescription, EditLongDescription, EditComparison, EditStandardKpi, EditStandardRef, EditCatalogCategory, EditFamily, EditChannel, EditThresholdSec, EditCatalogStatus, EditCatalogNotes, IsNew)));
            if (!result.IsSuccess) { ModalError = result.Error; return; }
            CloseModal();
            await LoadAsync();
        }
        catch (Exception ex) { ModalError = SafeError(ex); }
        finally { Saving = false; }
    }

    private void ConfirmDelete(RtsGridMetricDto m) => DeleteTarget = m;

    private async Task ExecuteDelete()
    {
        if (DeleteTarget is null) return;
        try { var result = await Mediator.Send(new DeleteRtsGridMetricCommand(DeleteTarget.MetricId)); if (!result.IsSuccess) Error = result.Error; DeleteTarget = null; await LoadAsync(); }
        catch (Exception ex) { Error = SafeError(ex); DeleteTarget = null; }
    }

    private static string SafeError(Exception ex) => ex is ValidationException vex ? string.Join(" ", vex.Errors.Select(e => e.ErrorMessage)) : "An unexpected error occurred. Please try again.";

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();

    private bool ShowTranslationModal;
    private string TranslationMetricId = "";
    private string? TranslationEnDisplayName;
    private string? TranslationEnShortDesc;
    private string? TranslationError;
    private string? TranslationSuccess;
    private bool TranslationSaving;
    private readonly string[] TranslationLocales = ["ru-RU", "he-IL"];
    private Dictionary<string, MetricTranslationDto> TranslationData = new();

    private async Task OpenTranslationModal(RtsGridMetricDto m)
    {
        TranslationMetricId = m.MetricId;
        TranslationEnDisplayName = m.DisplayName;
        TranslationEnShortDesc = m.ShortDescription;
        TranslationError = null;
        TranslationSuccess = null;
        TranslationData.Clear();
        try { var translations = await Mediator.Send(new GetMetricTranslationsQuery(m.MetricId)); foreach (var t in translations) TranslationData[t.Locale] = t; }
        catch (Exception ex) { TranslationError = SafeError(ex); }
        ShowTranslationModal = true;
    }

    private void CloseTranslationModal() { ShowTranslationModal = false; TranslationError = null; TranslationSuccess = null; }

    private string? GetTranslationField(string locale, string field)
    {
        if (!TranslationData.TryGetValue(locale, out var t)) return null;
        return field switch { "DisplayName" => t.DisplayName, "ShortDescription" => t.ShortDescription, "LongDescription" => t.LongDescription, "Comparison" => t.Comparison, _ => null };
    }

    private void SetTranslationField(string locale, string field, string? value)
    {
        if (!TranslationData.TryGetValue(locale, out var t)) { t = new MetricTranslationDto(TranslationMetricId, locale, null, null, null, null); TranslationData[locale] = t; }
        TranslationData[locale] = field switch { "DisplayName" => t with { DisplayName = value }, "ShortDescription" => t with { ShortDescription = value }, "LongDescription" => t with { LongDescription = value }, "Comparison" => t with { Comparison = value }, _ => t };
    }

    private async Task SaveTranslation(string locale)
    {
        TranslationSaving = true; TranslationError = null; TranslationSuccess = null;
        try { var t = TranslationData.GetValueOrDefault(locale) ?? new MetricTranslationDto(TranslationMetricId, locale, null, null, null, null); var req = new SaveMetricTranslationRequest(t.MetricId, t.Locale, t.DisplayName, t.ShortDescription, t.LongDescription, t.Comparison); var result = await Mediator.Send(new SaveMetricTranslationCommand(req)); if (!result.IsSuccess) TranslationError = result.Error; else TranslationSuccess = $"{locale} saved."; }
        catch (Exception ex) { TranslationError = SafeError(ex); }
        finally { TranslationSaving = false; }
    }

    private async Task ClearTranslation(string locale)
    {
        TranslationSaving = true; TranslationError = null; TranslationSuccess = null;
        try { var result = await Mediator.Send(new DeleteMetricTranslationCommand(TranslationMetricId, locale)); if (!result.IsSuccess) TranslationError = result.Error; else { TranslationData[locale] = new MetricTranslationDto(TranslationMetricId, locale, null, null, null, null); TranslationSuccess = $"{locale} cleared."; } }
        catch (Exception ex) { TranslationError = SafeError(ex); }
        finally { TranslationSaving = false; }
    }


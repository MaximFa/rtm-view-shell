@page "/admin/configuration/metrics"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin")]
@inject IMediator Mediator
@using MediatR
@using CcDashboard.Application.Commands.Configuration
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Contracts.DTOs.Configuration
@using Microsoft.AspNetCore.Authorization
@using FluentValidation
@implements IDisposable

<PageTitle>@L["Metrics_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Metrics_Title"]</h1>
    <button class="btn btn-primary btn-sm" @onclick="() => OpenModal(null)">
        <i class="bi bi-plus-lg me-1"></i>@L["Metrics_New"]
    </button>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @Error <button class="btn-close btn-sm" @onclick="() => Error = null"></button>
    </div>
}

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <input class="form-control form-control-sm" placeholder="@L["Metrics_MetricId"]…" @bind="SearchId" @bind:event="oninput" @bind:after="ResetPage" />
        </div>
        <div class="col-md-5">
            <input class="form-control form-control-sm" placeholder="@L["Metrics_Description"]…" @bind="SearchDesc" @bind:event="oninput" @bind:after="ResetPage" />
        </div>
    </div>

    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-sm table-hover align-middle" style="table-layout:fixed; width:100%;">
            <colgroup>
                <col style="width:14%" />
                <col style="width:14%" />
                <col style="width:20%" />
                <col style="width:8%" />
                <col style="width:7%" />
                <col style="width:7%" />
                <col style="width:18%" />
                <col style="width:12%" />
            </colgroup>
            <thead class="table-light">
                <tr>
                    <th>@L["Metrics_MetricId"]</th>
                    <th>@L["Metrics_DisplayName"]</th>
                    <th>@L["Metrics_Description"]</th>
                    <th>@L["Metrics_DataType"]</th>
                    <th>@L["Metrics_ValueType"]</th>
                    <th>@L["Metrics_MetricType"]</th>
                    <th>@L["Metrics_Function"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in PagedMetrics)
                {
                    <tr @key="m.MetricId">
                        <td class="small text-truncate" title="@m.MetricId">@m.MetricId</td>
                        <td class="small text-truncate" title="@(m.DisplayName ?? m.Description)">@(m.DisplayName ?? m.Description)</td>
                        <td class="small text-truncate" title="@m.Description">@m.Description</td>
                        <td class="small text-truncate">@m.DataType</td>
                        <td class="small text-truncate">@m.ValueType</td>
                        <td class="small text-truncate">@m.MetricType</td>
                        <td class="small text-truncate" title="@m.MetricFunction">@m.MetricFunction</td>
                        <td class="text-end text-nowrap">
                            <button class="btn btn-outline-secondary btn-sm me-1" title="Translations" @onclick="() => OpenTranslationModal(m)">
                                <i class="bi bi-translate"></i>
                            </button>
                            <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => OpenModal(m)">@L["Edit"]</button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(m)">@L["Delete"]</button>
                        </td>
                    </tr>
                }
                @if (TotalFiltered == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-3">@L["Metrics_Empty"]</td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        <span class="pagination-info">@TotalFiltered @L["Common_Records"]</span>
        <div class="pagination-controls">
            <select class="pagination-size" @bind="PageSize" @bind:after="ResetPage">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="PrevPage">&#8249;</button>
            <span class="pagination-counter">@PageLabel</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="NextPage">&#8250;</button>
        </div>
    </div>
}

@if (ShowModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-metric-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-metric-title">@(IsNew ? L["Metrics_New"] : L["Metrics_Edit"])</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (ModalError is not null)
                    {
                        <div class="alert alert-danger py-2">@ModalError</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_MetricId"] *</label>
                            @if (IsNew)
                            {
                                <div class="form-control bg-light text-muted">@L["Metrics_IdAutoGenerated"]</div>
                            }
                            else
                            {
                                <input class="form-control" value="@EditMetricId" disabled />
                            }
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_Description"]</label>
                            <input class="form-control" @bind="EditDescription" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_Default"]</label>
                            <input class="form-control" @bind="EditDefaultValue" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_DataType"] *</label>
                            <select class="form-select" @bind="EditDataType">
                                <option value="">— select —</option>
                                @foreach (var v in DataTypes)
                                {
                                    <option @key="v" value="@v">@v</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_Function"] *</label>
                            <select class="form-select" @bind="EditMetricFunction">
                                <option value="">— select —</option>
                                @foreach (var v in MetricFunctions)
                                {
                                    <option @key="v" value="@v">@v</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_Format"]</label>
                            <input class="form-control" @bind="EditMetricFormat" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_ValueType"] *</label>
                            <select class="form-select" @bind="EditValueType">
                                <option value="String">String</option>
                                <option value="Time">Time</option>
                                <option value="Number">Number</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_MetricType"] *</label>
                            <select class="form-select" @bind="EditMetricType">
                                <option value="Agent">Agent</option>
                                <option value="Data">Data</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@L["Metrics_Parameter"] *</label>
                            <input class="form-control" @bind="EditMetricParameter" />
                        </div>
                    </div>

                    <hr class="my-3" />
                    <h6 class="mb-3">@L["Metrics_CatalogueSection"]</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@L["Metrics_DisplayName"]</label>
                            <input class="form-control" @bind="EditDisplayName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Metrics_ShortDescription"]</label>
                            <input class="form-control" @bind="EditShortDescription" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@L["Metrics_LongDescription"]</label>
                            <textarea class="form-control" rows="2" @bind="EditLongDescription"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@L["Metrics_Comparison"]</label>
                            <textarea class="form-control" rows="2" @bind="EditComparison"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Metrics_StandardKpi"]</label>
                            <input class="form-control" @bind="EditStandardKpi" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@L["Metrics_StandardRef"]</label>
                            <input class="form-control" @bind="EditStandardRef" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_CatalogCategory"]</label>
                            <select class="form-select" @bind="EditCatalogCategory">
                                <option value="">— select —</option>
                                <option value="Queue">Queue</option>
                                <option value="AgentGroup">AgentGroup</option>
                                <option value="Agent">Agent</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_Family"]</label>
                            <input class="form-control" @bind="EditFamily" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_Channel"]</label>
                            <input class="form-control" @bind="EditChannel" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_ThresholdSec"]</label>
                            <input type="number" class="form-control" @bind="EditThresholdSec" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">@L["Metrics_CatalogStatus"]</label>
                            <select class="form-select" @bind="EditCatalogStatus">
                                <option value="">— select —</option>
                                <option value="active">active</option>
                                <option value="duplicate">duplicate</option>
                                <option value="deprecated">deprecated</option>
                                <option value="defect-candidate">defect-candidate</option>
                            </select>
                        </div>
                        <div class="col-md-4"></div>
                        <div class="col-12">
                            <label class="form-label">@L["Metrics_CatalogNotes"]</label>
                            <textarea class="form-control" rows="2" @bind="EditCatalogNotes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseModal">@L["Cancel"]</button>
                    <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@Saving">
                        @if (Saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L["Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (DeleteTarget is not null)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-metric-delete-title">
        <div class="modal-dialog modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-metric-delete-title">@L["Metrics_DeleteConfirm"]</h5>
                    <button class="btn-close" @onclick="() => DeleteTarget = null"></button>
                </div>
                <div class="modal-body">@L["Metrics_DeleteWarning"]: <strong>@DeleteTarget.MetricId</strong></div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="() => DeleteTarget = null">@L["Cancel"]</button>
                    <button class="btn btn-danger btn-sm" @onclick="ExecuteDelete">@L["Delete"]</button>
                </div>
            </div>
        </div>
    </div>
}


@if (ShowTranslationModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-translation-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <!-- TODO L1-C-i18n: localise after test-5 releases resx -->
                    <h5 class="modal-title" id="modal-translation-title">Translations: @TranslationMetricId</h5>
                    <button class="btn-close" @onclick="CloseTranslationModal"></button>
                </div>
                <div class="modal-body">
                    @if (TranslationError is not null)
                    {
                        <div class="alert alert-danger py-2">@TranslationError</div>
                    }
                    @if (TranslationSuccess is not null)
                    {
                        <div class="alert alert-success py-2">@TranslationSuccess</div>
                    }

                    <!-- EN reference (read-only) -->
                    <div class="card mb-3 bg-light">
                        <div class="card-header py-2">
                            <strong>en-US</strong> (Reference - read only)
                        </div>
                        <div class="card-body py-2">
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-0">DisplayName</label>
                                    <div class="form-control-plaintext small">@(TranslationEnDisplayName ?? "—")</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-0">ShortDescription</label>
                                    <div class="form-control-plaintext small">@(TranslationEnShortDesc ?? "—")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @foreach (var locale in TranslationLocales)
                    {
                        var isRtl = locale == "he-IL";
                        var dir = isRtl ? "rtl" : "ltr";
                        var loc = locale; // capture for lambdas
                        <div class="card mb-3">
                            <div class="card-header py-2 d-flex justify-content-between align-items-center">
                                <strong>@locale</strong>
                                <button class="btn btn-sm btn-outline-danger" @onclick="@(() => ClearTranslation(loc))" title="Clear">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div class="card-body py-2">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small">DisplayName</label>
                                        <input class="form-control form-control-sm" dir="@dir"
                                               value="@GetTranslationField(loc, nameof(MetricTranslationDto.DisplayName))"
                                               @onchange="@(e => SetTranslationField(loc, nameof(MetricTranslationDto.DisplayName), e.Value?.ToString()))" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small">ShortDescription</label>
                                        <input class="form-control form-control-sm" dir="@dir"
                                               value="@GetTranslationField(loc, nameof(MetricTranslationDto.ShortDescription))"
                                               @onchange="@(e => SetTranslationField(loc, nameof(MetricTranslationDto.ShortDescription), e.Value?.ToString()))" />
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">LongDescription</label>
                                        <textarea class="form-control form-control-sm" rows="2" dir="@dir"
                                                  value="@GetTranslationField(loc, nameof(MetricTranslationDto.LongDescription))"
                                                  @onchange="@(e => SetTranslationField(loc, nameof(MetricTranslationDto.LongDescription), e.Value?.ToString()))"></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small">Comparison</label>
                                        <textarea class="form-control form-control-sm" rows="2" dir="@dir"
                                                  value="@GetTranslationField(loc, nameof(MetricTranslationDto.Comparison))"
                                                  @onchange="@(e => SetTranslationField(loc, nameof(MetricTranslationDto.Comparison), e.Value?.ToString()))"></textarea>
                                    </div>
                                </div>
                                <div class="mt-2 text-end">
                                    <button class="btn btn-sm btn-primary" @onclick="@(() => SaveTranslation(loc))" disabled="@TranslationSaving">
                                        @if (TranslationSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        @L["Save"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseTranslationModal">@L["Common_Close"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<RtsGridMetricDto> Metrics = [];
    private string SearchId = "";
    private string SearchDesc = "";
    private IEnumerable<RtsGridMetricDto> FilteredMetrics =>
        Metrics.Where(m =>
            (string.IsNullOrWhiteSpace(SearchId)   || m.MetricId.Contains(SearchId, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(SearchDesc) || (m.Description ?? "").Contains(SearchDesc, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<string> DataTypes =>
        Metrics.Select(m => m.DataType).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x);
    private IEnumerable<string> MetricFunctions =>
        Metrics.Select(m => m.MetricFunction).Where(x => !string.IsNullOrEmpty(x)).Distinct().OrderBy(x => x);

    private int CurrentPage = 1;
    private int PageSize = 25;
    private int TotalFiltered => FilteredMetrics.Count();
    private int TotalPages => (int)Math.Ceiling((double)TotalFiltered / PageSize);
    private string PageLabel => $"{CurrentPage} / {Math.Max(1, TotalPages)}";
    private IEnumerable<RtsGridMetricDto> PagedMetrics => FilteredMetrics.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    private void ResetPage() => CurrentPage = 1;
    private void PrevPage() { if (CurrentPage > 1) CurrentPage--; }
    private void NextPage() { if (CurrentPage < TotalPages) CurrentPage++; }

    private bool Loading = true;
    private string? Error;

    private bool ShowModal;
    private bool IsNew;
    private bool Saving;
    private string? ModalError;
    private string EditMetricId = "";
    private string? EditDescription;
    private string EditDataType = "";
    private string EditMetricFunction = "";
    private string EditMetricParameter = "";
    private string? EditMetricFormat;
    private string? EditDefaultValue;
    private string EditValueType = "String";
    private string EditMetricType = "Agent";
    // Catalogue fields
    private string? EditDisplayName;
    private string? EditShortDescription;
    private string? EditLongDescription;
    private string? EditComparison;
    private string? EditStandardKpi;
    private string? EditStandardRef;
    private string? EditCatalogCategory;
    private string? EditFamily;
    private string? EditChannel;
    private int? EditThresholdSec;
    private string? EditCatalogStatus;
    private string? EditCatalogNotes;

    private RtsGridMetricDto? DeleteTarget;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Loading = true;
        try { Metrics = await Mediator.Send(new GetRtsGridMetricsQuery()); CurrentPage = 1; }
        catch (Exception ex) { Error = SafeError(ex); }
        finally { Loading = false; }
    }

    private void OpenModal(RtsGridMetricDto? m)
    {
        IsNew = m is null;
        EditMetricId = m?.MetricId ?? "";
        EditDescription = m?.Description;
        EditDataType = m?.DataType ?? "";
        EditMetricFunction = m?.MetricFunction ?? "";
        EditMetricParameter = m?.MetricParameter ?? "";
        EditMetricFormat = m?.MetricFormat;
        EditDefaultValue = m?.DefaultValue;
        EditValueType = m?.ValueType ?? "String";
        EditMetricType = m?.MetricType ?? "Agent";
        // Catalogue fields
        EditDisplayName = m?.DisplayName;
        EditShortDescription = m?.ShortDescription;
        EditLongDescription = m?.LongDescription;
        EditComparison = m?.Comparison;
        EditStandardKpi = m?.StandardKpi;
        EditStandardRef = m?.StandardRef;
        EditCatalogCategory = m?.CatalogCategory;
        EditFamily = m?.Family;
        EditChannel = m?.Channel;
        EditThresholdSec = m?.ThresholdSec;
        EditCatalogStatus = m?.CatalogStatus;
        EditCatalogNotes = m?.CatalogNotes;
        ModalError = null;
        ShowModal = true;
    }

    private void CloseModal() { ShowModal = false; ModalError = null; }

    private async Task Save()
    {
        // MetricId not validated for ADD (server generates UUIDv7-dashless)
        if (!IsNew && string.IsNullOrWhiteSpace(EditMetricId)) { ModalError = L["Metrics_IdRequired"]; return; }
        if (string.IsNullOrWhiteSpace(EditDataType)) { ModalError = L["Metrics_DataTypeRequired"]; return; }
        if (string.IsNullOrWhiteSpace(EditMetricFunction)) { ModalError = L["Metrics_FunctionRequired"]; return; }
        if (string.IsNullOrWhiteSpace(EditMetricParameter)) { ModalError = L["Metrics_ParameterRequired"]; return; }
        Saving = true;
        try
        {
            var result = await Mediator.Send(new SaveRtsGridMetricCommand(
                new SaveRtsGridMetricRequest(
                    EditMetricId, EditDescription, EditDataType,
                    EditMetricFunction, EditMetricParameter,
                    EditMetricFormat, EditDefaultValue, EditValueType, EditMetricType,
                    EditDisplayName, EditShortDescription, EditLongDescription, EditComparison,
                    EditStandardKpi, EditStandardRef, EditCatalogCategory, EditFamily, EditChannel,
                    EditThresholdSec, EditCatalogStatus, EditCatalogNotes,
                    IsNew)));
            if (!result.IsSuccess) { ModalError = result.Error; return; }
            CloseModal();
            await LoadAsync();
        }
        catch (Exception ex) { ModalError = SafeError(ex); }
        finally { Saving = false; }
    }

    private void ConfirmDelete(RtsGridMetricDto m) => DeleteTarget = m;

    private async Task ExecuteDelete()
    {
        if (DeleteTarget is null) return;
        try
        {
            var result = await Mediator.Send(new DeleteRtsGridMetricCommand(DeleteTarget.MetricId));
            if (!result.IsSuccess) Error = result.Error;
            DeleteTarget = null;
            await LoadAsync();
        }
        catch (Exception ex) { Error = SafeError(ex); DeleteTarget = null; }
    }

    private static string SafeError(Exception ex) =>
        ex is ValidationException vex
            ? string.Join(" ", vex.Errors.Select(e => e.ErrorMessage))
            : "An unexpected error occurred. Please try again.";

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();

    // ── Translation Editor ───────────────────────────────────────────────────
    private bool ShowTranslationModal;
    private string TranslationMetricId = "";
    private string? TranslationEnDisplayName;
    private string? TranslationEnShortDesc;
    private string? TranslationError;
    private string? TranslationSuccess;
    private bool TranslationSaving;
    private readonly string[] TranslationLocales = ["ru-RU", "he-IL"];
    private Dictionary<string, MetricTranslationDto> TranslationData = new();

    private async Task OpenTranslationModal(RtsGridMetricDto m)
    {
        TranslationMetricId = m.MetricId;
        TranslationEnDisplayName = m.DisplayName;
        TranslationEnShortDesc = m.ShortDescription;
        TranslationError = null;
        TranslationSuccess = null;
        TranslationData.Clear();

        try
        {
            var translations = await Mediator.Send(new GetMetricTranslationsQuery(m.MetricId));
            foreach (var t in translations)
                TranslationData[t.Locale] = t;
        }
        catch (Exception ex)
        {
            TranslationError = SafeError(ex);
        }

        ShowTranslationModal = true;
    }

    private void CloseTranslationModal()
    {
        ShowTranslationModal = false;
        TranslationError = null;
        TranslationSuccess = null;
    }

    private string? GetTranslationField(string locale, string field)
    {
        if (!TranslationData.TryGetValue(locale, out var t)) return null;
        return field switch
        {
            "DisplayName" => t.DisplayName,
            "ShortDescription" => t.ShortDescription,
            "LongDescription" => t.LongDescription,
            "Comparison" => t.Comparison,
            _ => null
        };
    }

    private void SetTranslationField(string locale, string field, string? value)
    {
        if (!TranslationData.TryGetValue(locale, out var t))
        {
            t = new MetricTranslationDto(TranslationMetricId, locale, null, null, null, null);
            TranslationData[locale] = t;
        }
        TranslationData[locale] = field switch
        {
            "DisplayName" => t with { DisplayName = value },
            "ShortDescription" => t with { ShortDescription = value },
            "LongDescription" => t with { LongDescription = value },
            "Comparison" => t with { Comparison = value },
            _ => t
        };
    }

    private async Task SaveTranslation(string locale)
    {
        TranslationSaving = true;
        TranslationError = null;
        TranslationSuccess = null;
        try
        {
            var t = TranslationData.GetValueOrDefault(locale) ?? new MetricTranslationDto(TranslationMetricId, locale, null, null, null, null);
            var req = new SaveMetricTranslationRequest(t.MetricId, t.Locale, t.DisplayName, t.ShortDescription, t.LongDescription, t.Comparison);
            var result = await Mediator.Send(new SaveMetricTranslationCommand(req));
            if (!result.IsSuccess)
            {
                TranslationError = result.Error;
            }
            else
            {
                TranslationSuccess = $"{locale} saved.";
            }
        }
        catch (Exception ex)
        {
            TranslationError = SafeError(ex);
        }
        finally
        {
            TranslationSaving = false;
        }
    }

    private async Task ClearTranslation(string locale)
    {
        TranslationSaving = true;
        TranslationError = null;
        TranslationSuccess = null;
        try
        {
            var result = await Mediator.Send(new DeleteMetricTranslationCommand(TranslationMetricId, locale));
            if (!result.IsSuccess)
            {
                TranslationError = result.Error;
            }
            else
            {
                TranslationData[locale] = new MetricTranslationDto(TranslationMetricId, locale, null, null, null, null);
                TranslationSuccess = $"{locale} cleared.";
            }
        }
        catch (Exception ex)
        {
            TranslationError = SafeError(ex);
        }
        finally
        {
            TranslationSaving = false;
        }
    }
}

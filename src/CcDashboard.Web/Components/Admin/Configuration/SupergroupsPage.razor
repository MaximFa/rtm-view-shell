@page "/admin/configuration/supergroups"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@using MediatR
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Domain.Interfaces
@using CcDashboard.Application.Commands.Configuration
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Contracts.DTOs.Configuration
@using CcDashboard.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using FluentValidation
@implements IDisposable

<PageTitle>@L["SG_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["SG_Title"]</h1>
    <div class="d-flex align-items-center gap-2">
        <AuthorizeView Roles="Superadmin">
            @if (Tenants.Count > 0)
            {
                <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                <select class="form-select form-select-sm" style="width:auto"
                        value="@SelectedTenantId"
                        @onchange="async e => { SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; _page = 1; await LoadAsync(); }">
                    <option value="">@L["Audit_AllTenants"]</option>
                    @foreach (var t in Tenants)
                    {
                        <option @key="t.Id" value="@t.Id">@t.Name</option>
                    }
                </select>
            }
        </AuthorizeView>
        <button class="btn btn-primary btn-sm text-nowrap" @onclick="() => OpenModal(null)">
            <i class="bi bi-plus-lg me-1"></i>@L["SG_New"]
        </button>
    </div>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @Error <button class="btn-close btn-sm" @onclick="() => Error = null"></button>
    </div>
}

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else
{
    <div class="row mb-3 g-2">
        <div class="col-auto">
            <input type="text" class="form-control form-control-sm" placeholder="@L["Common_Search"]..."
                   @bind="_search" @bind:event="oninput" @bind:after="() => _page = 1" style="width: 200px;" />
        </div>
    </div>

    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@L["SG_Name"]</th>
                    @if (CurrentUser.Role == "Superadmin")
                    {
                        <th>@L["PG_Tenant"]</th>
                    }
                    <th>@L["SG_Description"]</th>
                    <th>@L["SG_AgentGroups"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sg in PagedSupergroups)
                {
                    <tr @key="sg.SupergroupId">
                        <td>@sg.SupergroupName</td>
                        @if (CurrentUser.Role == "Superadmin")
                        {
                            var tenantName = Tenants.FirstOrDefault(t => t.Id == sg.TenantId)?.Name ?? sg.TenantId.ToString();
                            <td><span class="badge bg-light text-dark border small">@tenantName</span></td>
                        }
                        <td class="text-muted small">@sg.Description</td>
                        <td><span class="badge bg-secondary">@sg.AgentGroupIds.Count</span></td>
                        <td class="text-end">
                            <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenModal(sg)">@L["Edit"]</button>
                        </td>
                    </tr>
                }
                @if (!FilteredSupergroups.Any())
                {
                    <tr><td colspan="@(CurrentUser.Role == "Superadmin" ? 5 : 4)" class="text-center text-muted py-3">@L["SG_Empty"]</td></tr>
                }
            </tbody>
        </table>
    </div>
    <AppPagination TotalCount="FilteredSupergroups.Count()" Page="_page" PageSize="_pageSize"
                   PageChanged="p => { _page = p; StateHasChanged(); }" PageSizeChanged="s => { _pageSize = s; _page = 1; StateHasChanged(); }" />
}

@if (ShowModal)
{
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="modal-sg-title">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modal-sg-title">@(EditId is null ? L["SG_New"] : L["SG_Edit"])</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (ModalError is not null)
                    {
                        <div class="alert alert-danger py-2">@ModalError</div>
                    }
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label">@L["SG_Name"] *</label>
                            <input class="form-control" @bind="EditName" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@L["SG_Description"]</label>
                            <input class="form-control" @bind="EditDescription" />
                        </div>
                    </div>

                    <div class="fw-semibold small mb-2">
                        @L["SG_AgentGroups"] <span class="badge bg-secondary ms-1">@SelectedAgentGroupIds.Count</span>
                    </div>
                    <DualPaneSelector TKey="string"
                        AllItems="@AgentGroupItems"
                        SelectedIds="@SelectedAgentGroupIds"
                        SelectedIdsChanged="@(ids => SelectedAgentGroupIds = ids)" />

                    @if (EditId is not null)
                    {
                        <hr class="my-3" />
                        <div class="text-danger">
                            <strong>@L["Screens_DangerZone"]</strong>
                            @if (BusUsingSg.Count > 0)
                            {
                                <p class="small mt-2 mb-1">@L["SG_UsedInBU"]:</p>
                                <ul class="small mb-0">
                                    @foreach (var bu in BusUsingSg.Take(5))
                                    {
                                        <li>@bu</li>
                                    }
                                    @if (BusUsingSg.Count > 5)
                                    {
                                        <li>@L["Common_AndMore", BusUsingSg.Count - 5]</li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger ms-3 mt-2"
                                        @onclick="() => ConfirmDelete = true" disabled="@ConfirmDelete">
                                    @L["SG_DeleteConfirm"]
                                </button>
                                @if (ConfirmDelete)
                                {
                                    <span class="ms-2 small">@L["Screens_AreYouSure"]
                                        <button class="btn btn-danger btn-sm ms-1" @onclick="ExecuteDelete">@L["Screens_YesDelete"]</button>
                                        <button class="btn btn-secondary btn-sm ms-1" @onclick="() => ConfirmDelete = false">@L["Cancel"]</button>
                                    </span>
                                }
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseModal">@L["Cancel"]</button>
                    <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@Saving">
                        @if (Saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        @L["Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IReadOnlyList<SupergroupDto> Supergroups = [];
    private IReadOnlyList<AgentGroupDto> AllAgentGroups = [];
    private bool Loading = true;
    private string? Error;

    // Client-side filter
    private string _search = "";
    private int _page = 1;
    private int _pageSize = 25;

    private IEnumerable<SupergroupDto> FilteredSupergroups => Supergroups
        .Where(sg => string.IsNullOrWhiteSpace(_search)
            || (sg.SupergroupName ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
            || (sg.Description ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<SupergroupDto> PagedSupergroups => FilteredSupergroups.Skip((_page - 1) * _pageSize).Take(_pageSize);

    private List<TenantDto> Tenants = [];
    private Guid? SelectedTenantId;

    private bool ShowModal;
    private bool Saving;
    private string? ModalError;
    private int? EditId;
    private string? EditName;
    private string? EditDescription;
    private HashSet<string> SelectedAgentGroupIds = [];
    private bool ConfirmDelete;
    private List<string> BusUsingSg = [];

    private IReadOnlyList<(string Key, string Label)> AgentGroupItems =>
        AllAgentGroups.Select(a => (a.AgentGroupId, a.Name ?? a.AgentGroupId)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();
        if (CurrentUser.Role == "Superadmin")
            Tenants = (await Mediator.Send(new GetTenantsQuery())).ToList();
        else
            SelectedTenantId = CurrentUser.TenantId!.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        try
        {
            var tid = SelectedTenantId;
            Supergroups = await Mediator.Send(new GetSupergroupsQuery(tid));
            AllAgentGroups = await Mediator.Send(new GetAgentGroupsQuery(tid));
        }
        catch (Exception ex) { Error = SafeError(ex); }
        finally { Loading = false; }
    }

    private async Task OpenModal(SupergroupDto? sg)
    {
        EditId = sg?.SupergroupId;
        EditName = sg?.SupergroupName;
        EditDescription = sg?.Description;
        SelectedAgentGroupIds = sg?.AgentGroupIds.ToHashSet() ?? [];
        ModalError = null;
        ConfirmDelete = false;
        BusUsingSg = [];
        if (sg is not null)
        {
            BusUsingSg = await Mediator.Send(new GetBusinessUnitsUsingSupergroupQuery(sg.SupergroupId));
        }
        ShowModal = true;
    }

    private void CloseModal() { ShowModal = false; ModalError = null; }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(EditName)) { ModalError = L["SG_NameRequired"]; return; }
        Saving = true;
        try
        {
            var result = await Mediator.Send(new SaveSupergroupCommand(
                new SaveSupergroupRequest(EditId, EditName, EditDescription,
                    SelectedAgentGroupIds.ToList())));
            if (!result.IsSuccess) { ModalError = result.Error; return; }
            CloseModal();
            await LoadAsync();
        }
        catch (Exception ex) { ModalError = SafeError(ex); }
        finally { Saving = false; }
    }

    private async Task ExecuteDelete()
    {
        if (EditId is null) return;
        try
        {
            var result = await Mediator.Send(new DeleteSupergroupCommand(EditId.Value));
            if (!result.IsSuccess) { ModalError = result.Error; return; }
            CloseModal();
            await LoadAsync();
        }
        catch (Exception ex) { ModalError = SafeError(ex); }
    }

    private static string SafeError(Exception ex) =>
        ex is ValidationException vex
            ? string.Join(" ", vex.Errors.Select(e => e.ErrorMessage))
            : "An unexpected error occurred. Please try again.";

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

@page "/admin/audit"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@using MediatR
@using CcDashboard.Application.Queries.Audit
@using CcDashboard.Contracts.DTOs.Audit
@using CcDashboard.Contracts.Common
@using Microsoft.AspNetCore.Authorization

<PageTitle>@L["Audit_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Audit_Title"]</h1>
</div>

<!-- Filters -->
<div class="row g-2 mb-3">
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="EventTypeFilter" @bind:after="LoadAsync">
            <option value="">@L["Audit_AllTypes"]</option>
            @foreach (var t in EventTypes)
            {
                <option value="@t">@t</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="ResultFilter" @bind:after="LoadAsync">
            <option value="">@L["Audit_AllResults"]</option>
            <option value="Success">@L["Audit_Success"]</option>
            <option value="Failure">@L["Audit_Failure"]</option>
            <option value="Warning">@L["Audit_Warning"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" class="form-control form-control-sm" @bind="FromDate" @bind:after="LoadAsync" />
    </div>
    <div class="col-md-2">
        <input type="date" class="form-control form-control-sm" @bind="ToDate" @bind:after="LoadAsync" />
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="PageSize" @bind:after="LoadAsync">
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else if (Result == null || Result.Items.Count == 0)
{
    <div class="text-center text-muted py-5">@L["Audit_NoRecords"]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-hover">
            <thead class="table-light">
                <tr>
                    <th>@L["Audit_ColTime"]</th>
                    <th>@L["Audit_ColEvent"]</th>
                    <th>@L["Audit_ColResult"]</th>
                    <th>@L["Audit_ColUser"]</th>
                    <th>@L["Audit_ColIp"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Result.Items)
                {
                    <tr>
                        <td class="text-nowrap small">@log.CreatedAt.ToString("dd MMM HH:mm:ss")</td>
                        <td class="small fw-semibold">@log.EventType</td>
                        <td>@ResultBadge(log.EventResult)</td>
                        <td class="small">@(log.UserName ?? "-")</td>
                        <td class="small text-muted">@(log.IpAddress ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-2">
        <span class="text-muted small">@Result.TotalCount @L["Common_Records"]</span>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="PrevPage">
                @L["Common_Prev"]
            </button>
            <span class="align-self-center small">@L["Common_Page"] @Result.Page @L["Common_Of"] @Result.TotalPages</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(Result.Page >= Result.TotalPages)" @onclick="NextPage">
                @L["Common_Next"]
            </button>
        </div>
    </div>
}

@code {
    private PagedResult<AuditLogDto>? Result;
    private bool Loading = true;
    private string? EventTypeFilter;
    private string? ResultFilter;
    private DateTime? FromDate;
    private DateTime? ToDate;
    private int CurrentPage = 1;
    private int PageSize = 25;
    private List<string> EventTypes = [];

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadEventTypesAsync(), LoadAsync());
    }

    private Task LoadEventTypesAsync() => Task.CompletedTask;

    private async Task LoadAsync()
    {
        Loading = true;
        try
        {
            Result = await Mediator.Send(new GetAuditLogsQuery(
                EventType: EventTypeFilter,
                Result: ResultFilter,
                From: FromDate?.ToUniversalTime(),
                To: ToDate?.ToUniversalTime().AddDays(1),
                Page: CurrentPage,
                PageSize: PageSize));
        }
        catch { }
        finally { Loading = false; }
    }

    private async Task PrevPage() { CurrentPage--; await LoadAsync(); }
    private async Task NextPage() { CurrentPage++; await LoadAsync(); }

    private RenderFragment ResultBadge(string result) => result switch
    {
        "Success" => @<span class="badge bg-success">@L["Audit_Success"]</span>,
        "Failure" => @<span class="badge bg-danger">@L["Audit_Failure"]</span>,
        _ => @<span class="badge bg-warning text-dark">@L["Audit_Warning"]</span>
    };
}

@page "/admin/audit"
@rendermode InteractiveServer
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator")]
@inject IMediator Mediator
@inject ICurrentUserAccessor CurrentUser
@using MediatR
@using CcDashboard.Application.Queries.Audit
@using System.Collections.Generic
@using CcDashboard.Application.Queries.Tenants
@using CcDashboard.Contracts.DTOs.Audit
@using CcDashboard.Contracts.DTOs.Tenants
@using CcDashboard.Contracts.Common
@using CcDashboard.Domain.Interfaces
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json
@implements IDisposable

<PageTitle>@L["Audit_Title"] — RTM View Shell</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">@L["Audit_Title"]</h1>
    <AuthorizeView Roles="Superadmin">
        @if (Tenants.Count > 0)
        {
            <div class="d-flex align-items-center gap-2">
                <label class="form-label mb-0 small text-muted">@L["PG_Tenant"]</label>
                <select class="form-select form-select-sm" style="width:auto"
                        value="@SelectedTenantId"
                        @onchange="OnTenantChanged">
                    <option value="">@L["Audit_AllTenants"]</option>
                    @foreach (var t in Tenants)
                    {
                        <option @key="t.Id" value="@t.Id">@t.Name</option>
                    }
                </select>
            </div>
        }
    </AuthorizeView>
</div>

@if (Error is not null)
{
    <div class="alert alert-danger py-2 alert-dismissible">
        @Error <button class="btn-close btn-sm" @onclick="() => Error = null"></button>
    </div>
}

<!-- Filters -->
<div class="row g-2 mb-3">
    <div class="col-md-3">
        <select class="form-select form-select-sm" @bind="EventTypeFilter" @bind:after="ResetAndLoad">
            <option value="">@L["Audit_AllTypes"]</option>
            @foreach (var t in EventTypes)
            {
                <option @key="t" value="@t">@t</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select class="form-select form-select-sm" @bind="ResultFilter" @bind:after="ResetAndLoad">
            <option value="">@L["Audit_AllResults"]</option>
            <option value="Success">@L["Audit_Success"]</option>
            <option value="Failure">@L["Audit_Failure"]</option>
            <option value="Warning">@L["Audit_Warning"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="date" class="form-control form-control-sm" @bind="FromDate" @bind:after="ResetAndLoad" />
    </div>
    <div class="col-md-2">
        <input type="date" class="form-control form-control-sm" @bind="ToDate" @bind:after="ResetAndLoad" />
    </div>
</div>

@if (Loading)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm text-primary"></span></div>
}
else if (Result == null || Result.Items.Count == 0)
{
    <div class="text-center text-muted py-5">@L["Audit_NoRecords"]</div>
}
else
{
    <div class="table-responsive" aria-busy="@Loading">
        <table class="table table-sm table-hover">
            <thead class="table-light">
                <tr>
                    <th>@L["Audit_ColTime"]</th>
                    <th>@L["Audit_ColEvent"]</th>
                    <th>@L["Audit_ColResult"]</th>
                    <th>@L["Audit_ColUser"]</th>
                    <AuthorizeView Roles="Superadmin">
                        <th>@L["Audit_ColTenant"]</th>
                    </AuthorizeView>
                    <th>@L["Audit_ColDetails"]</th>
                    <th>@L["Audit_ColIp"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Result.Items)
                {
                    <tr @key="log.Id">
                        <td class="text-nowrap small">@log.CreatedAt.ToString("dd MMM HH:mm:ss")</td>
                        <td class="small fw-semibold">@log.EventType</td>
                        <td>@ResultBadge(log.EventResult)</td>
                        <td class="small">@(log.UserName ?? "-")</td>
                        <AuthorizeView Roles="Superadmin">
                            <td class="small text-muted">@TenantName(log.TenantId)</td>
                        </AuthorizeView>
                        <td class="small text-muted" title="@log.Details">@FormatDetails(log.Details)</td>
                        <td class="small text-muted">@(log.IpAddress ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination-bar">
        <span class="pagination-info">@Result.TotalCount @L["Common_Records"]</span>
        <div class="pagination-controls">
            <select class="pagination-size" @bind="PageSize" @bind:after="ResetAndLoad">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="PrevPage">&#8249;</button>
            <span class="pagination-counter">@CurrentPage / @Result.TotalPages</span>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(CurrentPage >= Result.TotalPages)" @onclick="NextPage">&#8250;</button>
        </div>
    </div>
}

@code {
    private PagedResult<AuditLogDto>? Result;
    private bool Loading = true;
    private string? Error;
    private string? EventTypeFilter;
    private string? ResultFilter;
    private DateTime? FromDate = DateTime.Today;
    private DateTime? ToDate = DateTime.Today;
    private int CurrentPage = 1;
    private int PageSize = 25;
    private List<string> EventTypes = [];

    private List<TenantDto> Tenants = [];
    private Guid? SelectedTenantId;

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.InitAsync();

        if (CurrentUser.Role == "Superadmin")
        {
            Tenants = (await Mediator.Send(new GetTenantsQuery(), _cts.Token)).ToList();
            // Default: no filter (all tenants)
            SelectedTenantId = null;
        }

        await LoadEventTypesAsync();
        await LoadAsync();
    }

    private async Task OnTenantChanged(ChangeEventArgs e)
    {
        SelectedTenantId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        CurrentPage = 1;
        await LoadEventTypesAsync();
        await LoadAsync();
    }

    private async Task ResetAndLoad()
    {
        CurrentPage = 1;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Loading = true;
        try
        {
            // For Superadmin: pass selected tenant (null = all tenants)
            // For Administrator: TenantId is null here, handler uses currentUser.TenantId
            var tenantId = CurrentUser.Role == "Superadmin" ? SelectedTenantId : null;

            Result = await Mediator.Send(new GetAuditLogsQuery(
                EventType: EventTypeFilter,
                Result: ResultFilter,
                From: FromDate?.ToUniversalTime(),
                To: ToDate?.ToUniversalTime().AddDays(1),
                Page: CurrentPage,
                PageSize: PageSize,
                TenantId: tenantId), _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { Error = ex.Message; }
        finally { Loading = false; }
    }

    private async Task LoadEventTypesAsync()
    {
        try
        {
            var tenantId = CurrentUser.Role == "Superadmin" ? SelectedTenantId : null;
            EventTypes = (await Mediator.Send(new GetDistinctAuditEventTypesQuery(tenantId), _cts.Token)).ToList();
        }
        catch { }
    }

    private async Task PrevPage() { CurrentPage--; await LoadAsync(); }
    private async Task NextPage() { CurrentPage++; await LoadAsync(); }

    private static string FormatDetails(string? json)
    {
        if (string.IsNullOrEmpty(json)) return "-";
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            // Prefer "Name" field, fall back to first string value
            if (root.TryGetProperty("Name", out var name) && name.ValueKind == JsonValueKind.String)
                return name.GetString() ?? "-";
            foreach (var prop in root.EnumerateObject())
                if (prop.Value.ValueKind == JsonValueKind.String)
                    return $"{prop.Name}: {prop.Value.GetString()}";
            return json.Length > 60 ? json[..60] + "…" : json;
        }
        catch { return json?.Length > 60 ? json[..60] + "…" : json ?? "-"; }
    }

    private string TenantName(Guid? tenantId) =>
        tenantId is null ? "—" :
        Tenants.FirstOrDefault(t => t.Id == tenantId)?.Name ?? tenantId.Value.ToString("D")[..8] + "…";

    private RenderFragment ResultBadge(string result) => result switch
    {
        "Success" => @<span class="badge bg-success">@L["Audit_Success"]</span>,
        "Failure" => @<span class="badge bg-danger">@L["Audit_Failure"]</span>,
        _ => @<span class="badge bg-warning text-dark">@L["Audit_Warning"]</span>
    };

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Contracts.DTOs.Widgets
@using Microsoft.AspNetCore.SignalR.Client
@using MediatR
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@implements IAsyncDisposable

@* Queue Grid Widget - connects to external SignalR simulator for real-time data *@

<div class="queue-grid-widget" style="@GetWidgetStyle()">
    @if (GridId == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-gear fs-3 mb-2 opacity-50"></i>
            <span class="small">@L["Widget_SaveConfigFirst"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Connecting)
    {
        <div class="d-flex align-items-center justify-content-center h-100 text-muted" aria-busy="true">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <span>@L["Widget_Connecting"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Failed)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-wifi-off fs-3 mb-2 text-warning"></i>
            <span class="small">@L["Widget_ConnectionFailed"]</span>
            <button class="btn btn-sm btn-link mt-2" @onclick="ReconnectAsync">
                @L["Widget_Retry"]
            </button>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-collection fs-3 mb-2 opacity-50"></i>
            <span class="small">@L["Widget_NoQueues"]</span>
        </div>
    }
    else
    {
        <div class="queue-grid-header d-flex align-items-center justify-content-between px-2 py-1 border-bottom">
            <span class="small text-muted">
                @_rows.Count @L["Widget_Queues"]
            </span>
            <span class="small">
                @if (_connectionState == ConnectionState.Connected)
                {
                    <span class="text-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@L["Widget_Live"]</span>
                }
                else if (_connectionState == ConnectionState.Reconnecting)
                {
                    <span class="text-warning"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@L["Widget_Reconnecting"]</span>
                }
            </span>
        </div>

        <div class="queue-grid-body" style="@GetTableStyle()">
            <table class="table table-sm mb-0 small" style="@GetTableStyle()">
                <thead class="queue-grid-thead" style="@GetTheadStyle()">
                    <tr style="@GetRowStyle(null, null)">
                        @foreach (var colDef in _columnDefs)
                        {
                            <th class="text-start">@colDef.Name</th>
                        }
                    </tr>
                </thead>
                <tbody style="@GetTableStyle()">
                    @foreach (var row in _rows)
                    {
                        <tr style="@GetRowStyle(row.BackgroundColor, row.FontColor)">
                            @foreach (var colDef in _columnDefs)
                            {
                                <td class="text-start font-monospace">@GetMetricValue(row.Metrics, colDef.MetricId)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public int GridId { get; set; }

    [Inject] private ILogger<QueueGridWidget> Logger { get; set; } = null!;
    [Inject] private IMediator Mediator { get; set; } = null!;

    private HubConnection? _hub;
    private List<QueueRowData> _rows = new();
    private ConnectionState _connectionState = ConnectionState.Connecting;
    private CancellationTokenSource _cts = new();

    // Configuration from widget settings
    private List<QueueGridColumnDef> _columnDefs = new();
    private List<QueueGridRowDef> _rowDefs = new();

    // Widget appearance
    private string? _fontSize;
    private string? _backgroundColor;
    private string? _fontColor;
    private string? _tableBackgroundColor;

    private class QueueRowData
    {
        public string RowId { get; set; } = "";
        public string? BackgroundColor { get; set; }
        public string? FontColor { get; set; }
        public Dictionary<string, string> Metrics { get; set; } = new();
    }

    private enum ConnectionState { Connecting, Connected, Reconnecting, Failed }

    protected override async Task OnInitializedAsync()
    {
        ApplyConfig();
        await ConnectAsync();
    }

    private int _previousGridId;

    protected override async Task OnParametersSetAsync()
    {
        ApplyConfig();

        if (GridId != 0 && _previousGridId == 0 && _hub is null)
        {
            _previousGridId = GridId;
            await ConnectAsync();
        }
        _previousGridId = GridId;
    }

    private void ApplyConfig()
    {
        if (Config is not null)
        {
            _fontSize = Config.FontSize;
            _backgroundColor = Config.BackgroundColor;
            _fontColor = Config.FontColor;
            _tableBackgroundColor = Config.TableBackgroundColor;

            _rowDefs = Config.QueueGridRows?.ToList() ?? new();
            _columnDefs = Config.QueueGridColumnDefs?.ToList() ?? new();

            // Initialize rows from row definitions
            _rows = _rowDefs.Select(r => new QueueRowData
            {
                RowId = r.Id,
                BackgroundColor = r.BackgroundColor,
                FontColor = r.FontColor
            }).ToList();
        }
    }

    private async Task ConnectAsync()
    {
        if (GridId == 0)
        {
            Logger.LogWarning("QueueGridWidget: GridId is 0, skipping connection");
            return;
        }

        _connectionState = ConnectionState.Connecting;
        Logger.LogInformation("QueueGridWidget: Starting connection for GridId {GridId}", GridId);

        await Task.Delay(Random.Shared.Next(100, 500), _cts.Token);

        try
        {
            var settings = await Mediator.Send(new GetTenantSettingsQuery(), _cts.Token);
            var simulatorUrl = settings?.SignalRConnectionUrl ?? "http://localhost:5045";
            var fullUrl = $"{simulatorUrl}/hubs/queue-grid?gridId={GridId}";

            Logger.LogInformation("QueueGridWidget: Connecting to {Url}", fullUrl);

            _hub = new HubConnectionBuilder()
                .WithUrl(fullUrl)
                .WithAutomaticReconnect(new[] {
                    TimeSpan.Zero,
                    TimeSpan.FromSeconds(2),
                    TimeSpan.FromSeconds(5),
                    TimeSpan.FromSeconds(10),
                    TimeSpan.FromSeconds(30)
                })
                .Build();

            _hub.On<GridUpdate>("QueueGridUpdate", async update =>
            {
                // Merge incoming data with our row definitions
                foreach (var incomingRow in update.Rows)
                {
                    var existingRow = _rows.FirstOrDefault(r => r.RowId == incomingRow.RowId);
                    if (existingRow != null)
                    {
                        existingRow.Metrics = incomingRow.Metrics;
                    }
                }
                await InvokeAsync(StateHasChanged);
            });

            _hub.Reconnecting += async _ =>
            {
                _connectionState = ConnectionState.Reconnecting;
                await InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += async _ =>
            {
                _connectionState = ConnectionState.Connected;
                await SendRowConfig();
                await InvokeAsync(StateHasChanged);
            };

            _hub.Closed += async ex =>
            {
                if (ex != null)
                {
                    Logger.LogWarning(ex, "SignalR connection closed with error");
                    _connectionState = ConnectionState.Failed;
                    await InvokeAsync(StateHasChanged);
                }
            };

            await _hub.StartAsync(_cts.Token);
            _connectionState = ConnectionState.Connected;

            await SendRowConfig();

            Logger.LogInformation("Connected to QueueGrid simulator for GridId {GridId}", GridId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "QueueGridWidget: Failed to connect. Error: {Message}", ex.Message);
            _connectionState = ConnectionState.Failed;
        }
    }

    private async Task SendRowConfig()
    {
        if (_hub is null || _hub.State != HubConnectionState.Connected) return;

        var rowConfigs = _rowDefs.Select((r, idx) => new RowConfig(
            RowId: r.Id,
            RowIndex: idx,
            DisplayName: r.QueueName ?? r.BusinessUnitName ?? $"Queue {idx + 1}"
        )).ToList();

        try
        {
            await _hub.SendAsync("UpdateRowConfig", GridId, rowConfigs, _cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to send row config");
        }
    }

    private async Task ReconnectAsync()
    {
        if (_hub != null)
        {
            try { await _hub.DisposeAsync(); } catch { }
            _hub = null;
        }

        _rows = _rowDefs.Select(r => new QueueRowData
        {
            RowId = r.Id,
            BackgroundColor = r.BackgroundColor,
            FontColor = r.FontColor
        }).ToList();

        await ConnectAsync();
    }

    private static string GetMetricValue(Dictionary<string, string> metrics, string metricId)
    {
        return metrics.TryGetValue(metricId, out var value) ? value : "-";
    }

    private string GetWidgetStyle()
    {
        var styles = new List<string>();
        if (!string.IsNullOrEmpty(_backgroundColor))
            styles.Add($"background-color: {_backgroundColor}");
        if (!string.IsNullOrEmpty(_fontColor))
            styles.Add($"color: {_fontColor}");
        if (!string.IsNullOrEmpty(_fontSize))
        {
            var size = _fontSize switch
            {
                "small" => "0.75rem",
                "normal" => "0.85rem",
                "large" => "1rem",
                "xlarge" => "1.15rem",
                "xxlarge" => "1.3rem",
                _ => "0.85rem"
            };
            styles.Add($"font-size: {size}");
        }
        return string.Join("; ", styles);
    }

    private string GetTableStyle()
    {
        var styles = new List<string>();

        if (!string.IsNullOrEmpty(_tableBackgroundColor) && _tableBackgroundColor != "transparent")
            styles.Add($"background-color: {_tableBackgroundColor}");
        if (!string.IsNullOrEmpty(_fontColor))
            styles.Add($"color: {_fontColor}");
        if (!string.IsNullOrEmpty(_fontSize))
        {
            var size = _fontSize switch
            {
                "small" => "0.75rem",
                "normal" => "0.85rem",
                "large" => "1rem",
                "xlarge" => "1.15rem",
                "xxlarge" => "1.3rem",
                _ => "0.85rem"
            };
            styles.Add($"font-size: {size}");
        }

        return string.Join("; ", styles);
    }

    private string GetTheadStyle()
    {
        var styles = new List<string>();

        var bgColor = !string.IsNullOrEmpty(_tableBackgroundColor) && _tableBackgroundColor != "transparent"
            ? _tableBackgroundColor
            : !string.IsNullOrEmpty(_backgroundColor) && _backgroundColor != "transparent"
                ? _backgroundColor
                : "var(--clr-surface, #fff)";

        styles.Add($"background-color: {bgColor}");

        if (!string.IsNullOrEmpty(_fontColor))
            styles.Add($"color: {_fontColor}");

        return string.Join("; ", styles);
    }

    private string GetRowStyle(string? bgColor, string? fontColor)
    {
        var styles = new List<string>();

        var effectiveBg = bgColor ?? (_tableBackgroundColor != "transparent" ? _tableBackgroundColor : null);
        var effectiveFont = fontColor ?? _fontColor;

        if (!string.IsNullOrEmpty(effectiveBg) && effectiveBg != "transparent")
            styles.Add($"background-color: {effectiveBg}");
        if (!string.IsNullOrEmpty(effectiveFont))
            styles.Add($"color: {effectiveFont}");

        return string.Join("; ", styles);
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_hub != null)
        {
            try
            {
                await _hub.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Error disposing hub connection");
            }
        }
        _cts.Dispose();
    }
}

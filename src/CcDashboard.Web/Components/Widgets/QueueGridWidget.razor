@using CcDashboard.Contracts.DTOs.Widgets
@using CcDashboard.Application.Queries.TenantSettings
@using Microsoft.AspNetCore.SignalR.Client
@using MediatR
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable

@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L
@inject IJSRuntime JS

@* Queue Grid Widget - connects to external SignalR simulator for real-time data *@

<div class="queue-grid-widget" style="@GetWidgetStyle()" @onkeydown="HandleKeyDown" tabindex="0">
    @* Reconnecting banner *@
    @if (_connectionState == ConnectionState.Reconnecting)
    {
        <div class="alert alert-warning alert-sm d-flex align-items-center gap-2 py-1 px-2 mb-0 rounded-0"
             role="alert" style="position: sticky; top: 0; z-index: 1040;">
            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
            <span class="small">@L["Widget_Reconnecting"]</span>
            <button class="btn btn-sm btn-link p-0 ms-auto" @onclick="ReconnectAsync" aria-label="@L["Widget_ReloadPage"]">
                @L["Widget_ReloadPage"]
            </button>
        </div>
    }

    @if (GridId == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-gear fs-3 mb-2 opacity-50" aria-hidden="true"></i>
            <span class="small">@L["Widget_SaveConfigFirst"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Connecting)
    {
        <div class="d-flex align-items-center justify-content-center h-100 text-muted" aria-busy="true" aria-live="polite">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <span>@L["Widget_Connecting"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Failed)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" role="alert">
            <i class="bi bi-wifi-off fs-3 mb-2 text-warning" aria-hidden="true"></i>
            <span class="small">@L["Widget_ConnectionFailed"]</span>
            <button class="btn btn-sm btn-link mt-2" @onclick="ReconnectAsync" aria-label="@L["Widget_Retry"]">
                @L["Widget_Retry"]
            </button>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" role="status">
            <i class="bi bi-collection fs-3 mb-2 opacity-50" aria-hidden="true"></i>
            <span class="small">@L["Widget_NoQueues"]</span>
        </div>
    }
    else
    {
        var filteredRows = GetFilteredRows();
        var pagedRows = GetPagedRows(filteredRows);
        var activeFilterCount = GetActiveFilterCount();

        <div class="queue-grid-body" style="@GetTableStyle()">
            @* Active filters toolbar *@
            @if (activeFilterCount > 0)
            {
                <div class="d-flex align-items-center gap-2 px-2 py-1 border-bottom small" style="@GetTableStyle(); border-color: currentColor !important; opacity: 0.9;">
                    <span class="badge rounded-pill" style="@GetBadgeInvertStyle()">@activeFilterCount</span>
                    <span>@L["Widget_ActiveFilters"]</span>
                    <button class="btn btn-link btn-sm p-0 ms-auto"
                            style="@GetFontColorStyle() text-decoration: none;"
                            @onclick="ClearAllFilters"
                            aria-label="@L["Widget_ClearAllFilters"]">
                        @L["Widget_ClearAllFilters"]
                    </button>
                </div>
            }

            <table class="table table-sm table-hover mb-0 small queue-grid-table" style="@GetTableStyle()">
                <thead class="queue-grid-thead" style="@GetTheadStyle()">
                    <tr style="@GetRowStyle()">
                        @* Queue Name - always first column *@
                        @{
                            var queueNameHasFilter = HasActiveFilter("_queueName");
                            var queueNameFilterOpen = _activeFilterColumn == "_queueName";
                        }
                        <th scope="col" class="text-start position-relative" style="@GetTheadCellStyle()">
                            <span style="cursor: pointer;"
                                  @onclick='() => ToggleSort("_queueName")'
                                  role="button">
                                @L["Widget_QueueName"]
                                @if (_sortColumn == "_queueName")
                                {
                                    <i class="bi @(_sortAscending ? "bi-caret-up-fill" : "bi-caret-down-fill") ms-1"></i>
                                }
                            </span>
                            <button class="btn btn-link btn-sm p-0 ms-1"
                                    style="@GetFilterButtonStyle(queueNameHasFilter)"
                                    @onclick='() => ToggleFilterDropdown("_queueName")'
                                    @onclick:stopPropagation="true"
                                    aria-expanded="@queueNameFilterOpen"
                                    aria-label="@L["Widget_FilterColumn", L["Widget_QueueName"]]">
                                <i class="bi bi-funnel@(queueNameHasFilter ? "-fill" : "")"></i>
                            </button>
                            @if (queueNameFilterOpen)
                            {
                                @RenderQueueNameFilterDropdown()
                            }
                        </th>
                        @foreach (var colDef in _columnDefs)
                        {
                            var hasFilter = HasActiveFilter(colDef.MetricId);
                            var isFilterOpen = _activeFilterColumn == colDef.MetricId;
                            <th scope="col" class="text-start position-relative" style="@GetTheadCellStyle()">
                                <span style="cursor: pointer;"
                                      @onclick="() => ToggleSort(colDef.MetricId)"
                                      role="button"
                                      aria-label="@L["Widget_SortBy", colDef.Name]">
                                    @colDef.Name
                                    @if (_sortColumn == colDef.MetricId)
                                    {
                                        <i class="bi @(_sortAscending ? "bi-caret-up-fill" : "bi-caret-down-fill") ms-1"
                                           aria-label="@(_sortAscending ? L["Widget_SortedAsc"] : L["Widget_SortedDesc"])"></i>
                                    }
                                </span>
                                <button class="btn btn-link btn-sm p-0 ms-1"
                                        style="@GetFilterButtonStyle(hasFilter)"
                                        @onclick="() => ToggleFilterDropdown(colDef.MetricId)"
                                        @onclick:stopPropagation="true"
                                        aria-expanded="@isFilterOpen"
                                        aria-label="@L["Widget_FilterColumn", colDef.Name]">
                                    <i class="bi bi-funnel@(hasFilter ? "-fill" : "")"></i>
                                </button>
                                @if (isFilterOpen)
                                {
                                    @RenderFilterDropdown(colDef)
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody style="@GetTableStyle()" @onclick="CloseFilterDropdown">
                    @foreach (var row in pagedRows)
                    {
                        <tr class="queue-grid-row" style="@GetRowStyle()">
                            @* Queue Name - always first cell *@
                            <td class="text-start">@row.QueueName</td>
                            @foreach (var colDef in _columnDefs)
                            {
                                var cellValue = GetMetricValue(row.Metrics, colDef.MetricId);
                                var useMono = IsNumericColumn(colDef.MetricId);
                                var (thresholdBg, thresholdFg) = GetThresholdStyle(colDef.MetricId, cellValue);
                                var hasThreshold = !string.IsNullOrEmpty(thresholdBg) || !string.IsNullOrEmpty(thresholdFg);

                                <td class="text-start @(useMono ? "font-monospace" : "")">
                                    @if (hasThreshold)
                                    {
                                        <span class="threshold-badge" style="@GetBadgeStyle(thresholdBg, thresholdFg)">@cellValue</span>
                                    }
                                    else
                                    {
                                        @cellValue
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Footer with pagination and connection status *@
        <div class="queue-grid-footer d-flex align-items-center justify-content-between px-2 py-1 border-top small" style="@GetTableStyle()">
            @* Live indicator *@
            <div class="d-flex align-items-center gap-1" aria-label="@L["Widget_LiveDataUpdating"]">
                <span class="live-dot @(_connectionState == ConnectionState.Connected ? "connected" : "disconnected")"
                      aria-hidden="true"></span>
                <span class="small" style="opacity: 0.7;">
                    @if (_connectionState == ConnectionState.Connected)
                    {
                        @L["Widget_Live"]
                    }
                    else
                    {
                        @L["Widget_Disconnected"]
                    }
                </span>
            </div>

            @if (_showPagination)
            {
                @* Pagination *@
                <div class="d-flex align-items-center gap-2">
                    @if (TotalPages > 1)
                    {
                        <button class="btn btn-sm btn-link p-0"
                                disabled="@(_currentPage <= 1)"
                                @onclick="PreviousPage"
                                aria-label="@L["Widget_PreviousPage"]">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>
                        <span style="opacity: 0.7;" aria-live="polite">@_currentPage / @TotalPages</span>
                        <button class="btn btn-sm btn-link p-0"
                                disabled="@(_currentPage >= TotalPages)"
                                @onclick="NextPage"
                                aria-label="@L["Widget_NextPage"]">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    }
                </div>

                @* Page size + Row count *@
                <div class="d-flex align-items-center gap-1">
                    <input type="number" class="form-control form-control-sm"
                           style="width: 50px; background: transparent; border: 1px solid currentColor; color: inherit; text-align: center; @GetFontColorStyle()"
                           min="1" max="500"
                           value="@_pageSize"
                           @onchange="OnPageSizeInputChanged"
                           title="@L["Widget_RowsPerPage"]" />
                    <span style="@GetFontColorStyle()">/ @filteredRows.Count</span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public int GridId { get; set; }
    [Parameter] public bool DarkMode { get; set; }

    // Dark mode colors (from Config, with sensible defaults)
    private string _darkBackgroundColor = "#333333";
    private string _darkFontColor = "#FFFFFF";
    private string _darkTableBackgroundColor = "#333333";

    // Effective colors (respecting dark mode)
    private string EffectiveBackgroundColor => DarkMode ? _darkBackgroundColor : (_backgroundColor ?? "");
    private string EffectiveFontColor => DarkMode ? _darkFontColor : (_fontColor ?? "");
    private string EffectiveTableBackgroundColor => DarkMode ? _darkTableBackgroundColor : (_tableBackgroundColor ?? "");

    [Inject] private ILogger<QueueGridWidget> Logger { get; set; } = null!;
    [Inject] private IMediator Mediator { get; set; } = null!;

    private HubConnection? _hub;
    private List<QueueRowData> _rows = new();
    private ConnectionState _connectionState = ConnectionState.Connecting;
    private CancellationTokenSource _cts = new();

    // Configuration
    private List<QueueGridColumnDef> _columnDefs = new();
    private List<QueueGridRowDef> _rowDefs = new();
    private int _pageSize = 20;
    private int _currentPage = 1;
    private string? _sortColumn;
    private bool _sortAscending = true;

    // Appearance
    private string? _fontSize;
    private string? _backgroundColor;
    private string? _fontColor;
    private string? _tableBackgroundColor;
    private bool _showPagination = true;

    // Detected column data types (from actual values)
    private Dictionary<string, string> _detectedDataTypes = new();

    // Column thresholds
    private Dictionary<string, List<ColumnThreshold>> _columnThresholds = new(StringComparer.OrdinalIgnoreCase);

    private record ColumnThreshold(
        string? MatchType,
        string? From,
        string? To,
        string? TextMatch,
        string? TextTo,
        string? BackgroundColor,
        string? FontColor
    );

    // Filters
    private string? _activeFilterColumn;
    private string? _listDropdownOpen;
    private Dictionary<string, ColumnFilter> _columnFilters = new();

    private class ColumnFilter
    {
        public string Mode { get; set; } = "";
        public string Operator { get; set; } = "contains";
        public string TextValue { get; set; } = "";
        public HashSet<string> SelectedValues { get; set; } = new();
    }

    // Persisted widget state (localStorage)
    private class WidgetState
    {
        public int PageSize { get; set; } = 20;
        public Dictionary<string, ColumnFilterState> Filters { get; set; } = new();
    }

    private class ColumnFilterState
    {
        public string Mode { get; set; } = "";
        public string Operator { get; set; } = "contains";
        public string TextValue { get; set; } = "";
        public List<string> SelectedValues { get; set; } = new();
    }

    private class QueueRowData
    {
        public string RowId { get; set; } = "";
        public string QueueName { get; set; } = "";
        public Dictionary<string, string> Metrics { get; set; } = new();
    }

    private enum ConnectionState { Connecting, Connected, Reconnecting, Failed }

    private int FilteredRowCount => GetFilteredRows().Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRowCount / (double)_pageSize));

    private bool _stateLoaded;

    protected override async Task OnInitializedAsync()
    {
        ApplyConfig();
        await ConnectAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && GridId != 0 && !_stateLoaded)
        {
            _stateLoaded = true;
            await LoadWidgetStateAsync();
            StateHasChanged();
        }
    }

    private int _previousGridId;

    protected override async Task OnParametersSetAsync()
    {
        ApplyConfig();

        if (GridId != 0 && _previousGridId == 0 && _hub is null)
        {
            _previousGridId = GridId;
            await ConnectAsync();
        }
        _previousGridId = GridId;
    }

    private void ApplyConfig()
    {
        if (Config is not null)
        {
            _fontSize = Config.FontSize;
            _backgroundColor = Config.BackgroundColor;
            _fontColor = Config.FontColor;
            _tableBackgroundColor = Config.TableBackgroundColor;
            // Dark mode colors from config
            _darkBackgroundColor = Config.DarkBackgroundColor ?? "#333333";
            _darkFontColor = Config.DarkFontColor ?? "#FFFFFF";
            _darkTableBackgroundColor = Config.DarkTableBackgroundColor ?? "#333333";
            _showPagination = Config.ShowPagination;

            _rowDefs = Config.QueueGridRows?.ToList() ?? new();
            _columnDefs = Config.QueueGridColumnDefs?.ToList() ?? new();

            // Column thresholds
            _columnThresholds = Config.ColumnThresholds?
                .ToDictionary(
                    kvp => kvp.Key,
                    kvp => kvp.Value.Select(t => new ColumnThreshold(
                        t.MatchType,
                        t.From,
                        t.To,
                        t.TextMatch,
                        t.TextTo,
                        t.BackgroundColor,
                        t.FontColor
                    )).ToList(),
                    StringComparer.OrdinalIgnoreCase
                ) ?? new(StringComparer.OrdinalIgnoreCase);

            // Initialize rows from row definitions
            _rows = _rowDefs.Select(r => new QueueRowData
            {
                RowId = r.Id,
                QueueName = r.QueueName ?? r.BusinessUnitName ?? ""
            }).ToList();
        }
    }

    private async Task ConnectAsync()
    {
        if (GridId == 0)
        {
            Logger.LogWarning("QueueGridWidget: GridId is 0, skipping connection");
            return;
        }

        _connectionState = ConnectionState.Connecting;
        Logger.LogInformation("QueueGridWidget: Starting connection for GridId {GridId}", GridId);

        await Task.Delay(Random.Shared.Next(100, 500), _cts.Token);

        try
        {
            var settings = await Mediator.Send(new GetTenantSettingsQuery(), _cts.Token);
            var simulatorUrl = settings?.SignalRConnectionUrl ?? "http://localhost:5045";
            var fullUrl = $"{simulatorUrl}/hubs/queue-grid?gridId={GridId}";

            Logger.LogInformation("QueueGridWidget: Connecting to {Url}", fullUrl);

            _hub = new HubConnectionBuilder()
                .WithUrl(fullUrl)
                .WithAutomaticReconnect(new[] {
                    TimeSpan.Zero,
                    TimeSpan.FromSeconds(2),
                    TimeSpan.FromSeconds(5),
                    TimeSpan.FromSeconds(10),
                    TimeSpan.FromSeconds(30)
                })
                .Build();

            _hub.On<GridUpdate>("QueueGridUpdate", async update =>
            {
                var isFirstData = _rows.All(r => r.Metrics.Count == 0);

                foreach (var incomingRow in update.Rows)
                {
                    var existingRow = _rows.FirstOrDefault(r => r.RowId == incomingRow.RowId);
                    if (existingRow != null)
                    {
                        existingRow.Metrics = incomingRow.Metrics;
                    }
                }

                // Detect column data types on first data received
                if (isFirstData)
                {
                    DetectColumnDataTypes();
                }

                await InvokeAsync(StateHasChanged);
            });

            _hub.Reconnecting += async _ =>
            {
                _connectionState = ConnectionState.Reconnecting;
                await InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += async _ =>
            {
                _connectionState = ConnectionState.Connected;
                await SendRowConfig();
                await InvokeAsync(StateHasChanged);
            };

            _hub.Closed += async ex =>
            {
                if (ex != null)
                {
                    Logger.LogWarning(ex, "SignalR connection closed with error");
                    _connectionState = ConnectionState.Failed;
                    await InvokeAsync(StateHasChanged);
                }
            };

            await _hub.StartAsync(_cts.Token);
            _connectionState = ConnectionState.Connected;

            await SendRowConfig();

            Logger.LogInformation("Connected to QueueGrid simulator for GridId {GridId}", GridId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "QueueGridWidget: Failed to connect. Error: {Message}", ex.Message);
            _connectionState = ConnectionState.Failed;
        }
    }

    private async Task SendRowConfig()
    {
        if (_hub is null || _hub.State != HubConnectionState.Connected) return;

        var rowConfigs = _rowDefs.Select((r, idx) => new RowConfig(
            RowId: r.Id,
            RowIndex: idx,
            DisplayName: r.QueueName ?? r.BusinessUnitName ?? $"Queue {idx + 1}"
        )).ToList();

        try
        {
            await _hub.SendAsync("UpdateRowConfig", GridId, rowConfigs, _cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to send row config");
        }
    }

    private async Task ReconnectAsync()
    {
        if (_hub != null)
        {
            try { await _hub.DisposeAsync(); } catch { }
            _hub = null;
        }

        _rows = _rowDefs.Select(r => new QueueRowData
        {
            RowId = r.Id,
            QueueName = r.QueueName ?? r.BusinessUnitName ?? ""
        }).ToList();

        await ConnectAsync();
    }

    // Filtering
    private List<QueueRowData> GetFilteredRows()
    {
        var rows = _rows.AsEnumerable();

        foreach (var (metricId, filter) in _columnFilters)
        {
            if (string.IsNullOrEmpty(filter.Mode)) continue;

            // Special case: Queue Name column
            if (metricId == "_queueName")
            {
                if (filter.Mode == "value" && !string.IsNullOrEmpty(filter.TextValue))
                {
                    rows = rows.Where(r => MatchesValueFilter(r.QueueName, filter));
                }
                else if (filter.Mode == "list" && filter.SelectedValues.Count > 0)
                {
                    rows = rows.Where(r => filter.SelectedValues.Contains(r.QueueName));
                }
            }
            else
            {
                if (filter.Mode == "value" && !string.IsNullOrEmpty(filter.TextValue))
                {
                    rows = rows.Where(r => MatchesValueFilter(GetMetricValue(r.Metrics, metricId), filter));
                }
                else if (filter.Mode == "list" && filter.SelectedValues.Count > 0)
                {
                    rows = rows.Where(r => filter.SelectedValues.Contains(GetMetricValue(r.Metrics, metricId)));
                }
            }
        }

        // Sorting
        if (!string.IsNullOrEmpty(_sortColumn))
        {
            var isNumeric = IsNumericColumn(_sortColumn);
            rows = _sortAscending
                ? rows.OrderBy(r => GetSortValue(r, _sortColumn, isNumeric))
                : rows.OrderByDescending(r => GetSortValue(r, _sortColumn, isNumeric));
        }

        return rows.ToList();
    }

    private static bool MatchesValueFilter(string value, ColumnFilter filter)
    {
        var filterValue = filter.TextValue;
        return filter.Operator switch
        {
            "contains" => value.Contains(filterValue, StringComparison.OrdinalIgnoreCase),
            "equal" => value.Equals(filterValue, StringComparison.OrdinalIgnoreCase),
            "startsWith" => value.StartsWith(filterValue, StringComparison.OrdinalIgnoreCase),
            "endsWith" => value.EndsWith(filterValue, StringComparison.OrdinalIgnoreCase),
            "less" => CompareNumeric(value, filterValue) < 0,
            "lessOrEqual" => CompareNumeric(value, filterValue) <= 0,
            "greater" => CompareNumeric(value, filterValue) > 0,
            "greaterOrEqual" => CompareNumeric(value, filterValue) >= 0,
            _ => true
        };
    }

    private static int CompareNumeric(string a, string b)
    {
        var aVal = ParseToSeconds(a) ?? 0;
        var bVal = ParseToSeconds(b) ?? 0;
        return aVal.CompareTo(bVal);
    }

    private object GetSortValue(QueueRowData row, string metricId, bool isNumeric)
    {
        // Special case: Queue Name column
        if (metricId == "_queueName")
        {
            return row.QueueName;
        }

        var value = GetMetricValue(row.Metrics, metricId);
        if (isNumeric)
        {
            return ParseToSeconds(value) ?? 0;
        }
        return value;
    }

    private List<QueueRowData> GetPagedRows(List<QueueRowData> filtered)
    {
        return filtered
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private bool HasActiveFilter(string metricId)
    {
        if (!_columnFilters.TryGetValue(metricId, out var filter)) return false;
        return filter.Mode == "value" && !string.IsNullOrEmpty(filter.TextValue)
            || filter.Mode == "list" && filter.SelectedValues.Count > 0;
    }

    private int GetActiveFilterCount()
    {
        return _columnFilters.Count(kvp =>
            kvp.Value.Mode == "value" && !string.IsNullOrEmpty(kvp.Value.TextValue)
            || kvp.Value.Mode == "list" && kvp.Value.SelectedValues.Count > 0);
    }

    private async Task ClearAllFilters()
    {
        _columnFilters.Clear();
        _activeFilterColumn = null;
        _listDropdownOpen = null;
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private void CloseFilterDropdown()
    {
        _activeFilterColumn = null;
        _listDropdownOpen = null;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseFilterDropdown();
        }
    }

    private List<string> GetDistinctValues(string metricId)
    {
        return _rows
            .Select(r => GetMetricValue(r.Metrics, metricId))
            .Where(v => v != "-")
            .Distinct()
            .OrderBy(v => v)
            .Take(50)
            .ToList();
    }

    private ColumnFilter GetOrCreateFilter(string metricId)
    {
        if (!_columnFilters.TryGetValue(metricId, out var filter))
        {
            filter = new ColumnFilter();
            _columnFilters[metricId] = filter;
        }
        return filter;
    }

    private void ToggleFilterDropdown(string metricId)
    {
        if (_activeFilterColumn == metricId)
        {
            _activeFilterColumn = null;
            _listDropdownOpen = null;
        }
        else
        {
            _activeFilterColumn = metricId;
            _listDropdownOpen = null;
            if (!_columnFilters.ContainsKey(metricId))
            {
                _columnFilters[metricId] = new ColumnFilter();
            }
        }
    }

    private async Task ClearFilter(string metricId)
    {
        if (_columnFilters.ContainsKey(metricId))
        {
            _columnFilters[metricId] = new ColumnFilter();
        }
        _activeFilterColumn = null;
        _listDropdownOpen = null;
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private void UpdateFilterOperator(string metricId, ChangeEventArgs e)
    {
        var filter = GetOrCreateFilter(metricId);
        filter.Operator = e.Value?.ToString() ?? "contains";
    }

    private async Task ApplyValueFilter(string metricId)
    {
        var filter = GetOrCreateFilter(metricId);
        if (!string.IsNullOrEmpty(filter.TextValue))
        {
            filter.Mode = "value";
            filter.SelectedValues.Clear();
        }
        _activeFilterColumn = null;
        _listDropdownOpen = null;
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private async Task ToggleListValue(string metricId, string value)
    {
        var filter = GetOrCreateFilter(metricId);
        filter.TextValue = "";

        if (filter.SelectedValues.Contains(value))
            filter.SelectedValues.Remove(value);
        else
            filter.SelectedValues.Add(value);

        filter.Mode = filter.SelectedValues.Count > 0 ? "list" : "";
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private static string GetListButtonLabel(ColumnFilter filter)
    {
        if (filter.SelectedValues.Count == 0) return "Select values...";
        if (filter.SelectedValues.Count == 1) return filter.SelectedValues.First();
        return $"{filter.SelectedValues.Count} selected";
    }

    private void ToggleListDropdown(string metricId)
    {
        _listDropdownOpen = _listDropdownOpen == metricId ? null : metricId;
    }

    private void OnValueInput(string metricId)
    {
        var filter = GetOrCreateFilter(metricId);
        if (string.IsNullOrEmpty(filter.TextValue))
        {
            filter.Mode = "";
        }
    }

    private RenderFragment RenderFilterDropdown(QueueGridColumnDef colDef) => __builder =>
    {
        var filter = GetOrCreateFilter(colDef.MetricId);
        var isNumeric = IsNumericColumn(colDef.MetricId);
        var distinctValues = isNumeric ? new List<string>() : GetDistinctValues(colDef.MetricId);

        <div class="filter-dropdown position-absolute rounded shadow-lg p-2"
             style="top: 100%; inset-inline-start: 0; min-width: 200px; z-index: 1050; @GetFilterDropdownStyle()"
             @onclick:stopPropagation="true">

            <!-- Header with label and icons -->
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small opacity-75">Value</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-link btn-sm p-0" style="color: var(--clr-success, #198754);" title="Apply" @onclick="() => ApplyValueFilter(colDef.MetricId)">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-link btn-sm p-0" style="color: var(--clr-danger, #dc3545);" title="Clear" @onclick="() => ClearFilter(colDef.MetricId)">
                        <i class="bi bi-trash"></i>
                    </button>
                    <button class="btn btn-link btn-sm p-0" style="@GetFontColorStyle()" title="Close" @onclick="CloseFilterDropdown">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- VALUE section -->
            <div class="mb-1">
                <select class="form-select form-select-sm mb-1"
                        style="@GetFilterInputStyle()"
                        value="@filter.Operator"
                        @onchange="e => UpdateFilterOperator(colDef.MetricId, e)">
                    @if (isNumeric)
                    {
                        <option value="less">Less than</option>
                        <option value="lessOrEqual">Less or equal</option>
                        <option value="greater">Greater than</option>
                        <option value="greaterOrEqual">Greater or equal</option>
                        <option value="equal">Equal</option>
                    }
                    else
                    {
                        <option value="contains">Contains</option>
                        <option value="equal">Equal</option>
                        <option value="startsWith">Starts with</option>
                        <option value="endsWith">Ends with</option>
                    }
                </select>
                <input type="text" class="form-control form-control-sm"
                       style="@GetFilterInputStyle()"
                       @bind="filter.TextValue"
                       @bind:event="oninput"
                       @bind:after="() => OnValueInput(colDef.MetricId)"
                       placeholder="@(isNumeric ? "e.g. 30:00" : "Filter value...")" />
            </div>

            @if (!isNumeric && distinctValues.Count > 0)
            {
                <div class="border-top pt-3 mt-3" style="border-color: currentColor; opacity: 0.3;">
                </div>
                <div style="opacity: 1;">
                    <div class="small mb-2 opacity-75">List</div>
                    <div class="position-relative">
                        <button class="btn btn-sm w-100 d-flex justify-content-between align-items-center"
                                style="@GetFilterInputStyle()"
                                @onclick="() => ToggleListDropdown(colDef.MetricId)"
                                @onclick:stopPropagation="true">
                            <span>@GetListButtonLabel(filter)</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        @if (_listDropdownOpen == colDef.MetricId)
                        {
                            <div class="position-absolute w-100 rounded shadow-sm mt-1"
                                 style="@GetFilterDropdownStyle() z-index: 1060; max-height: 180px; overflow-y: auto;">
                                @foreach (var val in distinctValues)
                                {
                                    var isChecked = filter.SelectedValues.Contains(val);
                                    <div class="d-flex align-items-center gap-2 px-2 py-1" style="border-bottom: 1px solid currentColor; opacity: 0.8;">
                                        <input type="checkbox" class="form-check-input m-0" style="flex-shrink: 0;"
                                               checked="@isChecked"
                                               @onchange="() => ToggleListValue(colDef.MetricId, val)" />
                                        <span class="small" style="text-transform: none;">@val</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    };


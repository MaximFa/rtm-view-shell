    private List<string> GetDistinctQueueNames()
    {
        return _rows
            .Select(r => r.QueueName)
            .Where(v => !string.IsNullOrEmpty(v))
            .Distinct()
            .OrderBy(v => v)
            .Take(50)
            .ToList();
    }

    // Sorting
    private void ToggleSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    // Pagination
    private void PreviousPage()
    {
        if (_currentPage > 1) _currentPage--;
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages) _currentPage++;
    }

    private async Task OnPageSizeInputChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0 && size <= 500)
        {
            _pageSize = size;
            _currentPage = 1;
            await SaveWidgetStateAsync();
        }
    }

    // Helpers
    private static string GetMetricValue(Dictionary<string, string> metrics, string metricId)
    {
        return metrics.TryGetValue(metricId, out var value) ? value : "-";
    }

    private bool IsNumericColumn(string metricId)
    {
        // First check detected data type from actual values
        if (_detectedDataTypes.TryGetValue(metricId, out var dataType))
        {
            return dataType == "number" || dataType == "time";
        }
        // Fallback to pattern matching on metric ID
        var id = metricId.ToLowerInvariant();
        return id.Contains("duration") || id.Contains("occupancy") || id.Contains("adherence") ||
               id.Contains("calls") || id.Contains("aht") || id.Contains("time") || id.Contains("percent") ||
               id.Contains("total") || id.Contains("avg") || id.Contains("count") || id.Contains("waiting") ||
               id.Contains("available") || id.Contains("level") || id.Contains("abandon");
    }

    private static string DetectDataType(string? value)
    {
        if (string.IsNullOrEmpty(value) || value == "-") return "text";

        // Check for time format: MM:SS or HH:MM:SS
        var parts = value.Split(':');
        if (parts.Length == 2 || parts.Length == 3)
        {
            if (parts.All(p => int.TryParse(p, out _)))
                return "time";
        }

        // Check for number (including percentages)
        var numStr = value.TrimEnd('%');
        if (double.TryParse(numStr, out _))
            return "number";

        return "text";
    }

    private void DetectColumnDataTypes()
    {
        if (_rows.Count == 0 || _columnDefs.Count == 0) return;

        var firstRow = _rows.FirstOrDefault(r => r.Metrics.Count > 0);
        if (firstRow == null) return;

        foreach (var colDef in _columnDefs)
        {
            if (string.IsNullOrEmpty(colDef.MetricId)) continue;

            var sampleValue = GetMetricValue(firstRow.Metrics, colDef.MetricId);
            var detectedType = DetectDataType(sampleValue);
            _detectedDataTypes[colDef.MetricId] = detectedType;
        }

        Logger.LogInformation("Detected column types: {Types}",
            string.Join(", ", _detectedDataTypes.Select(kvp => $"{kvp.Key}={kvp.Value}")));
    }

    private static double? ParseToSeconds(string? value)
    {
        if (string.IsNullOrEmpty(value)) return null;
        if (double.TryParse(value, out var num)) return num;

        var parts = value.Split(':');
        try
        {
            if (parts.Length == 3)
                return int.Parse(parts[0]) * 3600 + int.Parse(parts[1]) * 60 + int.Parse(parts[2]);
            if (parts.Length == 2)
                return int.Parse(parts[0]) * 60 + int.Parse(parts[1]);
        }
        catch { }
        return null;
    }

    // Thresholds
    private (string? bg, string? fg) GetThresholdStyle(string metricId, string cellValue)
    {
        if (!_columnThresholds.TryGetValue(metricId, out var thresholds) || thresholds.Count == 0)
            return (null, null);

        foreach (var t in thresholds)
        {
            if (t.MatchType == "text")
            {
                if (string.Equals(cellValue, t.TextMatch, StringComparison.OrdinalIgnoreCase))
                    return (t.BackgroundColor, t.FontColor);
            }
            else // numeric
            {
                var numericValue = ParseToSeconds(cellValue);
                var from = ParseToSeconds(t.From);
                var to = ParseToSeconds(t.To);

                if (numericValue.HasValue && from.HasValue)
                {
                    if (to.HasValue)
                    {
                        if (numericValue >= from && numericValue <= to)
                            return (t.BackgroundColor, t.FontColor);
                    }
                    else
                    {
                        if (numericValue >= from)
                            return (t.BackgroundColor, t.FontColor);
                    }
                }
            }
        }
        return (null, null);
    }

    private static string GetBadgeStyle(string? bg, string? fg)
    {
        var styles = new List<string>();
        if (!string.IsNullOrEmpty(bg)) styles.Add($"background-color: {bg}");
        if (!string.IsNullOrEmpty(fg)) styles.Add($"color: {fg}");
        return string.Join("; ", styles);
    }

    // Styles - using effective colors (respecting dark mode)
    private string GetWidgetStyle()
    {
        var styles = new List<string>();
        var bg = EffectiveBackgroundColor;
        var fg = EffectiveFontColor;
        if (!string.IsNullOrEmpty(bg))
            styles.Add($"background-color: {bg}");
        if (!string.IsNullOrEmpty(fg))
            styles.Add($"color: {fg}");
        if (!string.IsNullOrEmpty(_fontSize))
        {
            var size = _fontSize switch
            {
                "small" => "0.75rem",
                "normal" => "0.85rem",
                "large" => "1rem",
                "xlarge" => "1.15rem",
                "xxlarge" => "1.3rem",
                _ => "0.85rem"
            };
            styles.Add($"font-size: {size}");
        }
        return string.Join("; ", styles);
    }


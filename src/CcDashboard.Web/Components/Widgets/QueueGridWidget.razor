    // State persistence
    private string GetStorageKey() => $"queueGrid_{GridId}_state";

    private async Task SaveWidgetStateAsync()
    {
        if (GridId == 0) return;
        try
        {
            var state = new WidgetState
            {
                PageSize = _pageSize,
                Filters = _columnFilters.ToDictionary(
                    kvp => kvp.Key,
                    kvp => new ColumnFilterState
                    {
                        Mode = kvp.Value.Mode,
                        Operator = kvp.Value.Operator,
                        TextValue = kvp.Value.TextValue,
                        SelectedValues = kvp.Value.SelectedValues.ToList()
                    })
            };
            var json = System.Text.Json.JsonSerializer.Serialize(state);
            await JS.InvokeVoidAsync("localStorage.setItem", GetStorageKey(), json);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to save widget state");
        }
    }

    private async Task LoadWidgetStateAsync()
    {
        if (GridId == 0) return;
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", GetStorageKey());
            if (!string.IsNullOrEmpty(json))
            {
                var state = System.Text.Json.JsonSerializer.Deserialize<WidgetState>(json);
                if (state != null)
                {
                    _pageSize = state.PageSize > 0 ? state.PageSize : 20;
                    _columnFilters = state.Filters.ToDictionary(
                        kvp => kvp.Key,
                        kvp => new ColumnFilter
                        {
                            Mode = kvp.Value.Mode,
                            Operator = kvp.Value.Operator,
                            TextValue = kvp.Value.TextValue,
                            SelectedValues = kvp.Value.SelectedValues.ToHashSet()
                        });
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to load widget state");
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_hub != null)
        {
            try
            {
                await _hub.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Error disposing hub connection");
            }
        }
        _cts.Dispose();
    }

@using CcDashboard.Contracts.DTOs.Widgets
@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Application.Queries.AgentStates
@using CcDashboard.Domain.Domain.Rtm
@using CcDashboard.Application.Interfaces
@using MediatR
@using CcDashboard.Application.Queries.Widgets
@using Newtonsoft.Json.Serialization
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable

@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L
@inject IJSRuntime JS
@inject IRtmRelayService RtmRelay

<div class="agent-state-distribution-widget h-100 d-flex flex-column" style="@GetWidgetStyle()">
    @if (_connectionState == ConnectionState.Reconnecting)
    {
        <div class="alert alert-warning alert-sm d-flex align-items-center gap-2 py-1 px-2 mb-0 rounded-0"
             role="alert" style="position: sticky; top: 0; z-index: 1040;">
            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
            <span class="small">@L["Widget_Reconnecting"]</span>
        </div>
    }

    @if (RtsGridId == 0 || _businessUnitId == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-gear fs-3 mb-2 opacity-50" aria-hidden="true"></i>
            <span class="small">@L["Widget_SaveConfigFirst"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Connecting)
    {
        <div class="d-flex align-items-center justify-content-center h-100 text-muted" aria-busy="true" aria-live="polite">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <span>@L["Widget_Connecting"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Failed)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" role="alert">
            <i class="bi bi-wifi-off fs-3 mb-2 text-warning" aria-hidden="true"></i>
            <span class="small">@L["Widget_ConnectionFailed"]</span>
            <button class="btn btn-sm btn-link mt-2" @onclick="ReconnectAsync" aria-label="@L["Widget_Retry"]">
                @L["Widget_Retry"]
            </button>
        </div>
    }
    else
    {
        <div class="chart-container flex-grow-1 position-relative" style="min-height: 200px;">
            <canvas id="@_chartElementId"></canvas>
        </div>

        <div class="widget-footer d-flex align-items-center justify-content-between px-2 py-1 small" style="@GetFontColorStyle()">
            <div class="d-flex align-items-center gap-1">
                <span class="live-dot @(_connectionState == ConnectionState.Connected ? "connected" : "disconnected")"
                      aria-hidden="true"></span>
                <span class="small" style="opacity: 0.7;">
                    @if (_connectionState == ConnectionState.Connected)
                    {
                        @L["Widget_Live"]
                    }
                    else
                    {
                        @L["Widget_Disconnected"]
                    }
                </span>
            </div>
            <span class="small" style="opacity: 0.6;">@_totalAgents @L["Widget_Agents"]</span>
        </div>
    }
</div>

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public int GridId { get; set; }
    [Parameter] public bool DarkMode { get; set; }

    [Inject] private ILogger<AgentStateDistributionWidget> Logger { get; set; } = null!;
    [Inject] private IMediator Mediator { get; set; } = null!;

    // Fallback colors for "By Group" mode (keyed by CC code)
    private static readonly Dictionary<string, string> GroupFallbackColors = new()
    {
        ["AVAILABLE"]  = "#22c55e",
        ["ONPHONE"]    = "#3b82f6",
        ["BREAK"]      = "#f59e0b",
        ["PAPERWORK"]  = "#8b5cf6",
        ["TRAINING"]   = "#06b6d4",
        ["OTHER"]      = "#6b7280",
    };
    private static readonly Dictionary<string, string> DarkGroupFallbackColors = new()
    {
        ["AVAILABLE"]  = "#4ade80",
        ["ONPHONE"]    = "#60a5fa",
        ["BREAK"]      = "#fbbf24",
        ["PAPERWORK"]  = "#a78bfa",
        ["TRAINING"]   = "#22d3ee",
        ["OTHER"]      = "#9ca3af",
    };

    // Fallback colors for "By State" mode (keyed by AgentStateName display)
    private static readonly Dictionary<string, string> StateFallbackColors = new()
    {
        ["Available"]  = "#22c55e",
        ["On Phone"]   = "#3b82f6",
        ["Break"]      = "#f59e0b",
        ["Paperwork"]  = "#8b5cf6",
        ["Training"]   = "#06b6d4",
        ["Other"]      = "#6b7280",
    };
    private static readonly Dictionary<string, string> DarkStateFallbackColors = new()
    {
        ["Available"]  = "#4ade80",
        ["On Phone"]   = "#60a5fa",
        ["Break"]      = "#fbbf24",
        ["Paperwork"]  = "#a78bfa",
        ["Training"]   = "#22d3ee",
        ["Other"]      = "#9ca3af",
    };

    private Guid _tenantId;
    private Func<IReadOnlyList<GridCellUpdate>, Task>? _gridHandler;
    private ConnectionState _connectionState = ConnectionState.Connecting;
    private CancellationTokenSource _cts = new();

    private string _chartElementId = $"asd-chart-{Guid.NewGuid():N}";
    private Dictionary<string, string> _cellValues = new();
    private Dictionary<int, string> _cellIdToMetric = new();
    private int _totalAgents;

    // Agent state definitions loaded from DB
    private IReadOnlyList<AgentStateDefinitionDto> _definitions = Array.Empty<AgentStateDefinitionDto>();

    // Config values
    private int _businessUnitId;
    private string _chartType = "doughnut";
    private string _valueDisplay = "percentages";
    private bool _showLegend = true;
    private bool _showValueLabels = true;

    // Appearance
    private string? _backgroundColor;
    private string? _fontColor;
    private string _darkBackgroundColor = "#1e1e1e";
    private string _darkFontColor = "#f1f5f9";

    // CC-009: Distribution mode
    private string _distributionMode = "group"; // "group" | "state"

    // Segment colors: separate dictionaries for each mode
    private Dictionary<string, string> _groupSegmentColors = new();
    private Dictionary<string, string> _darkGroupSegmentColors = new();
    private Dictionary<string, string> _stateSegmentColors = new();
    private Dictionary<string, string> _darkStateSegmentColors = new();

    private enum ConnectionState { Connecting, Connected, Reconnecting, Failed }

    private string EffectiveBackgroundColor => DarkMode 
        ? (string.IsNullOrEmpty(_darkBackgroundColor) ? "#1e1e1e" : _darkBackgroundColor) 
        : (string.IsNullOrEmpty(_backgroundColor) ? "" : _backgroundColor);
    private string EffectiveFontColor => DarkMode 
        ? (string.IsNullOrEmpty(_darkFontColor) ? "#f1f5f9" : _darkFontColor) 
        : (string.IsNullOrEmpty(_fontColor) ? "#333333" : _fontColor);

    // CC-009: Dual-mode grid selection
    private int RtsGridId
    {
        get
        {
            if (_distributionMode == "state" && Config?.StateGridId > 0)
                return Config.StateGridId.Value;
            if (_distributionMode == "group" && Config?.GroupGridId > 0)
                return Config.GroupGridId.Value;
            // Legacy fallback
            return Config?.GridId ?? GridId;
        }
    }

    private string GetSegmentColor(string key)
    {
        // CC-009: Use correct color dictionary based on mode
        if (_distributionMode == "state")
        {
            var colors = DarkMode ? _darkStateSegmentColors : _stateSegmentColors;
            var fallback = DarkMode ? DarkStateFallbackColors : StateFallbackColors;
            return colors.GetValueOrDefault(key) ?? fallback.GetValueOrDefault(key, "#64748b");
        }
        else
        {
            var colors = DarkMode ? _darkGroupSegmentColors : _groupSegmentColors;
            var fallback = DarkMode ? DarkGroupFallbackColors : GroupFallbackColors;
            return colors.GetValueOrDefault(key) ?? fallback.GetValueOrDefault(key, "#64748b");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDefinitionsAsync();
        ApplyConfig();
        // ConnectAsync moved to OnAfterRenderAsync — does not run during SSR pre-render
    }

    private async Task LoadDefinitionsAsync()
    {
        try
        {
            _definitions = await Mediator.Send(new GetAgentStateDefinitionsQuery(), _cts.Token);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load agent state definitions");
            _definitions = Array.Empty<AgentStateDefinitionDto>();
        }
    }

    private int _previousGridId;
    private bool _chartRendered;

    protected override async Task OnParametersSetAsync()
    {
        ApplyConfig();
        var currentGridId = RtsGridId;

        // Initial connect is handled in OnAfterRenderAsync(firstRender) to avoid SSR pre-render cycling.
        // Track GridId for reconnect detection.
        if (currentGridId != 0 && _previousGridId == 0)
        {
            _previousGridId = currentGridId;
        }
        // Grid changed (mode switch) — reconnect only if already connected
        else if (_gridHandler is not null && currentGridId != 0 && currentGridId != _previousGridId && _businessUnitId > 0)
        {
            _previousGridId = currentGridId;
            _chartRendered = false;
            await ReconnectAsync();
        }

        _previousGridId = currentGridId;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ConnectAsync();

        if (_connectionState == ConnectionState.Connected && _cellValues.Count > 0 && !_chartRendered)
        {
            _chartRendered = true;
            await RenderChartAsync();
        }
    }

    private void ApplyConfig()
    {
        if (Config is null) return;

        _businessUnitId = Config.BusinessUnitId ?? 0;
        _chartType = Config.ChartType ?? "doughnut";
        _valueDisplay = Config.ValueDisplay ?? "percentages";
        _showLegend = Config.ShowLegend;
        _showValueLabels = Config.ShowValueLabels;

        _backgroundColor = Config.BackgroundColor;
        _fontColor = Config.FontColor;
        _darkBackgroundColor = Config.DarkBackgroundColor ?? "#1e1e1e";
        _darkFontColor = Config.DarkFontColor ?? "#f1f5f9";

        // CC-009: Distribution mode
        _distributionMode = Config.DistributionMode ?? "group";

        // CC-009: Dual-mode segment colors
        // Group colors use legacy SegmentColors property (keyed by CC code)
        _groupSegmentColors = Config.SegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
        _darkGroupSegmentColors = Config.DarkSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
        _stateSegmentColors = Config.StateSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
        _darkStateSegmentColors = Config.DarkStateSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();

        // Backward compat: legacy SegmentColors (keyed by display name) -> State mode
        var legacyColors = Config.SegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
        var legacyDarkColors = Config.DarkSegmentColors?.ToDictionary(kv => kv.Key, kv => kv.Value) ?? new();
        foreach (var kv in legacyColors)
            if (!_stateSegmentColors.ContainsKey(kv.Key)) _stateSegmentColors[kv.Key] = kv.Value;
        foreach (var kv in legacyDarkColors)
            if (!_darkStateSegmentColors.ContainsKey(kv.Key)) _darkStateSegmentColors[kv.Key] = kv.Value;

        // Backward compat: legacy individual color fields -> State mode
        if (!string.IsNullOrEmpty(Config.ColorAvailable) && !_stateSegmentColors.ContainsKey("Available"))
            _stateSegmentColors["Available"] = Config.ColorAvailable;
        if (!string.IsNullOrEmpty(Config.ColorOnPhone) && !_stateSegmentColors.ContainsKey("On Phone"))
            _stateSegmentColors["On Phone"] = Config.ColorOnPhone;
        if (!string.IsNullOrEmpty(Config.ColorBreak) && !_stateSegmentColors.ContainsKey("Break"))
            _stateSegmentColors["Break"] = Config.ColorBreak;
        if (!string.IsNullOrEmpty(Config.ColorPaperwork) && !_stateSegmentColors.ContainsKey("Paperwork"))
            _stateSegmentColors["Paperwork"] = Config.ColorPaperwork;
        if (!string.IsNullOrEmpty(Config.ColorTraining) && !_stateSegmentColors.ContainsKey("Training"))
            _stateSegmentColors["Training"] = Config.ColorTraining;
        if (!string.IsNullOrEmpty(Config.ColorOther) && !_stateSegmentColors.ContainsKey("Other"))
            _stateSegmentColors["Other"] = Config.ColorOther;

        if (!string.IsNullOrEmpty(Config.DarkColorAvailable) && !_darkStateSegmentColors.ContainsKey("Available"))
            _darkStateSegmentColors["Available"] = Config.DarkColorAvailable;
        if (!string.IsNullOrEmpty(Config.DarkColorOnPhone) && !_darkStateSegmentColors.ContainsKey("On Phone"))
            _darkStateSegmentColors["On Phone"] = Config.DarkColorOnPhone;
        if (!string.IsNullOrEmpty(Config.DarkColorBreak) && !_darkStateSegmentColors.ContainsKey("Break"))
            _darkStateSegmentColors["Break"] = Config.DarkColorBreak;
        if (!string.IsNullOrEmpty(Config.DarkColorPaperwork) && !_darkStateSegmentColors.ContainsKey("Paperwork"))
            _darkStateSegmentColors["Paperwork"] = Config.DarkColorPaperwork;
        if (!string.IsNullOrEmpty(Config.DarkColorTraining) && !_darkStateSegmentColors.ContainsKey("Training"))
            _darkStateSegmentColors["Training"] = Config.DarkColorTraining;
        if (!string.IsNullOrEmpty(Config.DarkColorOther) && !_darkStateSegmentColors.ContainsKey("Other"))
            _darkStateSegmentColors["Other"] = Config.DarkColorOther;
    }

    private async Task ConnectAsync()
    {
        if (RtsGridId == 0 || _businessUnitId == 0)
        {
            Logger.LogWarning("AgentStateDistributionWidget: RtsGridId or BusinessUnitId is 0, skipping connection");
            return;
        }
        if (_gridHandler is not null)
        {
            Logger.LogDebug("AgentStateDistributionWidget: already subscribed to grid {GridId}, skipping duplicate ConnectAsync", RtsGridId);
            return;
        }

        _connectionState = ConnectionState.Connecting;
        Logger.LogInformation("AgentStateDistributionWidget: Subscribing to GridId {GridId}", RtsGridId);

        try
        {
            // Load CellId → MetricId map so GridCellUpdate items can be decoded
            _cellIdToMetric = await Mediator.Send(new GetRtsGridCellMapQuery(RtsGridId), _cts.Token);
            Logger.LogInformation("AgentStateDistributionWidget: loaded {Count} cells for grid {GridId}",
                _cellIdToMetric.Count, RtsGridId);

            if (_tenantId == Guid.Empty)
            {
                var settings = await Mediator.Send(new GetTenantSettingsQuery(), _cts.Token);
                _tenantId = settings!.TenantId;
            }

            _gridHandler = async updates =>
            {
                var updated = false;
                foreach (var cell in updates)
                {
                    if (_cellIdToMetric.TryGetValue(cell.CellId, out var metricId))
                    {
                        _cellValues[metricId] = cell.Value ?? string.Empty;
                        updated = true;
                    }
                }
                if (updated)
                    await InvokeAsync(async () =>
                    {
                        StateHasChanged();
                        await RenderChartAsync();
                    });
            };

            await RtmRelay.SubscribeGridAsync(_tenantId, RtsGridId, _gridHandler, _cts.Token);
            _connectionState = ConnectionState.Connected;
            Logger.LogInformation("AgentStateDistributionWidget: subscribed to GridId {GridId}", RtsGridId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AgentStateDistributionWidget: Failed to subscribe. Error: {Message}", ex.Message);
            _connectionState = ConnectionState.Failed;
        }
    }

    private async Task ReconnectAsync()
    {
        if (_gridHandler != null && RtsGridId > 0 && _tenantId != Guid.Empty)
        {
            await RtmRelay.UnsubscribeGridAsync(_tenantId, RtsGridId, _gridHandler);
            _gridHandler = null;
        }
        _cellValues.Clear();
        _chartRendered = false;
        await ConnectAsync();
    }

    private async Task RenderChartAsync()
    {
        var segments = BuildSegments();
        if (segments.Count == 0) return;

        var options = new
        {
            chartType = _chartType,
            valueDisplay = _valueDisplay,
            showLegend = _showLegend,
            showValueLabels = _showValueLabels,
            fontColor = EffectiveFontColor
        };

        try
        {
            await JS.InvokeVoidAsync("agentStateDistributionChart.render", _chartElementId, segments, options);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to render chart");
        }
    }

    private List<object> BuildSegments()
    {
        var segments = new List<object>();
        var total = ParseInt(_cellValues.GetValueOrDefault("QueueLoginDataNumLoggedUsers"));
        _totalAgents = total;

        // CC-009: Build segments based on distribution mode
        if (_distributionMode == "state")
        {
            return BuildStateSegments(total);
        }
        else
        {
            return BuildGroupSegments(total);
        }
    }

    private List<object> BuildGroupSegments(int total)
    {
        var segments = new List<object>();

        // Use GroupColumnMetricIds from config (resolved at save time)
        var metricIds = Config?.GroupColumnMetricIds ?? new();
        if (metricIds.Count == 0)
        {
            // Legacy fallback: hardcoded group metrics
            var available = ParseInt(_cellValues.GetValueOrDefault("QueueLoginDataNumAvailableUsers"));
            var onPhone = ParseInt(_cellValues.GetValueOrDefault("QueueNumOnCallAgents"));
            var breakCount = ParseInt(_cellValues.GetValueOrDefault("QueueLoginDataNumBreakUsers"));
            var paperwork = ParseInt(_cellValues.GetValueOrDefault("QueueLoginDataNumPaperworkUsers"));
            var training = ParseInt(_cellValues.GetValueOrDefault("QueueLoginDataNumTrainingUsers"));

            segments.Add(new { label = "Available", value = available, color = GetSegmentColor("AVAILABLE") });
            segments.Add(new { label = "On Phone", value = onPhone, color = GetSegmentColor("ONPHONE") });
            segments.Add(new { label = "Break", value = breakCount, color = GetSegmentColor("BREAK") });
            segments.Add(new { label = "Paperwork", value = paperwork, color = GetSegmentColor("PAPERWORK") });
            segments.Add(new { label = "Training", value = training, color = GetSegmentColor("TRAINING") });

            var sumFive = available + onPhone + breakCount + paperwork + training;
            var other = Math.Max(0, total - sumFive);
            if (other > 0)
                segments.Add(new { label = "Other", value = other, color = GetSegmentColor("OTHER") });

            return segments;
        }

        // Use saved MetricIds: key = CC code (AVAILABLE), value = MetricId
        var sumFromMetrics = 0;
        foreach (var kv in metricIds.OrderBy(x => x.Key))
        {
            var ccCode = kv.Key;        // e.g., "AVAILABLE"
            var metricId = kv.Value;    // e.g., "UsersInStatusGroupCount_Available"
            var value = ParseInt(_cellValues.GetValueOrDefault(metricId));
            var color = GetSegmentColor(ccCode);

            // Get display name from definitions or use CC code
            var displayName = _definitions.FirstOrDefault(d => d.GroupName == ccCode)?.GroupName ?? ccCode;
            sumFromMetrics += value;
            segments.Add(new { label = displayName, value, color });
        }

        // "Other" = total - sum
        var otherCount = Math.Max(0, total - sumFromMetrics);
        if (otherCount > 0)
        {
            segments.Add(new { label = "Other", value = otherCount, color = GetSegmentColor("OTHER") });
        }

        return segments;
    }

    private List<object> BuildStateSegments(int total)
    {
        var segments = new List<object>();

        // Use StateColumnMetricIds from config (resolved at save time)
        var metricIds = Config?.StateColumnMetricIds ?? new();
        if (metricIds.Count == 0)
        {
            // Fallback: use definitions with dynamic metrics
            if (_definitions.Count == 0)
            {
                // No definitions, no metrics = empty chart
                return segments;
            }

            var sumFromDefs = 0;
            foreach (var def in _definitions.OrderBy(d => d.AgentState))
            {
                var metricId = def.MetricId;
                var value = metricId != null ? ParseInt(_cellValues.GetValueOrDefault(metricId)) : 0;
                var displayName = def.AgentState; // AgentStateName = display name
                var color = GetSegmentColor(displayName);

                sumFromDefs += value;
                segments.Add(new { label = displayName, value, color });
            }

            var otherVal = Math.Max(0, total - sumFromDefs);
            if (otherVal > 0)
            {
                segments.Add(new { label = "Other", value = otherVal, color = GetSegmentColor("Other") });
            }

            return segments;
        }

        // Use saved MetricIds: key = AgentStateName, value = MetricId
        var sumFromMetrics = 0;
        foreach (var kv in metricIds.OrderBy(x => x.Key))
        {
            var stateName = kv.Key;     // e.g., "Available"
            var metricId = kv.Value;    // e.g., "UsersInStatusCount_Available"
            var value = ParseInt(_cellValues.GetValueOrDefault(metricId));
            var color = GetSegmentColor(stateName);

            sumFromMetrics += value;
            segments.Add(new { label = stateName, value, color });
        }

        // "Other" = total - sum
        var otherCount = Math.Max(0, total - sumFromMetrics);
        if (otherCount > 0)
        {
            segments.Add(new { label = "Other", value = otherCount, color = GetSegmentColor("Other") });
        }

        return segments;
    }

    private static int ParseInt(string? value) =>
        int.TryParse(value, out var n) ? n : 0;

    private string GetWidgetStyle()
    {
        var styles = new List<string>();
        var bg = EffectiveBackgroundColor;
        var fg = EffectiveFontColor;
        if (!string.IsNullOrEmpty(bg))
            styles.Add($"background-color: {bg}");
        if (!string.IsNullOrEmpty(fg))
            styles.Add($"color: {fg}");
        return string.Join("; ", styles);
    }

    private string GetFontColorStyle()
    {
        var fg = EffectiveFontColor;
        return !string.IsNullOrEmpty(fg) ? $"color: {fg};" : "";
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();

        try
        {
            await JS.InvokeVoidAsync("agentStateDistributionChart.destroy", _chartElementId);
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Error destroying chart");
        }

        if (_gridHandler != null && RtsGridId > 0 && _tenantId != Guid.Empty)
        {
            try { await RtmRelay.UnsubscribeGridAsync(_tenantId, RtsGridId, _gridHandler); } catch { }
            _gridHandler = null;
        }

        _cts.Dispose();
    }

}

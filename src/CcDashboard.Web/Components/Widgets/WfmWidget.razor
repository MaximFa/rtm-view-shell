@using CcDashboard.Application.Interfaces
@using CcDashboard.Application.Wfm
@using CcDashboard.Domain.Interfaces
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable

@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L
@inject IWfmSnapshotStore WfmStore
@inject ICurrentUserAccessor CurrentUser
@inject ILogger<WfmWidget> Logger

<div class="wfm" style="@GetWidgetStyle()">
    @if (_queueId is null)
    {
        <div class="wfm-empty">
            <i class="bi bi-gear fs-3 mb-2 opacity-50" aria-hidden="true"></i>
            <span class="small">@L["Widget_SaveConfigFirst"]</span>
        </div>
    }
    else if (_snapshot is null)
    {
        <div class="wfm-loading">
            <div class="spinner-border spinner-border-sm mb-2" aria-hidden="true"></div>
            <span class="small">@L["Wfm_WaitingForData"]</span>
        </div>
    }
    else
    {
        <!-- Tiles: 2x2 grid of primary metrics -->
        <div class="wfmgrid">
            @foreach (var tileMetric in _tileMetrics)
            {
                var (value, unit) = GetMetricValue(tileMetric);
                <div class="wfmcell" style="@GetTileBackgroundStyle(tileMetric)">
                    <div class="k" style="@GetCaptionStyle()">@GetMetricLabel(tileMetric)</div>
                    <div class="v" style="@GetTileValueStyle(tileMetric)">@value@(!string.IsNullOrEmpty(unit) ? $" {unit}" : "")</div>
                </div>
            }
        </div>

        <!-- List: remaining metrics (legend style) -->
        @if (GetVisibleListMetrics().Any())
        {
            <div class="wfmlist">
                @foreach (var metric in GetVisibleListMetrics())
                {
                    var (value, unit) = GetMetricValue(metric);
                    var (pillBg, pillFg) = GetListPillColors(metric);
                    <div class="wfmlg">
                        <span class="lbl" style="@GetCaptionStyle()">@GetMetricLabel(metric)</span>
                        @if (!string.IsNullOrEmpty(pillBg))
                        {
                            <span class="n pill" style="background: @pillBg; color: @pillFg;">@value</span>
                        }
                        else
                        {
                            <span class="n" style="@GetValueStyle()">@value</span>
                        }
                        @if (!string.IsNullOrEmpty(unit))
                        {
                            <span class="p">@unit</span>
                        }
                    </div>
                }
            </div>
        }

        <!-- Note: time + window only -->
        <div class="wfmnote" style="@GetCaptionStyle()">
            @FormatTime(_snapshot.AsOfUtc) · @_snapshot.WindowMin @L["Wfm_MinWindow"]
        </div>
    }
</div>

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public int GridId { get; set; }
    [Parameter] public EventCallback<string?> BadgeStateChanged { get; set; }

    private Guid _tenantId;
    private string? _queueId;
    private WfmSnapshot? _snapshot;
    private DateTime _lastAsOfUtc;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    // Layout: which metrics go in tiles vs list
    private List<string> _tileMetrics = new() { "predictedSl", "occupancy", "nActual", "staffVariance" };
    private List<string> _listMetrics = new() { "lambdaPerHour", "aht", "wrapIncluded", "trafficA", "pWait", "predictedAsa", "requiredAgents", "erlangB", "understaff" };

    // All 13 metrics (for config modal reference)
    private static readonly string[] AllMetrics = {
        "lambdaPerHour", "aht", "nActual", "wrapIncluded",
        "trafficA", "pWait", "predictedSl", "predictedAsa", "requiredAgents", "erlangB", "occupancy",
        "understaff", "staffVariance"
    };

    // Input metrics: always visible (raw inputs, no Erlang required)
    private static readonly HashSet<string> InputMetrics = new(StringComparer.Ordinal)
    {
        "lambdaPerHour", "aht", "nActual", "wrapIncluded"
    };

    // Erlang metrics: visible only when _snapshot.State == WfmSnapshot.StateOk
    private static readonly HashSet<string> ErlangMetrics = new(StringComparer.Ordinal)
    {
        "trafficA", "pWait", "predictedSl", "predictedAsa", "requiredAgents",
        "erlangB", "occupancy", "understaff", "staffVariance"
    };

    // Appearance - dark mode defaults from DataSlotWidget
    private string _backgroundColor = "";
    private string _fontColor = "";
    private const string DarkBgDefault = "#1e3a5f";
    private const string DarkFontDefault = "#ffffff";

    // Thresholds (loaded from config or defaults)
    private Dictionary<string, List<ThresholdRule>> _tileThresholds = new();
    private Dictionary<string, List<ColumnThreshold>> _listThresholds = new();


    // Cached badge state for callback
    private string? _lastBadgeState;

    // Threshold rule class (matches ScreenEditorPage definition)
    private class ThresholdRule
    {
        public string? From { get; set; }
        public string? To { get; set; }
        public string? BackgroundColor { get; set; }
        public string? FontColor { get; set; }
    }

    // Column threshold class (matches ScreenEditorPage definition)
    private class ColumnThreshold
    {
        public string MatchType { get; set; } = "numeric";
        public string? From { get; set; }
        public string? To { get; set; }
        public string? TextMatch { get; set; }
        public string? TextTo { get; set; }
        public string TextMatchType { get; set; } = "equal";
        public string? BackgroundColor { get; set; }
        public string? FontColor { get; set; }
    }

    protected override Task OnInitializedAsync()
    {
        _tenantId = CurrentUser.TenantId ?? Guid.Empty;
        ApplyConfig();
        if (_tenantId != Guid.Empty && _queueId is not null)
        {
            _ = PollLoopAsync();
        }
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        ApplyConfig();
    }

    private void ApplyConfig()
    {
        if (Config is null) return;

        // Queue scope
        _queueId = Config.WfmQueueId;
        if (string.IsNullOrEmpty(_queueId) && Config.BusinessUnit is not null)
        {
            _queueId = Config.BusinessUnit;
        }

        // Appearance with dark mode defaults
        if (DarkMode)
        {
            _backgroundColor = Config.DarkBackgroundColor ?? DarkBgDefault;
            _fontColor = Config.DarkFontColor ?? DarkFontDefault;
        }
        else
        {
            _backgroundColor = Config.BackgroundColor ?? "";
            _fontColor = Config.FontColor ?? "";
        }

        // Tile and list configuration (use config if present, else defaults)
        if (Config.WfmTileMetrics?.Count == 4)
        {
            _tileMetrics = Config.WfmTileMetrics;
        }
        if (Config.WfmListMetrics?.Count > 0)
        {
            _listMetrics = Config.WfmListMetrics;
        }

        // Load tile thresholds from config, or use defaults
        _tileThresholds = Config.WfmTileThresholds?.ToDictionary(
            kvp => kvp.Key,
            kvp => kvp.Value.Select(t => new ThresholdRule
            {
                From = t.From,
                To = t.To,
                BackgroundColor = t.BackgroundColor,
                FontColor = t.FontColor
            }).ToList()) ?? new Dictionary<string, List<ThresholdRule>>();

        // Load list thresholds from config
        _listThresholds = Config.WfmListThresholds?.ToDictionary(
            kvp => kvp.Key,
            kvp => kvp.Value.Select(t => new ColumnThreshold
            {
                MatchType = t.MatchType,
                From = t.From,
                To = t.To,
                TextMatch = t.TextMatch,
                TextTo = t.TextTo,
                TextMatchType = t.TextMatchType,
                BackgroundColor = t.BackgroundColor,
                FontColor = t.FontColor
            }).ToList()) ?? new Dictionary<string, List<ColumnThreshold>>();
    }

    private async Task PollLoopAsync()
    {
        // Initial fetch
        var snapshot = WfmStore.Get(_tenantId, _queueId!);
        if (snapshot is not null)
        {
            _snapshot = snapshot;
            _lastAsOfUtc = snapshot.AsOfUtc;
            await NotifyBadgeState();
            await InvokeAsync(StateHasChanged);
        }

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                snapshot = WfmStore.Get(_tenantId, _queueId!);
                if (snapshot is not null && snapshot.AsOfUtc != _lastAsOfUtc)
                {
                    _snapshot = snapshot;
                    _lastAsOfUtc = snapshot.AsOfUtc;
                    await NotifyBadgeState();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { /* expected on dispose */ }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "WfmWidget poll loop error");
        }
    }

    private async Task NotifyBadgeState()
    {
        var state = _snapshot?.State;
        if (state != _lastBadgeState)
        {
            _lastBadgeState = state;
            if (BadgeStateChanged.HasDelegate)
            {
                await BadgeStateChanged.InvokeAsync(state);
            }
        }
    }

    // Get visible list metrics based on snapshot state
    private IEnumerable<string> GetVisibleListMetrics()
    {
        return _listMetrics.Where(m =>
            InputMetrics.Contains(m) || _snapshot?.State == WfmSnapshot.StateOk);
    }

    // Get metric value and unit
    private (string value, string unit) GetMetricValue(string metricKey)
    {
        if (_snapshot is null) return ("—", "");

        return metricKey switch
        {
            "lambdaPerHour" => (FormatDouble(_snapshot.Inputs.LambdaPerHour, 1), "/hr"),
            "aht" => (FormatDuration(_snapshot.Inputs.AhtSec), ""),
            "nActual" => (_snapshot.Inputs.NActual.ToString(), ""),
            "wrapIncluded" => (_snapshot.Inputs.WrapIncluded ? L["Common_Yes"] : L["Common_No"], ""),
            "trafficA" => (FormatDouble(_snapshot.Erlang.TrafficA, 2), "Erl"),
            "pWait" => (FormatPWait(_snapshot.Erlang.PWaitC), ""),
            "predictedSl" => (FormatPct(_snapshot.Erlang.PredictedSlPct), ""),
            "predictedAsa" => (FormatNullableDouble(_snapshot.Erlang.PredictedAsaSec, 1), "s"),
            "requiredAgents" => GetRequiredAgentsValue(),
            "erlangB" => (FormatPct(_snapshot.Erlang.ErlangBPct), ""),
            "occupancy" => (FormatPct(_snapshot.Erlang.OccupancyPct), ""),
            "understaff" => (FormatPct(_snapshot.Erlang.UnderstaffPct), ""),
            "staffVariance" => (FormatVariance(_snapshot.Erlang.StaffVariance), ""),
            _ => ("—", "")
        };
    }

    private (string value, string unit) GetRequiredAgentsValue()
    {
        if (_snapshot is null) return ("—", "");
        var capped = _snapshot.Erlang.RequiredCapped ? " ⚠" : "";
        return (_snapshot.Erlang.RequiredAgents.ToString() + capped, "");
    }

    private string GetMetricLabel(string metricKey)
    {
        return metricKey switch
        {
            "lambdaPerHour" => L["Wfm_Lambda"],
            "aht" => L["Wfm_AHT"],
            "nActual" => L["Wfm_NActual"],
            "wrapIncluded" => L["Wfm_WrapIncluded"],
            "trafficA" => L["Wfm_TrafficA"],
            "pWait" => L["Wfm_PWait"],
            "predictedSl" => L["Wfm_PredictedSL"],
            "predictedAsa" => L["Wfm_PredictedASA"],
            "requiredAgents" => L["Wfm_RequiredAgents"],
            "erlangB" => L["Wfm_ErlangB"],
            "occupancy" => L["Wfm_Occupancy"],
            "understaff" => L["Wfm_Understaff"],
            "staffVariance" => L["Wfm_StaffVariance"],
            _ => metricKey
        };
    }

    // Get raw numeric value for a metric (for threshold matching)
    private double? GetMetricNumericValue(string metricKey)
    {
        if (_snapshot is null) return null;

        return metricKey switch
        {
            "lambdaPerHour" => _snapshot.Inputs.LambdaPerHour,
            "aht" => _snapshot.Inputs.AhtSec,
            "nActual" => _snapshot.Inputs.NActual,
            "wrapIncluded" => _snapshot.Inputs.WrapIncluded ? 1 : 0,
            "trafficA" => _snapshot.Erlang.TrafficA,
            "pWait" => _snapshot.Erlang.PWaitC * 100,  // Convert to percentage
            "predictedSl" => _snapshot.Erlang.PredictedSlPct,
            "predictedAsa" => _snapshot.Erlang.PredictedAsaSec,
            "requiredAgents" => _snapshot.Erlang.RequiredAgents,
            "erlangB" => _snapshot.Erlang.ErlangBPct,
            "occupancy" => _snapshot.Erlang.OccupancyPct,
            "understaff" => _snapshot.Erlang.UnderstaffPct,
            "staffVariance" => _snapshot.Erlang.StaffVariance,
            _ => null
        };
    }

    // Apply tile threshold rules and get matching rule
    // Order: configured rules -> server band -> nothing
    // Seeded defaults stay in modal only (starting content), not in render path
    private ThresholdRule? GetMatchingTileThreshold(string metricKey)
    {
        var value = GetMetricNumericValue(metricKey);
        if (value is null) return null;

        // First check configured thresholds
        if (_tileThresholds.TryGetValue(metricKey, out var rules) && rules.Count > 0)
        {
            foreach (var rule in rules)
            {
                var from = ParseThresholdValue(rule.From, double.MinValue);
                var to = ParseThresholdValue(rule.To, double.MaxValue);
                if (value >= from && value <= to)
                    return rule;
            }
        }

        // Fall back to server RAG band (authoritative, respects TenantSettings.WfmSlTargetPct)
        if (_snapshot?.Rag.TryGetValue(metricKey, out var band) == true)
        {
            return band switch
            {
                "green" => new ThresholdRule { BackgroundColor = "#dcfce7", FontColor = "#22c55e" },
                "amber" => new ThresholdRule { BackgroundColor = "#fef3c7", FontColor = "#f59e0b" },
                "red"   => new ThresholdRule { BackgroundColor = "#fee2e2", FontColor = "#ef4444" },
                _ => null
            };
        }

        return null;
    }

    private static double ParseThresholdValue(string? text, double defaultValue)
    {
        if (string.IsNullOrEmpty(text)) return defaultValue;
        if (double.TryParse(text.Replace(",", "."), System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var value))
            return value;
        return defaultValue;
    }

    // Get inline background style for tile (applies rule.BackgroundColor verbatim)
    // Handles uppercase hex from palette, transparent, and any valid CSS colour
    private string GetTileBackgroundStyle(string metricKey)
    {
        var rule = GetMatchingTileThreshold(metricKey);
        if (rule is null || string.IsNullOrEmpty(rule.BackgroundColor))
            return "";

        // "transparent" is a valid choice, not empty
        return $"background-color: {rule.BackgroundColor};";
    }

    // Apply list threshold rules and get matching rule
    private ColumnThreshold? GetMatchingListThreshold(string metricKey)
    {
        var value = GetMetricNumericValue(metricKey);
        if (value is null) return null;

        // Check configured thresholds
        if (_listThresholds.TryGetValue(metricKey, out var rules) && rules.Count > 0)
        {
            foreach (var rule in rules)
            {
                if (rule.MatchType == "numeric")
                {
                    var from = ParseThresholdValue(rule.From, double.MinValue);
                    var to = ParseThresholdValue(rule.To, double.MaxValue);
                    if (value >= from && value <= to)
                        return rule;
                }
            }
        }

        return null;
    }

    // Get pill colors for list items based on threshold match or RAG band
    private (string? bg, string? fg) GetListPillColors(string metricKey)
    {
        // First check configured thresholds
        var rule = GetMatchingListThreshold(metricKey);
        if (rule is not null && !string.IsNullOrEmpty(rule.BackgroundColor))
        {
            return (rule.BackgroundColor, rule.FontColor ?? "#000000");
        }

        // Fall back to RAG band from snapshot
        if (_snapshot is null) return (null, null);
        if (!_snapshot.Rag.TryGetValue(metricKey, out var band)) return (null, null);

        return band switch
        {
            "green" => ("#dcfce7", "#166534"),  // green pill
            "amber" => ("#fef3c7", "#92400e"),  // amber pill
            "red" => ("#fee2e2", "#991b1b"),    // red pill
            _ => (null, null)
        };
    }

    // Formatting helpers
    private static string FormatDouble(double v, int decimals) => v.ToString($"F{decimals}");

    private static string FormatNullableDouble(double? v, int decimals, string suffix = "")
    {
        if (v is null) return "—";
        return v.Value.ToString($"F{decimals}");
    }

    private static string FormatPct(double? v)
    {
        if (v is null) return "—";
        return $"{v.Value:F1}%";
    }

    private static string FormatPWait(double? v)
    {
        if (v is null) return "—";
        return $"{(v.Value * 100):F1}%";
    }

    private static string FormatDuration(double seconds)
    {
        if (seconds < 60) return $"{seconds:F0}s";
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    private static string FormatVariance(int v)
    {
        if (v == 0) return "0";
        return v > 0 ? $"+{v}" : v.ToString();
    }

    private string FormatTime(DateTime utc)
    {
        var local = utc.ToLocalTime();
        return local.ToString("HH:mm:ss");
    }

    // Style helpers
    private string GetWidgetStyle()
    {
        var styles = new List<string>();
        if (!string.IsNullOrEmpty(_backgroundColor))
            styles.Add($"background-color: {_backgroundColor}");
        if (!string.IsNullOrEmpty(_fontColor))
            styles.Add($"color: {_fontColor}");
        return string.Join("; ", styles);
    }

    private string GetCaptionStyle()
    {
        // Captions use config color (not affected by thresholds)
        return !string.IsNullOrEmpty(_fontColor) ? $"color: {_fontColor};" : "";
    }

    private string GetValueStyle()
    {
        // Value style for items without threshold match
        return !string.IsNullOrEmpty(_fontColor) ? $"color: {_fontColor};" : "";
    }

    private string GetTileValueStyle(string metricKey)
    {
        // Tile value uses threshold font color when matched, otherwise config color
        var rule = GetMatchingTileThreshold(metricKey);
        if (rule is not null && !string.IsNullOrEmpty(rule.FontColor))
        {
            return $"color: {rule.FontColor};";
        }
        return !string.IsNullOrEmpty(_fontColor) ? $"color: {_fontColor};" : "";
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }
}

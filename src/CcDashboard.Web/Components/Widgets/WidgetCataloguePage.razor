@page "/widget-catalogue"
@layout MainLayout
@attribute [Authorize(Roles = "Superadmin,Administrator,Editor")]
@inject IMediator Mediator
@using MediatR
@using CcDashboard.Application.Queries.Widgets
@using Microsoft.AspNetCore.Authorization
@implements IDisposable

<PageTitle>@L["WidgetCatalogue_Title"] — RTM View Shell</PageTitle>

<h1 class="h4 mb-3">@L["WidgetCatalogue_Title"]</h1>

@if (Categories is null)
{
    <div class="text-center py-4"><span class="spinner-border spinner-border-sm"></span></div>
}
else
{
    @foreach (var cat in Categories)
    {
        <div class="card mb-3" @key="cat.Category">
            <div class="card-header">
                <strong>@cat.Category</strong>
                <span class="badge bg-secondary ms-2">@cat.Items.Count</span>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var item in cat.Items)
                {
                    <li @key="item.Id" class="list-group-item d-flex justify-content-between">
                        <div>
                            <strong>@item.Name</strong>
                            @if (item.Description is not null)
                            {
                                <span class="text-muted ms-2 small">@item.Description</span>
                            }
                        </div>
                        @if (!item.IsActive)
                        {
                            <span class="badge bg-secondary">@L["WidgetCatalogue_Inactive"]</span>
                        }
                    </li>
                }
            </ul>
        </div>
    }
}

@code {
    private IReadOnlyList<CcDashboard.Contracts.DTOs.Widgets.WidgetCatalogCategoryDto>? Categories;

    protected override async Task OnInitializedAsync()
        => Categories = await Mediator.Send(new GetWidgetCatalogQuery(), _cts.Token);

    private readonly CancellationTokenSource _cts = new();
    public void Dispose() => _cts.Cancel();
}

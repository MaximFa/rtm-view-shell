@using CcDashboard.Application.Queries.Widgets
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Contracts.DTOs.Configuration
@using CcDashboard.Infrastructure.Persistence
@using MediatR
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@using System.Text.Json
@implements IAsyncDisposable

@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L
@inject IMediator Mediator
@inject IJSRuntime JS
@inject ILogger<DayTrendWidget> Logger
@inject IDbContextFactory<AppDbContext> AppDbFactory
@inject CcDashboard.Domain.Interfaces.ICurrentUserAccessor CurrentUser

<div class="daytrend-widget h-100" style="@GetWidgetStyle()">
    @if (_loading)
    {
        <div class="d-flex align-items-center justify-content-center h-100" aria-busy="true">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <span style="@GetFontStyle()">@L["Loading"]</span>
        </div>
    }
    else if (_isNoQueues)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100">
            <i class="bi bi-exclamation-triangle fs-3 mb-2 text-warning" aria-hidden="true"></i>
            <span class="small" style="@GetFontStyle()">@L["Widget_NoQueuesForBU"]</span>
        </div>
    }
    else if (_error is not null)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100">
            <i class="bi bi-exclamation-circle fs-3 mb-2 text-danger" aria-hidden="true"></i>
            <span class="small mb-2" style="@GetFontStyle()">@_error</span>
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadDataAsync">
                @L["Widget_Retry"]
            </button>
        </div>
    }
    else if (_intervals.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100">
            <i class="bi bi-bar-chart fs-3 mb-2 opacity-50" aria-hidden="true"></i>
            <span class="small" style="@GetFontStyle()">@L["Widget_NoDataToday"]</span>
        </div>
    }
    else
    {
        <div class="chart-container" style="height: calc(100% - 24px);">
            <canvas id="@_chartId"></canvas>
        </div>
        <div class="text-end small pe-2 opacity-75" style="@GetFontStyle()">
            @L["Widget_LastUpdated"]: @_lastUpdate.ToString("HH:mm:ss")
        </div>
    }
</div>

    @if (IsViewMode && _showViewConfig)
    {
        <div class="daytrendview-modal-overlay" @onclick="() => _showViewConfig = false" @onclick:stopPropagation="true">
            <div class="modal-dialog modal-lg" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title mb-0">@L["Widget_LocalViewSettings"]</h6>
                        <button type="button" class="btn-close" @onclick="() => _showViewConfig = false"></button>
                    </div>
                    <div class="modal-body p-0">
                        <!-- Tab nav -->
                        <ul class="nav nav-tabs px-3 pt-2">
                            <li class="nav-item">
                                <button class="nav-link @(_viewTab == "general" ? "active" : "")"
                                        @onclick='() => _viewTab = "general"'>
                                    @L["DayTrend_TabGeneral"]
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(_viewTab == "queue" ? "active" : "")"
                                        @onclick='() => _viewTab = "queue"'>
                                    @L["DayTrend_TabQueueMetrics"]
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link @(_viewTab == "agent" ? "active" : "")"
                                        @onclick='() => _viewTab = "agent"'>
                                    @L["DayTrend_TabAgentMetrics"]
                                </button>
                            </li>
                        </ul>

                        <div class="tab-content p-3" style="max-height: 420px; overflow-y: auto;">

                            @* Tab: General *@
                            @if (_viewTab == "general")
                            {
                                <!-- BU selector -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@L["Widgets_BusinessUnit"]</label>
                                    <select class="form-select form-select-sm" @bind="_localBuId">
                                        <option value="0">— @L["Widget_UseDefault"] —</option>
                                        @foreach (var bu in _viewBuList)
                                        {
                                            <option value="@bu.BusinessUnitId">@bu.BusinessUnitName</option>
                                        }
                                    </select>
                                </div>
                                <!-- Chart type -->
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">@L["DayTrend_ChartType"]</label>
                                    <select class="form-select form-select-sm" @bind="_viewChartType">
                                        <option value="line">@L["DayTrend_ChartLine"]</option>
                                        <option value="bar">@L["DayTrend_ChartBar"]</option>
                                        <option value="area">@L["DayTrend_ChartArea"]</option>
                                        <option value="step">@L["DayTrend_ChartStep"]</option>
                                    </select>
                                </div>
                            }

                            @* Tab: Queue Metrics *@
                            @if (_viewTab == "queue")
                            {
                                @foreach (var m in _metrics)
                                {
                                    var metric = m;
                                    <div class="form-check form-check-sm mb-2">
                                        <input class="form-check-input" type="checkbox" id="vm_@metric.MetricId"
                                               checked="@metric.Enabled"
                                               @onchange="e => { var idx = _metrics.FindIndex(x => x.MetricId == metric.MetricId); if(idx>=0) _metrics[idx] = metric with { Enabled = (bool)e.Value! }; }" />
                                        <label class="form-check-label" for="vm_@metric.MetricId">
                                            @GetDisplayLabel(metric)
                                        </label>
                                    </div>
                                }
                            }

                            @* Tab: Agent Metrics *@
                            @if (_viewTab == "agent")
                            {
                                @if (_agentMetrics.Any())
                                {
                                    @foreach (var m in _agentMetrics)
                                    {
                                        var metric = m;
                                        <div class="form-check form-check-sm mb-2">
                                            <input class="form-check-input" type="checkbox" id="vm_@metric.MetricId"
                                                   checked="@metric.Enabled"
                                                   @onchange="e => { var idx = _agentMetrics.FindIndex(x => x.MetricId == metric.MetricId); if(idx>=0) _agentMetrics[idx] = metric with { Enabled = (bool)e.Value! }; }" />
                                            <label class="form-check-label" for="vm_@metric.MetricId">
                                                @GetDisplayLabel(metric)
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p class="text-muted small">@L["DayTrend_NoAgentMetrics"]</p>
                                }
                            }

                        </div>
                    </div>
                    <div class="modal-footer py-2 d-flex justify-content-between">
                        <button class="btn btn-sm btn-outline-danger" @onclick="ClearLocalOverridesAsync">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>@L["Widget_ResetToDefault"]
                        </button>
                        <div>
                            <button class="btn btn-sm btn-secondary me-2" @onclick="() => _showViewConfig = false">
                                @L["Cancel"]
                            </button>
                            <button class="btn btn-sm btn-primary" @onclick="ApplyViewConfigAsync">
                                <i class="bi bi-check2 me-1"></i>@L["Apply"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public Guid WidgetInstanceId { get; set; }
    [Parameter] public bool IsViewMode { get; set; }

    private readonly string _chartId = $"daytrend-{Guid.NewGuid():N}";
    private List<DayTrendIntervalData> _intervals = new();
    private bool _loading = true;
    private bool _isNoQueues;
    private string? _error;
    private DateTime _lastUpdate;
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    // Config values
    private string _title = "Day Trend";
    private int _businessUnitId;
    private int _intervalMinutes = 30;
    private int _refreshIntervalSeconds = 300;
    private string _chartType = "line";
    private bool _showDataLabels = true;
    private bool _showLegend = true;
    private List<DayTrendMetricConfig> _metrics = new();
    private List<DayTrendMetricConfig> _agentMetrics = new();

    // View-mode local config
    private bool _showViewConfig;
    private string _viewTab = "general";  // "general" | "queue" | "agent"
    private string? _localChartType;   // null = use saved config value
    private string _viewChartType = "line";  // current selection in modal
    private List<BusinessUnitDto> _viewBuList = [];
    private int _localBuId;                          // 0 = use saved config value
    private HashSet<string>? _localMetricIds;        // null = use saved config
    private HashSet<string>? _localAgentMetricIds;   // null = use saved config

    private string LocalStorageKey =>
        $"cc:daytrendview:{CurrentUser.UserId}:{WidgetInstanceId}";

    // Effective values used for data loading and rendering
    private int EffectiveBuId => _localBuId > 0 ? _localBuId : _businessUnitId;
    private string EffectiveChartType => _localChartType ?? _chartType;

    // Colors
    private string _backgroundColor = "";
    private string _fontColor = "";
    private string _darkBackgroundColor = "#1e293b";
    private string _darkFontColor = "#f1f5f9";

    private string EffectiveBackgroundColor => DarkMode ? _darkBackgroundColor : _backgroundColor;
    private string EffectiveFontColor => DarkMode
        ? (string.IsNullOrEmpty(_darkFontColor) ? "#f1f5f9" : _darkFontColor)
        : (string.IsNullOrEmpty(_fontColor) ? "#333333" : _fontColor);

    private int _lastBusinessUnitId;
    private int _lastIntervalMinutes;

    private static readonly HashSet<string> DefaultEnabledInteraction = new()
    {
        "interaction.incoming_calls",
        "interaction.answered_calls",
        "interaction.abandoned_calls",
    };

    private static readonly Dictionary<string, string> DefaultColors = new()
    {
        ["interaction.incoming_calls"]      = "#3b82f6",
        ["interaction.answered_calls"]      = "#22c55e",
        ["interaction.abandoned_calls"]     = "#ef4444",
        ["interaction.callback_requests"]   = "#f59e0b",
        ["interaction.completed_callbacks"] = "#8b5cf6",
        ["interaction.avg_wait_time"]       = "#06b6d4",
        ["interaction.max_wait_time"]       = "#0891b2",
        ["interaction.avg_talk_time"]       = "#64748b",
        ["interaction.avg_abandon_wait"]    = "#0d9488",
        ["interaction.outbound_calls"]      = "#6366f1",
        ["interaction.transferred_calls"]   = "#ec4899",
        ["statuslog.available_agents"]      = "#4ade80",
        ["statuslog.onphone_agents"]        = "#60a5fa",
        ["statuslog.break_agents"]          = "#fb923c",
        ["statuslog.paperwork_agents"]      = "#a78bfa",
        ["statuslog.training_agents"]       = "#94a3b8",
        ["statuslog.total_agents"]          = "#f1f5f9",
        ["statuslog.logged_in_agents"]      = "#fef08a",
        ["statuslog.available_time_ms"]     = "#86efac",
        ["statuslog.onphone_time_ms"]       = "#93c5fd",
        ["statuslog.break_time_ms"]         = "#fdba74",
        ["statuslog.paperwork_time_ms"]     = "#c4b5fd",
        ["statuslog.training_time_ms"]      = "#cbd5e1",
        ["statuslog.total_active_time_ms"]  = "#e2e8f0",
        ["agentstatus.available_time"]      = "#4ade80",
        ["agentstatus.onphone_time"]        = "#60a5fa",
        ["agentstatus.break_time"]          = "#fb923c",
        ["agentstatus.paperwork_time"]      = "#a78bfa",
        ["agentstatus.training_time"]       = "#94a3b8",
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadMetricsFromDbAsync();
        ParseConfig();
        _lastBusinessUnitId = _businessUnitId;
        _lastIntervalMinutes = _intervalMinutes;
        if (IsViewMode)
            await LoadLocalOverridesAsync();
        await LoadDataAsync();
        StartAutoRefresh();
    }

    protected override async Task OnParametersSetAsync()
    {
        ParseConfig();
        if (_businessUnitId != _lastBusinessUnitId || _intervalMinutes != _lastIntervalMinutes)
        {
            _lastBusinessUnitId = _businessUnitId;
            _lastIntervalMinutes = _intervalMinutes;
            await LoadDataAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && !_loading && !_isNoQueues && _error is null && _intervals.Count > 0)
        {
            await RenderChartAsync();
        }
    }

    private void ParseConfig()
    {
        if (Config is null) return;

        _title = Config.DisplayName ?? "Day Trend";
        _businessUnitId = Config.DayTrendBusinessUnitId ?? 0;
        _intervalMinutes = Config.DayTrendIntervalMinutes ?? 30;
        _refreshIntervalSeconds = Config.DayTrendRefreshIntervalSeconds ?? 300;
        _chartType = Config.DayTrendChartType ?? "line";
        _showDataLabels = Config.DayTrendShowDataLabels ?? true;
        _showLegend = Config.DayTrendShowLegend ?? true;

        // Colors
        _backgroundColor = Config.BackgroundColor ?? "";
        _fontColor = Config.FontColor ?? "";
        _darkBackgroundColor = Config.DarkBackgroundColor ?? "#1e293b";
        _darkFontColor = Config.DarkFontColor ?? "#f1f5f9";
    }

    private async Task LoadMetricsFromDbAsync()
    {
        await using var db = await AppDbFactory.CreateDbContextAsync();
        var allMetrics = await db.HistoryMetrics
            .AsNoTracking()
            .OrderBy(m => m.MetricId)
            .ToListAsync();

        var savedInteraction = Config?.DayTrendMetrics?.ToDictionary(m => m.MetricId)
                               ?? new Dictionary<string, DayTrendMetricConfig>();
        var savedAgent = Config?.DayTrendAgentMetrics?.ToDictionary(m => m.MetricId)
                         ?? new Dictionary<string, DayTrendMetricConfig>();

        _metrics = allMetrics
            .Where(m => m.MetricType == "Interaction")
            .Select(m => savedInteraction.TryGetValue(m.MetricId, out var saved)
                ? saved with { ValueType = m.ValueType }
                : new DayTrendMetricConfig(
                    m.MetricId,
                    Enabled: DefaultEnabledInteraction.Contains(m.MetricId),
                    Color: DefaultColors.GetValueOrDefault(m.MetricId, "#64748b"),
                    Label: m.Description,
                    ValueType: m.ValueType))
            .ToList();

        _agentMetrics = allMetrics
            .Where(m => m.MetricType == "AgentStatusLog" || m.MetricType == "AgentStatus")
            .Select(m => savedAgent.TryGetValue(m.MetricId, out var saved)
                ? saved with { ValueType = m.ValueType }
                : new DayTrendMetricConfig(
                    m.MetricId,
                    Enabled: false,
                    Color: DefaultColors.GetValueOrDefault(m.MetricId, "#64748b"),
                    Label: m.Description,
                    ValueType: m.ValueType))
            .ToList();

        Logger.LogInformation("DayTrendWidget: loaded {I} interaction + {A} agent metrics from history_metrics",
            _metrics.Count, _agentMetrics.Count);
    }

    private async Task LoadDataAsync()
    {
        if (EffectiveBuId == 0)
        {
            _loading = false;
            _error = L["Widget_SelectBusinessUnit"];
            return;
        }

        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var includeAgentMetrics = _agentMetrics.Any(m => m.Enabled);
            var result = await Mediator.Send(new DayTrendQuery(
                EffectiveBuId,
                _intervalMinutes,
                includeAgentMetrics), _cts.Token);

            _isNoQueues = result.IsNoQueues;
            _intervals = result.Intervals.ToList();
            _lastUpdate = DateTime.Now;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RenderChartAsync()
    {
        if (_intervals.Count == 0) return;

        Logger.LogInformation("DayTrendWidget: RenderChart - {IntervalCount} intervals, {MetricCount} metrics ({EnabledCount} enabled)",
            _intervals.Count, _metrics.Count, _metrics.Count(m => m.Enabled));

        var labels = _intervals.Select(i => i.IntervalStart.ToString("HH:mm")).ToArray();
        var datasets = new List<object>();

        // Add enabled interaction metrics
        foreach (var metric in _metrics.Where(m => m.Enabled))
        {
            var data = _intervals.Select(i =>
                i.Metrics.TryGetValue(metric.MetricId, out var v) ? v : 0).ToArray();

            var isTimeMetric = metric.ValueType == "Time";

            datasets.Add(new
            {
                label = GetDisplayLabel(metric),
                data,
                color = metric.Color,
                isAgentMetric = false,
                isTimeMetric
            });
        }

        // Add enabled agent metrics
        foreach (var metric in _agentMetrics.Where(m => m.Enabled))
        {
            var data = _intervals.Select(i =>
                i.Metrics.TryGetValue(metric.MetricId, out var v) ? v : 0).ToArray();

            var isTimeMetric = metric.ValueType == "Time";

            // Convert milliseconds to seconds for time metrics
            if (isTimeMetric)
            {
                data = data.Select(v => v / 1000.0).ToArray();
            }

            datasets.Add(new
            {
                label = GetDisplayLabel(metric),
                data,
                color = metric.Color,
                isAgentMetric = true,
                isTimeMetric
            });
        }

        var options = new
        {
            chartType = EffectiveChartType,
            showDataLabels = _showDataLabels,
            showLegend = _showLegend,
            fontColor = EffectiveFontColor
        };

        Logger.LogInformation("DayTrendWidget: Calling JS with {DatasetCount} datasets, chartId={ChartId}", datasets.Count, _chartId);

        try
        {
            await JS.InvokeVoidAsync("dayTrendChart.render", _chartId, labels, datasets, options);
            Logger.LogInformation("DayTrendWidget: JS render completed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "DayTrendWidget: JS render failed");
        }
    }

    private void StartAutoRefresh()
    {
        if (_refreshIntervalSeconds <= 0) return;

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_refreshIntervalSeconds));
        _ = Task.Run(async () =>
        {
            while (await _timer.WaitForNextTickAsync(_cts.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadDataAsync();
                    if (!_loading && _error is null && _intervals.Count > 0)
                    {
                        await RenderChartAsync();
                    }
                });
            }
        });
    }

    private string GetWidgetStyle()
    {
        var styles = new List<string>();
        var bg = EffectiveBackgroundColor;
        var fg = EffectiveFontColor;

        if (!string.IsNullOrEmpty(bg))
            styles.Add($"background-color: {bg}");
        if (!string.IsNullOrEmpty(fg))
            styles.Add($"color: {fg}");

        return string.Join("; ", styles);
    }

    private string GetFontStyle()
    {
        var fg = EffectiveFontColor;
        return !string.IsNullOrEmpty(fg) ? $"color: {fg};" : "";
    }

    private static string GetDisplayLabel(DayTrendMetricConfig metric)
    {
        if (!string.IsNullOrEmpty(metric.Label))
            return metric.Label;

        var parts = metric.MetricId.Split('.');
        if (parts.Length > 1)
        {
            return string.Join(" ", parts[1].Split('_')
                .Select(p => char.ToUpper(p[0]) + p[1..]));
        }
        return metric.MetricId;
    }

    private async Task LoadLocalOverridesAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", LocalStorageKey);
            if (string.IsNullOrEmpty(json)) return;

            var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("buId", out var buEl) && buEl.TryGetInt32(out var buId) && buId > 0)
                _localBuId = buId;

            if (root.TryGetProperty("metrics", out var mEl) && mEl.ValueKind == JsonValueKind.Array)
            {
                _localMetricIds = mEl.EnumerateArray()
                    .Select(x => x.GetString() ?? "")
                    .Where(s => !string.IsNullOrEmpty(s))
                    .ToHashSet();
                _metrics = _metrics.Select(m => m with { Enabled = _localMetricIds.Contains(m.MetricId) }).ToList();
            }

            if (root.TryGetProperty("agentMetrics", out var amEl) && amEl.ValueKind == JsonValueKind.Array)
            {
                _localAgentMetricIds = amEl.EnumerateArray()
                    .Select(x => x.GetString() ?? "")
                    .Where(s => !string.IsNullOrEmpty(s))
                    .ToHashSet();
                _agentMetrics = _agentMetrics.Select(m => m with { Enabled = _localAgentMetricIds.Contains(m.MetricId) }).ToList();
            }

            if (root.TryGetProperty("chartType", out var ctEl) && ctEl.ValueKind == JsonValueKind.String)
            {
                _localChartType = ctEl.GetString();
                _viewChartType = _localChartType ?? "line";
            }
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "DayTrendWidget: failed to load local overrides");
        }
    }

    private async Task SaveLocalOverridesAsync()
    {
        _localChartType = _viewChartType;
        var obj = new
        {
            buId = _localBuId,
            metrics = _metrics.Where(m => m.Enabled).Select(m => m.MetricId).ToArray(),
            agentMetrics = _agentMetrics.Where(m => m.Enabled).Select(m => m.MetricId).ToArray(),
            chartType = _viewChartType
        };
        var json = JsonSerializer.Serialize(obj);
        await JS.InvokeVoidAsync("localStorage.setItem", LocalStorageKey, json);
    }

    private async Task ClearLocalOverridesAsync()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", LocalStorageKey);
        _localBuId = 0;
        _localMetricIds = null;
        _localAgentMetricIds = null;
        _localChartType = null;
        _viewChartType = _chartType;
        _showViewConfig = false;
        ParseConfig();
        await LoadMetricsFromDbAsync();
        await LoadDataAsync();
    }

    public async Task OpenLocalConfigAsync()
    {
        if (!_viewBuList.Any())
            _viewBuList = (await Mediator.Send(new GetMyBusinessUnitsQuery(), _cts.Token)).ToList();

        _viewChartType = _localChartType ?? _chartType;
        _viewTab = "general";

        // Pre-select current effective values in the metric lists
        if (_localMetricIds is not null)
            _metrics = _metrics.Select(m => m with { Enabled = _localMetricIds.Contains(m.MetricId) }).ToList();

        if (_localAgentMetricIds is not null)
            _agentMetrics = _agentMetrics.Select(m => m with { Enabled = _localAgentMetricIds.Contains(m.MetricId) }).ToList();

        _showViewConfig = true;
    }

    private async Task ApplyViewConfigAsync()
    {
        await SaveLocalOverridesAsync();
        _showViewConfig = false;
        await LoadDataAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _timer?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("dayTrendChart.destroy", _chartId);
        }
        catch { /* ignore */ }
    }
}

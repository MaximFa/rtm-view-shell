@page "/widgets"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IWidgetCatalogService WidgetCatalog

<PageTitle>Widget Catalogue — RTM View</PageTitle>

<h1 class="h3 mb-4">Widget Catalogue</h1>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status" />
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var cat in _categories)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header fw-semibold">@cat.Name</div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">@cat.Description</p>
                        @if (_types.TryGetValue(cat.CategoryId, out var types))
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var t in types)
                                {
                                    <li class="list-group-item px-0 py-1 border-0">
                                        <span class="fw-medium small">@t.Name</span>
                                        <br />
                                        <span class="text-muted" style="font-size:.8rem;">@t.Description</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <small class="text-muted">
                            @(_types.GetValueOrDefault(cat.CategoryId)?.Count ?? 0) widget type(s)
                            <!-- TODO: widget-library — add to dashboard when available -->
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<WidgetCategoryDto> _categories = Array.Empty<WidgetCategoryDto>();
    private Dictionary<string, IReadOnlyList<WidgetTypeDto>> _types = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _categories = await WidgetCatalog.GetCategoriesAsync();
        foreach (var cat in _categories)
        {
            _types[cat.CategoryId] = await WidgetCatalog.GetTypesInCategoryAsync(cat.CategoryId);
        }
        _loading = false;
    }
}

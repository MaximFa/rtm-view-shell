@using CcDashboard.Application.Queries.InfoSlots
@using CcDashboard.Contracts.DTOs.InfoSlots
@using Microsoft.AspNetCore.SignalR.Client
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@using MediatR
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable

@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject CcDashboard.Domain.Interfaces.ICurrentUserAccessor CurrentUser

@* Info Slot Widget — CC-010 *@

<div class="is-widget @DirectionClass"
     data-bg="@(Config?.BackgroundColor ?? "auto")"
     data-text="@(Config?.FontColor ?? "auto")"
     style="@WidgetStyle">

    @if (_messages.Count == 0)
    {
        <div class="is-empty">
            @(L["InfoSlot_NoMessages"])
        </div>
    }
    else if (_displayMode == "Ticker")
    {
        <div class="is-ticker">
            <div class="is-ticker-track" style="--is-anim-duration: @AnimDuration">
                @foreach (var msg in OrderedMessages)
                {
                    <span class="is-msg @(msg.Priority == "High" ? "is-high" : "")" style="@MsgStyle">
                        @if (msg.Priority == "High") { <span class="is-star">★</span> }
                        @msg.Content
                        @if (ShowAuthor) { <span class="is-author">@msg.AuthorName</span> }
                        @if (ShowTimestamp) { <span class="is-time">@msg.CreatedAt.ToString("HH:mm")</span> }
                    </span>
                    <span class="is-sep">·····</span>
                }
            </div>
        </div>
    }
    else
    {
        <div class="is-sequential">
            @if (_currentIndex < OrderedMessages.Count())
            {
                var msg = OrderedMessages.ElementAt(_currentIndex);
                <div class="is-msg-content @(msg.Priority == "High" ? "is-high" : "")">
                    @if (msg.Priority == "High") { <span class="is-star">★</span> }
                    @msg.Content
                </div>
                <div class="is-msg-meta">
                    @if (ShowAuthor) { <span>@msg.AuthorName</span> }
                    @if (ShowTimestamp) { <span>@(ShowAuthor ? "· " : "")@msg.CreatedAt.ToString("HH:mm")</span> }
                    @if (msg.ExpiresAt.HasValue) { <span>· @L["InfoSlot_ExpiresAt"]: @msg.ExpiresAt.Value.ToString("HH:mm")</span> }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public bool DarkMode { get; set; }

    private List<InfoSlotMessageDto> _messages = new();
    private int _currentIndex = 0;
    private string _displayMode = "Ticker";
    private int _secondsPerMessage = 10;
    private HubConnection? _hub;
    private Timer? _timer;
    private Guid? _tenantId;

    private IEnumerable<InfoSlotMessageDto> OrderedMessages =>
        _messages.OrderByDescending(m => m.Priority == "High")
                 .ThenByDescending(m => m.CreatedAt)
                 .Take(int.MaxValue);

    private string DirectionClass => $"is-dir-{(Config?.ScrollDirection ?? "LeftToRight").ToLowerInvariant()}";

    private string AnimDuration => (Config?.ScrollSpeed ?? "Medium") switch
    {
        "Slow" => "40s",
        "Fast" => "10s",
        _ => "20s"
    };

    private bool ShowAuthor => Config?.ShowAuthor ?? true;
    private bool ShowTimestamp => Config?.ShowTimestamp ?? true;

    private string EffectiveBackgroundColor => DarkMode
        ? (Config?.DarkBackgroundColor ?? Config?.BackgroundColor ?? "auto")
        : (Config?.BackgroundColor ?? "auto");

    private string EffectiveFontColor => DarkMode
        ? (Config?.DarkFontColor ?? Config?.FontColor ?? "auto")
        : (Config?.FontColor ?? "auto");

    private string WidgetStyle
    {
        get
        {
            var styles = new List<string>();
            var bg = EffectiveBackgroundColor;
            var text = EffectiveFontColor;
            var fontSize = int.TryParse(Config?.FontSize, out var fs) ? fs : 14;

            if (bg != "auto" && bg != "transparent")
                styles.Add($"background-color: {bg}");
            if (text != "auto")
                styles.Add($"color: {text}");
            styles.Add($"font-size: {fontSize}px");

            return string.Join("; ", styles);
        }
    }

    private string MsgStyle
    {
        get
        {
            if (Config is null) return "";
            var styles = new List<string>();
            // Priority high styling via CSS variables
            // Priority high colors use CSS defaults
            return string.Join("; ", styles);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Config?.InfoSlotId is null) return;

        var data = await Mediator.Send(new GetInfoSlotWidgetDataQuery(Config.InfoSlotId.Value));
        if (data is not null)
        {
            _displayMode = data.DisplayMode;
            _secondsPerMessage = data.SecondsPerMessage;
            _messages = data.Messages;
        }

        // Start timer immediately after data loads (for Sequential mode)
        StartSequentialTimer();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Config?.InfoSlotId is not null)
        {
            _ = ConnectHubAsync(); // Fire and forget - errors handled inside
        }
    }

    private async Task ConnectHubAsync()
    {
        if (Config?.InfoSlotId is null) return;

        await CurrentUser.InitAsync(); // ensure auth state loaded
        _tenantId = CurrentUser.TenantId;
        if (_tenantId is null) return; // not authenticated — no hub

        try
        {
            var hubUrl = Navigation.ToAbsoluteUri("/hubs/info-slot");
            _hub = new HubConnectionBuilder()
                .WithUrl(hubUrl, options =>
                {
                    // Server-to-server loopback: bypass SSL cert validation.
                    // Safe: hub is [AllowAnonymous] read-only; tenant verified via DB.
                    options.HttpMessageHandlerFactory = _ => new HttpClientHandler
                    {
                        ServerCertificateCustomValidationCallback =
                            HttpClientHandler.DangerousAcceptAnyServerCertificateValidator
                    };
                })
                .WithAutomaticReconnect()
                .Build();

            _hub.On<InfoSlotMessageDto>("MessageAdded", msg =>
            {
                _messages.Add(msg);
                InvokeAsync(StateHasChanged);
            });

            _hub.On<Guid>("MessageDeactivated", msgId =>
            {
                _messages.RemoveAll(m => m.Id == msgId);
                InvokeAsync(StateHasChanged);
            });

            _hub.On<Guid>("MessageExpired", msgId =>
            {
                _messages.RemoveAll(m => m.Id == msgId);
                InvokeAsync(StateHasChanged);
            });

            _hub.On<InfoSlotMessageDto>("MessageUpdated", msg =>
            {
                var idx = _messages.FindIndex(m => m.Id == msg.Id);
                if (idx >= 0)
                    _messages[idx] = msg;
                InvokeAsync(StateHasChanged);
            });

            _hub.On<DisplayModeChangedPayload>("DisplayModeChanged", payload =>
            {
                _displayMode = payload.DisplayMode;
                _secondsPerMessage = payload.SecondsPerMessage;
                // Restart Sequential timer with new settings
                _timer?.Dispose();
                _timer = null;
                if (_displayMode == "Sequential")
                    RestartSequentialTimer();
                InvokeAsync(StateHasChanged);
            });

            await _hub.StartAsync();
            await _hub.InvokeAsync("JoinSlot", Config.InfoSlotId.Value, _tenantId.Value);
        }
        catch
        {
            // Hub connection failed - widget still works with initial data, just no live updates
        }
    }

    private void StartSequentialTimer()
    {
        if (_displayMode != "Sequential") return;

        var interval = _secondsPerMessage * 1000;
        _timer = new Timer(_ =>
        {
            _currentIndex = (_currentIndex + 1) % Math.Max(1, _messages.Count);
            InvokeAsync(StateHasChanged);
        }, null, interval, interval);
    }

    private void RestartSequentialTimer()
    {
        _timer?.Dispose();
        _currentIndex = 0;
        var interval = _secondsPerMessage * 1000;
        _timer = new Timer(_ =>
        {
            _currentIndex = (_currentIndex + 1) % Math.Max(1, _messages.Count);
            InvokeAsync(StateHasChanged);
        }, null, interval, interval);
    }

    private record DisplayModeChangedPayload(string DisplayMode, int SecondsPerMessage);

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_hub is not null)
        {
            if (Config?.InfoSlotId.HasValue == true)
            {
                try { await _hub.InvokeAsync("LeaveSlot", Config.InfoSlotId.Value, _tenantId ?? Guid.Empty); }
                catch { /* ignore on dispose */ }
            }
            await _hub.DisposeAsync();
        }
    }
}

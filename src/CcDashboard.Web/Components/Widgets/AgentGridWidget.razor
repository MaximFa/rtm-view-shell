@using CcDashboard.Contracts.DTOs.Widgets
@using CcDashboard.Application.Queries.TenantSettings
@using Microsoft.AspNetCore.SignalR.Client
@using MediatR
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@implements IAsyncDisposable

@* Agent Grid Widget - connects to external SignalR simulator for real-time agent data *@

<div class="agent-grid-widget" style="@GetWidgetStyle()">
    @if (GridId == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-gear fs-3 mb-2 opacity-50"></i>
            <span class="small">@L["Widget_SaveConfigFirst"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Connecting)
    {
        <div class="d-flex align-items-center justify-content-center h-100 text-muted" aria-busy="true">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <span>@L["Widget_Connecting"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Failed)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-wifi-off fs-3 mb-2 text-warning"></i>
            <span class="small">@L["Widget_ConnectionFailed"]</span>
            <button class="btn btn-sm btn-link mt-2" @onclick="ReconnectAsync">
                @L["Widget_Retry"]
            </button>
        </div>
    }
    else if (_agents.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-people fs-3 mb-2 opacity-50"></i>
            <span class="small">@L["Widget_NoAgents"]</span>
        </div>
    }
    else
    {
        var allFiltered = AllFilteredAgents;
        var pagedAgents = FilteredAgents;
        <div class="agent-grid-header d-flex align-items-center justify-content-between px-2 py-1 border-bottom">
            <span class="small text-muted">
                @if (TotalPages > 1)
                {
                    var startIdx = (_currentPage - 1) * _pageSize + 1;
                    var endIdx = Math.Min(_currentPage * _pageSize, allFiltered.Count);
                    <text>@startIdx-@endIdx / @allFiltered.Count @L["Widget_Agents"]</text>
                }
                else
                {
                    <text>@allFiltered.Count @L["Widget_Agents"]</text>
                }
            </span>
            <span class="small">
                @if (_connectionState == ConnectionState.Connected)
                {
                    <span class="text-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@L["Widget_Live"]</span>
                }
                else if (_connectionState == ConnectionState.Reconnecting)
                {
                    <span class="text-warning"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@L["Widget_Reconnecting"]</span>
                }
            </span>
        </div>

        <div class="agent-grid-body" style="@GetTableStyle()">
            <table class="table table-sm mb-0 small" style="@GetTableStyle()">
                <thead class="agent-grid-thead" style="@GetTheadStyle()">
                    <tr style="@GetRowStyle()">
                        @foreach (var colDef in _columnDefs)
                        {
                            var colKey = MetricIdToColumnKey(colDef.MetricId);
                            var alignClass = GetAlignmentClass(colDef.MetricId);
                            @RenderColumnHeader(colKey, colDef.Name, colDef.MetricId, alignClass)
                        }
                    </tr>
                </thead>
                <tbody style="@GetTableStyle()">
                    @if (pagedAgents.Count == 0)
                    {
                        <tr>
                            <td colspan="@_columnDefs.Count" class="text-center text-muted py-4">
                                <i class="bi bi-funnel me-1"></i>No results match filter
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var agent in pagedAgents)
                        {
                            <tr class="@GetRowClass(agent)" style="@GetRowStyle()">
                                @foreach (var colDef in _columnDefs)
                                {
                                    @RenderCell(agent, colDef)
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* Pagination controls *@
        @if (TotalPages > 1 || allFiltered.Count > PageSizes[0])
        {
            <div class="agent-grid-pagination d-flex align-items-center justify-content-between px-2 py-1 border-top">
                <div class="d-flex align-items-center gap-2">
                    <select class="form-select form-select-sm pagination-select"
                            value="@_pageSize"
                            @onchange="OnPageSizeChanged">
                        @foreach (var size in PageSizes)
                        {
                            <option value="@size">@size</option>
                        }
                    </select>
                    <span class="small text-muted">per page</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button class="btn btn-sm btn-outline-secondary pagination-btn"
                            disabled="@(_currentPage <= 1)"
                            @onclick="() => GoToPage(1)"
                            title="First">
                        <i class="bi bi-chevron-bar-left"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary pagination-btn"
                            disabled="@(_currentPage <= 1)"
                            @onclick="() => GoToPage(_currentPage - 1)"
                            title="Previous">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="small px-2">@_currentPage / @TotalPages</span>
                    <button class="btn btn-sm btn-outline-secondary pagination-btn"
                            disabled="@(_currentPage >= TotalPages)"
                            @onclick="() => GoToPage(_currentPage + 1)"
                            title="Next">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary pagination-btn"
                            disabled="@(_currentPage >= TotalPages)"
                            @onclick="() => GoToPage(TotalPages)"
                            title="Last">
                        <i class="bi bi-chevron-bar-right"></i>
                    </button>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public int GridId { get; set; }

    [Inject] private ILogger<AgentGridWidget> Logger { get; set; } = null!;
    [Inject] private IMediator Mediator { get; set; } = null!;

    private HubConnection? _hub;
    private List<AgentStatusDto> _agents = new();
    private ConnectionState _connectionState = ConnectionState.Connecting;
    private CancellationTokenSource _cts = new();

    // Configuration from widget settings
    private HashSet<string> _filterTeams = new();
    private HashSet<string> _filterStates = new();
    private HashSet<string> _visibleColumns = new() { "agent", "state", "duration", "occupancy", "adherence" };
    private bool _showAlerts = true;
    private List<AgentGridColumnDef> _columnDefs = new();  // Dynamic column definitions

    // Widget appearance
    private string? _fontSize;
    private string? _backgroundColor;
    private string? _fontColor;
    private string? _tableBackgroundColor;
    private Dictionary<string, List<ColumnThreshold>> _columnThresholds = new();
    private Dictionary<string, string> _columnNames = new();  // Custom column display names

    // Sorting and filtering state
    private string? _sortColumn;
    private bool _sortAscending = true;
    private string? _activeFilterColumn;
    private string? _listDropdownOpen;
    private Dictionary<string, ColumnFilter> _columnFilters = new();

    // Pagination
    private int _currentPage = 1;
    private int _pageSize = 15;
    private static readonly int[] PageSizes = { 15, 45, 100, 200 };

    private class ColumnFilter
    {
        public string Mode { get; set; } = ""; // "value" or "list"
        public string MatchType { get; set; } = "contains";
        public string TextValue { get; set; } = "";
        public HashSet<string> SelectedValues { get; set; } = new();
        public string ListSearch { get; set; } = "";
    }

    private static bool IsNumericColumn(string column) => IsNumericMetric(ColumnKeyToMetricId(column));

    // Filtered, sorted, and paginated agents
    private List<AgentStatusDto> AllFilteredAgents
    {
        get
        {
            var result = _agents
                .Where(a => _filterTeams.Count == 0 || _filterTeams.Contains(a.TeamName))
                .Where(a => _filterStates.Count == 0 || _filterStates.Contains(a.State.ToString()));

            // Apply saved table filters from config (before interactive filters)
            if (Config?.TableFilters is { Count: > 0 } tableFilters)
            {
                var validRules = tableFilters.Where(r => !string.IsNullOrEmpty(r.MetricId)).ToList();
                if (validRules.Count > 0)
                {
                    result = result.Where(a => EvaluateTableFilters(a, validRules));
                }
            }

            // Apply interactive column filters
            foreach (var (column, filter) in _columnFilters)
            {
                if (!HasActiveFilter(column)) continue;
                result = result.Where(a => MatchesFilter(a, column, filter));
            }

            // Apply sorting
            if (!string.IsNullOrEmpty(_sortColumn))
            {
                var metricId = ColumnKeyToMetricId(_sortColumn);
                if (IsNumericMetric(metricId))
                {
                    result = _sortAscending
                        ? result.OrderBy(a => GetMetricNumericValue(a, metricId))
                        : result.OrderByDescending(a => GetMetricNumericValue(a, metricId));
                }
                else
                {
                    result = _sortAscending
                        ? result.OrderBy(a => GetMetricTextValue(a, metricId))
                        : result.OrderByDescending(a => GetMetricTextValue(a, metricId));
                }
            }

            return result.ToList();
        }
    }

    private int TotalPages => (int)Math.Ceiling((double)AllFilteredAgents.Count / _pageSize);

    private List<AgentStatusDto> FilteredAgents => AllFilteredAgents
        .Skip((_currentPage - 1) * _pageSize)
        .Take(_pageSize)
        .ToList();

    private static string ColumnKeyToMetricId(string colKey) => colKey switch
    {
        "agent" => "AgentName",
        "state" => "AgentState",
        "duration" => "AgentStateDuration",
        "queue" => "AgentQueue",
        "occupancy" => "AgentOccupancy",
        "adherence" => "AgentAdherence",
        "calls" => "AgentCalls",
        "aht" => "AgentAHT",
        "extension" => "AgentExtension",
        "team" => "AgentTeam",
        "utilisation" => "AgentUtilisation",
        "acwavg" => "AgentAcwAvg",
        _ => colKey
    };

    private bool MatchesFilter(AgentStatusDto agent, string column, ColumnFilter filter)
    {
        // List mode - check if value is in selected list
        if (filter.Mode == "list")
        {
            var textValue = GetColumnTextValue(agent, column);
            return filter.SelectedValues.Contains(textValue);
        }

        // Value mode
        var colTextValue = GetColumnTextValue(agent, column);
        var numValue = GetColumnNumericValue(agent, column);

        // For numeric comparisons
        if (filter.MatchType is "greater" or "greaterequal" or "less" or "lessequal")
        {
            var compareValue = ParseFilterValue(filter.TextValue);
            if (compareValue is null) return true;

            return filter.MatchType switch
            {
                "greater" => numValue > compareValue,
                "greaterequal" => numValue >= compareValue,
                "less" => numValue < compareValue,
                "lessequal" => numValue <= compareValue,
                _ => true
            };
        }

        // For text comparisons
        return filter.MatchType switch
        {
            "equal" => colTextValue.Equals(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "notequal" => !colTextValue.Equals(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "contains" => colTextValue.Contains(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "notcontains" => !colTextValue.Contains(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "startswith" => colTextValue.StartsWith(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "endswith" => colTextValue.EndsWith(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "empty" => string.IsNullOrEmpty(colTextValue),
            "notempty" => !string.IsNullOrEmpty(colTextValue),
            _ => true
        };
    }

    private bool EvaluateTableFilters(AgentStatusDto agent, List<TableFilterRule> rules)
    {
        if (rules.Count == 0) return true;

        // Evaluate first rule
        bool result = EvaluateSingleTableFilter(agent, rules[0]);

        // Combine with subsequent rules using their connectors
        for (int i = 1; i < rules.Count; i++)
        {
            var rule = rules[i];
            var ruleResult = EvaluateSingleTableFilter(agent, rule);

            if (rule.Connector == "OR")
                result = result || ruleResult;
            else // AND
                result = result && ruleResult;
        }

        return result;
    }

    private bool EvaluateSingleTableFilter(AgentStatusDto agent, TableFilterRule rule)
    {
        // Get column key from MetricId
        var colKey = MetricIdToColumnKey(rule.MetricId);

        // Use existing MatchesFilter by constructing a temporary ColumnFilter
        var tempFilter = new ColumnFilter
        {
            Mode = "value",
            MatchType = rule.Operator,
            TextValue = rule.Value
        };

        return MatchesFilter(agent, colKey, tempFilter);
    }

    private static decimal? ParseFilterValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        // Check if it's a time format (contains ":")
        if (value.Contains(':'))
        {
            var parts = value.Split(':');
            if (parts.Length == 2)
            {
                // Could be M:SS or MM:SS or H:MM
                if (int.TryParse(parts[0], out var p1) && int.TryParse(parts[1], out var p2))
                {
                    // Assume M:SS format (minutes:seconds)
                    return p1 * 60 + p2;
                }
            }
            else if (parts.Length == 3)
            {
                // H:MM:SS format
                if (int.TryParse(parts[0], out var h) && int.TryParse(parts[1], out var m) && int.TryParse(parts[2], out var s))
                {
                    return h * 3600 + m * 60 + s;
                }
            }
            return null;
        }

        // Remove % if present and parse as number
        var cleanValue = value.TrimEnd('%').Trim();
        if (decimal.TryParse(cleanValue, out var num))
            return num;

        return null;
    }

    private string GetColumnTextValue(AgentStatusDto agent, string column) =>
        GetMetricTextValue(agent, ColumnKeyToMetricId(column));

    private decimal GetColumnNumericValue(AgentStatusDto agent, string column) =>
        GetMetricNumericValue(agent, ColumnKeyToMetricId(column));

    private bool ShowColumn(string col) => _visibleColumns.Count == 0 || _visibleColumns.Contains(col);

    private string GetColumnLabel(string column, string defaultLabel)
    {
        return _columnNames.TryGetValue(column, out var customName) && !string.IsNullOrEmpty(customName)
            ? customName
            : defaultLabel;
    }

    private static List<AgentGridColumnDef> GetDefaultColumnDefs() => new()
    {
        new() { Name = "Agent", MetricId = "AgentName" },
        new() { Name = "State", MetricId = "AgentState" },
        new() { Name = "Duration", MetricId = "AgentStateDuration" },
        new() { Name = "OCC%", MetricId = "AgentOccupancy" },
        new() { Name = "ADH%", MetricId = "AgentAdherence" }
    };

    private static string MetricIdToColumnKey(string metricId) => metricId switch
    {
        "AgentName" => "agent",
        "AgentState" => "state",
        "AgentStateDuration" => "duration",
        "AgentQueue" => "queue",
        "AgentOccupancy" => "occupancy",
        "AgentAdherence" => "adherence",
        "AgentCalls" => "calls",
        "AgentAHT" => "aht",
        "AgentExtension" => "extension",
        "AgentTeam" => "team",
        "AgentUtilisation" => "utilisation",
        "AgentAcwAvg" => "acwavg",
        _ => metricId // preserve original case for DB MetricIds
    };

    private static bool IsNumericMetric(string metricId)
    {
        // Pattern-based detection for all metrics (existing and future)
        // Right-aligned: numbers, durations, percentages, counts

        // Explicit exclusions - these are TEXT, not numeric (left-aligned)
        if (metricId.Contains("TimeStamp", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Name", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Extension", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Station", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("UserId", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Phone", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("Campaign", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("InteractionId", StringComparison.OrdinalIgnoreCase)) return false;
        if (metricId.Contains("InteractionType", StringComparison.OrdinalIgnoreCase)) return false;

        // Duration patterns
        if (metricId.Contains("Duration", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Time", StringComparison.OrdinalIgnoreCase)) return true;

        // Count patterns
        if (metricId.Contains("Number", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Num", StringComparison.OrdinalIgnoreCase) && !metricId.Contains("Phone", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Calls", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Chats", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Callbacks", StringComparison.OrdinalIgnoreCase)) return true;

        // Percentage patterns
        if (metricId.Contains("Pct", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Percent", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Occupancy", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Adherence", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Utilisation", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("ServiceLevel", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("FCR", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("CSAT", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.EndsWith("CPH", StringComparison.OrdinalIgnoreCase)) return true;

        // Average patterns
        if (metricId.Contains("Average", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Avg", StringComparison.OrdinalIgnoreCase)) return true;
        if (metricId.Contains("Max", StringComparison.OrdinalIgnoreCase)) return true;

        // Explicit list for special cases
        return metricId is "AgentAHT" or "AgentAcwAvg";
    }

    private static bool IsCenterAlignedMetric(string metricId)
    {
        // Center-aligned: status badges (State without Duration suffix)
        if (metricId.Contains("State", StringComparison.OrdinalIgnoreCase) &&
            !metricId.Contains("Duration", StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private static bool IsEndAlignedMetric(string metricId) => IsNumericMetric(metricId);

    private static string GetAlignmentClass(string metricId)
    {
        if (IsCenterAlignedMetric(metricId)) return "text-center";
        if (IsEndAlignedMetric(metricId)) return "text-end";
        return ""; // left-aligned by default
    }

    private string GetMetricTextValue(AgentStatusDto agent, string metricId) => metricId switch
    {
        // Core widget fields
        "AgentName" or "AgentLoginName" => agent.DisplayName,
        "AgentState" or "MonAgentState" => GetStateLabel(agent.State),
        "AgentStateDuration" or "MonAgentStateDuration" or "MonAgentTelStateDuration" => FormatDuration(agent.StateDurationSeconds),
        "AgentQueue" or "MonActiveCampaign" => agent.QueueName ?? "-",
        "AgentOccupancy" => $"{agent.OccupancyPercent:0}%",
        "AgentAdherence" => $"{agent.AdherencePercent:0}%",
        "AgentCalls" or "MonAgentNumMakeCallsInCompleted" => agent.CallsHandledToday.ToString(),
        "AgentAHT" or "MonAgentAverageCallDuration" => FormatDuration(agent.AhtSeconds),
        "AgentExtension" or "MonAgentExtension" or "MonAgentStation" => agent.Extension,
        "AgentTeam" => agent.TeamName,
        "AgentUtilisation" => $"{agent.UtilisationPercent:0}%",
        "AgentAcwAvg" => FormatDuration(agent.AcwAvgSeconds),
        // DB MetricIds - Text fields
        "MonAgentUserId" => agent.AgentId,
        "MonAgentStateDesc" => agent.State.ToString(),
        "MonAgentStateDescDuration" => FormatDuration(agent.StateDurationSeconds),
        "RemotePhoneNumber" => agent.CallerId ?? "-",
        "MonInteractionType" => agent.CallDirection?.ToString() ?? "-",
        "MonAgentTelState" => GetStateLabel(agent.State),
        "MonAgentActiveInteractionId" => agent.CurrentCallId ?? "-",
        // DB MetricIds - Call counts
        "AgentIncomingCalls" or "MonAgentNumberOfInboundCallsOnly" => agent.IncomingCalls.ToString(),
        "MonAgentNumberOfInboundCallsWithIntercom" => (agent.IncomingCalls + agent.InternalCalls).ToString(),
        "AgentOutgoingCalls" or "MonAgentNumberOfMakeCalls" => agent.OutgoingCalls.ToString(),
        "AgentInternalCalls" or "UserNumAllIntercom" => agent.InternalCalls.ToString(),
        "AgentTransferredCalls" or "MonAgentNumberOfConsultCalls" => agent.TransferredCalls.ToString(),
        "AgentConferenceCalls" => agent.ConferenceCalls.ToString(),
        "AgentAbandonedCalls" or "UserNumMissedCalls" => agent.AbandonedCalls.ToString(),
        "MonAgentProxyCallsNum" or "MonAgentOutgoingCallbacksNum" => agent.CallbacksCompleted.ToString(),
        "MonAgentNumChatsCompleted" or "MonAgentNumChatsActive" => "0",
        "MonAgentNumberOfInboundCalls15sec" or "MonAgentNumberOfInboundCalls10Min" => agent.IncomingCalls.ToString(),
        // DB MetricIds - Time-based (durations)
        "AgentTalkTime" or "MonAgentTalkDuration" or "MonAgentDurationOfCalls" => FormatDuration(agent.TalkTimeSeconds),
        "AgentHoldTime" or "MonAgentHeldDuration" => FormatDuration(agent.HoldTimeSeconds),
        "AgentWrapTime" or "MonAgentWrapUpDuration" => FormatDuration(agent.WrapTimeSeconds),
        "AgentIdleTime" or "MonAgentBreakDuration" or "MonAgentPaperworkDuration" or "MonAgentUnavailableStateDuration" => FormatDuration(agent.IdleTimeSeconds),
        "MonAgentAvailableDuration" => FormatDuration(agent.IdleTimeSeconds),
        "AgentLoginDuration" or "MonAgentLoginTime" or "MonAgentCurrentLoginDuration" => FormatDuration(agent.LoginDurationSeconds),
        "MonAgentDurationOfCurrentCall" => FormatDuration(agent.CallDurationSeconds ?? 0),
        "AgentAvgTalkTime" or "MonAgentAverageInboundCallDuration" or "MonAgentAverageMakeCallDuration" => FormatDuration(agent.AvgTalkTimeSeconds),
        "AgentAvgHoldTime" or "MonAgentAvgHoldTime" => FormatDuration(agent.AvgHoldTimeSeconds),
        "AgentAvgWrapTime" or "MonAgentAvgWrapTime" => FormatDuration(agent.AvgWrapTimeSeconds),
        "MonAgentMaxCallDuration" => FormatDuration(agent.TalkTimeSeconds),
        "MonAgentAverageAgentDialerDuration" => FormatDuration(agent.AvgTalkTimeSeconds),
        // DB MetricIds - Percent
        "MonAgentTalkDurationPct" => $"{agent.OccupancyPercent:0}%",
        // DB MetricIds - Timestamps
        "MonAgentFirstLoginTimeStamp" or "MonAgentCurrentLoginTimeStamp" => agent.StateStartedAt.ToString("HH:mm:ss"),
        "MonAgentTodayLogin" => agent.State != AgentState.LoggedOut ? "Yes" : "No",
        // Extended metrics - Performance
        "AgentServiceLevel" => $"{agent.ServiceLevelPercent:0}%",
        "AgentFCR" => $"{agent.FirstCallResolutionPercent:0}%",
        "AgentCSAT" => $"{agent.CustomerSatisfactionPercent:0}%",
        "AgentCallbacksScheduled" => agent.CallbacksScheduled.ToString(),
        "AgentCallbacksCompleted" => agent.CallbacksCompleted.ToString(),
        "UserCPH" => $"{(agent.CallsHandledToday / Math.Max(1, agent.LoginDurationSeconds / 3600m)):0.0}",
        _ => $"[{metricId}]"
    };

    private decimal GetMetricNumericValue(AgentStatusDto agent, string metricId) => metricId switch
    {
        // Core widget fields
        "AgentStateDuration" or "MonAgentStateDuration" or "MonAgentTelStateDuration" or "MonAgentStateDescDuration" => agent.StateDurationSeconds,
        "AgentOccupancy" or "MonAgentTalkDurationPct" => agent.OccupancyPercent,
        "AgentAdherence" => agent.AdherencePercent,
        "AgentCalls" or "MonAgentNumMakeCallsInCompleted" => agent.CallsHandledToday,
        "AgentAHT" or "MonAgentAverageCallDuration" => agent.AhtSeconds,
        "AgentUtilisation" => agent.UtilisationPercent,
        "AgentAcwAvg" => agent.AcwAvgSeconds,
        // DB MetricIds - Call counts
        "AgentIncomingCalls" or "MonAgentNumberOfInboundCallsOnly" or "MonAgentNumberOfInboundCalls15sec" or "MonAgentNumberOfInboundCalls10Min" => agent.IncomingCalls,
        "MonAgentNumberOfInboundCallsWithIntercom" => agent.IncomingCalls + agent.InternalCalls,
        "AgentOutgoingCalls" or "MonAgentNumberOfMakeCalls" => agent.OutgoingCalls,
        "AgentInternalCalls" or "UserNumAllIntercom" => agent.InternalCalls,
        "AgentTransferredCalls" or "MonAgentNumberOfConsultCalls" => agent.TransferredCalls,
        "AgentConferenceCalls" => agent.ConferenceCalls,
        "AgentAbandonedCalls" or "UserNumMissedCalls" => agent.AbandonedCalls,
        "MonAgentProxyCallsNum" or "MonAgentOutgoingCallbacksNum" => agent.CallbacksCompleted,
        "MonAgentNumChatsCompleted" or "MonAgentNumChatsActive" => 0,
        // DB MetricIds - Time-based (durations as seconds)
        "AgentTalkTime" or "MonAgentTalkDuration" or "MonAgentDurationOfCalls" => agent.TalkTimeSeconds,
        "AgentHoldTime" or "MonAgentHeldDuration" => agent.HoldTimeSeconds,
        "AgentWrapTime" or "MonAgentWrapUpDuration" => agent.WrapTimeSeconds,
        "AgentIdleTime" or "MonAgentBreakDuration" or "MonAgentPaperworkDuration" or "MonAgentUnavailableStateDuration" or "MonAgentAvailableDuration" => agent.IdleTimeSeconds,
        "AgentLoginDuration" or "MonAgentLoginTime" or "MonAgentCurrentLoginDuration" => agent.LoginDurationSeconds,
        "MonAgentDurationOfCurrentCall" => agent.CallDurationSeconds ?? 0,
        "AgentAvgTalkTime" or "MonAgentAverageInboundCallDuration" or "MonAgentAverageMakeCallDuration" or "MonAgentAverageAgentDialerDuration" => agent.AvgTalkTimeSeconds,
        "AgentAvgHoldTime" => agent.AvgHoldTimeSeconds,
        "AgentAvgWrapTime" => agent.AvgWrapTimeSeconds,
        "MonAgentMaxCallDuration" => agent.TalkTimeSeconds,
        // Extended metrics - Performance
        "AgentServiceLevel" => agent.ServiceLevelPercent,
        "AgentFCR" => agent.FirstCallResolutionPercent,
        "AgentCSAT" => agent.CustomerSatisfactionPercent,
        "AgentCallbacksScheduled" => agent.CallbacksScheduled,
        "AgentCallbacksCompleted" => agent.CallbacksCompleted,
        "UserCPH" => agent.CallsHandledToday / Math.Max(1, agent.LoginDurationSeconds / 3600m),
        _ => 0
    };


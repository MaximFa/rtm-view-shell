@using CcDashboard.Contracts.DTOs.Widgets
@using CcDashboard.Application.Queries.TenantSettings
@using Microsoft.AspNetCore.SignalR.Client
@using MediatR
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@implements IAsyncDisposable

@* Agent Grid Widget - connects to external SignalR simulator for real-time agent data *@

<div class="agent-grid-widget h-100 d-flex flex-column" style="@GetWidgetStyle()">
    @if (_connectionState == ConnectionState.Connecting)
    {
        <div class="d-flex align-items-center justify-content-center h-100 text-muted" aria-busy="true">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <span>@L["Widget_Connecting"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Failed)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-wifi-off fs-3 mb-2 text-warning"></i>
            <span class="small">@L["Widget_ConnectionFailed"]</span>
            <button class="btn btn-sm btn-link mt-2" @onclick="ReconnectAsync">
                @L["Widget_Retry"]
            </button>
        </div>
    }
    else if (FilteredAgents.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-people fs-3 mb-2 opacity-50"></i>
            <span class="small">@L["Widget_NoAgents"]</span>
        </div>
    }
    else
    {
        <div class="agent-grid-header d-flex align-items-center justify-content-between px-2 py-1 border-bottom">
            <span class="small text-muted">
                @FilteredAgents.Count @L["Widget_Agents"]
            </span>
            <span class="small">
                @if (_connectionState == ConnectionState.Connected)
                {
                    <span class="text-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@L["Widget_Live"]</span>
                }
                else if (_connectionState == ConnectionState.Reconnecting)
                {
                    <span class="text-warning"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>@L["Widget_Reconnecting"]</span>
                }
            </span>
        </div>

        <div class="agent-grid-body flex-grow-1 overflow-auto" style="@GetTableStyle()">
            <table class="table table-sm table-hover mb-0 small">
                <thead class="sticky-top bg-body">
                    <tr>
                        @if (ShowColumn("agent")) { <th>@L["Widget_Agent"]</th> }
                        @if (ShowColumn("state")) { <th>@L["Widget_State"]</th> }
                        @if (ShowColumn("duration")) { <th class="text-end">@L["Widget_Duration"]</th> }
                        @if (ShowColumn("queue")) { <th>@L["Widget_Queue"]</th> }
                        @if (ShowColumn("occupancy")) { <th class="text-end">@L["Widget_Occupancy"]</th> }
                        @if (ShowColumn("adherence")) { <th class="text-end">@L["Widget_Adherence"]</th> }
                        @if (ShowColumn("calls")) { <th class="text-end">Calls</th> }
                        @if (ShowColumn("aht")) { <th class="text-end">AHT</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var agent in FilteredAgents)
                    {
                        <tr class="@GetRowClass(agent)">
                            @if (ShowColumn("agent"))
                            {
                                <td>
                                    <div class="d-flex align-items-center">
                                        <span class="agent-avatar me-2 @GetStateColorClass(agent.State)">
                                            @GetInitials(agent.DisplayName)
                                        </span>
                                        <div>
                                            <div class="fw-medium" style="@GetBadgeStyle("agent", agent.DisplayName)">@agent.DisplayName</div>
                                            <div class="text-muted" style="font-size: 0.75rem;">@agent.Extension</div>
                                        </div>
                                    </div>
                                </td>
                            }
                            @if (ShowColumn("state"))
                            {
                                var hasStateThreshold = HasThreshold("state", agent.State.ToString());
                                <td>
                                    <span class="badge @(hasStateThreshold ? "" : GetStateBadgeClass(agent.State))"
                                          style="@(hasStateThreshold ? GetBadgeStyle("state", agent.State.ToString()) : "")">
                                        @GetStateLabel(agent.State)
                                    </span>
                                    @if (!string.IsNullOrEmpty(agent.NotReadyReasonName))
                                    {
                                        <div class="text-muted" style="font-size: 0.7rem;">@agent.NotReadyReasonName</div>
                                    }
                                </td>
                            }
                            @if (ShowColumn("duration"))
                            {
                                <td class="text-end font-monospace">
                                    <span style="@GetBadgeStyle("duration", agent.StateDurationSeconds)">@FormatDuration(agent.StateDurationSeconds)</span>
                                </td>
                            }
                            @if (ShowColumn("queue"))
                            {
                                <td><span style="@GetBadgeStyle("queue", agent.QueueName ?? "")">@(agent.QueueName ?? "-")</span></td>
                            }
                            @if (ShowColumn("occupancy"))
                            {
                                <td class="text-end">
                                    <span style="@GetBadgeStyle("occupancy", agent.OccupancyPercent)">@agent.OccupancyPercent.ToString("0")%</span>
                                </td>
                            }
                            @if (ShowColumn("adherence"))
                            {
                                <td class="text-end">
                                    <span style="@GetBadgeStyle("adherence", agent.AdherencePercent)">@agent.AdherencePercent.ToString("0")%</span>
                                </td>
                            }
                            @if (ShowColumn("calls"))
                            {
                                <td class="text-end"><span style="@GetBadgeStyle("calls", agent.CallsHandledToday)">@agent.CallsHandledToday</span></td>
                            }
                            @if (ShowColumn("aht"))
                            {
                                <td class="text-end font-monospace"><span style="@GetBadgeStyle("aht", agent.AhtSeconds)">@FormatDuration(agent.AhtSeconds)</span></td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public Guid WidgetId { get; set; }

    [Inject] private ILogger<AgentGridWidget> Logger { get; set; } = null!;
    [Inject] private IMediator Mediator { get; set; } = null!;

    private HubConnection? _hub;
    private List<AgentStatusDto> _agents = new();
    private ConnectionState _connectionState = ConnectionState.Connecting;
    private CancellationTokenSource _cts = new();

    // Configuration from widget settings
    private HashSet<string> _filterTeams = new();
    private HashSet<string> _filterStates = new();
    private HashSet<string> _visibleColumns = new() { "agent", "state", "duration", "occupancy", "adherence" };
    private bool _showAlerts = true;

    // Widget appearance
    private string? _fontSize;
    private string? _backgroundColor;
    private string? _fontColor;
    private string? _tableBackgroundColor;
    private Dictionary<string, List<ColumnThreshold>> _columnThresholds = new();

    // Filtered agents based on config
    private List<AgentStatusDto> FilteredAgents => _agents
        .Where(a => _filterTeams.Count == 0 || _filterTeams.Contains(a.TeamName))
        .Where(a => _filterStates.Count == 0 || _filterStates.Contains(a.State.ToString()))
        .ToList();

    private bool ShowColumn(string col) => _visibleColumns.Count == 0 || _visibleColumns.Contains(col);

    private string GetWidgetStyle()
    {
        var styles = new List<string>();
        if (!string.IsNullOrEmpty(_backgroundColor))
            styles.Add($"background-color: {_backgroundColor}");
        if (!string.IsNullOrEmpty(_fontColor))
            styles.Add($"color: {_fontColor}");
        if (!string.IsNullOrEmpty(_fontSize))
        {
            var size = _fontSize switch
            {
                "small" => "0.75rem",
                "normal" => "0.85rem",
                "large" => "1rem",
                "xlarge" => "1.15rem",
                "xxlarge" => "1.3rem",
                _ => "0.85rem"
            };
            styles.Add($"font-size: {size}");
        }
        return string.Join("; ", styles);
    }

    private ColumnThreshold? FindMatchingThreshold(string column, object? value)
    {
        if (!_columnThresholds.TryGetValue(column, out var thresholds) || thresholds.Count == 0)
            return null;

        foreach (var threshold in thresholds)
        {
            bool matches = false;

            if (threshold.MatchType == "text" && value is string textValue)
            {
                matches = threshold.TextMatchType switch
                {
                    "equal" => textValue.Equals(threshold.TextMatch ?? "", StringComparison.OrdinalIgnoreCase),
                    "notequal" => !textValue.Equals(threshold.TextMatch ?? "", StringComparison.OrdinalIgnoreCase),
                    "contains" => !string.IsNullOrEmpty(threshold.TextMatch) && textValue.Contains(threshold.TextMatch, StringComparison.OrdinalIgnoreCase),
                    "startswith" => !string.IsNullOrEmpty(threshold.TextMatch) && textValue.StartsWith(threshold.TextMatch, StringComparison.OrdinalIgnoreCase),
                    "endswith" => !string.IsNullOrEmpty(threshold.TextMatch) && textValue.EndsWith(threshold.TextMatch, StringComparison.OrdinalIgnoreCase),
                    "empty" => string.IsNullOrEmpty(textValue),
                    "notempty" => !string.IsNullOrEmpty(textValue),
                    _ => false
                };
            }
            else if (threshold.MatchType == "numeric" && value is not null)
            {
                // Try to parse value as decimal
                decimal numValue = value switch
                {
                    int i => i,
                    decimal d => d,
                    double dbl => (decimal)dbl,
                    float f => (decimal)f,
                    string s when decimal.TryParse(s, out var parsed) => parsed,
                    string s when TryParseTimeToSeconds(s, out var secs) => secs,
                    _ => 0
                };

                // Parse From/To thresholds (support time format like "0:00" or "10:00")
                decimal? fromValue = ParseThresholdValue(threshold.From);
                decimal? toValue = ParseThresholdValue(threshold.To);

                bool fromOk = fromValue is null || numValue >= fromValue;
                bool toOk = toValue is null || numValue <= toValue;
                matches = fromOk && toOk;
            }

            if (matches)
                return threshold;
        }

        return null;
    }

    private string GetTableStyle()
    {
        if (!string.IsNullOrEmpty(_tableBackgroundColor) && _tableBackgroundColor != "transparent")
            return $"background-color: {_tableBackgroundColor}";
        return "";
    }

    private string GetBadgeStyle(string column, object? value)
    {
        var threshold = FindMatchingThreshold(column, value);
        if (threshold is null) return "";

        var styles = new List<string>();
        if (!string.IsNullOrEmpty(threshold.BackgroundColor) && threshold.BackgroundColor != "transparent")
            styles.Add($"background-color: {threshold.BackgroundColor}");
        if (!string.IsNullOrEmpty(threshold.FontColor))
            styles.Add($"color: {threshold.FontColor}");
        return string.Join("; ", styles);
    }

    private bool HasThreshold(string column, object? value)
    {
        return FindMatchingThreshold(column, value) is not null;
    }

    private static decimal? ParseThresholdValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;
        if (decimal.TryParse(value, out var dec)) return dec;
        if (TryParseTimeToSeconds(value, out var secs)) return secs;
        return null;
    }

    private static bool TryParseTimeToSeconds(string? value, out decimal seconds)
    {
        seconds = 0;
        if (string.IsNullOrWhiteSpace(value)) return false;

        // Try parsing as TimeSpan (supports "0:00", "1:30", "10:00", "1:00:00", etc.)
        if (TimeSpan.TryParse(value, out var ts))
        {
            seconds = (decimal)ts.TotalSeconds;
            return true;
        }
        return false;
    }

    private enum ConnectionState { Connecting, Connected, Reconnecting, Failed }

    protected override async Task OnInitializedAsync()
    {
        ApplyConfig();
        await ConnectAsync();
    }

    protected override void OnParametersSet()
    {
        // Re-apply config when parameters change (e.g., after saving config modal)
        ApplyConfig();
    }

    private void ApplyConfig()
    {
        if (Config is not null)
        {
            // Filters
            _filterTeams = Config.AgentGridTeams?.ToHashSet() ?? new HashSet<string>();
            _filterStates = Config.AgentGridStates?.ToHashSet() ?? new HashSet<string>();
            _visibleColumns = Config.AgentGridColumns?.ToHashSet() ?? new HashSet<string> { "agent", "state", "duration", "occupancy", "adherence" };
            _showAlerts = Config.AgentGridShowAlerts;

            // Appearance
            _fontSize = Config.FontSize;
            _backgroundColor = Config.BackgroundColor;
            _fontColor = Config.FontColor;
            _tableBackgroundColor = Config.TableBackgroundColor;

            // Column thresholds
            _columnThresholds = Config.ColumnThresholds ?? new Dictionary<string, List<ColumnThreshold>>();
        }
    }

    private async Task ConnectAsync()
    {
        _connectionState = ConnectionState.Connecting;
        Logger.LogInformation("AgentGridWidget: Starting connection for widget {WidgetId}", WidgetId);

        try
        {
            var settings = await Mediator.Send(new GetTenantSettingsQuery(), _cts.Token);
            Logger.LogInformation("AgentGridWidget: TenantSettings loaded, SignalRConnectionUrl = '{Url}'",
                settings?.SignalRConnectionUrl ?? "(null)");

            var simulatorUrl = settings?.SignalRConnectionUrl ?? "http://localhost:5045";
            var gridId = WidgetId;
            var fullUrl = $"{simulatorUrl}/hubs/agent-grid?gridId={gridId}";

            Logger.LogInformation("AgentGridWidget: Connecting to {Url}", fullUrl);

            _hub = new HubConnectionBuilder()
                .WithUrl(fullUrl)
                .WithAutomaticReconnect(new[] {
                    TimeSpan.Zero,
                    TimeSpan.FromSeconds(2),
                    TimeSpan.FromSeconds(5),
                    TimeSpan.FromSeconds(10),
                    TimeSpan.FromSeconds(30)
                })
                .Build();

            _hub.On<AgentGridUpdate>("AgentGridUpdate", async update =>
            {
                _agents = update.Agents;
                await InvokeAsync(StateHasChanged);
            });

            _hub.Reconnecting += async _ =>
            {
                _connectionState = ConnectionState.Reconnecting;
                await InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += async _ =>
            {
                _connectionState = ConnectionState.Connected;
                await InvokeAsync(StateHasChanged);
            };

            _hub.Closed += async ex =>
            {
                if (ex != null)
                {
                    Logger.LogWarning(ex, "SignalR connection closed with error");
                    _connectionState = ConnectionState.Failed;
                    await InvokeAsync(StateHasChanged);
                }
            };

            await _hub.StartAsync(_cts.Token);
            _connectionState = ConnectionState.Connected;
            Logger.LogInformation("Connected to AgentGrid simulator for widget {WidgetId}", WidgetId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AgentGridWidget: Failed to connect. Error: {Message}", ex.Message);
            _connectionState = ConnectionState.Failed;
        }
    }

    private async Task ReconnectAsync()
    {
        if (_hub != null)
        {
            try { await _hub.DisposeAsync(); } catch { }
            _hub = null;
        }

        _agents.Clear();
        await ConnectAsync();
    }

    private static string FormatDuration(int seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0
            ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}"
            : name.Length >= 2 ? name[..2].ToUpper() : name.ToUpper();
    }

    private string GetStateLabel(AgentState state) => state switch
    {
        AgentState.Ready => L["State_Ready"],
        AgentState.Talking => L["State_Talking"],
        AgentState.Hold => L["State_Hold"],
        AgentState.Acw => L["State_ACW"],
        AgentState.NotReady => L["State_NotReady"],
        AgentState.Outbound => L["State_Outbound"],
        AgentState.LoggedOut => L["State_LoggedOut"],
        _ => state.ToString()
    };

    private static string GetStateBadgeClass(AgentState state) => state switch
    {
        AgentState.Ready => "bg-success",
        AgentState.Talking => "bg-primary",
        AgentState.Hold => "bg-warning text-dark",
        AgentState.Acw => "bg-info text-dark",
        AgentState.NotReady => "bg-secondary",
        AgentState.Outbound => "bg-primary",
        AgentState.LoggedOut => "bg-dark",
        _ => "bg-secondary"
    };

    private static string GetStateColorClass(AgentState state) => state switch
    {
        AgentState.Ready => "avatar-success",
        AgentState.Talking or AgentState.Outbound => "avatar-primary",
        AgentState.Hold => "avatar-warning",
        AgentState.Acw => "avatar-info",
        AgentState.NotReady => "avatar-secondary",
        AgentState.LoggedOut => "avatar-dark",
        _ => "avatar-secondary"
    };

    private string GetRowClass(AgentStatusDto agent)
    {
        if (!_showAlerts) return "";
        if (agent.AlertLevel == AlertLevel.Critical)
            return "table-danger";
        if (agent.AlertLevel == AlertLevel.Warning)
            return "table-warning";
        return "";
    }

    private static string GetMetricClass(decimal value, decimal good, decimal warn)
    {
        if (value >= good) return "text-success";
        if (value >= warn) return "text-warning";
        return "text-danger";
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_hub != null)
        {
            try
            {
                await _hub.DisposeAsync();
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Error disposing hub connection");
            }
        }
        _cts.Dispose();
    }
}

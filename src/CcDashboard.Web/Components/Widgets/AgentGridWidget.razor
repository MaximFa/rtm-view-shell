        if (!string.IsNullOrEmpty(fg))
            styles.Add($"color: {fg}");
        if (!string.IsNullOrEmpty(_fontSize))
        {
            styles.Add($"font-size: {ResolveFontSizePx(_fontSize)}");
        }
        return string.Join("; ", styles);
    }


@using CcDashboard.Contracts.DTOs.Widgets
@using CcDashboard.Application.Queries.TenantSettings
@using Microsoft.AspNetCore.SignalR.Client
@using MediatR
@using static CcDashboard.Web.Components.Dashboard.ScreenEditorPage
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable

@inject IStringLocalizer<CcDashboard.Web.Resources.SharedResources> L

@* Agent Grid Widget - connects to external SignalR simulator for real-time data *@

<div class="agent-grid-widget" style="@GetWidgetStyle()" @onkeydown="HandleKeyDown" tabindex="0">
    @* Reconnecting banner - P0 *@
    @if (_connectionState == ConnectionState.Reconnecting)
    {
        <div class="alert alert-warning alert-sm d-flex align-items-center gap-2 py-1 px-2 mb-0 rounded-0"
             role="alert" style="position: sticky; top: 0; z-index: 1040;">
            <div class="spinner-border spinner-border-sm" aria-hidden="true"></div>
            <span class="small">@L["Widget_Reconnecting"]</span>
            <button class="btn btn-sm btn-link p-0 ms-auto" @onclick="ReconnectAsync" aria-label="@L["Widget_ReloadPage"]">
                @L["Widget_ReloadPage"]
            </button>
        </div>
    }

    @if (GridId == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
            <i class="bi bi-gear fs-3 mb-2 opacity-50" aria-hidden="true"></i>
            <span class="small">@L["Widget_SaveConfigFirst"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Connecting)
    {
        <div class="d-flex align-items-center justify-content-center h-100 text-muted" aria-busy="true" aria-live="polite">
            <div class="spinner-border spinner-border-sm me-2" aria-hidden="true"></div>
            <span>@L["Widget_Connecting"]</span>
        </div>
    }
    else if (_connectionState == ConnectionState.Failed)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" role="alert">
            <i class="bi bi-wifi-off fs-3 mb-2 text-warning" aria-hidden="true"></i>
            <span class="small">@L["Widget_ConnectionFailed"]</span>
            <button class="btn btn-sm btn-link mt-2" @onclick="ReconnectAsync" aria-label="@L["Widget_Retry"]">
                @L["Widget_Retry"]
            </button>
        </div>
    }
    else if (_rows.Count == 0)
    {
        <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted" role="status">
            <i class="bi bi-people fs-3 mb-2 opacity-50" aria-hidden="true"></i>
            <span class="small">@L["Widget_NoAgents"]</span>
        </div>
    }
    else
    {
        var filteredRows = GetFilteredRows();
        var pagedRows = GetPagedRows(filteredRows);
        var activeFilterCount = GetActiveFilterCount();

        <div class="agent-grid-body" style="@GetTableStyle()">
            @* Active filters toolbar - P1 *@
            @if (activeFilterCount > 0)
            {
                <div class="d-flex align-items-center gap-2 px-2 py-1 border-bottom small" style="@GetTableStyle(); border-color: currentColor !important; opacity: 0.9;">
                    <span class="badge rounded-pill" style="@GetBadgeInvertStyle()">@activeFilterCount</span>
                    <span>@L["Widget_ActiveFilters"]</span>
                    <button class="btn btn-link btn-sm p-0 ms-auto"
                            style="@GetFontColorStyle() text-decoration: none;"
                            @onclick="ClearAllFilters"
                            aria-label="@L["Widget_ClearAllFilters"]">
                        @L["Widget_ClearAllFilters"]
                    </button>
                </div>
            }

            <table class="table table-sm table-hover mb-0 small agent-grid-table" style="@GetTableStyle()">
                <thead class="agent-grid-thead" style="@GetTheadStyle()">
                    <tr style="@GetRowStyle()">
                        @foreach (var colDef in _columnDefs)
                        {
                            var hasFilter = HasActiveFilter(colDef.MetricId);
                            var isFilterOpen = _activeFilterColumn == colDef.MetricId;
                            <th scope="col" class="text-start position-relative" style="@GetTheadCellStyle()">
                                <span style="cursor: pointer;"
                                      @onclick="() => ToggleSort(colDef.MetricId)"
                                      role="button"
                                      aria-label="@L["Widget_SortBy", colDef.Name]">
                                    @colDef.Name
                                    @if (_sortColumn == colDef.MetricId)
                                    {
                                        <i class="bi @(_sortAscending ? "bi-caret-up-fill" : "bi-caret-down-fill") ms-1"
                                           aria-label="@(_sortAscending ? L["Widget_SortedAsc"] : L["Widget_SortedDesc"])"></i>
                                    }
                                </span>
                                <button class="btn btn-link btn-sm p-0 ms-1"
                                        style="@GetFilterButtonStyle(hasFilter)"
                                        @onclick="() => ToggleFilterDropdown(colDef.MetricId)"
                                        @onclick:stopPropagation="true"
                                        aria-label="@L["Widget_FilterColumn", colDef.Name]"
                                        aria-expanded="@isFilterOpen"
                                        title="@L["Widget_Filter"]">
                                    <i class="bi @(hasFilter ? "bi-funnel-fill" : "bi-funnel")" aria-hidden="true"></i>
                                </button>
                                @if (isFilterOpen)
                                {
                                    @RenderFilterDropdown(colDef)
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody style="@GetTableStyle()" @onclick="CloseFilterDropdown">
                    @if (pagedRows.Count == 0)
                    {
                        <tr>
                            <td colspan="@_columnDefs.Count" class="text-center py-4" role="status">
                                <div class="d-flex flex-column align-items-center text-muted">
                                    <i class="bi bi-funnel fs-4 mb-2 opacity-50" aria-hidden="true"></i>
                                    <span class="small mb-2">@L["Widget_NoMatchingAgents"]</span>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="ClearAllFilters">
                                        @L["Widget_ClearFilters"]
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in pagedRows)
                        {
                            <tr class="agent-grid-row" style="@GetRowStyle()">
                                @{ var isFirstCol = true; }
                                @foreach (var colDef in _columnDefs)
                                {
                                    var cellValue = GetMetricValue(row.Metrics, colDef.MetricId);
                                    var useMono = IsNumericColumn(colDef.MetricId);
                                    var isAgentCol = isFirstCol && (_showAvatar || _showScore);
                                    var (thresholdBg, thresholdFg) = GetThresholdStyle(colDef.MetricId, cellValue);
                                    var hasThreshold = !string.IsNullOrEmpty(thresholdBg) || !string.IsNullOrEmpty(thresholdFg);

                                    <td class="text-start @(useMono ? "font-monospace" : "")">
                                        @if (isAgentCol)
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                @if (_showAvatar)
                                                {
                                                    <div class="agent-avatar" style="background-color: @_avatarBgColor; color: @_avatarFontColor;" title="@cellValue">
                                                        @GetInitials(cellValue)
                                                    </div>
                                                }
                                                <div>
                                                    <div>@cellValue</div>
                                                    @if (_showScore && _scoreFormula.Count > 0)
                                                    {
                                                        var score = CalculateScore(row.Metrics);
                                                        <div class="agent-score" style="color: @_scoreStarColor;">
                                                            @for (int i = 0; i < 5; i++)
                                                            {
                                                                <i class="bi @(i < score ? "bi-star-fill" : "bi-star") small"></i>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        else if (hasThreshold)
                                        {
                                            <span class="threshold-badge" style="@GetBadgeStyle(thresholdBg, thresholdFg)">@cellValue</span>
                                        }
                                        else
                                        {
                                            @cellValue
                                        }
                                    </td>
                                    isFirstCol = false;
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* Footer with pagination and connection status - P1 *@
        <div class="agent-grid-footer d-flex align-items-center justify-content-between px-2 py-1 border-top small">
            @* Live indicator *@
            <div class="d-flex align-items-center gap-1" aria-label="@L["Widget_LiveDataUpdating"]">
                <span class="live-dot @(_connectionState == ConnectionState.Connected ? "connected" : "disconnected")"
                      aria-hidden="true"></span>
                <span class="text-muted small">
                    @if (_connectionState == ConnectionState.Connected)
                    {
                        @L["Widget_Live"]
                    }
                    else
                    {
                        @L["Widget_Disconnected"]
                    }
                </span>
            </div>

            @if (_showPagination)
            {
                @* Pagination *@
                <div class="d-flex align-items-center gap-2">
                    @if (TotalPages > 1)
                    {
                        <button class="btn btn-sm btn-link p-0"
                                disabled="@(_currentPage <= 1)"
                                @onclick="PreviousPage"
                                aria-label="@L["Widget_PreviousPage"]">
                            <i class="bi bi-chevron-left" aria-hidden="true"></i>
                        </button>
                        <span class="text-muted" aria-live="polite">@_currentPage / @TotalPages</span>
                        <button class="btn btn-sm btn-link p-0"
                                disabled="@(_currentPage >= TotalPages)"
                                @onclick="NextPage"
                                aria-label="@L["Widget_NextPage"]">
                            <i class="bi bi-chevron-right" aria-hidden="true"></i>
                        </button>
                    }
                </div>

                @* Page size + Row count *@
                <div class="d-flex align-items-center gap-1">
                    <input type="number" class="form-control form-control-sm page-size-input"
                           style="width: 50px; background: transparent; border: 1px solid currentColor; color: inherit; text-align: center; @GetFontColorStyle()"
                           min="1" max="500"
                           value="@_pageSize"
                           @onchange="OnPageSizeInputChanged"
                           title="@L["Widget_RowsPerPage"]" />
                    <span style="@GetFontColorStyle()">/ @filteredRows.Count</span>
                </div>
            }
        </div>
    }

</div>

@inject IJSRuntime JS

@code {
    [Parameter] public WidgetConfig? Config { get; set; }
    [Parameter] public int GridId { get; set; }
    [Parameter] public bool DarkMode { get; set; }

    // Dark mode colors (from Config, with sensible defaults)
    private string _darkBackgroundColor = "#333333";
    private string _darkFontColor = "#FFFFFF";
    private string _darkTableBackgroundColor = "#333333";

    // Effective colors (respecting dark mode)
    private string EffectiveBackgroundColor => DarkMode ? _darkBackgroundColor : (_backgroundColor ?? "");
    private string EffectiveFontColor => DarkMode ? _darkFontColor : (_fontColor ?? "");
    private string EffectiveTableBackgroundColor => DarkMode ? _darkTableBackgroundColor : (_tableBackgroundColor ?? "");

    [Inject] private ILogger<AgentGridWidget> Logger { get; set; } = null!;
    [Inject] private IMediator Mediator { get; set; } = null!;

    private HubConnection? _hub;
    private List<AgentRowData> _rows = new();
    private ConnectionState _connectionState = ConnectionState.Connecting;
    private CancellationTokenSource _cts = new();

    // Configuration
    private List<AgentGridColumnDef> _columnDefs = new();
    private int _pageSize = 20;
    private int _currentPage = 1;
    private string? _sortColumn;
    private bool _sortAscending = true;

    // Appearance
    private string? _fontSize;
    private string? _backgroundColor;
    private string? _fontColor;
    private string? _tableBackgroundColor;

    // Avatar and Score
    private bool _showAvatar;
    private bool _showPagination = true;
    private string _avatarBgColor = "#1e3461";
    private string _avatarFontColor = "#FFFFFF";
    private bool _showScore;
    private string _scoreStarColor = "#ffc107";
    private List<ScoreFormulaRule> _scoreFormula = new();

    // Column thresholds (case-insensitive keys)
    private Dictionary<string, List<ColumnThreshold>> _columnThresholds = new(StringComparer.OrdinalIgnoreCase);

    private record ScoreFormulaRule(string MetricId, string Operator, string Value);
    private record ColumnThreshold(
        string? MatchType,  // "numeric" or "text", nullable for backward compatibility
        string? From,
        string? To,
        string? TextMatch,
        string? TextTo,
        string? TextMatchType,  // nullable for backward compatibility
        string? BackgroundColor,
        string? FontColor
    );

    // Column filters
    private string? _activeFilterColumn;
    private string? _listDropdownOpen;
    private Dictionary<string, ColumnFilter> _columnFilters = new();

    private class ColumnFilter
    {
        public string Mode { get; set; } = ""; // "value" or "list"
        public string Operator { get; set; } = "contains"; // contains, equal, startsWith, endsWith, less, greater, lessOrEqual, greaterOrEqual
        public string TextValue { get; set; } = "";
        public HashSet<string> SelectedValues { get; set; } = new();
    }

    // Persisted widget state (localStorage)
    private class WidgetState
    {
        public int PageSize { get; set; } = 20;
        public Dictionary<string, ColumnFilterState> Filters { get; set; } = new();
    }

    private class ColumnFilterState
    {
        public string Mode { get; set; } = "";
        public string Operator { get; set; } = "contains";
        public string TextValue { get; set; } = "";
        public List<string> SelectedValues { get; set; } = new();
    }

    private class AgentRowData
    {
        public string RowId { get; set; } = "";
        public Dictionary<string, string> Metrics { get; set; } = new();
    }

    private enum ConnectionState { Connecting, Connected, Reconnecting, Failed }

    private int FilteredRowCount => GetFilteredRows().Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRowCount / (double)_pageSize));

    private bool _stateLoaded;

    protected override async Task OnInitializedAsync()
    {
        ApplyConfig();
        await ConnectAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && GridId != 0 && !_stateLoaded)
        {
            _stateLoaded = true;
            await LoadWidgetStateAsync();
            StateHasChanged();
        }
    }

    private int _previousGridId;

    protected override async Task OnParametersSetAsync()
    {
        ApplyConfig();

        if (GridId != 0 && _previousGridId == 0 && _hub is null)
        {
            _previousGridId = GridId;
            await ConnectAsync();
        }
        _previousGridId = GridId;
    }

    private void ApplyConfig()
    {
        if (Config is not null)
        {
            _fontSize = Config.FontSize;
            _backgroundColor = Config.BackgroundColor;
            _fontColor = Config.FontColor;
            _tableBackgroundColor = Config.TableBackgroundColor;
            // Dark mode colors from config
            _darkBackgroundColor = Config.DarkBackgroundColor ?? "#333333";
            _darkFontColor = Config.DarkFontColor ?? "#FFFFFF";
            _darkTableBackgroundColor = Config.DarkTableBackgroundColor ?? "#333333";
            _columnDefs = Config.AgentGridColumnDefs?.ToList() ?? new();

            // Avatar, Score, Pagination
            _showAvatar = Config.ShowAvatar;
            _showPagination = Config.ShowPagination;
            _avatarBgColor = Config.AvatarBgColor ?? "#1e3461";
            _avatarFontColor = Config.AvatarFontColor ?? "#FFFFFF";
            _showScore = Config.ShowScore;
            _scoreStarColor = Config.ScoreStarColor ?? "#ffc107";
            _scoreFormula = Config.ScoreFormula?
                .Select(r => new ScoreFormulaRule(r.MetricId, r.Operator, r.Value))
                .ToList() ?? new();

            // Column thresholds - exact MetricId keys
            _columnThresholds = Config.ColumnThresholds?
                .ToDictionary(
                    kvp => kvp.Key,
                    kvp => kvp.Value.Select(t => new ColumnThreshold(
                        t.MatchType,
                        t.From,
                        t.To,
                        t.TextMatch,
                        t.TextTo,
                        t.TextMatchType,
                        t.BackgroundColor,
                        t.FontColor
                    )).ToList()
                ) ?? new();

            // Debug logging
            Logger.LogInformation("AgentGridWidget: Loaded {Count} threshold columns: {Keys}",
                _columnThresholds.Count,
                string.Join(", ", _columnThresholds.Select(kv => $"{kv.Key}({kv.Value.Count})")));

            // Detailed threshold logging
            foreach (var (colKey, rules) in _columnThresholds)
            {
                foreach (var r in rules)
                {
                    Logger.LogInformation("  Threshold: col={Col}, type={Type}, from={From}, to={To}, bg={Bg}",
                        colKey, r.MatchType, r.From, r.To, r.BackgroundColor);
                }
            }
        }
    }

    private async Task ConnectAsync()
    {
        if (GridId == 0)
        {
            Logger.LogWarning("AgentGridWidget: GridId is 0, skipping connection");
            return;
        }

        _connectionState = ConnectionState.Connecting;
        Logger.LogInformation("AgentGridWidget: Starting connection for GridId {GridId}", GridId);

        await Task.Delay(Random.Shared.Next(100, 500), _cts.Token);

        try
        {
            var settings = await Mediator.Send(new GetTenantSettingsQuery(), _cts.Token);
            var simulatorUrl = settings?.SignalRConnectionUrl ?? "http://localhost:5045";
            var fullUrl = $"{simulatorUrl}/hubs/agent-grid?gridId={GridId}";

            Logger.LogInformation("AgentGridWidget: Connecting to {Url}", fullUrl);

            _hub = new HubConnectionBuilder()
                .WithUrl(fullUrl)
                .WithAutomaticReconnect(new[] {
                    TimeSpan.Zero,
                    TimeSpan.FromSeconds(2),
                    TimeSpan.FromSeconds(5),
                    TimeSpan.FromSeconds(10),
                    TimeSpan.FromSeconds(30)
                })
                .Build();

            _hub.On<GridUpdate>("AgentGridUpdate", async update =>
            {
                var isFirstData = _rows.Count == 0;
                _rows = update.Rows.Select(r => new AgentRowData
                {
                    RowId = r.RowId,
                    Metrics = r.Metrics
                }).ToList();

                // Detect column data types on first data received
                if (isFirstData)
                {
                    DetectColumnDataTypes();
                }

                await InvokeAsync(StateHasChanged);
            });

            _hub.Reconnecting += async _ =>
            {
                _connectionState = ConnectionState.Reconnecting;
                await InvokeAsync(StateHasChanged);
            };

            _hub.Reconnected += async _ =>
            {
                _connectionState = ConnectionState.Connected;
                await InvokeAsync(StateHasChanged);
            };

            _hub.Closed += async ex =>
            {
                if (ex != null)
                {
                    Logger.LogWarning(ex, "SignalR connection closed with error");
                    _connectionState = ConnectionState.Failed;
                    await InvokeAsync(StateHasChanged);
                }
            };

            await _hub.StartAsync(_cts.Token);
            _connectionState = ConnectionState.Connected;

            Logger.LogInformation("Connected to AgentGrid simulator for GridId {GridId}", GridId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "AgentGridWidget: Failed to connect. Error: {Message}", ex.Message);
            _connectionState = ConnectionState.Failed;
        }
    }

    private async Task ReconnectAsync()
    {
        if (_hub != null)
        {
            try { await _hub.DisposeAsync(); } catch { }
            _hub = null;
        }
        _rows.Clear();
        await ConnectAsync();
    }

    private List<AgentRowData> GetFilteredRows()
    {
        var result = _rows.AsEnumerable();

        foreach (var (metricId, filter) in _columnFilters)
        {
            if (filter.Mode == "") continue;

            if (filter.Mode == "list")
            {
                result = result.Where(r => filter.SelectedValues.Contains(GetMetricValue(r.Metrics, metricId)));
            }
            else if (filter.Mode == "value" && !string.IsNullOrEmpty(filter.TextValue))
            {
                result = result.Where(r => MatchesValueFilter(GetMetricValue(r.Metrics, metricId), filter));
            }
        }

        return result.ToList();
    }

    private List<AgentRowData> GetPagedRows(List<AgentRowData> filtered)
    {
        var sorted = filtered.AsEnumerable();

        if (!string.IsNullOrEmpty(_sortColumn))
        {
            if (IsNumericColumn(_sortColumn))
            {
                sorted = _sortAscending
                    ? sorted.OrderBy(r => ParseNumericValue(GetMetricValue(r.Metrics, _sortColumn)))
                    : sorted.OrderByDescending(r => ParseNumericValue(GetMetricValue(r.Metrics, _sortColumn)));
            }
            else
            {
                sorted = _sortAscending
                    ? sorted.OrderBy(r => GetMetricValue(r.Metrics, _sortColumn))
                    : sorted.OrderByDescending(r => GetMetricValue(r.Metrics, _sortColumn));
            }
        }

        return sorted
            .Skip((_currentPage - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private static bool MatchesValueFilter(string value, ColumnFilter filter)
    {
        if (string.IsNullOrEmpty(filter.TextValue)) return true;

        // Try numeric/time comparison
        var numValue = ParseNumericValue(value);
        var numFilter = ParseNumericValue(filter.TextValue);

        if (numValue.HasValue && numFilter.HasValue)
        {
            return filter.Operator switch
            {
                "less" => numValue < numFilter,
                "lessOrEqual" => numValue <= numFilter,
                "greater" => numValue > numFilter,
                "greaterOrEqual" => numValue >= numFilter,
                "equal" => Math.Abs(numValue.Value - numFilter.Value) < 0.001,
                _ => true
            };
        }

        // Text comparison
        return filter.Operator switch
        {
            "equal" => value.Equals(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "contains" => value.Contains(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "startsWith" => value.StartsWith(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            "endsWith" => value.EndsWith(filter.TextValue, StringComparison.OrdinalIgnoreCase),
            _ => value.Contains(filter.TextValue, StringComparison.OrdinalIgnoreCase)
        };
    }

    private static double? ParseNumericValue(string? value)
    {
        if (string.IsNullOrEmpty(value) || value == "-") return null;

        // Remove % and try parse
        if (double.TryParse(value.Replace("%", "").Trim(), out var result))
            return result;

        // Try time format MM:SS or HH:MM:SS -> seconds
        var parts = value.Split(':');
        if (parts.Length == 2 && int.TryParse(parts[0], out var mm) && int.TryParse(parts[1], out var ss))
            return mm * 60 + ss;
        if (parts.Length == 3 && int.TryParse(parts[0], out var hh) && int.TryParse(parts[1], out var m) && int.TryParse(parts[2], out var s))
            return hh * 3600 + m * 60 + s;

        return null;
    }

    private bool IsNumericColumn(string metricId)
    {
        // First check if we have detected DataType in column definition
        var colDef = _columnDefs.FirstOrDefault(c => c.MetricId == metricId);
        if (colDef != null && !string.IsNullOrEmpty(colDef.DataType))
        {
            return colDef.DataType == "number" || colDef.DataType == "time";
        }
        // Fallback to pattern matching
        var id = metricId.ToLowerInvariant();
        return id.Contains("duration") || id.Contains("occupancy") || id.Contains("adherence") ||
               id.Contains("calls") || id.Contains("aht") || id.Contains("time") || id.Contains("percent") ||
               id.Contains("total") || id.Contains("avg") || id.Contains("count");
    }

    private static string DetectDataType(string? value)
    {
        if (string.IsNullOrEmpty(value) || value == "-") return "text";

        // Check for time format: MM:SS or HH:MM:SS
        var parts = value.Split(':');
        if (parts.Length == 2 || parts.Length == 3)
        {
            if (parts.All(p => int.TryParse(p, out _)))
                return "time";
        }

        // Check for number (including percentages)
        var numStr = value.Replace("%", "").Trim();
        if (double.TryParse(numStr, out _))
            return "number";

        // Otherwise it's text
        return "text";
    }

    private void DetectColumnDataTypes()
    {
        if (_rows.Count == 0 || _columnDefs.Count == 0) return;

        var firstRow = _rows[0];
        var typesChanged = false;

        foreach (var colDef in _columnDefs)
        {
            if (string.IsNullOrEmpty(colDef.MetricId)) continue;

            var sampleValue = GetMetricValue(firstRow.Metrics, colDef.MetricId);
            var detectedType = DetectDataType(sampleValue);

            if (colDef.DataType != detectedType)
            {
                colDef.DataType = detectedType;
                typesChanged = true;
            }
        }

        if (typesChanged)
        {
            Logger.LogInformation("Detected column types: {Types}",
                string.Join(", ", _columnDefs.Select(c => $"{c.Name}={c.DataType}")));
        }
    }

    private bool HasActiveFilter(string metricId)
    {
        return _columnFilters.TryGetValue(metricId, out var filter) && filter.Mode != "";
    }

    private int GetActiveFilterCount()
    {
        return _columnFilters.Count(kv => kv.Value.Mode != "");
    }

    private async Task ClearAllFilters()
    {
        _columnFilters.Clear();
        _activeFilterColumn = null;
        _listDropdownOpen = null;
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private void CloseFilterDropdown()
    {
        _activeFilterColumn = null;
        _listDropdownOpen = null;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseFilterDropdown();
        }
    }

    private bool IsStatusColumn(string metricId)
    {
        var id = metricId.ToLowerInvariant();
        return id.Contains("status") || id.Contains("state") || id.Contains("interaction_state");
    }

    private string GetStatusBadgeClass(string status)
    {
        // Enterprise-grade muted badges: light background + dark text
        var s = status.ToLowerInvariant();
        return s switch
        {
            "available" or "ready" or "active" => "badge-status badge-available",
            "on call" or "busy" or "talking" => "badge-status badge-oncall",
            "break" or "pause" or "lunch" => "badge-status badge-break",
            "wrap up" or "paperwork" or "acw" => "badge-status badge-acw",
            "unavailable" or "offline" or "logged out" => "badge-status badge-unavailable",
            "meeting" or "training" => "badge-status badge-meeting",
            _ => "badge-status badge-default"
        };
    }

    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        return parts[0].Length >= 2 ? parts[0][..2].ToUpperInvariant() : parts[0].ToUpperInvariant();
    }

    private string GetAvatarClass(Dictionary<string, string> metrics)
    {
        // Color based on status if available
        foreach (var (key, value) in metrics)
        {
            if (IsStatusColumn(key))
            {
                var s = value.ToLowerInvariant();
                return s switch
                {
                    "available" or "ready" or "active" => "avatar-success",
                    "on call" or "busy" or "talking" => "avatar-primary",
                    "break" or "pause" or "lunch" => "avatar-warning",
                    "wrap up" or "paperwork" or "acw" => "avatar-info",
                    "meeting" or "training" => "avatar-meeting",
                    _ => "avatar-secondary"
                };
            }
        }
        return "avatar-secondary";
    }


    private (string? bg, string? fg) GetThresholdStyle(string metricId, string cellValue)
    {
        // Exact MetricId match only
        if (!_columnThresholds.TryGetValue(metricId, out var thresholds) || thresholds.Count == 0)
            return (null, null);

        foreach (var t in thresholds)
        {
            bool matches;
            // Auto-detect numeric matching: if From/To looks like time (MM:SS) or number, use numeric comparison
            var isNumericThreshold = t.MatchType == "numeric" || IsNumericThresholdValue(t.From) || IsNumericThresholdValue(t.To);

            if (isNumericThreshold)
            {
                var numValue = ParseNumericValue(cellValue);
                var fromVal = ParseNumericValue(t.From);
                var toVal = ParseNumericValue(t.To);

                matches = numValue.HasValue;
                if (matches && fromVal.HasValue && numValue < fromVal) matches = false;
                if (matches && toVal.HasValue && numValue > toVal) matches = false;
            }
            else // text match
            {
                var matchValue = t.TextMatch ?? "";
                matches = t.TextMatchType switch
                {
                    "equal" => cellValue.Equals(matchValue, StringComparison.OrdinalIgnoreCase),
                    "contains" => cellValue.Contains(matchValue, StringComparison.OrdinalIgnoreCase),
                    "startswith" => cellValue.StartsWith(matchValue, StringComparison.OrdinalIgnoreCase),
                    "endswith" => cellValue.EndsWith(matchValue, StringComparison.OrdinalIgnoreCase),
                    _ => cellValue.Equals(matchValue, StringComparison.OrdinalIgnoreCase)
                };
            }

            if (matches)
            {
                Logger.LogDebug("Threshold matched: col={Col}, value='{Value}', bg={Bg}, fg={Fg}",
                    metricId, cellValue, t.BackgroundColor, t.FontColor);
                return (t.BackgroundColor, t.FontColor);
            }
        }

        return (null, null);
    }

    private static bool IsNumericThresholdValue(string? value)
    {
        if (string.IsNullOrEmpty(value)) return false;
        // Time format: MM:SS or HH:MM:SS
        if (value.Contains(':')) return true;
        // Number format
        return double.TryParse(value.Replace("%", "").Trim(), out _);
    }

    private int CalculateScore(Dictionary<string, string> metrics)
    {
        if (_scoreFormula.Count == 0) return 0;

        var matchedRules = 0;
        foreach (var rule in _scoreFormula)
        {
            if (string.IsNullOrEmpty(rule.MetricId)) continue;

            var metricValue = GetMetricValue(metrics, rule.MetricId);
            var numValue = ParseNumericValue(metricValue);
            var threshold = ParseNumericValue(rule.Value);

            if (numValue.HasValue && threshold.HasValue)
            {
                var matches = rule.Operator switch
                {
                    ">=" => numValue >= threshold,
                    "<=" => numValue <= threshold,
                    ">" => numValue > threshold,
                    "<" => numValue < threshold,
                    "==" => Math.Abs(numValue.Value - threshold.Value) < 0.001,
                    "!=" => Math.Abs(numValue.Value - threshold.Value) >= 0.001,
                    _ => false
                };
                if (matches) matchedRules++;
            }
        }

        // Calculate stars: percentage of matched rules (5 stars = 100%)
        var percentage = (double)matchedRules / _scoreFormula.Count;
        return (int)Math.Round(percentage * 5);
    }

    private void ToggleFilterDropdown(string metricId)
    {
        if (_activeFilterColumn == metricId)
        {
            _activeFilterColumn = null;
            _listDropdownOpen = null;
        }
        else
        {
            _activeFilterColumn = metricId;
            _listDropdownOpen = null;
        }
    }

    private ColumnFilter GetOrCreateFilter(string metricId)
    {
        if (!_columnFilters.TryGetValue(metricId, out var filter))
        {
            filter = new ColumnFilter();
            _columnFilters[metricId] = filter;
        }
        return filter;
    }

    private async Task ClearFilter(string metricId)
    {
        if (_columnFilters.ContainsKey(metricId))
        {
            _columnFilters[metricId] = new ColumnFilter();
        }
        _activeFilterColumn = null;
        _listDropdownOpen = null;
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private void UpdateFilterOperator(string metricId, ChangeEventArgs e)
    {
        var filter = GetOrCreateFilter(metricId);
        filter.Operator = e.Value?.ToString() ?? "contains";
    }

    private async Task ApplyValueFilter(string metricId)
    {
        var filter = GetOrCreateFilter(metricId);
        if (!string.IsNullOrEmpty(filter.TextValue))
        {
            filter.Mode = "value";
            filter.SelectedValues.Clear(); // Clear List when Value is applied
        }
        _activeFilterColumn = null;
        _listDropdownOpen = null;
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private async Task ToggleListValue(string metricId, string value)
    {
        var filter = GetOrCreateFilter(metricId);

        // Clear Value when using List
        filter.TextValue = "";

        if (filter.SelectedValues.Contains(value))
            filter.SelectedValues.Remove(value);
        else
            filter.SelectedValues.Add(value);

        filter.Mode = filter.SelectedValues.Count > 0 ? "list" : "";
        _currentPage = 1;
        await SaveWidgetStateAsync();
    }

    private void OnValueInput(string metricId)
    {
        var filter = GetOrCreateFilter(metricId);
        // Clear List selection when typing in Value field
        if (!string.IsNullOrEmpty(filter.TextValue))
        {
            filter.SelectedValues.Clear();
            filter.Mode = ""; // Reset mode, will be set on Apply
            _listDropdownOpen = null;
        }
    }

    private void ToggleListDropdown(string metricId)
    {
        _listDropdownOpen = _listDropdownOpen == metricId ? null : metricId;
    }

    private static string GetListButtonLabel(ColumnFilter filter)
    {
        if (filter.SelectedValues.Count == 0)
            return "Select values...";
        if (filter.SelectedValues.Count == 1)
            return filter.SelectedValues.First();
        return $"{filter.SelectedValues.Count} selected";
    }

    private List<string> GetDistinctValues(string metricId)
    {
        return _rows
            .Select(r => GetMetricValue(r.Metrics, metricId))
            .Where(v => v != "-")
            .Distinct()
            .OrderBy(v => v)
            .ToList();
    }

    private RenderFragment RenderFilterDropdown(AgentGridColumnDef colDef) => __builder =>
    {
        var filter = GetOrCreateFilter(colDef.MetricId);
        var isNumeric = IsNumericColumn(colDef.MetricId);
        var distinctValues = isNumeric ? new List<string>() : GetDistinctValues(colDef.MetricId);

        <div class="filter-dropdown position-absolute rounded shadow-lg p-2"
             style="top: 100%; inset-inline-start: 0; min-width: 200px; z-index: 1050; @GetFilterDropdownStyle()"
             @onclick:stopPropagation="true">

            <!-- Header with label and icons -->
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small opacity-75">Value</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-link btn-sm p-0" style="color: var(--clr-success, #198754);" title="Apply" @onclick="() => ApplyValueFilter(colDef.MetricId)">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button class="btn btn-link btn-sm p-0" style="color: var(--clr-danger, #dc3545);" title="Clear" @onclick="() => ClearFilter(colDef.MetricId)">
                        <i class="bi bi-trash"></i>
                    </button>
                    <button class="btn btn-link btn-sm p-0" style="@GetFontColorStyle()" title="Close" @onclick="CloseFilterDropdown">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <!-- VALUE section -->
            <div class="mb-1">
                <select class="form-select form-select-sm mb-1"
                        style="@GetFilterInputStyle()"
                        value="@filter.Operator"
                        @onchange="e => UpdateFilterOperator(colDef.MetricId, e)">
                    @if (isNumeric)
                    {
                        <option value="less">Less than</option>
                        <option value="lessOrEqual">Less or equal</option>
                        <option value="greater">Greater than</option>
                        <option value="greaterOrEqual">Greater or equal</option>
                        <option value="equal">Equal</option>
                    }
                    else
                    {
                        <option value="contains">Contains</option>
                        <option value="equal">Equal</option>
                        <option value="startsWith">Starts with</option>
                        <option value="endsWith">Ends with</option>
                    }
                </select>
                <input type="text" class="form-control form-control-sm"
                       style="@GetFilterInputStyle()"
                       @bind="filter.TextValue"
                       @bind:event="oninput"
                       @bind:after="() => OnValueInput(colDef.MetricId)"
                       placeholder="@(isNumeric ? "e.g. 30:00" : "Filter value...")" />
            </div>

            @if (!isNumeric && distinctValues.Count > 0)
            {
                <!-- LIST section as dropdown -->
                <div class="border-top pt-3 mt-3" style="border-color: currentColor; opacity: 0.3;">
                </div>
                <div style="opacity: 1;">
                    <div class="small mb-2 opacity-75">List</div>
                    <div class="position-relative">
                        <button class="btn btn-sm w-100 d-flex justify-content-between align-items-center"
                                style="@GetFilterInputStyle()"
                                @onclick="() => ToggleListDropdown(colDef.MetricId)"
                                @onclick:stopPropagation="true">
                            <span>@GetListButtonLabel(filter)</span>
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        @if (_listDropdownOpen == colDef.MetricId)
                        {
                            <div class="position-absolute w-100 rounded shadow-sm mt-1"
                                 style="@GetFilterDropdownStyle() z-index: 1060; max-height: 180px; overflow-y: auto;">
                                @foreach (var val in distinctValues)
                                {
                                    var isChecked = filter.SelectedValues.Contains(val);
                                    <div class="d-flex align-items-center gap-2 px-2 py-1" style="border-bottom: 1px solid currentColor; opacity: 0.8;">
                                        <input type="checkbox" class="form-check-input m-0" style="flex-shrink: 0;"
                                               checked="@isChecked"
                                               @onchange="() => ToggleListValue(colDef.MetricId, val)" />
                                        <span class="small" style="text-transform: none;">@val</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    };

    private void ToggleSort(string column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
        }
        else
        {
            _sortColumn = column;
            _sortAscending = true;
        }
    }

    private void PreviousPage()
    {
        if (_currentPage > 1) _currentPage--;
    }

    private void NextPage()
    {
        if (_currentPage < TotalPages) _currentPage++;
    }

    private async Task OnPageSizeInputChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size) && size > 0 && size <= 500)
        {
            _pageSize = size;
            _currentPage = 1;
            await SaveWidgetStateAsync();
        }
    }

    private static string GetMetricValue(Dictionary<string, string> metrics, string metricId)
    {

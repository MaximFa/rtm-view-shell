@using Microsoft.Extensions.Localization
@using MediatR
@using CcDashboard.Application.Queries.Configuration
@using CcDashboard.Application.Queries.TenantSettings
@using CcDashboard.Contracts.DTOs.Configuration
@using CcDashboard.Domain.Domain.Reports
@using CcDashboard.Domain.Interfaces
@using Microsoft.Extensions.Logging
@inject IStringLocalizer<SharedResources> L
@inject IMediator Mediator
@inject ILogger<ReportWidgetConfigModal> Logger
@inject ICurrentUserAccessor CurrentUser

@if (IsOpen)
{
    <div class="modal show d-block report-config-modal @(DarkMode ? "dark-mode" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5); z-index: 10001; position: fixed;">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" style="z-index: 10002;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["ReportWidget_Configure"]</h5>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="@L["Common_Close"]"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(_tab == "scope" ? "active" : "")" @onclick='() => _tab = "scope"'>
                                <i class="bi bi-bullseye me-1"></i>@L["WidgetCfg_Scope"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>
                                @L["WidgetCfg_General"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(_tab == "columns" ? "active" : "")" @onclick='() => _tab = "columns"'>
                                @L["WidgetCfg_Columns"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(_tab == "thresholds" ? "active" : "")" @onclick='() => _tab = "thresholds"'>
                                @L["WidgetCfg_Thresholds"]
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(_tab == "appearance" ? "active" : "")" @onclick='() => _tab = "appearance"'>
                                @L["WidgetCfg_Appearance"]
                            </button>
                        </li>
                    </ul>

                    @if (_tab == "scope")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@L["WidgetCfg_SelectBusinessUnits"] <span class="text-danger">*</span></label>
                            @if (_busLoading)
                            {
                                <div class="text-center py-2"><span class="spinner-border spinner-border-sm"></span></div>
                            }
                            else if (_businessUnits.Count == 0)
                            {
                                <div class="alert alert-warning py-2">@L["WidgetCfg_NoBusinessUnitsAvailable"]</div>
                            }
                            else
                            {
                                <!-- Selected BUs as chips -->
                                @if (_selectedBuIds.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @foreach (var buId in _selectedBuIds)
                                        {
                                            var bu = _businessUnits.FirstOrDefault(b => b.BusinessUnitId == buId);
                                            if (bu is not null)
                                            {
                                                <span class="badge bg-primary d-flex align-items-center gap-1">
                                                    @bu.BusinessUnitName
                                                    <button type="button" class="btn-close btn-close-white btn-sm ms-1"
                                                            style="font-size: 0.6rem;"
                                                            @onclick="() => RemoveBu(buId)"
                                                            @onclick:stopPropagation="true"></button>
                                                </span>
                                            }
                                        }
                                    </div>
                                }

                                <!-- Searchable multi-select dropdown -->
                                <div class="searchable-select">
                                    <input type="text" class="form-control" placeholder="@L["Common_Search"]..."
                                           value="@_buSearch"
                                           @oninput="OnBuSearchInput"
                                           @onfocus="OnBuSearchFocus"
                                           @onblur="OnBuSearchBlur" />
                                    @if (_buDropdownOpen)
                                    {
                                        <div class="searchable-dropdown">
                                            @foreach (var bu in FilteredBusinessUnits)
                                            {
                                                var isSelected = _selectedBuIds.Contains(bu.BusinessUnitId);
                                                <div class="dropdown-item d-flex align-items-center @(isSelected ? "active" : "")"
                                                     @onmousedown="() => ToggleBu(bu.BusinessUnitId)"
                                                     @onmousedown:preventDefault="true">
                                                    <i class="bi @(isSelected ? "bi-check-square-fill" : "bi-square") me-2"></i>
                                                    @bu.BusinessUnitName
                                                </div>
                                            }
                                            @if (!FilteredBusinessUnits.Any())
                                            {
                                                <div class="dropdown-item text-muted"><em>@L["Common_NoResults"]</em></div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (IsAgentWidget)
                        {
                            <div class="mb-3">
                                <label class="form-label">@L["WidgetCfg_AgentAxis"]</label>
                                <select class="form-select" @bind="_agentAxis">
                                    <option value="detail">@L["WidgetCfg_AgentAxis_Detail"]</option>
                                    <option value="cumulative">@L["WidgetCfg_AgentAxis_Cumulative"]</option>
                                </select>
                            </div>
                        }
                    }
                    else if (_tab == "general")
                    {
                        <div class="mb-3">
                            <label class="form-label">@L["ReportWidget_Title"]</label>
                            <input type="text" class="form-control" @bind="_title" />
                        </div>
                        @* End-of-shift reports need the shift hours; the DATE comes from the page,
                           like every other report (operator, 2026-11-04). Without the hours the
                           server refuses the query outright, so an unset pair blocks Save here
                           instead of letting the widget render a server error on the dashboard. *@
                        @* AgentPerformance has no period of its own: the period is the page's date
                           range, like every other report. What it does need is the mode - the
                           server refuses the widget without it - and, later, the agent pick. *@
                        @if (IsAgentPerformanceWidget)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    @L["ReportWidget_Mode"] <span class="text-danger">*</span>
                                </label>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" id="mode-summary"
                                           name="agent-performance-mode"
                                           checked="@(_mode == AgentPerformanceModes.Summary)"
                                           @onchange="@(() => _mode = AgentPerformanceModes.Summary)" />
                                    <label class="form-check-label" for="mode-summary">@L["ReportWidget_ModeSummary"]</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" id="mode-bydate"
                                           name="agent-performance-mode"
                                           checked="@(_mode == AgentPerformanceModes.ByDate)"
                                           @onchange="@(() => _mode = AgentPerformanceModes.ByDate)" />
                                    <label class="form-check-label" for="mode-bydate">@L["ReportWidget_ModeByDate"]</label>
                                </div>
                                <div class="small text-muted mt-1">@L["ReportWidget_ModeHint"]</div>
                                @if (ModeProblem is { } modeProblem)
                                {
                                    <div class="alert alert-warning py-1 px-2 small mt-2 mb-0">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@modeProblem
                                    </div>
                                }
                            </div>
                        }
                        @if (IsEndOfShiftWidget)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-semibold">
                                    @L["ReportWidget_ShiftHours"] <span class="text-danger">*</span>
                                </label>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="small text-muted">@L["ReportWidget_ShiftFrom"]</span>
                                    <select class="form-select form-select-sm" style="width: auto;" @bind="_shiftStartHour">
                                        <option value="">@L["Common_NotSelected"]</option>
                                        @for (var h = 0; h <= 23; h++)
                                        {
                                            var hour = h;
                                            <option value="@hour">@HourLabel(hour)</option>
                                        }
                                    </select>
                                    <span class="small text-muted">@L["ReportWidget_ShiftTo"]</span>
                                    <select class="form-select form-select-sm" style="width: auto;" @bind="_shiftEndHour">
                                        <option value="">@L["Common_NotSelected"]</option>
                                        @for (var h = 1; h <= 24; h++)
                                        {
                                            var hour = h;
                                            <option value="@hour">@HourLabel(hour)</option>
                                        }
                                    </select>
                                </div>
                                <div class="small text-muted mt-1">@L["ReportWidget_ShiftHoursHint"]</div>
                                @if (ShiftProblem is { } problem)
                                {
                                    <div class="alert alert-warning py-1 px-2 small mt-2 mb-0">
                                        <i class="bi bi-exclamation-triangle me-1"></i>@problem
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_tab == "columns")
                    {
                        @* Operator, 2026-11-03: the user picks the columns. The offer comes from
                           the SERVER's rule (AllowedColumns = the row record's fields), named in
                           full because two types are called ReportWidgetConfig and the bare name
                           binds to this one, which has no column rules. *@
                        @if (_allowedColumns is null || _allowedColumns.Count == 0)
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle me-2"></i>@L["ReportWidget_ColumnsFixed"]
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small text-muted">@L["ReportWidget_ColumnsHint"]</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetColumns">
                                    @L["ReportWidget_ColumnsReset"]
                                </button>
                            </div>
                            @* An empty choice is refused rather than saved: a report with no
                               columns renders an empty table, which reads as "no data". *@
                            @if (_selectedColumns.Count == 0)
                            {
                                <div class="alert alert-warning py-1 px-2 small">
                                    <i class="bi bi-exclamation-triangle me-1"></i>@L["ReportWidget_ColumnsNoneChosen"]
                                </div>
                            }
                            <div class="report-columns-picker">
                                @foreach (var col in _allowedColumns)
                                {
                                    <div class="form-check" @key="col">
                                        <input class="form-check-input" type="checkbox" id="@($"col-{col}")"
                                               checked="@_selectedColumns.Contains(col)"
                                               @onchange="e => ToggleColumn(col, e)" />
                                        <label class="form-check-label" for="@($"col-{col}")">
                                            @ColumnLabel(col)
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (_tab == "thresholds")
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>@L["ReportWidget_ThresholdsHint"]
                        </div>
                    }
                    else if (_tab == "appearance")
                    {
                        <!-- Typography Section -->
                        <div class="appearance-section mb-4">
                            <h6 class="section-label">@L["WidgetCfg_Typography"]</h6>
                            <div class="row align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1">@L["Widgets_TableFontSize"]</label>
                                    <select class="form-select form-select-sm" @bind="_tableFontSize">
                                        @foreach (var size in _tenantFontSizes)
                                        {
                                            <option value="@size">@size px</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-muted mb-1">@L["Widgets_HeaderFontSize"]</label>
                                    <select class="form-select form-select-sm" @bind="_headerFontSize">
                                        @foreach (var size in _tenantFontSizes)
                                        {
                                            <option value="@size">@size px</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Colors Section -->
                        <div class="appearance-section mb-4">
                            <h6 class="section-label">@L["WidgetCfg_Colors"]</h6>
                            <div class="color-dual-header">
                                <span class="color-setting-label"></span>
                                <span class="color-mode-label">@L["WidgetCfg_LightMode"]</span>
                                <span class="color-mode-label">@L["WidgetCfg_DarkMode"]</span>
                            </div>

                            <!-- Widget Background -->
                                <div class="color-setting-row-dual">
                                    <span class="color-setting-label">@L["WidgetCfg_WidgetBackground"]</span>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(_lightBackground, BackgroundColors)"
                                              style="@GetColorStyle(_lightBackground); cursor: pointer;"
                                              @onclick='() => ToggleColorPalette("lightBg")'
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "lightBg")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in BackgroundColors)
                                                {
                                                    <span class="clr-swatch @(_lightBackground == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { _lightBackground = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(_darkBackground, BackgroundColors)"
                                              style="@GetColorStyle(_darkBackground); cursor: pointer;"
                                              @onclick='() => ToggleColorPalette("darkBg")'
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "darkBg")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in BackgroundColors)
                                                {
                                                    <span class="clr-swatch @(_darkBackground == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { _darkBackground = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Text Color -->
                                <div class="color-setting-row-dual">
                                    <span class="color-setting-label">@L["WidgetCfg_TextColor"]</span>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(_lightTextColor, FontColors)"
                                              style="@GetColorStyle(_lightTextColor); cursor: pointer;"
                                              @onclick='() => ToggleColorPalette("lightText")'
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "lightText")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in FontColors)
                                                {
                                                    <span class="clr-swatch @(_lightTextColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { _lightTextColor = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(_darkTextColor, FontColors)"
                                              style="@GetColorStyle(_darkTextColor); cursor: pointer;"
                                              @onclick='() => ToggleColorPalette("darkText")'
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "darkText")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in FontColors)
                                                {
                                                    <span class="clr-swatch @(_darkTextColor == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { _darkTextColor = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Table Background -->
                                <div class="color-setting-row-dual">
                                    <span class="color-setting-label">@L["WidgetCfg_TableBackground"]</span>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(_lightTableBackground, TableBackgroundColors)"
                                              style="@GetColorStyle(_lightTableBackground); cursor: pointer;"
                                              @onclick='() => ToggleColorPalette("lightTable")'
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "lightTable")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in TableBackgroundColors)
                                                {
                                                    <span class="clr-swatch @(_lightTableBackground == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { _lightTableBackground = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="position-relative">
                                        <span class="clr-swatch clr-swatch-lg"
                                              title="@GetColorName(_darkTableBackground, TableBackgroundColors)"
                                              style="@GetColorStyle(_darkTableBackground); cursor: pointer;"
                                              @onclick='() => ToggleColorPalette("darkTable")'
                                              @onclick:stopPropagation></span>
                                        @if (_openColorPalette == "darkTable")
                                        {
                                            <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1040;"
                                                 @onclick="CloseColorPalette"></div>
                                            <div class="color-palette-dropdown">
                                                @foreach (var color in TableBackgroundColors)
                                                {
                                                    <span class="clr-swatch @(_darkTableBackground == color.Value ? "selected" : "")"
                                                          title="@color.Name"
                                                          style="@GetColorStyle(color.Value)"
                                                          @onclick="() => { _darkTableBackground = color.Value; CloseColorPalette(); }"
                                                          @onclick:stopPropagation></span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="Close">@L["Common_Cancel"]</button>
                    <button type="button" class="btn btn-primary" @onclick="Save" disabled="@(!CanSave)">@L["Common_Save"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ReportWidgetConfig> OnSave { get; set; }
    [Parameter] public ReportWidgetConfig? InitialConfig { get; set; }

    // FEAT-REPORT-* column picker. The offer and the standard set both come from the server's
    // rule, so the picker cannot disagree with what the server will actually return.
    private IReadOnlyList<string>? _allowedColumns;
    private readonly HashSet<string> _selectedColumns = new(StringComparer.Ordinal);
    [Parameter] public ReportWidgetType WidgetType { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public Guid? TenantId { get; set; }

    private string _tab = "scope";
    private string? _title;
    private int _pageSize = 25;
    // Deliberately nullable with no invented default: a shift the operator never chose must not be
    // saved as if they had. An unset pair blocks Save and says so next to the fields.
    private int? _shiftStartHour;
    private int? _shiftEndHour;
    // No invented default here either: "summary" would silently decide for the operator which
    // report they asked for, and the two modes answer different questions.
    private string? _mode;

    // Typography
    private string _tableFontSize = "14";
    private string _headerFontSize = "14";

    // Colors - light mode
    private string _lightBackground = "transparent";
    private string _lightTextColor = "#000000";
    private string _lightTableBackground = "transparent";

    // Colors - dark mode
    private string _darkBackground = "#1e293b";
    private string _darkTextColor = "#e2e8f0";
    private string _darkTableBackground = "transparent";

    // Color palette state
    private string? _openColorPalette;

    // Scope fields (BU-only, no queue mode)
    private List<int> _selectedBuIds = new();
    private string _agentAxis = "detail";

    // BU searchable dropdown state
    private string _buSearch = "";
    private bool _buDropdownOpen;

    // Data sources
    private IReadOnlyList<BusinessUnitDto> _businessUnits = [];
    private bool _busLoading;
    private bool _dataLoaded;

    // Tenant palettes
    private List<string> _tenantBackgroundColors = [];
    private List<string> _tenantFontColors = [];
    private List<string> _tenantFontSizes = [];

    private void ToggleColumn(string column, ChangeEventArgs e)
    {
        // ChangeEventArgs.Value for a checkbox is a bool, but read it as one rather than
        // comparing against true: a null or a string would silently mean "unchecked" otherwise.
        if (e.Value is bool isChecked && isChecked) _selectedColumns.Add(column);
        else _selectedColumns.Remove(column);
    }

    private void ResetColumns()
    {
        _selectedColumns.Clear();
        foreach (var c in CcDashboard.Application.HistoricalReports.ReportWidgetConfig.DefaultColumns(WidgetType))
            _selectedColumns.Add(c);
    }

    // A column with no resource key shows its field name, not a blank: a blank header over real
    // numbers reads as data that failed to load.
    private string ColumnLabel(string column)
    {
        var key = ReportColumnLabels.KeyFor(column);
        return key is null ? column : L[key].Value;
    }

    private bool IsAgentWidget => WidgetType is ReportWidgetType.AgentMonthly or ReportWidgetType.AgentShiftDetail;

    private bool IsAgentPerformanceWidget => WidgetType is ReportWidgetType.AgentPerformance;

    /// <summary>The message next to the mode choice, or null when a mode is chosen.</summary>
    private string? ModeProblem => IsAgentPerformanceWidget
                                   && _mode != AgentPerformanceModes.Summary
                                   && _mode != AgentPerformanceModes.ByDate
        ? L["ReportWidget_ModeRequired"].Value
        : null;

    private bool IsEndOfShiftWidget =>
        WidgetType is ReportWidgetType.EndOfShiftAgents or ReportWidgetType.EndOfShiftQueues;

    // 24 is midnight at the end of the shift, not an hour of the day: printing "24:00" keeps
    // "ends at midnight" readable, where "00:00" would read as the start of the same date.
    private static string HourLabel(int hour) => $"{hour:00}:00";

    /// <summary>
    /// The one message shown next to the hour fields, or null when the pair is usable. The order
    /// matters: an unset pair is reported as unset, not as a wrong order, because a missing value
    /// compared against anything would otherwise be described as a contradiction the user never made.
    /// </summary>
    private string? ShiftProblem
    {
        get
        {
            if (!IsEndOfShiftWidget)
                return null;
            if (_shiftStartHour is null || _shiftEndHour is null)
                return L["ReportWidget_ShiftHoursRequired"].Value;
            if (_shiftEndHour <= _shiftStartHour)
                return L["ReportWidget_ShiftEndBeforeStart"].Value;
            return null;
        }
    }

    private bool CanSave => _selectedBuIds.Count > 0 && ShiftProblem is null && ModeProblem is null;

    // Filtered BUs for searchable dropdown
    private IEnumerable<BusinessUnitDto> FilteredBusinessUnits =>
        string.IsNullOrWhiteSpace(_buSearch)
            ? _businessUnits
            // BusinessUnitName is declared nullable (BusinessUnitDto), so the search dereferenced a
            // possibly-null string - the CS8602 that predated this unit. A unit with no name simply
            // does not match a search: "?." yields null and "== true" makes that a no-match, which
            // is the honest answer. Coalescing to "" would have the same effect here, but reads as
            // if an unnamed unit were an empty-named one.
            : _businessUnits.Where(b => b.BusinessUnitName?.Contains(_buSearch, StringComparison.OrdinalIgnoreCase) == true);

    // Color palettes built from tenant settings
    private (string Name, string Value)[] BackgroundColors => BuildBackgroundColors();
    private (string Name, string Value)[] TableBackgroundColors => BuildTableBackgroundColors();
    private (string Name, string Value)[] FontColors => BuildFontColors();

    private (string Name, string Value)[] BuildBackgroundColors()
    {
        var colors = new List<(string, string)> { ("Transparent", "transparent") };
        foreach (var c in _tenantBackgroundColors)
            colors.Add((c.ToUpperInvariant(), c.ToUpperInvariant()));
        return colors.ToArray();
    }

    private (string Name, string Value)[] BuildTableBackgroundColors()
    {
        var colors = new List<(string, string)> { ("Transparent", "transparent") };
        foreach (var c in _tenantBackgroundColors)
            colors.Add((c.ToUpperInvariant(), c.ToUpperInvariant()));
        return colors.ToArray();
    }

    private (string Name, string Value)[] BuildFontColors()
    {
        var colors = new List<(string, string)>();
        foreach (var c in _tenantFontColors)
            colors.Add((c.ToUpperInvariant(), c.ToUpperInvariant()));
        return colors.ToArray();
    }

    private static List<string> GetDefaultBackgroundColors() =>
    [
        "#FFFFFF", "#F5F5F5", "#E8F5E9", "#FFF3E0", "#FFEBEE",
        "#E3F2FD", "#F3E5F5", "#FFFDE7", "#E0F7FA", "#FBE9E7"
    ];

    private static List<string> GetDefaultFontColors() =>
    [
        "#000000", "#333333", "#666666", "#1976D2", "#388E3C",
        "#D32F2F", "#7B1FA2", "#F57C00", "#0097A7", "#5D4037"
    ];

    private static List<string> GetDefaultFontSizes() => ["12", "14", "18", "24", "32"];

    private static string GetColorStyle(string? color)
    {
        if (string.IsNullOrEmpty(color) || color == "transparent")
            return "background: linear-gradient(45deg, #ccc 25%, transparent 25%, transparent 75%, #ccc 75%), linear-gradient(45deg, #ccc 25%, transparent 25%, transparent 75%, #ccc 75%); background-size: 8px 8px; background-position: 0 0, 4px 4px;";
        return $"background-color: {color};";
    }

    private static string GetColorName(string? color, (string Name, string Value)[] palette)
    {
        if (string.IsNullOrEmpty(color)) return "None";
        var match = palette.FirstOrDefault(c => c.Value.Equals(color, StringComparison.OrdinalIgnoreCase));
        return string.IsNullOrEmpty(match.Name) ? color : match.Name;
    }

    private void ToggleColorPalette(string paletteKey)
    {
        _openColorPalette = _openColorPalette == paletteKey ? null : paletteKey;
    }

    private void CloseColorPalette() => _openColorPalette = null;

    // BU search handlers (mirror dashboard clear-on-focus pattern)
    private void OnBuSearchInput(ChangeEventArgs e)
    {
        _buSearch = e.Value?.ToString() ?? "";
        _buDropdownOpen = true;
    }

    private void OnBuSearchFocus()
    {
        _buSearch = string.Empty;
        _buDropdownOpen = true;
    }

    private async Task OnBuSearchBlur()
    {
        await Task.Delay(150);
        _buDropdownOpen = false;
    }

    private void ToggleBu(int buId)
    {
        if (_selectedBuIds.Contains(buId))
            _selectedBuIds.Remove(buId);
        else
            _selectedBuIds.Add(buId);
    }

    private void RemoveBu(int buId)
    {
        _selectedBuIds.Remove(buId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            // Load initial config
            _allowedColumns = CcDashboard.Application.HistoricalReports.ReportWidgetConfig
                .AllowedColumns(WidgetType);
            _selectedColumns.Clear();
            // What is ticked: the user's own choice, else the standard set for this type - the same
            // set the server falls back to, so an untouched widget shows exactly what it showed.
            foreach (var c in (InitialConfig?.Columns is { Count: > 0 } chosen
                        ? chosen
                        : CcDashboard.Application.HistoricalReports.ReportWidgetConfig.DefaultColumns(WidgetType)))
                _selectedColumns.Add(c);

            if (InitialConfig is not null)
            {
                _title = InitialConfig.Title;
                _pageSize = InitialConfig.PageSize ?? 25;
                _shiftStartHour = InitialConfig.ShiftStartHour;
                _shiftEndHour = InitialConfig.ShiftEndHour;
                _mode = InitialConfig.Mode;

                // Appearance - typography
                _tableFontSize = ResolveFontSizeToPixel(InitialConfig.Appearance?.TableFontSize);
                _headerFontSize = ResolveFontSizeToPixel(InitialConfig.Appearance?.HeaderFontSize);

                // Appearance - colors
                _lightBackground = InitialConfig.Appearance?.LightBackground ?? "transparent";
                _lightTextColor = InitialConfig.Appearance?.LightTextColor ?? "#000000";
                _lightTableBackground = InitialConfig.Appearance?.LightTableBackground ?? "transparent";
                _darkBackground = InitialConfig.Appearance?.DarkBackground ?? "#1e293b";
                _darkTextColor = InitialConfig.Appearance?.DarkTextColor ?? "#e2e8f0";
                _darkTableBackground = InitialConfig.Appearance?.DarkTableBackground ?? "transparent";

                // Scope - BU only
                if (InitialConfig.Scope is not null)
                {
                    _selectedBuIds = InitialConfig.Scope.BusinessUnitIds?.ToList() ?? new();
                    _agentAxis = InitialConfig.Scope.AgentAxis ?? "detail";
                }
            }
            else
            {
                // Reset to defaults for new widget
                _title = null;
                _pageSize = 25;
                _shiftStartHour = null;
                _shiftEndHour = null;
                _mode = null;
                _tableFontSize = "14";
                _headerFontSize = "14";
                _lightBackground = "transparent";
                _lightTextColor = "#000000";
                _lightTableBackground = "transparent";
                _darkBackground = "#1e293b";
                _darkTextColor = "#e2e8f0";
                _darkTableBackground = "transparent";
                _selectedBuIds = new();
                _agentAxis = "detail";
            }

            // Reset search state
            _buSearch = "";
            _buDropdownOpen = false;

            // Load data sources if not already loaded
            if (!_dataLoaded)
            {
                await LoadDataSources();
                _dataLoaded = true;
            }
        }
        else
        {
            _dataLoaded = false;
            _openColorPalette = null;
            _buDropdownOpen = false;
        }
    }

    private static string ResolveFontSizeToPixel(string? value) => value switch
    {
        "small"   => "12",
        "normal"  => "14",
        "large"   => "18",
        "xlarge"  => "24",
        "xxlarge" => "32",
        null or "" => "14",
        _ => value.TrimEnd('p', 'x')
    };

    private async Task LoadDataSources()
    {
        _busLoading = true;
        StateHasChanged();

        // Load business units
        try
        {
            _businessUnits = await Mediator.Send(new GetMyBusinessUnitsQuery(TenantId));
        }
        catch (Exception ex)
        {
            _businessUnits = [];
            Logger.LogError(ex, "ReportWidgetConfigModal: failed to load business units");
        }
        finally
        {
            _busLoading = false;
        }

        // Load tenant palettes
        try
        {
            var tenantId = CurrentUser.TenantId;
            if (tenantId.HasValue)
            {
                var tenantSettings = await Mediator.Send(new GetTenantSettingsQuery(tenantId.Value));
                if (tenantSettings is not null)
                {
                    _tenantBackgroundColors = tenantSettings.BackgroundColorPalette ?? GetDefaultBackgroundColors();
                    _tenantFontColors = tenantSettings.FontColorPalette ?? GetDefaultFontColors();
                    _tenantFontSizes = tenantSettings.FontSizes?.Count > 0 ? tenantSettings.FontSizes : GetDefaultFontSizes();
                }
                else
                {
                    _tenantBackgroundColors = GetDefaultBackgroundColors();
                    _tenantFontColors = GetDefaultFontColors();
                    _tenantFontSizes = GetDefaultFontSizes();
                }
            }
            else
            {
                _tenantBackgroundColors = GetDefaultBackgroundColors();
                _tenantFontColors = GetDefaultFontColors();
                _tenantFontSizes = GetDefaultFontSizes();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ReportWidgetConfigModal: failed to load tenant palettes");
            _tenantBackgroundColors = GetDefaultBackgroundColors();
            _tenantFontColors = GetDefaultFontColors();
            _tenantFontSizes = GetDefaultFontSizes();
        }

        StateHasChanged();
    }

    private async Task Save()
    {
        var scope = new ReportScope
        {
            BusinessUnitIds = _selectedBuIds.ToList(),
            AgentAxis = IsAgentWidget ? _agentAxis : null
        };

        var config = new ReportWidgetConfig
        {
            Title = _title,
            Scope = scope,
            // Keep the ORDER of AllowedColumns rather than the order ticks were made: the table
            // must look the same after a reopen, and a set has no order to remember.
            // An empty choice is not saved as empty - that would render a table with no columns;
            // null means "the standard set", which is what an untouched widget already means.
            Columns = (_allowedColumns is null || _selectedColumns.Count == 0)
                ? null
                : _allowedColumns.Where(_selectedColumns.Contains).ToList(),
            PageSize = InitialConfig?.PageSize ?? 25,
            // Hours belong to the end-of-shift types only: the server rejects a query that carries
            // them on any other type, so a leftover pair from a retyped widget must not be saved.
            ShiftStartHour = IsEndOfShiftWidget ? _shiftStartHour : null,
            ShiftEndHour = IsEndOfShiftWidget ? _shiftEndHour : null,
            // The mode belongs to AgentPerformance only; the server refuses it on other types.
            Mode = IsAgentPerformanceWidget ? _mode : null,
            // Carried through untouched: the agent pick has no control yet (backend owes the
            // "agents in scope" query), and a dialog that saved null here would erase a list a
            // later version let someone choose.
            AgentIds = IsAgentPerformanceWidget ? InitialConfig?.AgentIds : null,
            Appearance = new AppearanceConfig
            {
                TableFontSize = _tableFontSize,
                HeaderFontSize = _headerFontSize,
                LightBackground = _lightBackground == "transparent" ? null : _lightBackground,
                LightTextColor = _lightTextColor,
                DarkBackground = _darkBackground,
                DarkTextColor = _darkTextColor,
                LightTableBackground = _lightTableBackground == "transparent" ? null : _lightTableBackground,
                DarkTableBackground = _darkTableBackground == "transparent" ? null : _darkTableBackground
            }
        };

        await OnSave.InvokeAsync(config);
        await Close();
    }

    private async Task Close()
    {
        _tab = "scope";
        _openColorPalette = null;
        _buDropdownOpen = false;
        await OnClose.InvokeAsync();
    }
}

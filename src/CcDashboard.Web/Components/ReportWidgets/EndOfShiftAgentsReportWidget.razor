@using MediatR
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using CcDashboard.Application.HistoricalReports.Queries
@using CcDashboard.Contracts.Common
@using CcDashboard.Domain.Domain.Reports
@using ReportColumns = CcDashboard.Application.HistoricalReports.ReportColumns
@using ReportColumnKind = CcDashboard.Application.HistoricalReports.ReportColumnKind
@using ReportColumn = CcDashboard.Application.HistoricalReports.ReportColumn
@inject IMediator Mediator
@inject IStringLocalizer<SharedResources> L
@inject ILogger<EndOfShiftAgentsReportWidget> Logger

@* FEAT-REPORT-EOS-AGENTS-01: one row per agent for the shift window.
   Built on QueueIntervalReportWidget: same states, paging, dark mode and appearance variables, so
   a new report looks and behaves like the five that already exist. Two things differ, both from
   the contract: the columns come from the widget's configuration rather than being fixed, and the
   result can say its newest part is not aggregated yet. *@

@* PR234-V4-EOS-DATE-CHANGE-NO-EFFECT-01: say WHICH date and hours these numbers are for.
   Measured on 234 on 2026-11-05: changing only the page's second date field changes nothing here -
   the report takes the first date and the hours - and nothing on screen said so, so a person had
   no way to see that their change had been ignored. Printed before every other branch, so it is
   there when the widget is refusing as well as when it is showing rows. *@
<div class="report-widget-shownfor small text-muted px-2 pt-1" role="note">@ShownForText</div>

@if (_denied)
{
    <div class="alert alert-warning">
        <i class="bi bi-shield-exclamation me-2"></i>@L["Report_AccessDenied"]
    </div>
}
else if (_needsShiftHours)
{
    @* Said here, in the user's language, instead of letting the server's English refusal through:
       without the shift hours the query cannot be built at all, and the cure is in this widget's
       own settings, so the message names it. *@
    <div class="alert alert-info">
        <i class="bi bi-clock-history me-2"></i>@L["ReportWidget_ShiftHoursMissing"]
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}
else if (ReportLoadingView.ShowSpinner(_loading, HasRows))
{
    @* The spinner belongs to the FIRST load only - when there is nothing to show yet. Replacing
       rows that are already on screen makes every filter change blink the data away and back, and
       teaches people that the report loses data. Rows that are one answer old are not wrong. *@
    <div class="d-flex justify-content-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
@* The explicit null test, not HasRows: the compiler does not carry a property's pattern into
   the branch below, and without it every @_result.Rows read warns (CS8602) - the exact warning
   this file collected once already. *@
else if (_result is null || _result.Rows.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>@L["Report_NoData"]
    </div>
}
else
{
    @* The window reaches past what has been aggregated: say so, with the instant it reaches. The
       server sends DataThroughUtc in UTC - the only UTC value in this contract - so it goes
       through WallClock, like every other stored instant on screen. *@
    @* No "_result is not null" here: this whole branch already ran after the null check above, and
       re-testing it told the compiler the opposite - that null was still possible - which is what
       produced CS8602 on the @foreach below (line 76 in the run, column 42, on .Rows). The model
       widget has no such re-test and no such warning. *@
    @if (_incomplete)
    {
        <div class="alert alert-warning py-1 px-2 mb-1 small" role="status">
            <i class="bi bi-hourglass-split me-1"></i>@IncompleteText
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_caveat))
    {
        <div class="report-widget-caveat small text-muted px-2 pb-1" role="note">
            <i class="bi bi-info-circle me-1"></i>@_caveat
        </div>
    }

    @if (ReportLoadingView.ShowUpdatingMark(_loading, HasRows))
    {
        @* The rows below are one answer old and a newer one is on its way. Said out loud: a silent
           wait is exactly how a stuck screen looks healthy, which cost us a whole morning. *@
        <div class="small text-muted px-2 pb-1" role="status">
            <span class="spinner-border spinner-border-sm me-1"></span>@L["Common_Loading"]
        </div>
    }

    @* One table for every report; the funnel sits in the header of each column the rule says
       can be filtered. The row of buttons above the table is gone - it named the columns a
       second time, and two namings drift (operator, 2026-11-07). *@
    <ReportRowTable Rows="_result.Rows" Columns="_columns" DarkMode="DarkMode" WidgetType="ReportWidgetType.EndOfShiftAgents"
                    Updating="ReportLoadingView.ShowUpdatingMark(_loading, HasRows)"
                    Caption="@L["Report_EndOfShiftAgents"].Value">
        <HeaderExtra Context="column">
            <ColumnFilterHeader Column="@column.Name"
                                ColumnLabel="@ColumnLabel(column.Name)"
                                Kind="column.Kind"
                                Applied="_filters.For(column.Name)"
                                IsOpen="_filters.OpenColumn == column.Name"
                                Loading="_filters.ValuesLoading"
                                Values="_filters.Values"
                                TotalCount="_filters.ValuesTotal"
                                Truncated="_filters.ValuesTruncated"
                                OnToggle="ToggleFilterAsync"
                                OnApply="ApplyFilterAsync"
                                OnClear="ClearFilterAsync"
                                OnClose="CloseFilter" />
        </HeaderExtra>
    </ReportRowTable>

    <div class="report-widget-footer">
        <span class="report-widget-footer-pagesize">
            <input type="number" class="form-control form-control-sm" style="width:70px"
                   min="1" max="1000" step="1" value="@_pageSize" @onchange="OnPageSizeChanged" />
            <span class="small text-muted ms-1">@L["Report_Rows"]</span>
        </span>
        <span class="report-widget-footer-info">
            @L["Report_Showing"] @_result.Rows.Count @L["Report_Of"] @_result.TotalCount
        </span>
        @if (TotalPages > 1)
        {
            <span class="report-widget-footer-pager">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="PrevPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="mx-2">@_page / @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page >= TotalPages)" @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ReportWidgetConfig? Config { get; set; }
    [Parameter, EditorRequired] public DateTime From { get; set; }
    [Parameter, EditorRequired] public DateTime To { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public Guid? TenantId { get; set; }
    /// <summary>Identity of this widget on the screen; the page keys its filter dictionary by it.</summary>
    [Parameter] public Guid WidgetId { get; set; }
    /// <summary>
    /// Tells the page what this widget is filtered by. The export is built by the page, so a
    /// filter it never hears about would produce a file that disagrees with the screen.
    /// </summary>
    [Parameter] public EventCallback<ReportWidgetFilter> FilterChanged { get; set; }

    private bool _loading;
    private bool _denied;
    private string? _error;
    private bool _needsShiftHours;
    private AgentSummaryReportResult? _result;
    private bool _incomplete;
    private DateTime? _dataThroughUtc;
    private string? _caveat;
    private IReadOnlyList<string> _columns = Array.Empty<string>();
    private int _page = 1;
    private int _pageSize = 25;
    private DateTime _lastFrom;
    private DateTime _lastTo;
    private string? _lastConfigJson;
    private bool _initialized;

    /// <summary>
    /// "Shown for 2026-11-04, 09:00-18:00" - the date that actually went into the query, not the
    /// page's field, and the hours from the configuration. When the hours are missing the line
    /// names the date alone: inventing a window here would hide the very defect it exists to show.
    /// </summary>
    private string ShownForText
    {
        get
        {
            // The page's own culture, not ISO: the date fields above show dd/MM/yyyy on a he-IL
            // board, and a caption in another format reads as a different date entirely.
            var date = From.Date.ToString("d");
            var start = Config?.ShiftStartHour;
            var end = Config?.ShiftEndHour;
            return start is null || end is null
                ? string.Format(L["Report_ShownForDate"].Value, date)
                : string.Format(L["Report_ShownForShift"].Value, date, $"{start:00}:00", $"{end:00}:00");
        }
    }

    // Funnel filters live on the screen only (operator, 2026-11-07): a filter kept in the widget's
    // configuration would open tomorrow's shift already narrowed, and whoever opened it would read
    // an empty table as "there was no work". One object, shared by every report - the last time
    // this state was written by hand it was written three times and already differed.
    private readonly ReportFilterState _filters = new();

    private string ColumnLabel(string column)
    {
        var key = ReportColumnLabels.KeyFor(column);
        return key is null ? column : L[key].Value;
    }

    private void CloseFilter() => _filters.Close();

    /// <summary>
    /// Open a column's window. For a text column the checkbox values come from the SERVER, over
    /// the whole window and scope - not from the page in hand, which holds 25 rows of possibly
    /// hundreds and would offer a choice that is not the real one.
    /// </summary>
    private async Task ToggleFilterAsync(string column)
    {
        if (!_filters.Toggle(column)) return;

        var kind = ReportColumns.Find(ReportWidgetType.EndOfShiftAgents, column)?.Kind;
        if (kind is not (ReportColumnKind.Text or ReportColumnKind.Id)) return;

        _filters.BeginLoadingValues();
        try
        {
            var res = await Mediator.Send(BuildQuery(valuesFor: column));
            if (res.ColumnValues is { } values && values.Column == column)
                _filters.SetValues(values);
        }
        catch (Exception ex)
        {
            // An unreachable list is not a reason to refuse the window: the text filter still
            // works, and saying nothing would look like a column with no values at all.
            Logger.LogWarning(ex, "Filter values for {Column} could not be loaded", column);
        }
        finally
        {
            _filters.EndLoadingValues();
        }
    }

    private async Task ApplyFilterAsync((string Column, ColumnFilterDraft Draft) applied)
    {
        var (column, draft) = applied;
        var kind = ReportColumns.Find(ReportWidgetType.EndOfShiftAgents, column)?.Kind ?? ReportColumnKind.Text;
        _filters.Apply(column, ReportFilterState.Build(column, kind, draft));
        await AfterFilterChangedAsync();
    }

    private async Task ClearFilterAsync(string column)
    {
        _filters.Clear(column);
        await AfterFilterChangedAsync();
    }

    private async Task AfterFilterChangedAsync()
    {
        await FilterChanged.InvokeAsync(new ReportWidgetFilter(WidgetId, _filters.ForQuery()));
        // Back to the first page: page 4 of an unfiltered answer is usually past the end of a
        // filtered one, and an empty page reads as "nothing found" rather than "you are past it".
        _page = 1;
        await LoadData();
    }

    /// <summary>
    /// The one place this widget builds its query. The page of rows and the list of values the
    /// filter window offers are asked for here both - so they cannot end up describing different
    /// windows or different filters, which would offer a choice the table cannot contain.
    /// One date on both ends: an end-of-shift report lies on a single date, the one picked on the
    /// page; the hours come from the widget's settings.
    /// </summary>
    private RunReportWidgetQuery BuildQuery(string? valuesFor = null)
    {
        var effectiveConfig = (Config ?? new ReportWidgetConfig()) with { PageSize = _pageSize };
        var shiftDate = From.Date;
        return new RunReportWidgetQuery(
            ReportWidgetType.EndOfShiftAgents,
            effectiveConfig.ToJson(),
            shiftDate,
            shiftDate,
            _page,
            TenantId,
            false,
            Config?.ShiftStartHour,
            Config?.ShiftEndHour)
        {
            Filters = _filters.ForQuery(),
            ValuesForColumn = valuesFor
        };
    }

    private bool HasRows => _result is { Rows.Count: > 0 };

    private int TotalPages => _result is null ? 1 : (int)Math.Ceiling((double)_result.TotalCount / _pageSize);

    private string IncompleteText => _dataThroughUtc is null
        ? L["Report_Incomplete"].Value.Replace("{0}", "-")
        : string.Format(L["Report_Incomplete"].Value,
                        WallClock.ToServerLocal(_dataThroughUtc.Value).ToString("yyyy-MM-dd HH:mm"));

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            _pageSize = Config?.PageSize ?? 25;
            _initialized = true;
        }

        var configJson = Config?.ToJson();
        if (From != _lastFrom || To != _lastTo || configJson != _lastConfigJson)
        {
            _lastFrom = From;
            _lastTo = To;
            _lastConfigJson = configJson;
            _page = 1;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        _denied = false;
        _error = null;
        _needsShiftHours = false;

        // The shift hours are part of the query, not of the config the server parses: without them
        // ValidateShift refuses before any data is read ("Shift start and end hours are required").
        // Until this unit they were never sent from Web at all, so the widget could only ever draw
        // that refusal. An unusable pair is caught here, in the user's language, and no query is
        // sent - a request that is certain to be refused is not a measurement of anything.
        var startHour = Config?.ShiftStartHour;
        var endHour = Config?.ShiftEndHour;
        if (startHour is null || endHour is null || endHour <= startHour)
        {
            _needsShiftHours = true;
            _result = null;
            _loading = false;
            StateHasChanged();
            return;
        }

        StateHasChanged();

        try
        {
            var res = await Mediator.Send(BuildQuery());

            if (res.Denied)
            {
                _denied = true;
                _result = null;
            }
            else if (!string.IsNullOrEmpty(res.Error))
            {
                _error = res.Error;
                _result = null;
            }
            else
            {
                _result = res.AgentSummary;
                _incomplete = res.Incomplete;
                _dataThroughUtc = res.DataThroughUtc;
                // PR234-V4-EOS-CAVEAT-NOT-LOCALIZED-01: the server sends a CODE now; the sentence
                // and its translations belong here. A code this screen cannot put into words
                // shows nothing and goes to the log - a raw "status-start-bucket" on the board
                // would tell the reader nothing and look like a fault in the report.
                var caveatKey = ReportCaveat.KeyFor(res.CaveatCode);
                if (ReportCaveat.IsUnknown(res.CaveatCode))
                    Logger.LogWarning("Report widget received an unrecognised caveat code {CaveatCode}", res.CaveatCode);
                _caveat = caveatKey is null ? null : L[caveatKey].Value;
                // The columns come from the ANSWER, not from a calculation here: the server already
                // resolved "what the user picked, else the standard set" and sends it back as
                // EffectiveColumns. Taking it from the response is what makes a disagreement
                // between the header and the cells impossible, rather than merely unlikely.
                //
                // This replaces my first attempt, which called GetEffectiveColumns on the widget's
                // own config and did not compile: there are TWO types named ReportWidgetConfig -
                // this one (Web.Components.ReportWidgets, carries Appearance/Scope/PageSize) and
                // the server's (Application.HistoricalReports, carries the column rules). The
                // widget has `@using` for both, so the name bound to the type without the method.
                // The fallback below names the server's type in full for exactly that reason, and
                // the column rule stays in one place - the server's.
                // Read the nullable property into a local first: a conditional whose branches are
                // "nullable property" and "non-null value" can be assigned to a non-nullable field
                // only if the compiler keeps the narrowing across the two reads of the property.
                // With a local there is nothing to doubt - and nothing for the build to warn about.
                var fromServer = res.EffectiveColumns;
                var columns = fromServer is { Count: > 0 }
                    ? fromServer
                    : CcDashboard.Application.HistoricalReports.ReportWidgetConfig
                        .DefaultColumns(ReportWidgetType.EndOfShiftAgents);

                // PR234-V4-EOS-AGENTS-EMPTY-COLUMNS-01: this report covers ONE date, so Date is
                // null in every row and the column was a stripe of dashes. The same rule the
                // agent performance report uses for its "summary" mode applies here - the report
                // is a summary of one window - so it is called with byDate: false rather than
                // copied.
                _columns = AgentSummaryColumns.ForMode(columns, byDate: false);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "EndOfShiftAgentsReportWidget load failed");
            _error = ex.Message;
            _result = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = Math.Clamp(size, 1, 1000);
            _page = 1;
            await LoadData();
        }
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
            await LoadData();
        }
    }

}

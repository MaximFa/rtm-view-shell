@using System.Text.Json
@using MediatR
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using CcDashboard.Application.HistoricalReports.Queries
@using CcDashboard.Contracts.Common
@using CcDashboard.Domain.Domain.Reports
@using ReportColumns = CcDashboard.Application.HistoricalReports.ReportColumns
@using ReportColumnKind = CcDashboard.Application.HistoricalReports.ReportColumnKind
@using ReportColumn = CcDashboard.Application.HistoricalReports.ReportColumn
@using ReportIntervalLabel = CcDashboard.Application.HistoricalReports.ReportIntervalLabel
@inject IMediator Mediator
@inject IStringLocalizer<SharedResources> L
@inject ILogger<EndOfShiftQueuesReportWidget> Logger
@inject CcDashboard.Web.Services.ReportModalService Modal
@implements IDisposable

@* FEAT-REPORT-EOS-QUEUES-01, made configurable by FEAT-REPORT-EOS-CONFIGURABLE-01 (2026-11-07):
   one row per (interval of the step, queue) over the page's period; the step is the viewer's own.
   Originally one row per queue for the shift window.
   Built on QueueIntervalReportWidget: same states, paging, dark mode and appearance variables, so
   a new report looks and behaves like the five that already exist. Two things differ, both from
   the contract: the columns come from the widget's configuration rather than being fixed, and the
   result can say its newest part is not aggregated yet. *@

@* PR234-V4-EOS-DATE-CHANGE-NO-EFFECT-01: say WHICH date and hours these numbers are for.
   Measured on 234 on 2026-11-05: changing only the page's second date field changes nothing here -
   the report takes the first date and the hours - and nothing on screen said so, so a person had
   no way to see that their change had been ignored. Printed before every other branch, so it is
   there when the widget is refusing as well as when it is showing rows. *@
<div class="report-widget-shownfor d-flex align-items-center justify-content-between gap-2 small text-muted px-2 pt-1">
    <span role="note">@ShownForText</span>
    @* FEAT-REPORT-EOS-CONFIGURABLE-01: the step is the viewer's own setting, kept per widget the
       same way DayTrend keeps its interval (user view settings by widget id). Offered only where
       the widget has an identity to keep it under - in the editor it has none, and a button
       whose choice is forgotten on the next redraw is a control that controls nothing. *@
    @if (WidgetId != Guid.Empty)
    {
        <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2 report-step-button"
                title="@L["Widget_LocalViewSettings"]" @onclick="OpenStepWindow">
            <i class="bi bi-calendar3-range me-1" aria-hidden="true"></i>@L["Report_Step"]: @StepName(_step)
            @if (_personalStep is null)
            {
                @* Says that nobody chose this step on this screen - it is the widget's own default,
                   set in the editor; "Reset" in the window returns here. *@
                <span class="ms-1 opacity-75">(@L["Common_Default"])</span>
            }
        </button>
    }
</div>


@if (_denied)
{
    <div class="alert alert-warning">
        <i class="bi bi-shield-exclamation me-2"></i>@L["Report_AccessDenied"]
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}
else if (ReportLoadingView.ShowSpinner(_loading, HasRows))
{
    @* The spinner belongs to the FIRST load only - when there is nothing to show yet. Replacing
       rows that are already on screen makes every filter change blink the data away and back, and
       teaches people that the report loses data. Rows that are one answer old are not wrong. *@
    <div class="d-flex justify-content-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
@* The explicit null test, not HasRows: the compiler does not carry a property's pattern into
   the branch below, and without it every @_result.Rows read warns (CS8602) - the exact warning
   this file collected once already. *@
@* PR234-V4-REPORT-FILTER-EMPTY-RESULT-STUCK-01: "no data" only when nothing is filtered. Empty WITH
   filters keeps the table - its header carries the funnels, the only way back out of the filter. *@
else if (_result is null || (_result.Rows.Count == 0 && !_filters.Any))
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>@L["Report_NoData"]
    </div>
}
else
{
    @* The window reaches past what has been aggregated: say so, with the instant it reaches. The
       server sends DataThroughUtc in UTC - the only UTC value in this contract - so it goes
       through WallClock, like every other stored instant on screen. *@
    @* No "_result is not null" here: this whole branch already ran after the null check above, and
       re-testing it told the compiler the opposite - that null was still possible - which is what
       produced CS8602 on the @foreach below (line 76 in the run, column 42, on .Rows). The model
       widget has no such re-test and no such warning. *@
    @if (_incomplete)
    {
        <div class="alert alert-warning py-1 px-2 mb-1 small" role="status">
            <i class="bi bi-hourglass-split me-1"></i>@IncompleteText
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_caveat))
    {
        <div class="report-widget-caveat small text-muted px-2 pb-1" role="note">
            <i class="bi bi-info-circle me-1"></i>@_caveat
        </div>
    }

    @if (ReportLoadingView.ShowUpdatingMark(_loading, HasRows))
    {
        @* The rows below are one answer old and a newer one is on its way. Said out loud: a silent
           wait is exactly how a stuck screen looks healthy, which cost us a whole morning. *@
        <div class="small text-muted px-2 pb-1" role="status">
            <span class="spinner-border spinner-border-sm me-1"></span>@L["Common_Loading"]
        </div>
    }

    @* One table for every report; the funnel sits in the header of each column the rule says
       can be filtered. The row of buttons above the table is gone - it named the columns a
       second time, and two namings drift (operator, 2026-11-07). *@
    <ReportRowTable FiltersActive="_filters.Any" OnClearFilters="ClearAllFiltersAsync" Rows="_result.Rows" Columns="_columns" DarkMode="DarkMode" WidgetType="ReportWidgetType.EndOfShiftQueues"
                    CellText="QueueCellText"
                    SortColumn="@_sortColumn" SortDescending="_sortDescending" OnSort="SortByAsync"
                    Updating="ReportLoadingView.ShowUpdatingMark(_loading, HasRows)"
                    Caption="@L["Report_EndOfShiftQueues"].Value">
        <HeaderExtra Context="column">
            <ColumnFilterHeader Column="@column.Name" Group="_filters"
                                ColumnLabel="@ColumnLabel(column.Name)"
                                Kind="column.Kind"
                                DateFormat="@ReportIntervalLabel.DayFormat"
                                Applied="_filters.For(column.Name)"
                                IsOpen="_filters.OpenColumn == column.Name"
                                Loading="_filters.ValuesLoading"
                                Values="_filters.Values"
                                TotalCount="_filters.ValuesTotal"
                                Truncated="_filters.ValuesTruncated"
                                OnToggle="ToggleFilterAsync"
                                OnApply="ApplyFilterAsync"
                                OnClear="ClearFilterAsync"
                                OnClose="CloseFilter" />
        </HeaderExtra>
    </ReportRowTable>

    <ReportTableFooter PageSize="_pageSize" OnPageSize="OnPageSizeChanged"
                       Shown="_result.Rows.Count" Total="_result.TotalCount"
                       Page="_page" Pages="TotalPages" OnPrev="PrevPage" OnNext="NextPage" />
}

@code {
    [Parameter, EditorRequired] public ReportWidgetConfig? Config { get; set; }
    [Parameter, EditorRequired] public DateTime From { get; set; }
    [Parameter, EditorRequired] public DateTime To { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public Guid? TenantId { get; set; }
    /// <summary>Identity of this widget on the screen; the page keys its filter dictionary by it.</summary>
    [Parameter] public Guid WidgetId { get; set; }
    /// <summary>
    /// Tells the page what this widget is filtered by. The export is built by the page, so a
    /// filter it never hears about would produce a file that disagrees with the screen.
    /// </summary>
    [Parameter] public EventCallback<ReportWidgetFilter> FilterChanged { get; set; }
    /// <summary>
    /// Tells the page which step this widget is drawn with - on load and on every change - so the
    /// export the page builds is grouped like the screen.
    /// </summary>
    [Parameter] public EventCallback<ReportWidgetStep> StepChanged { get; set; }

    private bool _loading;
    private bool _denied;
    private string? _error;
    private QueueSummaryReportResult? _result;
    private bool _incomplete;
    private DateTime? _dataThroughUtc;
    private string? _caveat;
    private IReadOnlyList<string> _columns = Array.Empty<string>();
    private int _page = 1;
    private int _pageSize = 25;
    private DateTime _lastFrom;
    private DateTime _lastTo;
    private string? _lastConfigJson;
    private bool _initialized;

    /// <summary>
    /// "Data for 01.11.2026 - 07.11.2026": the period that actually went into the query. The
    /// caption exists because a report that silently ignores a control is unreadable - that is how
    /// the second date field went unnoticed for a day.
    /// </summary>
    private string ShownForText
    {
        get
        {
            // One rule for every report widget: dd/MM/yyyy, as the date fields above (PR234-V4-REPORT-SHOWN-FOR-DATE-FORMAT-01).
            return ReportPeriodText.ShownFor(L, From, To);
        }
    }

    // Funnel filters live on the screen only (operator, 2026-11-07): a filter kept in the widget's
    // configuration would open tomorrow's shift already narrowed, and whoever opened it would read
    // an empty table as "there was no work". One object, shared by every report - the last time
    // this state was written by hand it was written three times and already differed.
    private readonly ReportFilterState _filters = new();

    private string ColumnLabel(string column)
    {
        var key = ReportColumnLabels.KeyFor(column);
        return key is null ? column : L[key].Value;
    }

    private void CloseFilter() => _filters.Close();

    /// <summary>
    /// Open a column's window. For a text column the checkbox values come from the SERVER, over
    /// the whole window and scope - not from the page in hand, which holds 25 rows of possibly
    /// hundreds and would offer a choice that is not the real one.
    /// </summary>
    private async Task ToggleFilterAsync(string column)
    {
        if (!_filters.Toggle(column)) return;

        var kind = ReportColumns.Find(ReportWidgetType.EndOfShiftQueues, column)?.Kind;
        if (kind is not (ReportColumnKind.Text or ReportColumnKind.Id)) return;

        _filters.BeginLoadingValues();
        try
        {
            var res = await Mediator.Send(BuildQuery(valuesFor: column));
            if (res.ColumnValues is { } values && values.Column == column)
                _filters.SetValues(values);
        }
        catch (Exception ex)
        {
            // An unreachable list is not a reason to refuse the window: the text filter still
            // works, and saying nothing would look like a column with no values at all.
            Logger.LogWarning(ex, "Filter values for {Column} could not be loaded", column);
        }
        finally
        {
            _filters.EndLoadingValues();
        }
    }

    private async Task ApplyFilterAsync((string Column, ColumnFilterDraft Draft) applied)
    {
        var (column, draft) = applied;
        var kind = ReportColumns.Find(ReportWidgetType.EndOfShiftQueues, column)?.Kind ?? ReportColumnKind.Text;
        _filters.Apply(column, ReportFilterState.Build(column, kind, draft));
        await AfterFilterChangedAsync();
    }

    private async Task ClearFilterAsync(string column)
    {
        _filters.Clear(column);
        await AfterFilterChangedAsync();
    }

    /// <summary>
    /// PR234-V4-REPORT-FILTER-EMPTY-RESULT-STUCK-01: "Clear filters" in an empty filtered table. The
    /// same path as clearing one funnel - FilterChanged included - so the export drops the filters too.
    /// </summary>
    private async Task ClearAllFiltersAsync()
    {
        _filters.ClearAll();
        await AfterFilterChangedAsync();
    }

    private async Task AfterFilterChangedAsync()
    {
        await FilterChanged.InvokeAsync(new ReportWidgetFilter(WidgetId, _filters.ForQuery()));
        // Back to the first page: page 4 of an unfiltered answer is usually past the end of a
        // filtered one, and an empty page reads as "nothing found" rather than "you are past it".
        _page = 1;
        await LoadData();
    }

    /// <summary>
    /// The one place this widget builds its query. The page of rows and the list of values the
    /// filter window offers are asked for here both - so they cannot end up describing different
    /// windows or different filters, which would offer a choice the table cannot contain.
    /// The period is the page's From..To and the step is this viewer's own (FEAT-REPORT-EOS-CONFIGURABLE-01).
    /// </summary>
    private RunReportWidgetQuery BuildQuery(string? valuesFor = null)
    {
        var effectiveConfig = (Config ?? new ReportWidgetConfig()) with { PageSize = _pageSize };
        // A period now, like every other report, and no shift hours at all: the server refuses
        // them on this type (FEAT-REPORT-EOS-CONFIGURABLE-01). Sending a value that is ignored
        // would be worse than refusing it - the screen would carry a setting that decides nothing.
        return new RunReportWidgetQuery(
            ReportWidgetType.EndOfShiftQueues,
            effectiveConfig.ToJson(),
            From,
            To,
            _page,
            TenantId)
        {
            Filters = _filters.ForQuery(),
            ValuesForColumn = valuesFor,
            Step = _step,
            SortColumn = _sortColumn,
            SortDescending = _sortDescending
        };
    }

    // ---- Step (FEAT-REPORT-EOS-CONFIGURABLE-01) -------------------------------------------------

    // The key under which the step is kept in the user's view settings of this widget.
    private const string StepSettingKey = "reportStep";

    /// <summary>The step in force: ReportWidgetSteps.Effective(personal, widget default) - one rule.</summary>
    private ReportStep _step = ReportStep.Day;
    /// <summary>This viewer's own choice on this widget, or null when they have made none.</summary>
    private ReportStep? _personalStep;
    /// <summary>The widget's default from its configuration (editor), Day when unset.</summary>
    private ReportStep WidgetDefaultStep => ReportWidgetSteps.FromConfig(Config?.DefaultStep) ?? ReportStep.Day;
    /// <summary>The selection inside the window, applied only by Apply.</summary>
    private ReportStep _viewStep = ReportStep.Day;
    private bool _stepLoaded;


    private string StepName(ReportStep step) => L[ReportWidgetSteps.NameKey(step)].Value;

    /// <summary>
    /// Reads the viewer's step before the first query, so the first answer is already in it. A
    /// stored value this build does not know is logged and read as Day - not thrown: a settings row
    /// written by a later version must not take the report down.
    /// The settings row is keyed by WidgetId, which here is a REPORT widget's id: UserWidgetSettings
    /// has no foreign key to dashboard widgets (AppDbContext.cs:348-357), and the coordinator
    /// decided to use it as it is, without a schema change (2026-11-07 09:09:23Z).
    /// </summary>
    private async Task LoadStepAsync()
    {
        if (WidgetId == Guid.Empty) return;
        try
        {
            var json = await Mediator.Send(new CcDashboard.Application.Queries.Widgets.GetUserWidgetSettingsQuery(WidgetId));
            if (string.IsNullOrEmpty(json)) return;
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind == JsonValueKind.Object
                && doc.RootElement.TryGetProperty(StepSettingKey, out var el)
                && el.ValueKind == JsonValueKind.String)
            {
                var text = el.GetString();
                if (Enum.TryParse<ReportStep>(text, ignoreCase: true, out var stored) && Enum.IsDefined(stored))
                    _personalStep = stored;
                else
                    Logger.LogWarning("Report widget {WidgetId}: unknown stored step {Step}, using Day", WidgetId, text);
            }
        }
        catch (Exception ex)
        {
            // An unreadable setting is not a reason to refuse the report: it opens by days.
            Logger.LogWarning(ex, "Report widget {WidgetId}: view settings could not be read", WidgetId);
        }
    }

    // FEAT-REPORT-FILTER-MODAL-01 (coordinator 2026-11-07T15:05:51Z, the same subject): the step window is drawn by
    // the page's ReportModalHost, outside the scaled board. Measured on 234 the same day: drawn inside the widget, its
    // backdrop darkened only the board and left the date bar above bright and clickable.
    private async Task OpenStepWindow()
    {
        _viewStep = _step;
        await Modal.ShowAsync(this, this, L["Widget_LocalViewSettings"].Value, StepBody, CloseStepWindow, StepFooter);
    }

    private Task CloseStepWindow()
    {
        Modal.Hide(this);
        return Task.CompletedTask;
    }

    private void PickStep(ReportStep step)
    {
        _viewStep = step;
        Modal.Refresh(this);   // the window shows this widget's state, but the page draws it
    }

    private RenderFragment StepBody => __builder =>
    {
        <label class="form-label fw-semibold">@L["Report_Step"]</label>
        @* Ascending, as the operator ordered them (2026-11-07 12:31): half hour, hour, day, month, year. *@
        <div class="btn-group w-100" role="group" aria-label="@L["Report_Step"]">
            @foreach (var step in ReportWidgetSteps.Ascending)
            {
                var stepOption = step;
                <button type="button"
                        class="btn btn-sm @(_viewStep == stepOption ? "btn-primary" : "btn-outline-secondary")"
                        aria-pressed="@(_viewStep == stepOption ? "true" : "false")"
                        @onclick="() => PickStep(stepOption)">@StepName(stepOption)</button>
            }
        </div>
        <div class="small text-muted mt-2">@L["Common_Default"]: @StepName(WidgetDefaultStep)</div>
    };

    private RenderFragment StepFooter => __builder =>
    {
        <div class="d-flex justify-content-between w-100">
            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ResetStepAsync">
                <i class="bi bi-arrow-counterclockwise me-1"></i>@L["Widget_ResetToDefault"]
            </button>
            <div>
                <button type="button" class="btn btn-sm btn-secondary me-2" @onclick="CloseStepWindow">@L["Cancel"]</button>
                <button type="button" class="btn btn-sm btn-primary" @onclick="ApplyStepAsync">
                    <i class="bi bi-check2 me-1"></i>@L["Apply"]
                </button>
            </div>
        </div>
    };

    public void Dispose() => Modal.Hide(this);

    private async Task ApplyStepAsync()
    {
        Modal.Hide(this);
        if (_viewStep == _step) return;
        try
        {
            var json = JsonSerializer.Serialize(new Dictionary<string, string> { [StepSettingKey] = _viewStep.ToString() });
            await Mediator.Send(new CcDashboard.Application.Commands.Widgets.SaveUserWidgetSettingsCommand(WidgetId, json));
            _personalStep = _viewStep;
        }
        catch (Exception ex)
        {
            // Said in the log, and the step still applies to this screen: the person chose it and
            // sees it; only tomorrow's default is lost.
            Logger.LogWarning(ex, "Report widget {WidgetId}: step could not be saved", WidgetId);
            _personalStep = _viewStep;   // in force on this screen all the same
        }
        await ChangeStepAsync(_viewStep);
    }

    private async Task ResetStepAsync()
    {
        Modal.Hide(this);
        try
        {
            await Mediator.Send(new CcDashboard.Application.Commands.Widgets.DeleteUserWidgetSettingsCommand(WidgetId));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Report widget {WidgetId}: view settings could not be deleted", WidgetId);
        }
        // Back to the widget's own default, not to Day: "reset" undoes the viewer's choice only.
        _personalStep = null;
        await ChangeStepAsync(ReportWidgetSteps.Effective(null, Config?.DefaultStep));
    }

    private async Task ChangeStepAsync(ReportStep step)
    {
        var changed = step != _step;
        _step = step;
        await StepChanged.InvokeAsync(new ReportWidgetStep(WidgetId, _step));
        if (!changed) return;
        // Back to the first page, as after a filter: page 4 of days is past the end of months.
        _page = 1;
        await LoadData();
    }

    // ---- The interval column, written from the ANSWER ---------------------------------------------

    // What the rows on screen were built with: the step the server USED. The page's step may already be
    // newer than the answer in hand, and the label must describe the numbers next to it.
    private ReportStep _answerStep = ReportStep.Day;

    // FEAT-REPORT-QUEUE-DATE-FORMAT-01 (operator 2026-11-07 22:29 / 22:32): every date of THIS report is written by the
    // Queue Report rule - the interval by its step, any other date-and-time column dd/MM/yyyy HH:mm. The common
    // ReportCellFormat stays as it is: the agents' reports keep their format (operator: "agents - not now").
    private string? QueueCellText(object row, string column)
    {
        if (row is not QueueSummaryRow r) return null;
        if (column == nameof(QueueSummaryRow.IntervalStart)) return ReportIntervalLabel.Cell(r.IntervalStart, _answerStep);
        var kind = ReportColumns.Find(ReportWidgetType.EndOfShiftQueues, column)?.Kind;
        if (kind is not (ReportColumnKind.DateTime or ReportColumnKind.Date)) return null;
        var value = typeof(QueueSummaryRow).GetProperty(column)?.GetValue(r) as DateTime?;
        if (value is null) return "-";
        return kind == ReportColumnKind.Date
            ? value.Value.ToString(ReportIntervalLabel.DayFormat, System.Globalization.CultureInfo.InvariantCulture)
            : ReportIntervalLabel.Instant(value.Value);
    }

    // ---- Sorting (FEAT-REPORT-QUEUE-COLUMN-SORT-01, operator 2026-11-07 22:29) ---------------------
    // The server pages the rows, so the server sorts them - after the filters, before the pages. Sorting one page of
    // twenty on the screen would show an order that is not the report's. A click on a column name: ascending ->
    // descending -> the report's own order. A new order starts again from page 1.
    private string? _sortColumn;
    private bool _sortDescending;

    private async Task SortByAsync(string column)
    {
        (_sortColumn, _sortDescending) = ReportSortCycle.Next(_sortColumn, _sortDescending, column);
        _page = 1;
        await LoadData();
    }

    private bool HasRows => _result is { Rows.Count: > 0 };

    private int TotalPages => _result is null ? 1 : (int)Math.Ceiling((double)_result.TotalCount / _pageSize);

    private string IncompleteText => _dataThroughUtc is null
        ? L["Report_Incomplete"].Value.Replace("{0}", "-")
        : string.Format(L["Report_Incomplete"].Value,
                        ReportIntervalLabel.Instant(WallClock.ToServerLocal(_dataThroughUtc.Value)));

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            _pageSize = Config?.PageSize ?? 25;
            _initialized = true;
        }

        if (!_stepLoaded)
        {
            _stepLoaded = true;
            await LoadStepAsync();
            _step = ReportWidgetSteps.Effective(_personalStep, Config?.DefaultStep);
            // Told even when nothing was stored: the page must not assume a step it was never told.
            await StepChanged.InvokeAsync(new ReportWidgetStep(WidgetId, _step));
        }

        var configJson = Config?.ToJson();
        if (From != _lastFrom || To != _lastTo || configJson != _lastConfigJson)
        {
            _lastFrom = From;
            _lastTo = To;
            _lastConfigJson = configJson;
            _page = 1;
            // A new default from the editor moves the step - unless this viewer chose their own.
            var effective = ReportWidgetSteps.Effective(_personalStep, Config?.DefaultStep);
            if (effective != _step)
            {
                _step = effective;
                await StepChanged.InvokeAsync(new ReportWidgetStep(WidgetId, _step));
            }
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        _denied = false;
        _error = null;

        StateHasChanged();

        try
        {
            var query = BuildQuery();
            var res = await Mediator.Send(query);

            if (res.Denied)
            {
                _denied = true;
                _result = null;
            }
            else if (!string.IsNullOrEmpty(res.Error))
            {
                // The server sends a CODE; the sentence belongs here. Error is the log line
                // ("never shown as is") and printing it put English on a Hebrew board - a retired
                // report said "Report type QueueInterval is retired" to whoever opened it.
                if (ReportErrorText.IsUnknown(res.ErrorCode))
                    Logger.LogWarning("Report widget failed with an unrecognised error code {ErrorCode}: {Error}", res.ErrorCode, res.Error);
                _error = L[ReportErrorText.KeyFor(res.ErrorCode)].Value;
                _result = null;
            }
            else
            {
                _result = res.QueueSummary;
                // The step the server USED, not the one asked for; Day when an older server sends none.
                _answerStep = res.Step ?? ReportStep.Day;
                _incomplete = res.Incomplete;
                _dataThroughUtc = res.DataThroughUtc;
                // PR234-V4-EOS-CAVEAT-NOT-LOCALIZED-01: the server sends a CODE now; the sentence
                // and its translations belong here. A code this screen cannot put into words
                // shows nothing and goes to the log - a raw "status-start-bucket" on the board
                // would tell the reader nothing and look like a fault in the report.
                var caveatKey = ReportCaveat.KeyFor(res.CaveatCode);
                if (ReportCaveat.IsUnknown(res.CaveatCode))
                    Logger.LogWarning("Report widget received an unrecognised caveat code {CaveatCode}", res.CaveatCode);
                _caveat = caveatKey is null ? null : L[caveatKey].Value;
                // The columns come from the ANSWER, not from a calculation here: the server already
                // resolved "what the user picked, else the standard set" and sends it back as
                // EffectiveColumns. Taking it from the response is what makes a disagreement
                // between the header and the cells impossible, rather than merely unlikely.
                //
                // This replaces my first attempt, which called GetEffectiveColumns on the widget's
                // own config and did not compile: there are TWO types named ReportWidgetConfig -
                // this one (Web.Components.ReportWidgets, carries Appearance/Scope/PageSize) and
                // the server's (Application.HistoricalReports, carries the column rules). The
                // widget has `@using` for both, so the name bound to the type without the method.
                // The fallback below names the server's type in full for exactly that reason, and
                // the column rule stays in one place - the server's.
                // Read the nullable property into a local first: a conditional whose branches are
                // "nullable property" and "non-null value" can be assigned to a non-nullable field
                // only if the compiler keeps the narrowing across the two reads of the property.
                // With a local there is nothing to doubt - and nothing for the build to warn about.
                var fromServer = res.EffectiveColumns;
                _columns = fromServer is { Count: > 0 }
                    ? fromServer
                    : CcDashboard.Application.HistoricalReports.ReportWidgetConfig
                        .DefaultColumns(ReportWidgetType.EndOfShiftQueues);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "EndOfShiftQueuesReportWidget load failed");
            _error = L["Report_ErrorUnknown"].Value;
            _result = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = Math.Clamp(size, 1, 1000);
            _page = 1;
            await LoadData();
        }
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
            await LoadData();
        }
    }
}

@using CcDashboard.Application.HistoricalReports.Queries
@using CcDashboard.Contracts.Common
@inject IStringLocalizer<SharedResources> L

@* FEAT-REPORT-EOS-AGENTS-01 / FEAT-REPORT-AGENT-PERF-01: the table both agent reports draw.
   They are two reports to the user - two palette entries, two sets of settings - but they share
   one row type (AgentSummaryRow), so they share the drawing and nothing else. This component
   takes rows and columns and knows nothing about shift hours, modes or periods: that is what
   keeps one report's settings out of the other. *@

<div class="report-widget-table-container">
    <div class="report-widget-table-scroll">
        <table class="table table-sm table-hover report-table report-widget-table" aria-label="@Caption">
            <caption class="visually-hidden">@Caption</caption>
            <thead class="@(DarkMode ? "table-dark" : "table-light")">
                <tr>
                    @foreach (var col in Columns)
                    {
                        <th scope="col" class="@(ReportColumnLabels.IsText(col) ? null : "text-end")">@Header(col)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        @foreach (var col in Columns)
                        {
                            <td class="@(ReportColumnLabels.IsText(col) ? null : "text-end")">@Cell(row, col)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AgentSummaryRow> Rows { get; set; } = Array.Empty<AgentSummaryRow>();
    [Parameter, EditorRequired] public IReadOnlyList<string> Columns { get; set; } = Array.Empty<string>();
    [Parameter] public bool DarkMode { get; set; }
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;

    // A column with no resource key shows its field name, never a blank: a blank header over real
    // numbers reads as data that failed to load.
    private string Header(string column)
    {
        var key = ReportColumnLabels.KeyFor(column);
        return key is null ? column : L[key].Value;
    }

    private static string Cell(AgentSummaryRow row, string column) => column switch
    {
        // Date is null except in AgentPerformance byDate mode, and it is ALREADY the site's local
        // date (the server applies its display zone) - so it is printed, never converted.
        "Date"             => row.Date?.ToString("yyyy-MM-dd") ?? "-",
        "AgentExternalId"  => row.AgentExternalId,
        "AgentDisplayName" => row.AgentDisplayName ?? "-",
        // The agent sums DO carry "Ms" and really are milliseconds - unlike the queue sums, which
        // have no suffix and are seconds. The two groups are told apart in ReportColumnLabels
        // rather than guessed from the name; getting it backwards shows nine hours as 32 seconds.
        "SumLoggedInMs"    => ReportFormat.Duration(row.SumLoggedInMs / 1000.0),
        "SumAvailableMs"   => ReportFormat.Duration(row.SumAvailableMs / 1000.0),
        "SumOnphoneMs"     => ReportFormat.Duration(row.SumOnphoneMs / 1000.0),
        "SumHoldMs"        => ReportFormat.Duration(row.SumHoldMs / 1000.0),
        "SumPaperworkMs"   => ReportFormat.Duration(row.SumPaperworkMs / 1000.0),
        "SumBreakMs"       => ReportFormat.Duration(row.SumBreakMs / 1000.0),
        "SumTrainingMs"    => ReportFormat.Duration(row.SumTrainingMs / 1000.0),
        "SumUnavailableMs" => ReportFormat.Duration(row.SumUnavailableMs / 1000.0),
        "TalkPureMs"       => ReportFormat.Duration(row.TalkPureMs / 1000.0),
        "Handled"          => row.Handled.ToString(),
        "OccupancyPct"     => ReportFormat.Pct(row.OccupancyPct),
        "HoldPct"          => ReportFormat.Pct(row.HoldPct),
        "AgentAht"         => ReportFormat.Duration(row.AgentAht),
        _                  => string.Empty
    };
}

@using CcDashboard.Application.HistoricalReports.Queries
@using ReportColumns = CcDashboard.Application.HistoricalReports.ReportColumns
@using ReportColumnKind = CcDashboard.Application.HistoricalReports.ReportColumnKind
@using ReportColumn = CcDashboard.Application.HistoricalReports.ReportColumn
@inject IStringLocalizer<SharedResources> L
@inject CcDashboard.Web.Services.ReportModalService Modal
@implements IDisposable

@* The funnel that sits next to a column's name, and the window it opens.

   Operator, 2026-11-07: "why didn't we make the filter like the real-time grids - a funnel at the
   column? I want filters on all the fields, and this way we just build another filter bar that
   duplicates the columns." He is right: a row of buttons above a table names the columns a second
   time, and the two namings drift.

   The funnel appears only where the rule says the column can be filtered - ReportColumns decides
   that, not this markup - and the window itself is the one the whole product uses.

   FEAT-REPORT-FILTER-MODAL-01 (operator 2026-11-07 16:22): the window is a MODAL now, drawn by the page's
   ReportModalHost outside the scaled board and titled with the column's name. It used to hang under the button inside
   the widget - clipped in a short widget, slid under the sticky header. Same window, same logic, one place. *@

<span class="column-filter-anchor">
    <button type="button"
            class="btn btn-sm btn-link p-0 align-baseline @(Applied is null ? "text-muted" : "text-primary")"
            title="@(Applied is null ? L["Widgets_Filter_List"].Value : L["Widget_ClearFilters"].Value)"
            @onclick="() => OnToggle.InvokeAsync(Column)"
            @onclick:stopPropagation="true">
        <i class="bi @(Applied is null ? "bi-funnel" : "bi-funnel-fill")"></i>
    </button>
</span>

@code {
    [Parameter, EditorRequired] public string Column { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ColumnLabel { get; set; } = string.Empty;

    /// <summary>The filter in force on this column, or null.</summary>
    [Parameter] public ReportColumnFilter? Applied { get; set; }

    /// <summary>What the column holds: the window offers the inputs that kind allows.</summary>
    [Parameter, EditorRequired] public ReportColumnKind Kind { get; set; }
    /// <summary>Passed on to the window: null keeps the browser's date field (FEAT-REPORT-QUEUE-DATE-FORMAT-01).</summary>
    [Parameter] public string? DateFormat { get; set; }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public IReadOnlyList<string> Values { get; set; } = Array.Empty<string>();
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool Truncated { get; set; }

    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public EventCallback<(string Column, ColumnFilterDraft Draft)> OnApply { get; set; }
    [Parameter] public EventCallback<string> OnClear { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>The widget's filter state: the funnels of one widget replace each other's window quietly.</summary>
    [Parameter] public object? Group { get; set; }

    // ---- FEAT-REPORT-FILTER-MODAL-01: the window goes to the page's host ------------------------------------------
    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
            await Modal.ShowAsync(this, Group, ColumnLabel, Window, () => OnClose.InvokeAsync());
        else
            Modal.Hide(this);
    }

    /// <summary>The window's body: the column's filter, or a spinner while its values load.</summary>
    private RenderFragment Window => __builder =>
    {
        if (Loading)
        {
            <div class="text-center py-3"><span class="spinner-border spinner-border-sm"></span></div>
        }
        else
        {
            <ColumnFilterPopup ColumnLabel="@ColumnLabel"
                               Kind="Kind"
                               DateFormat="@DateFormat"
                               Op="@Applied?.Op"
                               Text="@Applied?.Text"
                               SelectedValues="Applied?.Values"
                               Number="Applied?.Number"
                               NumberTo="Applied?.NumberTo"
                               Time="Applied?.Time"
                               TimeTo="Applied?.TimeTo"
                               Values="Values"
                               TotalCount="TotalCount"
                               Truncated="Truncated"
                               OnApply="draft => OnApply.InvokeAsync((Column, draft))"
                               OnClear="() => OnClear.InvokeAsync(Column)"
                               OnClose="OnClose" />
        }
    };

    public void Dispose() => Modal.Hide(this);
}

@using CcDashboard.Domain.Domain.Reports
@inject IStringLocalizer<SharedResources> L

@* Report Widget dispatcher - routes to specific report widget components *@

<div class="report-widget-render">
    @switch (WidgetType)
    {
        case ReportWidgetType.QueueInterval:
            <QueueIntervalReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
            break;
        case ReportWidgetType.QueueWaitTime:
            <QueueWaitTimeReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
            break;
        case ReportWidgetType.AgentMonthly:
            <AgentMonthlyReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
            break;
        case ReportWidgetType.AgentShiftDetail:
            <AgentShiftDetailReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
            break;
        case ReportWidgetType.Distribution:
            <DistributionReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
            break;
        default:
            <div class="report-widget-stub report-widget-unknown">
                <i class="bi bi-question-circle"></i>
                <span>@L["UnknownWidget"]</span>
            </div>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public ReportWidgetType WidgetType { get; set; }
    [Parameter] public string? ConfigJson { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public DateTime From { get; set; } = DateTime.UtcNow.Date.AddDays(-7);
    [Parameter] public DateTime To { get; set; } = DateTime.UtcNow.Date;
    [Parameter] public int Page { get; set; } = 1;

    private ReportWidgetConfig? _config;

    protected override void OnParametersSet()
    {
        _config = ReportWidgetConfig.Parse(ConfigJson);
    }
}

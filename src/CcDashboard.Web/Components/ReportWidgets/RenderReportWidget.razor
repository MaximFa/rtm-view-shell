@using CcDashboard.Domain.Domain.Reports
@inject IStringLocalizer<SharedResources> L

@* Report Widget dispatcher - mirrors RenderWidget pattern for report-specific widgets *@

<div class="report-widget-render">
    @switch (WidgetType)
    {
        case ReportWidgetType.QueueInterval:
            <div class="report-widget-stub">
                <i class="bi bi-table"></i>
                <span>@L["QueueInterval"] — stub</span>
            </div>
            break;
        case ReportWidgetType.QueueWaitTime:
            <div class="report-widget-stub">
                <i class="bi bi-clock-history"></i>
                <span>@L["QueueWaitTime"] — stub</span>
            </div>
            break;
        case ReportWidgetType.AgentMonthly:
            <div class="report-widget-stub">
                <i class="bi bi-calendar-month"></i>
                <span>@L["AgentMonthly"] — stub</span>
            </div>
            break;
        case ReportWidgetType.AgentShiftDetail:
            <div class="report-widget-stub">
                <i class="bi bi-person-lines-fill"></i>
                <span>@L["AgentShiftDetail"] — stub</span>
            </div>
            break;
        case ReportWidgetType.Distribution:
            <div class="report-widget-stub">
                <i class="bi bi-pie-chart"></i>
                <span>@L["Distribution"] — stub</span>
            </div>
            break;
        default:
            <div class="report-widget-stub report-widget-unknown">
                <i class="bi bi-question-circle"></i>
                <span>@L["UnknownWidget"]</span>
            </div>
            break;
    }
</div>

@code {
    [Parameter, EditorRequired] public ReportWidgetType WidgetType { get; set; }
    [Parameter] public string? ConfigJson { get; set; }
    [Parameter] public bool DarkMode { get; set; }
}

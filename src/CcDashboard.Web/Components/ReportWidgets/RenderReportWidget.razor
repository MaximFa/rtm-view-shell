@using CcDashboard.Domain.Domain.Reports
@inject IStringLocalizer<SharedResources> L

@* Report Widget dispatcher - routes to specific report widget components *@

<div class="report-widget-render" style="@BuildAppearanceStyle()">
    @if (_unconfigured)
    {
        <div class="report-widget-unconfigured text-center text-muted py-4">
            <i class="bi bi-gear fs-3 d-block mb-2 opacity-50"></i>
            <span>@L["ReportWidget_Unconfigured"]</span>
        </div>
    }
    else
    {
        @switch (WidgetType)
        {
            case ReportWidgetType.QueueInterval:
                <QueueIntervalReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
                break;
            case ReportWidgetType.QueueWaitTime:
                <QueueWaitTimeReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
                break;
            case ReportWidgetType.AgentMonthly:
                <AgentMonthlyReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
                break;
            case ReportWidgetType.AgentShiftDetail:
                <AgentShiftDetailReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
                break;
            case ReportWidgetType.Distribution:
                <DistributionReportWidget Config="_config" From="From" To="To" DarkMode="DarkMode" Page="Page" />
                break;
            default:
                <div class="report-widget-stub report-widget-unknown">
                    <i class="bi bi-question-circle"></i>
                    <span>@L["UnknownWidget"]</span>
                </div>
                break;
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public ReportWidgetType WidgetType { get; set; }
    [Parameter] public string? ConfigJson { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public DateTime From { get; set; } = DateTime.UtcNow.Date.AddDays(-7);
    [Parameter] public DateTime To { get; set; } = DateTime.UtcNow.Date;
    [Parameter] public int Page { get; set; } = 1;

    private ReportWidgetConfig? _config;
    private bool _unconfigured;

    protected override void OnParametersSet()
    {
        _config = ReportWidgetConfig.Parse(ConfigJson);

        // Widget is unconfigured if no BUs selected (BU-only scope)
        _unconfigured = _config is null
            || _config.Scope is null
            || _config.Scope.BusinessUnitIds is null
            || _config.Scope.BusinessUnitIds.Count == 0;
    }

    private string BuildAppearanceStyle()
    {
        var appearance = _config?.Appearance;
        if (appearance is null)
            return string.Empty;

        var vars = new List<string>();

        // Background - choose light or dark based on DarkMode
        var bg = DarkMode ? appearance.DarkBackground : appearance.LightBackground;
        if (!string.IsNullOrEmpty(bg) && bg != "transparent")
            vars.Add($"--rw-bg:{bg}");

        // Text color
        var text = DarkMode ? appearance.DarkTextColor : appearance.LightTextColor;
        if (!string.IsNullOrEmpty(text))
            vars.Add($"--rw-text:{text}");

        // Table background
        var tableBg = DarkMode ? appearance.DarkTableBackground : appearance.LightTableBackground;
        if (!string.IsNullOrEmpty(tableBg) && tableBg != "transparent")
            vars.Add($"--rw-table-bg:{tableBg}");

        // Font sizes - convert to px
        var tableFontPx = ResolveFontSizeToPixel(appearance.TableFontSize);
        if (!string.IsNullOrEmpty(tableFontPx))
            vars.Add($"--rw-table-font:{tableFontPx}px");

        var headerFontPx = ResolveFontSizeToPixel(appearance.HeaderFontSize);
        if (!string.IsNullOrEmpty(headerFontPx))
            vars.Add($"--rw-header-font:{headerFontPx}px");

        return string.Join("; ", vars);
    }

    private static string? ResolveFontSizeToPixel(string? value) => value switch
    {
        "small"   => "12",
        "normal"  => "14",
        "large"   => "18",
        "xlarge"  => "24",
        "xxlarge" => "32",
        null or "" => null,
        _ => value.TrimEnd('p', 'x')
    };
}

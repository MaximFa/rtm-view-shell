@using MediatR
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using CcDashboard.Application.HistoricalReports.Queries
@using CcDashboard.Domain.Domain.Reports
@inject IMediator Mediator
@inject IStringLocalizer<SharedResources> L
@inject ILogger<QueueIntervalReportWidget> Logger

@if (_denied)
{
    <div class="alert alert-warning">
        <i class="bi bi-shield-exclamation me-2"></i>@L["Report_AccessDenied"]
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>@_error
    </div>
}
else if (_loading)
{
    <div class="d-flex justify-content-center py-4">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@L["Common_Loading"]</span>
        </div>
    </div>
}
else if (_result is null || _result.Rows.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>@L["Report_NoData"]
    </div>
}
else
{
    <div class="report-widget-table-container">
        <div class="report-widget-table-scroll">
            <table class="table table-sm table-hover report-table report-widget-table" aria-label="@L["Report_QueueInterval"]">
                <caption class="visually-hidden">@L["Report_QueueInterval"]</caption>
                <thead class="@(DarkMode ? "table-dark" : "table-light")">
                    <tr>
                        <th scope="col">@L["Report_Interval"]</th>
                        <th scope="col">@L["Report_Workgroup"]</th>
                        <th scope="col" class="text-end">@L["Report_Offered"]</th>
                        <th scope="col" class="text-end">@L["Report_Answered"]</th>
                        <th scope="col" class="text-end">@L["Report_Abandoned"]</th>
                        <th scope="col" class="text-end">@L["Report_AbandonPct"]</th>
                        <th scope="col" class="text-end">@L["Report_AnsweredInSL"]</th>
                        <th scope="col" class="text-end">@L["Report_SLPct"]</th>
                        <th scope="col" class="text-end">@L["Report_ASA"]</th>
                        <th scope="col" class="text-end">@L["Report_AHT"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _result.Rows)
                    {
                        <tr>
                            <td>@row.IntervalStart.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@row.Workgroup</td>
                            <td class="text-end">@row.Offered</td>
                            <td class="text-end">@row.Answered</td>
                            <td class="text-end">@row.Abandoned</td>
                            <td class="text-end">@FormatPct(row.AbandonPct)</td>
                            <td class="text-end">@row.AnsweredInSl</td>
                            <td class="text-end">@FormatPct(row.SlPct)</td>
                            <td class="text-end">@FormatDuration(row.Asa)</td>
                            <td class="text-end">@FormatDuration(row.QueueAht)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="report-widget-footer">
        <span class="report-widget-footer-pagesize">
            <input type="number" class="form-control form-control-sm" style="width:70px"
                   min="1" max="1000" step="1" value="@_pageSize" @onchange="OnPageSizeChanged" />
            <span class="small text-muted ms-1">@L["Report_Rows"]</span>
        </span>
        <span class="report-widget-footer-info">
            @L["Report_Showing"] @_result.Rows.Count @L["Report_Of"] @_result.TotalCount
        </span>
        @if (TotalPages > 1)
        {
            <span class="report-widget-footer-pager">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page <= 1)" @onclick="PrevPage">
                    <i class="bi bi-chevron-left"></i>
                </button>
                <span class="mx-2">@_page / @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(_page >= TotalPages)" @onclick="NextPage">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </span>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ReportWidgetConfig? Config { get; set; }
    [Parameter, EditorRequired] public DateTime From { get; set; }
    [Parameter, EditorRequired] public DateTime To { get; set; }
    [Parameter] public bool DarkMode { get; set; }
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public Guid? TenantId { get; set; }

    private bool _loading;
    private bool _denied;
    private string? _error;
    private QueueIntervalReportResult? _result;
    private int _page = 1;
    private int _pageSize = 25;
    private DateTime _lastFrom;
    private DateTime _lastTo;
    private string? _lastConfigJson;
    private bool _initialized;

    private int TotalPages => _result is null ? 1 : (int)Math.Ceiling((double)_result.TotalCount / _pageSize);

    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized)
        {
            _pageSize = Config?.PageSize ?? 25;
            _initialized = true;
        }

        var configJson = Config?.ToJson();
        if (From != _lastFrom || To != _lastTo || configJson != _lastConfigJson)
        {
            _lastFrom = From;
            _lastTo = To;
            _lastConfigJson = configJson;
            _page = 1;
            await LoadData();
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        _denied = false;
        _error = null;
        StateHasChanged();

        try
        {
            var effectiveConfig = (Config ?? new ReportWidgetConfig()) with { PageSize = _pageSize };
            var configJson = effectiveConfig.ToJson();
            var res = await Mediator.Send(new RunReportWidgetQuery(
                ReportWidgetType.QueueInterval,
                configJson,
                From,
                To,
                _page,
                TenantId));

            if (res.Denied)
            {
                _denied = true;
                _result = null;
            }
            else if (!string.IsNullOrEmpty(res.Error))
            {
                _error = res.Error;
                _result = null;
            }
            else
            {
                _result = res.QueueInterval;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "QueueIntervalReportWidget load failed");
            _error = ex.Message;
            _result = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            _pageSize = Math.Clamp(size, 1, 1000);
            _page = 1;
            await LoadData();
        }
    }

    private async Task PrevPage()
    {
        if (_page > 1)
        {
            _page--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages)
        {
            _page++;
            await LoadData();
        }
    }

    private static string FormatPct(double? val) => val.HasValue ? $"{val.Value:F1}%" : "-";

    private static string FormatDuration(double? seconds)
    {
        if (!seconds.HasValue) return "-";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}:{ts.Minutes:D2}:{ts.Seconds:D2}"
            : $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
